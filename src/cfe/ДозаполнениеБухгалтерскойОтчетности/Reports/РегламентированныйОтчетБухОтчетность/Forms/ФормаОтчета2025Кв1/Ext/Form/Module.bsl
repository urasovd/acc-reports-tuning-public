// Дозаполнение бухгалтерской отчётности: кнопки «Заполнить с доработками».
// План: docs/urdv-dozapolnenie-buh-otchetnosti/01-план.md

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура дбу_ПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка)

	дбу_ДобавитьКомандыЗаполненияСДоработками();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура дбу_ЗаполнитьСДоработками(Команда)

	дбу_ЗаполнитьСДоработкамиНаКлиенте(Команды.Заполнить, Ложь);

КонецПроцедуры

&НаКлиенте
Процедура дбу_ЗаполнитьТекущийСДоработками(Команда)

	дбу_ЗаполнитьСДоработкамиНаКлиенте(Команды.ЗаполнитьТекущий, Истина);

КонецПроцедуры

// Штатная команда должна всегда запускать только типовое заполнение.
// Сбрасываем флаг после возможного неуспешного запуска пользовательского режима
// до начала фоновой операции типовой формы.
&НаКлиенте
&Перед("ЗаполнитьАвто")
Процедура дбу_ЗаполнитьАвтоПеред(Команда)

	дбу_СброситьПараметрыЗаполненияСДоработкамиНаКлиенте();
	дбу_СброситьПараметрыЗаполненияСДоработкамиНаСервере();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура дбу_ЗаполнитьСДоработкамиНаКлиенте(КомандаЗаполнения, ТолькоТекущийРаздел)

	Отказ = Ложь;
	РегламентированнаяОтчетностьКлиентПереопределяемый.ПроверитьВозможностьАвтоЗаполненияРеглОтчета(ИмяФормы, Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	Если РегламентированнаяОтчетностьКлиент.АвтозаполнениеБудетРеализованоВБудущихВерсиях(ЭтотОбъект) Тогда
		Возврат;
	КонецЕсли;

	дбу_УстановитьПараметрыЗаполненияСДоработкамиНаСервере(ТолькоТекущийРаздел);

	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Команда", КомандаЗаполнения);

	ЗаполнитьАвтоЗавершение(Отказ, ДополнительныеПараметры);

КонецПроцедуры

&НаСервере
&После("ЗагрузитьДанныеЗаполнения")
Процедура дбу_ЗагрузитьДанныеЗаполненияПосле()

	Если Не дбу_НужноПрименитьДоработкиПослеЗагрузки() Тогда
		Возврат;
	КонецЕсли;

	дбу_СброситьПараметрыЗаполненияСДоработкамиНаСервере();
	дбу_ПрименитьДоработкиНаСервере();

КонецПроцедуры

&НаСервере
Процедура дбу_ДобавитьКомандыЗаполненияСДоработками()

	дбу_ДобавитьКомандуЗаполненияСДоработками(
		"дбу_ЗаполнитьСДоработками",
		"Заполнить с доработками",
		"Стандартное заполнение всех разделов по данным учёта с последующим применением "
			+ "правил доработки по направлениям бизнеса организации.");

	дбу_ДобавитьКомандуЗаполненияСДоработками(
		"дбу_ЗаполнитьТекущийСДоработками",
		"Заполнить текущий с доработками",
		"Стандартное заполнение текущего раздела по данным учёта с последующим применением "
			+ "правил доработки только для этого раздела.");

КонецПроцедуры

&НаСервере
Процедура дбу_ДобавитьКомандуЗаполненияСДоработками(ИмяКоманды, Заголовок, Подсказка)

	НоваяКоманда = ЭтаФорма.Команды.Добавить(ИмяКоманды);
	НоваяКоманда.Действие = ИмяКоманды;
	НоваяКоманда.Заголовок = Заголовок;
	НоваяКоманда.Подсказка = Подсказка;

	ЭлементКоманда = ЭтаФорма.Элементы.Добавить(ИмяКоманды, Тип("КнопкаФормы"), ЭтаФорма.Элементы.ПодменюЗаполнить);
	ЭлементКоманда.ИмяКоманды = ИмяКоманды;
	ЭлементКоманда.Вид = ВидКнопкиФормы.ОбычнаяКнопка;

КонецПроцедуры

&НаСервере
Процедура дбу_УстановитьПараметрыЗаполненияСДоработкамиНаСервере(ТолькоТекущийРаздел)

	СтруктураРеквизитовФормы.Вставить("дбу_ПрименитьДоработкиПриЗагрузке", Истина);
	СтруктураРеквизитовФормы.Вставить("дбу_ОграничитьДоработкиТекущимРазделом", ТолькоТекущийРаздел);

	ИмяРазделаДляДоработок = "";
	Если ТолькоТекущийРаздел Тогда
		ИмяРазделаДляДоработок = СтруктураРеквизитовФормы.НаимТекущегоРаздела;
	КонецЕсли;

	СтруктураРеквизитовФормы.Вставить("дбу_РазделДляДоработок", ИмяРазделаДляДоработок);

КонецПроцедуры

&НаКлиенте
Процедура дбу_СброситьПараметрыЗаполненияСДоработкамиНаКлиенте()

	Если СтруктураРеквизитовФормы = Неопределено Тогда
		Возврат;
	КонецЕсли;

	СтруктураРеквизитовФормы.Вставить("дбу_ПрименитьДоработкиПриЗагрузке", Ложь);
	СтруктураРеквизитовФормы.Вставить("дбу_ОграничитьДоработкиТекущимРазделом", Ложь);
	СтруктураРеквизитовФормы.Вставить("дбу_РазделДляДоработок", "");

КонецПроцедуры

&НаСервере
Процедура дбу_СброситьПараметрыЗаполненияСДоработкамиНаСервере()

	СтруктураРеквизитовФормы.Вставить("дбу_ПрименитьДоработкиПриЗагрузке", Ложь);
	СтруктураРеквизитовФормы.Вставить("дбу_ОграничитьДоработкиТекущимРазделом", Ложь);
	СтруктураРеквизитовФормы.Вставить("дбу_РазделДляДоработок", "");

КонецПроцедуры

&НаСервере
Функция дбу_НужноПрименитьДоработкиПослеЗагрузки()

	ЗначениеФлага = Ложь;
	Если СтруктураРеквизитовФормы.Свойство("дбу_ПрименитьДоработкиПриЗагрузке", ЗначениеФлага) Тогда
		Возврат ЗначениеФлага = Истина;
	КонецЕсли;

	Возврат Ложь;

КонецФункции

&НаСервере
Функция дбу_ПараметрыПримененияДоработок()

	// Не использовать имя «Параметры» — на форме это свойство только для чтения.
	ПараметрыПрименения = Новый Структура;
	ПараметрыПрименения.Вставить("РазделОтбора", Неопределено);
	ПараметрыПрименения.Вставить("ТолькоУказанныйРаздел", Ложь);

	ОграничитьТекущимРазделом = Ложь;
	Если СтруктураРеквизитовФормы.Свойство("дбу_ОграничитьДоработкиТекущимРазделом", ОграничитьТекущимРазделом)
		И ОграничитьТекущимРазделом Тогда

		ПараметрыПрименения.ТолькоУказанныйРаздел = Истина;

		ИмяРаздела = "";
		Если СтруктураРеквизитовФормы.Свойство("дбу_РазделДляДоработок", ИмяРаздела) Тогда
			ПараметрыПрименения.РазделОтбора = дбу_СтруктураОтчетности.РазделБухОтчетностиПоИмени(ИмяРаздела);
		КонецЕсли;

	КонецЕсли;

	Возврат ПараметрыПрименения;

КонецФункции

&НаСервере
Процедура дбу_ПрименитьДоработкиНаСервере()

	ДеревоДанныхРазделов = ПолучитьИзВременногоХранилища(СтруктураМногострочныхРазделов);
	ПараметрыПрименения = дбу_ПараметрыПримененияДоработок();

	дбу_ДвижокДоработки.ПрименитьДоработки(
		СтруктураРеквизитовФормы.Организация, СтруктураРеквизитовФормы.мДатаКонцаПериодаОтчета, ДеревоДанныхРазделов,
		СтруктураРеквизитовФормы, ПараметрыПрименения.РазделОтбора, ПараметрыПрименения.ТолькоУказанныйРаздел);

	РегламентированнаяОтчетность.ПоместитьВКэш(
		ДеревоДанныхРазделов, УникальныйИдентификатор, СтруктураМногострочныхРазделов);

	АдаптироватьМеханизмРасшифровки2011(ДеревоДанныхРазделов);
	ВывестиМакетВТаблДокНаСервере(СтруктураРеквизитовФормы.НаимТекущегоРаздела);
	ГибридныйРасчетПоказателей();

	Модифицированность = Истина;

КонецПроцедуры

#КонецОбласти
