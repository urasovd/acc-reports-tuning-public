&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ПериодПрименения = НачалоМесяца(ТекущаяДатаСеанса());
	ПерезаписатьСуществующее = Истина;

КонецПроцедуры

&НаКлиенте
Процедура СоздатьПример(Команда)

	Если Не ЗначениеЗаполнено(Организация) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Укажите организацию для применения профиля.'"));
		Возврат;
	КонецЕсли;

	РезультатСоздания = СоздатьПримерНаСервере();
	Если Не РезультатСоздания.Успех Тогда
		ПоказатьПредупреждение(, РезультатСоздания.ТекстОшибки);
		Возврат;
	КонецЕсли;

	СсылкаПравила = РезультатСоздания.Правило;
	Протокол = РезультатСоздания.Протокол;

	// После создания остаёмся на форме с протоколом результата.
	// Правило открывается отдельной кнопкой «Открыть правило».

КонецПроцедуры

&НаКлиенте
Процедура СоздатьПримерОткрытьПравило(Ответ, СсылкаПравила) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	ПараметрыФормы = Новый Структура("Ключ", СсылкаПравила);
	ОткрытьФорму("Справочник.дбу_ПравилаДоработки.Форма.ФормаЭлемента", ПараметрыФормы);

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьПравило(Команда)

	Если Не ЗначениеЗаполнено(СсылкаПравила) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Сначала создайте пример.'"));
		Возврат;
	КонецЕсли;

	ПараметрыФормы = Новый Структура("Ключ", СсылкаПравила);
	ОткрытьФорму("Справочник.дбу_ПравилаДоработки.Форма.ФормаЭлемента", ПараметрыФормы);

КонецПроцедуры

&НаСервере
Функция СоздатьПримерНаСервере()

	Результат = дбу_ПримерыПравил.СоздатьПолигонТестирования(Организация, ПериодПрименения, ПерезаписатьСуществующее);
	Если Результат.Успех Тогда
		СсылкаПравила = Результат.Правило;
		Протокол = Результат.Протокол;
	КонецЕсли;

	Возврат Результат;

КонецФункции
