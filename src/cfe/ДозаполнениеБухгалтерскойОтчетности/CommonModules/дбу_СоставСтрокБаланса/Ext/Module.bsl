// Переводит типовые составляющие строки баланса в строки, которые можно выбрать на форме правила.
// В операнд переносятся только простые СКД и СКК с одним счётом.

#Область ПрограммныйИнтерфейс

// Алгоритмы строк баланса организации на дату отчёта.
//
Функция АлгоритмыБаланса(Организация, Период, ЭтоБалансНекоммерческойОрганизации = Ложь) Экспорт

	Возврат ЗаполнениеБухгалтерскойОтчетности2025Основная.дбу_АлгоритмыБалансаОрганизации(
		Организация, Период, ЭтоБалансНекоммерческойОрганизации);

КонецФункции

// Номер и наименование каждой строки, которую вернул типовой построитель.
//
Функция СтрокиИзАлгоритмов(Алгоритмы) Экспорт

	Строки = Новый ТаблицаЗначений;
	Строки.Колонки.Добавить("Номер", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(10)));
	Строки.Колонки.Добавить("Наименование", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(150)));

	Для Каждого Алгоритм Из Алгоритмы Цикл
		Строка = Строки.Добавить();
		Строка.Номер = СокрЛП(Алгоритм.Номер);
		Строка.Наименование = СокрЛП(Алгоритм.Наименование);
	КонецЦикла;

	Возврат Строки;

КонецФункции

// Составляющие одной строки. МожноВыбрать = Истина только для +СКД / -СКК с одним счётом.
//
Функция СоставляющиеИзАлгоритмов(Алгоритмы, НомерСтроки) Экспорт

	Составляющие = НовыйСоставляющие();
	Алгоритм = НайтиАлгоритм(Алгоритмы, НомерСтроки);
	Если Алгоритм = Неопределено Тогда
		Возврат Составляющие;
	КонецЕсли;

	Для Каждого Элемент Из Алгоритм.Составляющие Цикл
		Строка = Составляющие.Добавить();
		ЗаполнитьСоставляющую(Строка, Элемент);
	КонецЦикла;

	Возврат Составляющие;

КонецФункции

// Код строки баланса, если она есть в макете и её можно выбрать. Иначе пустая строка.
//
Функция СтрокаОтчетностиПоКоду(КодСтроки) Экспорт

	Описание = дбу_СтруктураОтчетности.ОписаниеСтроки(
		Перечисления.дбу_РазделыБухОтчетности.Баланс, КодСтроки);
	Если Описание = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Возврат Описание.КодСтроки;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НовыйСоставляющие()

	Составляющие = Новый ТаблицаЗначений;
	Составляющие.Колонки.Добавить("Пометка", Новый ОписаниеТипов("Булево"));
	Составляющие.Колонки.Добавить("Знак", Новый ОписаниеТипов("Число"));
	Составляющие.Колонки.Добавить("Способ", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(50)));
	Составляющие.Колонки.Добавить("КодСчета", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(20)));
	Составляющие.Колонки.Добавить("Счет", Новый ОписаниеТипов("ПланСчетовСсылка.Хозрасчетный"));
	Составляющие.Колонки.Добавить("Описание", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(250)));
	Составляющие.Колонки.Добавить("МожноВыбрать", Новый ОписаниеТипов("Булево"));
	Составляющие.Колонки.Добавить("Причина", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(200)));
	Возврат Составляющие;

КонецФункции

Функция НайтиАлгоритм(Алгоритмы, НомерСтроки)

	ИскомыйНомер = СокрЛП(НомерСтроки);
	Для Каждого Алгоритм Из Алгоритмы Цикл
		Если СокрЛП(Алгоритм.Номер) = ИскомыйНомер Тогда
			Возврат Алгоритм;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

Процедура ЗаполнитьСоставляющую(Строка, Элемент)

	Описание = "";
	Если ТипЗнч(Элемент) = Тип("Массив") И Элемент.Количество() > 0 Тогда
		Описание = Строка(Элемент[0]);
	КонецЕсли;
	Строка.Описание = Описание;

	Текст = СтрЗаменить(Описание, " ", "");
	Строка.Знак = 1;
	Если Лев(Текст, 1) = "-" Тогда
		Строка.Знак = -1;
		Текст = Сред(Текст, 2);
	ИначеЕсли Лев(Текст, 1) = "+" Тогда
		Текст = Сред(Текст, 2);
	КонецЕсли;

	ПозицияСчета = 1;
	Пока ПозицияСчета <= СтрДлина(Текст) Цикл
		Если СтрНайти("0123456789", Сред(Текст, ПозицияСчета, 1)) > 0 Тогда
			Прервать;
		КонецЕсли;
		ПозицияСчета = ПозицияСчета + 1;
	КонецЦикла;

	Строка.Способ = Лев(Текст, ПозицияСчета - 1);
	Счета = Сред(Текст, ПозицияСчета);
	Если СтрНайти(Счета, ",") > 0 Тогда
		Строка.КодСчета = Счета;
		Строка.Причина = НСтр("ru = 'В одной строке несколько счетов, её нельзя перенести одним операндом.'");
		Возврат;
	КонецЕсли;

	Строка.КодСчета = Счета;
	Если Строка.Способ <> "СКД" И Строка.Способ <> "СКК" Тогда
		Строка.Причина = НСтр("ru = 'Этот вид составляющей правило пока не переносит.'");
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Счета) Тогда
		Строка.Причина = НСтр("ru = 'В описании нет счёта.'");
		Возврат;
	КонецЕсли;

	Счет = ПланыСчетов.Хозрасчетный.НайтиПоКоду(Счета);
	Если Не ЗначениеЗаполнено(Счет) Тогда
		Строка.Причина = СтрШаблон(НСтр("ru = 'Счёт %1 не найден в плане счетов.'"), Счета);
		Возврат;
	КонецЕсли;

	Строка.Счет = Счет;
	Строка.МожноВыбрать = Истина;

КонецПроцедуры

#КонецОбласти
