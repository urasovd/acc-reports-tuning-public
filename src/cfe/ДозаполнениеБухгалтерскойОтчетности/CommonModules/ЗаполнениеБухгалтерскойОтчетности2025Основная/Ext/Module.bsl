// Вызов закрытого построителя состава строк баланса из расширения.
// Собственный метод заимствованного модуля видит неэкспортные методы типового модуля.

#Область ПрограммныйИнтерфейс

// Возвращает алгоритмы строк баланса 2025.
//
// Параметры:
//  ПараметрыАлгоритмов - Структура - поля, которые собирает ПараметрыАлгоритмовБаланса2025.
//
// Возвращаемое значение:
//  Массив из Структура - алгоритмы строк. Составляющие: массив из описание и доп. параметры.
//
Функция дбу_АлгоритмыБаланса(ПараметрыАлгоритмов) Экспорт

	Возврат АлгоритмыБО2025Кв1_Баланс(ПараметрыАлгоритмов);

КонецФункции

// Собирает параметры так же, как типовое заполнение, и возвращает алгоритмы строк.
// Для коммерческой отчётности ЭтоБалансНекоммерческойОрганизации = Ложь.
// Если в учётной политике включена классификация по срокам, читаются те же бухгалтерские итоги,
// без которых типовой построитель не отдаёт строки задолженности.
//
Функция дбу_АлгоритмыБалансаОрганизации(Организация, Период, ЭтоБалансНекоммерческойОрганизации = Ложь) Экспорт

	ПараметрыЗаполнения = НовыеПараметрыЗаполненияБаланс();
	ПараметрыЗаполнения.Организация = Организация;
	ПараметрыЗаполнения.КонецОтчетногоПериода = КонецДня(Период);
	ПараметрыЗаполнения.НачалоПериодаОтчета = НачалоМесяца(Период);
	ПараметрыЗаполнения.КонецПериодаОтчета = Новый МоментВремениСУточнениемПериода(КонецМесяца(Период), 0);
	ПараметрыЗаполнения.ЭтоБалансНекоммерческойОрганизации = ЭтоБалансНекоммерческойОрганизации;
	ПараметрыЗаполнения.РазделятьАвансыПоВидамАктивов =
		РегламентированнаяОтчетность.АвансыРазделеныПоВидамАктивов(Организация, Период);
	ПараметрыЗаполнения.СчетаСРеквизитами = ЗаполнениеБухгалтерскойОтчетностиИтоги.СчетаСРеквизитами();
	ПараметрыЗаполнения.Вставить("бит_стр_СчетВСтроке",
		бит_стр_Сервер.ПолучитьПравилоОтображенияСчетовВБалансе(
			Новый Структура("Организация, КонецОтчетногоПериода", Организация, ПараметрыЗаполнения.КонецОтчетногоПериода)));

	ГоловнаяОрганизация = БухгалтерскийУчетПереопределяемый.ГоловнаяОрганизация(Организация);
	Классифицировать = УчетнаяПолитика.КлассифицироватьАктивыОбязательстваПоСрокам(
		ПараметрыЗаполнения.КонецОтчетногоПериода, ГоловнаяОрганизация);

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		ОбщиеИтогиПоСчетам = Неопределено;
		Если Классифицировать Тогда
			ОбщиеИтогиПоСчетам = РассчитатьБухгалтерскиеВеличиныФормаОтчета2025Кв1_Баланс(ПараметрыЗаполнения);
		Иначе
			ПараметрыЗаполнения.НастройкаВключенаКлассифицироватьАктивыОбязательства = Ложь;
			ПараметрыЗаполнения.КлассифицироватьАктивыОбязательстваПоСрокам = Ложь;
		КонецЕсли;
		Алгоритмы = АлгоритмыБО2025Кв1_Баланс(ПараметрыАлгоритмовБаланса2025(ПараметрыЗаполнения, ОбщиеИтогиПоСчетам));
		УстановитьПривилегированныйРежим(Ложь);
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;

	Возврат Алгоритмы;

КонецФункции

#КонецОбласти
