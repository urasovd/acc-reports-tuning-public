// Расчет обязательств по аренде для бухгалтерской отчетности по схеме справки-расчета (Excel).
// Источник суммы — график платежей документов аренды. Остатки 76.07.1 и 76.07.2
// определяют порядок оплаты: обычный, предоплата, постоплата или неоднозначный.
//
// Схема строк баланса, которую воспроизводят правила:
//  - 1450: долгосрочная часть — платежи позже 12 месяцев, дисконтированные по дням, без НДС;
//  - 1550: краткосрочная часть — платежи в пределах 12 месяцев (без уже начисленных
//          при постоплате) плюс аванс при предоплате;
//  - 1520: неоплаченные начисленные платежи 76.07.2 — обычная кредиторская задолженность.

#Область ПрограммныйИнтерфейс

// Рассчитывает обязательства по всем договорам аренды организации на отчетную дату.
//
// Возвращаемое значение:
//  Структура - КраткосрочнаяЧасть, ДолгосрочнаяЧасть, ВсегоОбязательство,
//              НеоплаченныеПлатежи, ТиповаяКраткосрочнаяЧасть, ТиповаяДолгосрочнаяЧасть,
//              Договоры (Массив), Предупреждения (Массив).
//
Функция РассчитатьПоОрганизации(Организация, ОтчетнаяДата, Допуск = 1) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("КраткосрочнаяЧасть", 0);
	Результат.Вставить("ДолгосрочнаяЧасть", 0);
	Результат.Вставить("ВсегоОбязательство", 0);
	Результат.Вставить("НеоплаченныеПлатежи", 0);
	Результат.Вставить("ТиповаяКраткосрочнаяЧасть", 0);
	Результат.Вставить("ТиповаяДолгосрочнаяЧасть", 0);
	Результат.Вставить("Договоры", Новый Массив);
	Результат.Вставить("Предупреждения", Новый Массив);

	Если Не ЗначениеЗаполнено(Организация) Тогда
		Результат.Предупреждения.Добавить(НСтр("ru = 'Не указана организация для расчета аренды.'"));
		Возврат Результат;
	КонецЕсли;

	ДатаРасчета = НачалоДня(ОтчетнаяДата);
	ГруппыИсточников = ИсточникиГрафиковПоДоговорам(Организация, КонецДня(ДатаРасчета));
	Договоры = Новый Массив;
	Для Каждого ЭлементГруппы Из ГруппыИсточников Цикл
		Договоры.Добавить(ЭлементГруппы.Ключ);
	КонецЦикла;

	Остатки = Остатки7607ПоДоговорам(Организация, ДатаРасчета, Договоры);

	Для Каждого ЭлементГруппы Из ГруппыИсточников Цикл

		Договор = ЭлементГруппы.Ключ;
		Группа = ЭлементГруппы.Значение;
		График = НовыйГрафикРасчета();
		АвансовыеПлатежи = 0;
		Источники = ИсточникиДействующегоГрафика(Группа);
		ЗаполнитьГрафикИзИсточников(График, Источники, АвансовыеПлатежи);

		ОстаткиДоговора = Остатки.Получить(Договор);
		Если ОстаткиДоговора = Неопределено Тогда
			ОстаткиДоговора = Новый Структура("Остаток76071,Остаток76072", 0, 0);
		КонецЕсли;

		Расчет = РассчитатьПоДанным(График, ДатаРасчета,
			ОстаткиДоговора.Остаток76071, ОстаткиДоговора.Остаток76072,
			АвансовыеПлатежи, Допуск);
		Расчет.Вставить("Договор", Договор);
		Расчет.Вставить("Контрагент", Группа.Контрагент);
		Расчет.Вставить("ИсточникиГрафика", Источники);

		Если Расчет.ВидРасчета = "Неоднозначный" И ОстаткиДоговора.Остаток76072 > Допуск Тогда
			Погашение = ПогашениеПо76072(Организация, Договор, ДатаРасчета);
			РаспределитьОтсрочку(Расчет, Погашение.Оплачено, Погашение.ПроцентыНачислено,
				Погашение.КоличествоОплат, Допуск);
		КонецЕсли;

		Результат.КраткосрочнаяЧасть = Результат.КраткосрочнаяЧасть + Расчет.КраткосрочнаяЧасть;
		Результат.ДолгосрочнаяЧасть = Результат.ДолгосрочнаяЧасть + Расчет.ДолгосрочнаяЧасть;
		Результат.ВсегоОбязательство = Результат.ВсегоОбязательство + Расчет.ВсегоОбязательство;
		Результат.НеоплаченныеПлатежи = Результат.НеоплаченныеПлатежи + Расчет.НеоплаченныеПлатежи;
		Результат.Договоры.Добавить(Расчет);

		Для Каждого Предупреждение Из Расчет.Предупреждения Цикл
			Результат.Предупреждения.Добавить(СтрШаблон("%1: %2", Строка(Договор), Предупреждение));
		КонецЦикла;

	КонецЦикла;

	Типовые = ТиповыеАрендныеОбязательства(Организация, ДатаРасчета);
	Результат.ТиповаяКраткосрочнаяЧасть = Типовые.КраткосрочнаяЧасть;
	Результат.ТиповаяДолгосрочнаяЧасть = Типовые.ДолгосрочнаяЧасть;

	Возврат Результат;

КонецФункции

// Выполняет чистый расчет по переданному графику. Функция не читает и не изменяет данные ИБ.
// График должен содержать колонки ДатаПлатежа, СуммаПлатежа, СуммаНДСПлатежа,
// СтавкаДисконтирования (годовая, в процентах).
//
// Платеж дисконтируется по дням: СуммаБезНДС / (1 + Ставка)^(Дней / 365).
// Платежи до отчетной даты + 12 месяцев включительно — краткосрочная часть, позже — долгосрочная.
// При постоплате ближайшие платежи, уже начисленные на 76.07.2, в аренду не включаются:
// они показываются как кредиторская задолженность (НеоплаченныеПлатежи).
// При предоплате оплаченный аванс (без НДС) добавляется в краткосрочную часть.
//
Функция РассчитатьПоДанным(График, ОтчетнаяДата, Остаток76071 = 0,
	Остаток76072 = 0, АвансовыеПлатежи = 0, Допуск = 1) Экспорт

	ДатаРасчета = НачалоДня(ОтчетнаяДата);
	ДатаГраницыКраткосрочнойЧасти = ДобавитьМесяц(ДатаРасчета, 12);

	БудущиеПлатежи = НоваяТаблицаСтрокРасчета();
	Для Каждого Платеж Из График Цикл
		ДатаПлатежа = НачалоДня(Платеж.ДатаПлатежа);
		Если ДатаПлатежа <= ДатаРасчета Тогда
			Продолжить;
		КонецЕсли;
		СтрокаРасчета = БудущиеПлатежи.Добавить();
		СтрокаРасчета.ДатаПлатежа = ДатаПлатежа;
		СтрокаРасчета.СуммаПлатежа = Платеж.СуммаПлатежа;
		СтрокаРасчета.СуммаНДСПлатежа = Платеж.СуммаНДСПлатежа;
		СтрокаРасчета.СуммаБезНДС = Платеж.СуммаПлатежа - Платеж.СуммаНДСПлатежа;
		СтрокаРасчета.СтавкаДисконтирования = Платеж.СтавкаДисконтирования;
	КонецЦикла;
	БудущиеПлатежи.Сортировать("ДатаПлатежа");

	СуммыПлатежей = Новый Массив;
	Для Каждого СтрокаРасчета Из БудущиеПлатежи Цикл
		СуммыПлатежей.Добавить(СтрокаРасчета.СуммаПлатежа);
	КонецЦикла;
	Классификация = КлассифицироватьСпособОплаты(СуммыПлатежей, Остаток76071, Остаток76072, Допуск);

	СуммаГрафикаБрутто = 0;
	СуммаГрафикаБезНДС = 0;
	КраткосрочнаяПоГрафику = 0;
	ДолгосрочнаяЧасть = 0;
	НачисленоДисконтированное = 0;
	НомерПлатежа = 0;

	Для Каждого СтрокаРасчета Из БудущиеПлатежи Цикл

		НомерПлатежа = НомерПлатежа + 1;
		СтрокаРасчета.КоличествоДней = (СтрокаРасчета.ДатаПлатежа - ДатаРасчета) / 86400;
		СтрокаРасчета.ДисконтированнаяСумма = ДисконтированнаяСумма(СтрокаРасчета.СуммаБезНДС,
			СтрокаРасчета.СтавкаДисконтирования, СтрокаРасчета.КоличествоДней);

		СуммаГрафикаБрутто = СуммаГрафикаБрутто + СтрокаРасчета.СуммаПлатежа;
		СуммаГрафикаБезНДС = СуммаГрафикаБезНДС + СтрокаРасчета.СуммаБезНДС;

		Если НомерПлатежа <= Классификация.КоличествоНачисленныхПлатежей Тогда
			НачисленоДисконтированное = НачисленоДисконтированное + СтрокаРасчета.ДисконтированнаяСумма;
			СтрокаРасчета.ВидЧасти = "Начислено";
		ИначеЕсли СтрокаРасчета.ДатаПлатежа <= ДатаГраницыКраткосрочнойЧасти Тогда
			КраткосрочнаяПоГрафику = КраткосрочнаяПоГрафику + СтрокаРасчета.ДисконтированнаяСумма;
			СтрокаРасчета.ВидЧасти = "Краткосрочная";
		Иначе
			ДолгосрочнаяЧасть = ДолгосрочнаяЧасть + СтрокаРасчета.ДисконтированнаяСумма;
			СтрокаРасчета.ВидЧасти = "Долгосрочная";
		КонецЕсли;

	КонецЦикла;

	// Аванс сидит в 76.07.1 с НДС, обязательство показывается без НДС.
	ПредоплатаВРасчете = Классификация.СуммаПредоплаты;
	Если ПредоплатаВРасчете <> 0 И СуммаГрафикаБрутто <> 0 Тогда
		ПредоплатаВРасчете = ПредоплатаВРасчете * СуммаГрафикаБезНДС / СуммаГрафикаБрутто;
	КонецЕсли;
	Если Классификация.Вид = "Предоплата" И АвансовыеПлатежи <> 0
		И АбсолютноеЗначение(АвансовыеПлатежи - Классификация.СуммаПредоплаты) > Допуск Тогда
		Классификация.Предупреждения.Добавить(СтрШаблон(
			НСтр("ru = 'Аванс в документе аренды (%1) не совпадает с превышением 76.07.1 над графиком (%2); в расчет взята разница с 76.07.1.'"),
			Формат(АвансовыеПлатежи, "ЧДЦ=2; ЧГ=0"), Формат(Классификация.СуммаПредоплаты, "ЧДЦ=2; ЧГ=0")));
	КонецЕсли;

	КраткосрочнаяЧасть = КраткосрочнаяПоГрафику + ПредоплатаВРасчете;

	Результат = Новый Структура;
	Результат.Вставить("ВидРасчета", Классификация.Вид);
	Результат.Вставить("СуммаГрафикаБрутто", СуммаГрафикаБрутто);
	Результат.Вставить("СуммаГрафикаБезНДС", СуммаГрафикаБезНДС);
	Результат.Вставить("Остаток76071", Остаток76071);
	Результат.Вставить("Остаток76072", Остаток76072);
	Результат.Вставить("КонтрольнаяРазница", Классификация.Разница);
	Результат.Вставить("Предоплата", ПредоплатаВРасчете);
	Результат.Вставить("НачисленоПоГрафику", Классификация.СуммаНачисленныхПлатежей);
	Результат.Вставить("НачисленоДисконтированное", НачисленоДисконтированное);
	Результат.Вставить("НеоплаченныеПлатежи", Классификация.НеоплаченныеПлатежи);
	Результат.Вставить("КраткосрочнаяПоГрафику", КраткосрочнаяПоГрафику);
	Результат.Вставить("КраткосрочнаяЧасть", КраткосрочнаяЧасть);
	Результат.Вставить("ДолгосрочнаяЧасть", ДолгосрочнаяЧасть);
	Результат.Вставить("ВсегоОбязательство", КраткосрочнаяЧасть + ДолгосрочнаяЧасть);
	Результат.Вставить("СтрокиРасчета", БудущиеПлатежи);
	Результат.Вставить("Предупреждения", Классификация.Предупреждения);
	Возврат Результат;

КонецФункции

// Определяет порядок оплаты по сверке будущих платежей графика с 76.07.1 и 76.07.2.
//
// Параметры:
//  СуммыПлатежей - Массив из Число - суммы будущих платежей с НДС в порядке дат.
//
// Возвращаемое значение:
//  Структура - Вид (Обычный, Предоплата, Постоплата, Неоднозначный), Разница,
//              СуммаПредоплаты, КоличествоНачисленныхПлатежей, СуммаНачисленныхПлатежей,
//              НеоплаченныеПлатежи, Предупреждения.
//
// Постоплата признается, только если превышение графика над 76.07.1 в точности равно
// нескольким ближайшим платежам и покрыто кредитом 76.07.2: эти платежи уже начислены,
// но еще не оплачены. Иначе график считается полностью и выдается предупреждение.
//
Функция КлассифицироватьСпособОплаты(СуммыПлатежей, Остаток76071,
	Остаток76072 = 0, Допуск = 1) Экспорт

	СуммаГрафика = 0;
	Для Каждого Сумма Из СуммыПлатежей Цикл
		СуммаГрафика = СуммаГрафика + Сумма;
	КонецЦикла;

	Разница = СуммаГрафика - Остаток76071;
	Предупреждения = Новый Массив;
	Результат = Новый Структура;
	Результат.Вставить("Вид", "Неоднозначный");
	Результат.Вставить("Разница", Разница);
	Результат.Вставить("СуммаПредоплаты", 0);
	Результат.Вставить("КоличествоНачисленныхПлатежей", 0);
	Результат.Вставить("СуммаНачисленныхПлатежей", 0);
	Результат.Вставить("НеоплаченныеПлатежи", Остаток76072);
	Результат.Вставить("Предупреждения", Предупреждения);

	Если АбсолютноеЗначение(Разница) <= Допуск Тогда
		Результат.Вид = "Обычный";
		Возврат Результат;
	КонецЕсли;

	Если Разница < 0 Тогда
		Результат.Вид = "Предоплата";
		Результат.СуммаПредоплаты = -Разница;
		Возврат Результат;
	КонецЕсли;

	КоличествоНачисленных = КоличествоПлатежейНакопленныхДо(СуммыПлатежей, Разница, Допуск);
	Если КоличествоНачисленных > 0 И Остаток76072 >= Разница - Допуск Тогда
		Результат.Вид = "Постоплата";
		Результат.КоличествоНачисленныхПлатежей = КоличествоНачисленных;
		Результат.СуммаНачисленныхПлатежей = Разница;
		Если Остаток76072 - Разница > Допуск Тогда
			Предупреждения.Добавить(СтрШаблон(
				НСтр("ru = 'На 76.07.2 больше начисленных платежей (%1), чем ближайших по графику (%2): вероятна просрочка оплаты. Вся сумма 76.07.2 показана как кредиторская задолженность.'"),
				Формат(Остаток76072, "ЧДЦ=2; ЧГ=0"), Формат(Разница, "ЧДЦ=2; ЧГ=0")));
		КонецЕсли;
		Возврат Результат;
	КонецЕсли;

	// Превышение графика не объясняется начисленными платежами: график считается целиком,
	// а часть 76.07.2, которая входит в график, остается в обязательстве по аренде.
	Результат.НеоплаченныеПлатежи = Макс(0, Остаток76072 - Разница);
	Предупреждения.Добавить(СтрШаблон(
		НСтр("ru = 'График превышает 76.07.1 на %1, и это не совпадает с ближайшими платежами; расчет выполнен по полному графику. Проверьте 76.07.1 и 76.07.2 (76.07.2 = %2).'"),
		Формат(Разница, "ЧДЦ=2; ЧГ=0"), Формат(Остаток76072, "ЧДЦ=2; ЧГ=0")));
	Возврат Результат;

КонецФункции

// Отсрочка оплаты (например, договор аренды земельного участка): начисленная аренда копится на 76.07.2
// и гасится равными взносами основного долга вместе с процентами за отсрочку, как в
// листе «График платежей» справки-расчета. Взносы, которые придутся на ближайшие
// 12 месяцев, — кредиторская задолженность (строка 1520), остальная краткосрочная
// часть остается в аренде (1550). Функция не читает данные ИБ: оплаты, проценты и
// число оплат по 76.07.2 передаются параметрами.
//
// Взнос основного долга = (оплачено − начисленные проценты) / число оплат. Отсрочка
// признается, только если остаток 76.07.2 состоит из целого числа таких взносов
// (допуск — на каждый взнос). Иначе расчет не меняется и остается предупреждение.
//
Процедура РаспределитьОтсрочку(Расчет, Оплачено, ПроцентыНачислено, КоличествоОплат, Допуск = 1) Экспорт

	Остаток76072 = Расчет.Остаток76072;
	Если КоличествоОплат = 0 Или Остаток76072 <= Допуск Тогда
		Возврат;
	КонецЕсли;

	ВзносОсновногоДолга = (Оплачено - ПроцентыНачислено) / КоличествоОплат;
	Если ВзносОсновногоДолга <= Допуск Тогда
		Возврат;
	КонецЕсли;

	КоличествоВзносов = Окр(Остаток76072 / ВзносОсновногоДолга, 0);
	Если КоличествоВзносов = 0
		Или АбсолютноеЗначение(Остаток76072 - КоличествоВзносов * ВзносОсновногоДолга)
			> Допуск * КоличествоВзносов Тогда
		Возврат;
	КонецЕсли;

	ПлатежейВ12Месяцах = 0;
	Для Каждого СтрокаРасчета Из Расчет.СтрокиРасчета Цикл
		Если СтрокаРасчета.ВидЧасти = "Краткосрочная" Тогда
			ПлатежейВ12Месяцах = ПлатежейВ12Месяцах + 1;
		КонецЕсли;
	КонецЦикла;

	ОсновнойДолгКПогашению = Мин(Остаток76072, ВзносОсновногоДолга * ПлатежейВ12Месяцах);
	ОсновнойДолгКПогашению = Мин(ОсновнойДолгКПогашению, Расчет.КраткосрочнаяЧасть);

	Расчет.ВидРасчета = "Отсрочка";
	Расчет.НеоплаченныеПлатежи = ОсновнойДолгКПогашению;
	Расчет.КраткосрочнаяЧасть = Расчет.КраткосрочнаяЧасть - ОсновнойДолгКПогашению;
	Расчет.ВсегоОбязательство = Расчет.КраткосрочнаяЧасть + Расчет.ДолгосрочнаяЧасть;
	Расчет.Вставить("ВзносОсновногоДолга", ВзносОсновногоДолга);
	Расчет.Вставить("ВзносовНа76072", КоличествоВзносов);
	Расчет.Предупреждения.Очистить();

КонецПроцедуры

// Возвращает одно из агрегированных значений для операнда правила.
//
Функция ЗначениеПоказателяПоОрганизации(Организация, ОтчетнаяДата, ИмяПоказателя) Экспорт

	Расчет = РассчитатьПоОрганизации(Организация, ОтчетнаяДата);
	Если Не Расчет.Свойство(ИмяПоказателя) Или ИмяПоказателя = "Договоры"
		Или ИмяПоказателя = "Предупреждения" Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Неизвестный показатель аренды: %1.'"), ИмяПоказателя);
	КонецЕсли;

	Возврат Расчет[ИмяПоказателя];

КонецФункции

// Имя показателя расчета для способа расчета операнда или пустая строка,
// если способ не относится к аренде.
//
Функция ИмяПоказателяСпособаРасчета(СпособРасчета) Экспорт

	Способы = Перечисления.дбу_СпособыРасчетаОперанда;
	Если СпособРасчета = Способы.АрендаКраткосрочная Тогда
		Возврат "КраткосрочнаяЧасть";
	ИначеЕсли СпособРасчета = Способы.АрендаДолгосрочная Тогда
		Возврат "ДолгосрочнаяЧасть";
	ИначеЕсли СпособРасчета = Способы.АрендаВсегоОбязательство Тогда
		Возврат "ВсегоОбязательство";
	ИначеЕсли СпособРасчета = Способы.АрендаНеоплаченныеПлатежи Тогда
		Возврат "НеоплаченныеПлатежи";
	ИначеЕсли СпособРасчета = Способы.АрендаТиповаяДолгосрочная Тогда
		Возврат "ТиповаяДолгосрочнаяЧасть";
	ИначеЕсли СпособРасчета = Способы.АрендаТиповаяКраткосрочная Тогда
		Возврат "ТиповаяКраткосрочнаяЧасть";
	КонецЕсли;

	Возврат "";

КонецФункции

