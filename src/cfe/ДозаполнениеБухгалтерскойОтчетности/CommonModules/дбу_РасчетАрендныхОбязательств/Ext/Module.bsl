Функция КоличествоПлатежейНакопленныхДо(СуммыПлатежей, Разница, Допуск)

	Накоплено = 0;
	Для Индекс = 0 По СуммыПлатежей.ВГраница() Цикл
		Накоплено = Накоплено + СуммыПлатежей[Индекс];
		Если АбсолютноеЗначение(Накоплено - Разница) <= Допуск Тогда
			Возврат Индекс + 1;
		КонецЕсли;
		Если Накоплено > Разница + Допуск Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Возврат 0;

КонецФункции

Функция ДисконтированнаяСумма(СуммаБезНДС, ГодоваяСтавка, КоличествоДней)

	Если ГодоваяСтавка = 0 Тогда
		Возврат СуммаБезНДС;
	КонецЕсли;

	ДневнаяСтавка = Pow(1 + ГодоваяСтавка / 100, 1 / 365) - 1;
	Возврат СуммаБезНДС / Pow(1 + ДневнаяСтавка, КоличествоДней);

