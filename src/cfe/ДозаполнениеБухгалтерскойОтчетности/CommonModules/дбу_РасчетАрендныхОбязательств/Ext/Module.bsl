// Обязательство по аренде так, как его разделяет типовое заполнение баланса.
// Нужно правилу строки 1450, чтобы заменить только арендное слагаемое типовой строки.
//
Функция ТиповыеАрендныеОбязательства(Организация, ДатаРасчета)

	Результат = Новый Структура("КраткосрочнаяЧасть,ДолгосрочнаяЧасть", 0, 0);

	Организации = Новый Массив;
	Организации.Добавить(Организация);
	Контекст = РасчетПоказателейБалансаПоОбязательствам.НовыйКонтекстРасчета();
	Контекст.КонецПериода = КонецДня(ДатаРасчета);
	Контекст.КонецПериодаДата = КонецДня(ДатаРасчета);
	Контекст.Организации = Организации;
	Контекст.ИспользуетсяВалютныйУчет = БухгалтерскийУчетПереопределяемый.ИспользоватьВалютныйУчет();
	Контекст.ЕстьДисконтирование = УчетнаяПолитика.ПоддерживаетсяДисконтированиеОбязательств();

	ИсходныеДанные = РасчетПоказателейБалансаПоОбязательствам.ИсходныеДанныеПоАренднымОбязательствам(Контекст);
	Для Каждого СтрокаОбязательства Из ИсходныеДанные.АрендныеОбязательства Цикл
		Результат.КраткосрочнаяЧасть = Результат.КраткосрочнаяЧасть
			+ СтрокаОбязательства.КраткосрочноеОбязательство;
		Результат.ДолгосрочнаяЧасть = Результат.ДолгосрочнаяЧасть
			+ СтрокаОбязательства.ДолгосрочноеОбязательство;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Процедура ЗаполнитьГрафикИзИсточников(График, Источники, АвансовыеПлатежи)

	Если Источники.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Документ.Ссылка КАК Ссылка,
	|	Документ.АвансовыеПлатежи КАК АвансовыеПлатежи,
	|	Документ.СтавкаДисконтирования КАК СтавкаДисконтирования
	|ИЗ
	|	Документ.ПоступлениеВАренду КАК Документ
	|ГДЕ
	|	Документ.Ссылка В (&Источники)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Документ.Ссылка,
	|	Документ.АвансовыеПлатежи,
	|	Документ.СтавкаДисконтирования
	|ИЗ
	|	Документ.ИзменениеУсловийАренды КАК Документ
	|ГДЕ
	|	Документ.Ссылка В (&Источники)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	График.Ссылка КАК Ссылка,
	|	График.ДатаПлатежа КАК ДатаПлатежа,
	|	График.СуммаПлатежа КАК СуммаПлатежа,
	|	График.СуммаНДСПлатежа КАК СуммаНДСПлатежа
	|ИЗ
	|	Документ.ПоступлениеВАренду.ГрафикПлатежей КАК График
	|ГДЕ
	|	График.Ссылка В (&Источники)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	График.Ссылка,
	|	График.ДатаПлатежа,
	|	График.СуммаПлатежа,
	|	График.СуммаНДСПлатежа
	|ИЗ
	|	Документ.ИзменениеУсловийАренды.ГрафикПлатежей КАК График
	|ГДЕ
	|	График.Ссылка В (&Источники)";
	Запрос.УстановитьПараметр("Источники", Источники);
	Пакет = Запрос.ВыполнитьПакет();

	Ставки = Новый Соответствие;
	Выборка = Пакет[0].Выбрать();
	Пока Выборка.Следующий() Цикл
		АвансовыеПлатежи = АвансовыеПлатежи + Выборка.АвансовыеПлатежи;
		Ставки.Вставить(Выборка.Ссылка, Выборка.СтавкаДисконтирования);
	КонецЦикла;

	Выборка = Пакет[1].Выбрать();
	Пока Выборка.Следующий() Цикл
		СтрокаГрафика = График.Добавить();
		СтрокаГрафика.ДатаПлатежа = Выборка.ДатаПлатежа;
		СтрокаГрафика.СуммаПлатежа = Выборка.СуммаПлатежа;
		СтрокаГрафика.СуммаНДСПлатежа = Выборка.СуммаНДСПлатежа;
		СтрокаГрафика.СтавкаДисконтирования = Ставки.Получить(Выборка.Ссылка);
	КонецЦикла;

КонецПроцедуры

Функция ИсточникиГрафиковПоДоговорам(Организация, ОтчетнаяДата)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	""Поступление"" КАК ВидДокумента,
	|	Документ.Ссылка КАК Ссылка,
	|	Документ.Дата КАК Дата,
	|	Документ.Контрагент КАК Контрагент,
	|	Документ.ДоговорКонтрагента КАК Договор
	|ИЗ
	|	Документ.ПоступлениеВАренду КАК Документ
	|ГДЕ
	|	Документ.Проведен
	|	И Документ.Организация = &Организация
	|	И Документ.Дата <= &ОтчетнаяДата
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	""Изменение"",
	|	Документ.Ссылка,
	|	Документ.Дата,
	|	Документ.Контрагент,
	|	Документ.ДоговорКонтрагента
	|ИЗ
	|	Документ.ИзменениеУсловийАренды КАК Документ
	|ГДЕ
	|	Документ.Проведен
	|	И Документ.Организация = &Организация
	|	И Документ.Дата <= &ОтчетнаяДата
	|
	|УПОРЯДОЧИТЬ ПО
	|	Договор,
	|	Дата УБЫВ";
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ОтчетнаяДата", ОтчетнаяДата);

	Группы = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Не ЗначениеЗаполнено(Выборка.Договор) Тогда
			Продолжить;
		КонецЕсли;
		Группа = Группы.Получить(Выборка.Договор);
		Если Группа = Неопределено Тогда
			Группа = Новый Структура;
			Группа.Вставить("Контрагент", Выборка.Контрагент);
			Группа.Вставить("ПоследнееИзменение", Неопределено);
			Группа.Вставить("ДатаПоследнегоИзменения", Дата(1, 1, 1));
			Группа.Вставить("Поступления", Новый Массив);
			Группы.Вставить(Выборка.Договор, Группа);
		КонецЕсли;

		Если Выборка.ВидДокумента = "Изменение" Тогда
			Если Группа.ПоследнееИзменение = Неопределено
				Или Выборка.Дата > Группа.ДатаПоследнегоИзменения Тогда
				Группа.ПоследнееИзменение = Выборка.Ссылка;
				Группа.ДатаПоследнегоИзменения = Выборка.Дата;
				Группа.Контрагент = Выборка.Контрагент;
			КонецЕсли;
		Иначе
			Группа.Поступления.Добавить(Выборка.Ссылка);
		КонецЕсли;
	КонецЦикла;

	Возврат Группы;

КонецФункции

