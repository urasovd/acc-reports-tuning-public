Функция Остатки7607ПоДоговорам(Организация, ОтчетнаяДата, Договоры)

	Результат = Новый Соответствие;
	Если Договоры.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Счета = Новый Массив;
	Счет76071 = ПланыСчетов.Хозрасчетный.НайтиПоКоду("76.07.1");
	Счет76072 = ПланыСчетов.Хозрасчетный.НайтиПоКоду("76.07.2");
	Если ЗначениеЗаполнено(Счет76071) Тогда
		Счета.Добавить(Счет76071);
	КонецЕсли;
	Если ЗначениеЗаполнено(Счет76072) Тогда
		Счета.Добавить(Счет76072);
	КонецЕсли;
	Если Счета.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Остатки.Субконто2 КАК Договор,
	|	Остатки.Счет КАК Счет,
	|	СУММА(Остатки.СуммаОстатокКт - Остатки.СуммаОстатокДт) КАК Сумма
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.Остатки(
	|		&ГраницаПериода,
	|		Счет В (&Счета),
	|		,
	|		Организация = &Организация
	|			И Субконто2 В (&Договоры)) КАК Остатки
	|СГРУППИРОВАТЬ ПО
	|	Остатки.Субконто2,
	|	Остатки.Счет";
	Запрос.УстановитьПараметр("ГраницаПериода",
		Новый Граница(КонецДня(ОтчетнаяДата), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Счета", Счета);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Договоры", Договоры);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ОстаткиДоговора = Результат.Получить(Выборка.Договор);
		Если ОстаткиДоговора = Неопределено Тогда
			ОстаткиДоговора = Новый Структура("Остаток76071,Остаток76072", 0, 0);
			Результат.Вставить(Выборка.Договор, ОстаткиДоговора);
		КонецЕсли;
		Если Выборка.Счет = Счет76071 Тогда
			ОстаткиДоговора.Остаток76071 = Макс(0, Выборка.Сумма);
		ИначеЕсли Выборка.Счет = Счет76072 Тогда
			ОстаткиДоговора.Остаток76072 = Макс(0, Выборка.Сумма);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Оплаты и начисленные проценты за отсрочку по 76.07.2 договора на отчетную дату.
// Проценты отличаются от начисления аренды только содержанием проводки
// («Проценты за отсрочку платежа…»): обе идут Дт 76.07.1 Кт 76.07.2.
//
Функция ПогашениеПо76072(Организация, Договор, ДатаРасчета)

	Результат = Новый Структура("Оплачено,ПроцентыНачислено,КоличествоОплат", 0, 0, 0);
	Счет76072 = ПланыСчетов.Хозрасчетный.НайтиПоКоду("76.07.2");
	Если Не ЗначениеЗаполнено(Счет76072) Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Движения.Регистратор КАК Регистратор,
	|	Движения.СчетДт КАК СчетДт,
	|	Движения.СубконтоДт2 КАК ДоговорДт,
	|	Движения.СубконтоКт2 КАК ДоговорКт,
	|	Движения.Содержание КАК Содержание,
	|	Движения.Сумма КАК Сумма
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.ДвиженияССубконто(
	|			,
	|			&Граница,
	|			Организация = &Организация
	|				И (СчетДт = &Счет
	|					ИЛИ СчетКт = &Счет),
	|			,
	|			) КАК Движения";
	Запрос.УстановитьПараметр("Граница", Новый Граница(КонецДня(ДатаРасчета), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Счет", Счет76072);

	Оплаты = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Выборка.СчетДт = Счет76072 Тогда
			Если Выборка.ДоговорДт <> Договор Тогда
				Продолжить;
			КонецЕсли;
			Результат.Оплачено = Результат.Оплачено + Выборка.Сумма;
			Оплаты.Вставить(Выборка.Регистратор, Истина);
		ИначеЕсли Выборка.ДоговорКт = Договор
			И СтрНайти(НРег(Выборка.Содержание), "процент") > 0 Тогда
			Результат.ПроцентыНачислено = Результат.ПроцентыНачислено + Выборка.Сумма;
		КонецЕсли;
	КонецЦикла;
	Результат.КоличествоОплат = Оплаты.Количество();

	Возврат Результат;

КонецФункции

Функция НовыйГрафикРасчета()

