// СКД-операнды и компиляция запросов для дозаполнения бухотчётности.
// Порт логики из кбо_ПравилаРасчетаПоказателейБухОтчетности / кбо_ОбщегоНазначения.

#Область ПрограммныйИнтерфейс

// Возвращает значение параметра компоновки данных
//
// Параметры:
//	ОбъектНастройки	- НастройкиКомпоновкиДанных, ПользовательскиеНастройкиКомпоновкиДанных, КомпоновщикНастроекКомпоновкиДанных, 
//		НастройкиВложенногоОбъектаКомпоновкиДанных, ДанныеРасшифровкиКомпоновкиДанных, КоллекцияЗначенийПараметровКомпоновкиДанных,
//		ОформлениеКомпоновкиДанных
//	Параметр		- Строка, ПараметрКомпоновкиДанных - поле или имя поля, для которого нужно вернуть параметр.
//
// Возвращаемое значение:
//	ЗначениеПараметраНастроекКомпоновкиДанных - Неопределено, если параметр не найден.
//
Функция ПолучитьПараметр(ОбъектНастройки, Параметр) Экспорт
	
	ЗначениеПараметра = Неопределено;
	ПолеПараметр = ?(ТипЗнч(Параметр) = Тип("Строка"), Новый ПараметрКомпоновкиДанных(Параметр), Параметр);
	
	Если ТипЗнч(ОбъектНастройки) = Тип("НастройкиКомпоновкиДанных") Тогда
		ЗначениеПараметра = ОбъектНастройки.ПараметрыДанных.НайтиЗначениеПараметра(ПолеПараметр);
	ИначеЕсли ТипЗнч(ОбъектНастройки) = Тип("ПользовательскиеНастройкиКомпоновкиДанных") Тогда
		Для Каждого ЭлементНастройки Из ОбъектНастройки.Элементы Цикл
			Если ТипЗнч(ЭлементНастройки) = Тип("ЗначениеПараметраНастроекКомпоновкиДанных") И ЭлементНастройки.Параметр = ПолеПараметр Тогда
				ЗначениеПараметра = ЭлементНастройки;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	ИначеЕсли ТипЗнч(ОбъектНастройки) = Тип("КомпоновщикНастроекКомпоновкиДанных") Тогда
		Для Каждого ЭлементНастройки Из ОбъектНастройки.ПользовательскиеНастройки.Элементы Цикл
			Если ТипЗнч(ЭлементНастройки) = Тип("ЗначениеПараметраНастроекКомпоновкиДанных") И ЭлементНастройки.Параметр = ПолеПараметр Тогда
				ЗначениеПараметра = ЭлементНастройки;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если ЗначениеПараметра = Неопределено Тогда
			ЗначениеПараметра = ОбъектНастройки.Настройки.ПараметрыДанных.НайтиЗначениеПараметра(ПолеПараметр);
		КонецЕсли;
		Если ЗначениеПараметра = Неопределено Тогда
			ЗначениеПараметра = ОбъектНастройки.ФиксированныеНастройки.ПараметрыДанных.НайтиЗначениеПараметра(ПолеПараметр);
		КонецЕсли;
	ИначеЕсли ТипЗнч(ОбъектНастройки) = Тип("НастройкиВложенногоОбъектаКомпоновкиДанных") Тогда
		ЗначениеПараметра = ОбъектНастройки.Настройки.ПараметрыДанных.НайтиЗначениеПараметра(ПолеПараметр);
	ИначеЕсли ТипЗнч(ОбъектНастройки) = Тип("ДанныеРасшифровкиКомпоновкиДанных") Тогда
		ЗначениеПараметра = ОбъектНастройки.Настройки.ПараметрыДанных.НайтиЗначениеПараметра(ПолеПараметр);
	ИначеЕсли ТипЗнч(ОбъектНастройки) = Тип("КоллекцияЗначенийПараметровКомпоновкиДанных") Тогда
		ЗначениеПараметра = ОбъектНастройки.Найти(ПолеПараметр);
	ИначеЕсли ТипЗнч(ОбъектНастройки) = Тип("ОформлениеКомпоновкиДанных") Тогда
		ЗначениеПараметра = ОбъектНастройки.НайтиЗначениеПараметра(ПолеПараметр);
	КонецЕсли;
	
	Возврат ЗначениеПараметра;
	
КонецФункции

// Устанавливает параметр настроек компоновки данных
//
// Параметры:
//	Настройки - НастройкиКомпоновкиДанных, ПользовательскиеНастройкиКомпоновкиДанных,
//		КомпоновщикНастроекКомпоновкиДанных - настройки КД, для которых требуется установить параметры
//	Параметр - Строка, ПараметрКомпоновкиДанных - параметр, который требуется установить
//	Значение - Произвольный - значение, которое требуется установить
//	Использование - Булево - признак использования параметра КД.
//
// Возвращаемое значение:
//	ЗначениеПараметраНастроекКомпоновкиДанных - установленный параметр настроек КД. Неопределено, если параметр на найден.
//
Функция УстановитьПараметр(Настройки, Параметр, Значение, Использование = Истина) Экспорт
	
	ЗначениеПараметра = ПолучитьПараметр(Настройки, Параметр);
	
	Если ЗначениеПараметра <> Неопределено Тогда
		ЗначениеПараметра.Значение		= Значение;
		ЗначениеПараметра.Использование	= Использование;
	КонецЕсли;
	
	Возврат ЗначениеПараметра;
	
КонецФункции

// Формирует текстовое представление отбора компоновки данных
//
// Параметры:
//  Описание				 - 	 Результирующая строка с описанием, при первом вызове передавать пустую строку 
//  КоллекцияЭлементовОтбора - 	 КоллекцияЭлементовОтбораКомпоновкиДанных, описываемая коллекция 
//  ПоляКомпоновкиДанных	 - 	 ПоляНабораДанныхСхемыКомпоновкиДанных, коллекция полей, если параметр задан, представления полей соответствуют их заголовкам в схеме компоновки 
//  ТекущаяОперация			 - 	 Строка, служебный параметр 
//
Процедура СформироватьОписаниеОтбораКомпоновкиДанных(Описание, Знач КоллекцияЭлементовОтбора, Знач ПоляКомпоновкиДанных = Неопределено, Знач ТекущаяОперация = " и ") Экспорт
	
	// Представления системных перечислений
	Группы = Новый Соответствие;
	Группы.Вставить(ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ	, " и ");
	Группы.Вставить(ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли	, " или ");
	Группы.Вставить(ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаНе	, " не ");
	
	ВидыСравнения = Новый Соответствие;
	ВидыСравнения.Вставить(ВидСравненияКомпоновкиДанных.Больше				, " > ");
	ВидыСравнения.Вставить(ВидСравненияКомпоновкиДанных.БольшеИлиРавно		, " >= ");
	ВидыСравнения.Вставить(ВидСравненияКомпоновкиДанных.ВИерархии			, " из группы ");
	ВидыСравнения.Вставить(ВидСравненияКомпоновкиДанных.ВСписке				, " из списка ");
	ВидыСравнения.Вставить(ВидСравненияКомпоновкиДанных.ВСпискеПоИерархии	, " из группы списка ");
	ВидыСравнения.Вставить(ВидСравненияКомпоновкиДанных.Заполнено			, " заполнено");
	ВидыСравнения.Вставить(ВидСравненияКомпоновкиДанных.Меньше				, " < ");
	ВидыСравнения.Вставить(ВидСравненияКомпоновкиДанных.МеньшеИлиРавно		, " <= ");
	ВидыСравнения.Вставить(ВидСравненияКомпоновкиДанных.НачинаетсяС			, " начинается с ");
	ВидыСравнения.Вставить(ВидСравненияКомпоновкиДанных.НеВИерархии			, " не из группы ");
	ВидыСравнения.Вставить(ВидСравненияКомпоновкиДанных.НеВСписке			, " не из списка ");
	ВидыСравнения.Вставить(ВидСравненияКомпоновкиДанных.НеВСпискеПоИерархии	, " не из группы списка ");
	ВидыСравнения.Вставить(ВидСравненияКомпоновкиДанных.НеЗаполнено			, " не заполнено");
	ВидыСравнения.Вставить(ВидСравненияКомпоновкиДанных.НеНачинаетсяС		, " не начинается с ");
	ВидыСравнения.Вставить(ВидСравненияКомпоновкиДанных.НеПодобно			, " не соответствует шаблону ");
	ВидыСравнения.Вставить(ВидСравненияКомпоновкиДанных.Подобно				, " соответствует шаблону ");
	ВидыСравнения.Вставить(ВидСравненияКомпоновкиДанных.НеРавно				, " <> ");
	ВидыСравнения.Вставить(ВидСравненияКомпоновкиДанных.Равно				, " = ");
	ВидыСравнения.Вставить(ВидСравненияКомпоновкиДанных.Содержит			, " содержит ");
	ВидыСравнения.Вставить(ВидСравненияКомпоновкиДанных.НеСодержит			, " не содержит ");
	
	Если ТипЗнч(КоллекцияЭлементовОтбора) = Тип("КоллекцияЭлементовОтбораКомпоновкиДанных") Тогда
		
		Для Каждого ЭлементОтбора Из КоллекцияЭлементовОтбора Цикл
			
			Если Не ЭлементОтбора.Использование Тогда
				Продолжить;
			КонецЕсли;
			
			Если ТипЗнч(ЭлементОтбора) = Тип("ЭлементОтбораКомпоновкиДанных") Тогда
				
				// Отдельный элемент отбора
				ПредставлениеЗначения = "";
				
				Если ЗначениеЗаполнено(ЭлементОтбора.ПравоеЗначение)
					И ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке
					Или ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.НеВСписке
					Или ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСпискеПоИерархии
					Или ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.НеВСпискеПоИерархии Тогда
					
					// Списковые значения перечисляем через запятую
					Для Каждого ЭлементСписка Из ЭлементОтбора.ПравоеЗначение Цикл
						ПредставлениеЗначения = ПредставлениеЗначения + ?(ЗначениеЗаполнено(ПредставлениеЗначения), ", ", "") + Строка(ЭлементСписка);
					КонецЦикла;
					
					ПредставлениеЗначения = """" + ПредставлениеЗначения + """";
					
				Иначе
					
					// Значения примитивных типов
					Если ТипЗнч(ЭлементОтбора.ПравоеЗначение) = Тип("СтандартнаяДатаНачала")
						И ЗначениеЗаполнено(ЭлементОтбора.ПравоеЗначение) Тогда
						ПредставлениеЗначения = Формат(ЭлементОтбора.ПравоеЗначение.Дата, "ДФ=dd.MM.yyyy");
					ИначеЕсли ТипЗнч(ЭлементОтбора.ПравоеЗначение) = Тип("Число") Тогда
						ПредставлениеЗначения = Формат(ЭлементОтбора.ПравоеЗначение, "ЧН=0; ЧГ=3,0");
					ИначеЕсли ЗначениеЗаполнено(ЭлементОтбора.ПравоеЗначение) Тогда
						ПредставлениеЗначения = ?(ТипЗнч(ЭлементОтбора.ПравоеЗначение) = Тип("Булево"), Формат(ЭлементОтбора.ПравоеЗначение, "БЛ=Нет; БИ=Да"), """" + Строка(ЭлементОтбора.ПравоеЗначение) + """");
					КонецЕсли;
					
				КонецЕсли;
				
				// Вычисление представления поля отбора
				ПредставлениеПоля = Строка(ЭлементОтбора.ЛевоеЗначение);
				МассивПолей = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ПредставлениеПоля, ".");
				
				Если МассивПолей.Количество() > 1 Тогда
					ПредставлениеПоля = МассивПолей[0];
				КонецЕсли;
				
				// В полях схемы компоновки берем заголовки
				Если ПоляКомпоновкиДанных <> Неопределено Тогда
					
					Поле = ПоляКомпоновкиДанных.Найти(ПредставлениеПоля);
					
					Если Поле <> Неопределено Тогда
						ПредставлениеПоля = Поле.Заголовок;
					КонецЕсли;
					
				КонецЕсли;
				
				// Составное поле
				Если МассивПолей.Количество() > 1 Тогда
					Для Инд = 1 По МассивПолей.ВГраница() Цикл
						ПредставлениеПоля = ПредставлениеПоля + "." + МассивПолей[Инд];
					КонецЦикла;
				КонецЕсли;
				
				Описание = Описание + ?(ЗначениеЗаполнено(Описание) И Не Прав(Описание, 1) = "(", ТекущаяОперация, "") + ПредставлениеПоля + ВидыСравнения[ЭлементОтбора.ВидСравнения] + ПредставлениеЗначения; 
				ВложенноеВыражение = Ложь;
				
			ИначеЕсли ТипЗнч(ЭлементОтбора) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда
				
				// Группа элементов отбора
				Описание = Описание + ?(ЗначениеЗаполнено(Описание) И Не Прав(Описание, 1) = "(", ТекущаяОперация, "") + ?(ЭлементОтбора.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаНе, "не ", "") + "(";
				
				// Рекурсивно добавляем описание вложенных элементов
				СформироватьОписаниеОтбораКомпоновкиДанных(Описание, ЭлементОтбора.Элементы, ПоляКомпоновкиДанных, ?(ЭлементОтбора.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаНе, " и ", Группы[ЭлементОтбора.ТипГруппы]));
				
				Описание = Описание + ")";
				
			КонецЕсли;
			
		КонецЦикла;
				
	КонецЕсли;
	
КонецПроцедуры

// Добавляет выбранное поле компоновки данных
//
// Параметры:
//	Куда         - КомпоновщикНастроекКомпоновкиДанных, НастройкиКомпоновкиДанных, ВыбранныеПоляКомпоновкиДанных - назначение, куда нужно добавить поле
//	ИмяИлиПолеКД - Строка, ПолеКомпоновкиДанных - имя добавляемого поля
//	Заголовок    - Строка - заголовок поля в результате компоновки.
//
// Возвращаемое значение:
//	ВыбранноеПолеКомпоновкиДанных - выбранное поле.
//
Функция ДобавитьВыбранноеПоле(Куда, ИмяИлиПолеКД, Заголовок = "") Экспорт
	
	Если ТипЗнч(Куда) = Тип("КомпоновщикНастроекКомпоновкиДанных") Тогда
		ВыбранныеПоляКД = Куда.Настройки.Выбор;
	ИначеЕсли ТипЗнч(Куда) = Тип("НастройкиКомпоновкиДанных") Тогда
		ВыбранныеПоляКД = Куда.Выбор;
	Иначе
		ВыбранныеПоляКД = Куда;
	КонецЕсли;
	
	Если ТипЗнч(ИмяИлиПолеКД) = Тип("Строка") Тогда
		ПолеКД = Новый ПолеКомпоновкиДанных(ИмяИлиПолеКД);
	Иначе
		ПолеКД = ИмяИлиПолеКД;
	КонецЕсли;
	
	ВыбранноеПолеКД = ВыбранныеПоляКД.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
	ВыбранноеПолеКД.Поле = ПолеКД;
	Если Заголовок <> "" Тогда
		ВыбранноеПолеКД.Заголовок = Заголовок;
	КонецЕсли;
	
	Возврат ВыбранноеПолеКД;
	
КонецФункции

// Добавляет отбор в коллекцию отборов компоновщика или группы отборов
//
// Параметры:
//	ЭлементСтруктуры        - КомпоновщикНастроекКомпоновкиДанных, НастройкиКомпоновкиДанных - элемент структуры КД
//	Поле                    - Строка - имя поля, по которому добавляется отбор
//	Значение                - Произвольный - значение отбора КД
//	ВидСравнения            - ВидСравненияКомпоновкиДанных - вид сравнений КД (по умолчанию: Неопределено)
//	Использование           - Булево - признак использования отбора (по умолчанию: Истина)
//	ДополнительныеПараметры - Структура
//		* ВПользовательскиеНастройки - Булево - признак добавления в пользовательские настройки КД (по умолчанию: ложь)
//		* ЗаменятьСуществующий       - Булево - признак полной замены существующего отбора по полю (по умолчанию: истина).
//
// Возвращаемое значение:
//	ЭлементОтбораКомпоновкиДанных - добавленный отбор.
//
Функция ДобавитьОтбор(ЭлементСтруктуры, Знач Поле, Значение = Неопределено, ВидСравнения = Неопределено, Использование = Истина, ДополнительныеПараметры = Неопределено) Экспорт
		
	Если ДополнительныеПараметры = Неопределено Тогда
		ДополнительныеПараметры = Новый Структура("ВПользовательскиеНастройки, ЗаменятьСуществующий", Ложь, Истина); 
	Иначе
		Если Не ДополнительныеПараметры.Свойство("ВПользовательскиеНастройки") Тогда
			ДополнительныеПараметры.Вставить("ВПользовательскиеНастройки", Ложь);
		КонецЕсли;
		Если Не ДополнительныеПараметры.Свойство("ЗаменятьСуществующий") Тогда
			ДополнительныеПараметры.Вставить("ЗаменятьСуществующий", Истина);
		КонецЕсли;
	КонецЕсли;
	
	Если ТипЗнч(Поле) = Тип("Строка") Тогда
		Поле = Новый ПолеКомпоновкиДанных(Поле);
	КонецЕсли;
	
	Если ТипЗнч(ЭлементСтруктуры) = Тип("КомпоновщикНастроекКомпоновкиДанных") Тогда
		Отбор = ЭлементСтруктуры.Настройки.Отбор;
		
		Если ДополнительныеПараметры.ВПользовательскиеНастройки Тогда
			Для Каждого ЭлементНастройки Из ЭлементСтруктуры.ПользовательскиеНастройки.Элементы Цикл
				Если ЭлементНастройки.ИдентификаторПользовательскойНастройки = ЭлементСтруктуры.Настройки.Отбор.ИдентификаторПользовательскойНастройки Тогда
					Отбор = ЭлементНастройки;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(ЭлементСтруктуры) = Тип("НастройкиКомпоновкиДанных") Тогда
		Отбор = ЭлементСтруктуры.Отбор;
	Иначе
		Отбор = ЭлементСтруктуры;
	КонецЕсли;
	
	Если ВидСравнения = Неопределено Тогда
		ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	КонецЕсли;
	
	ЭлементОтбора = Неопределено;
	Если ДополнительныеПараметры.ЗаменятьСуществующий Тогда
		Для каждого Элемент Из Отбор.Элементы Цикл
			
			Если ТипЗнч(Элемент) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда
				Продолжить;
			КонецЕсли;
			
			Если Элемент.ЛевоеЗначение = Поле Тогда
				ЭлементОтбора = Элемент;
			КонецЕсли;
			
		КонецЦикла;
	КонецЕсли;
	
	Если ЭлементОтбора = Неопределено Тогда
		ЭлементОтбора = Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	КонецЕсли;
	ЭлементОтбора.Использование		= Использование;
	ЭлементОтбора.ЛевоеЗначение		= Поле;
	ЭлементОтбора.ВидСравнения		= ВидСравнения;
	ЭлементОтбора.ПравоеЗначение	= Значение;
	
	Возврат ЭлементОтбора;
	
КонецФункции

// Имя макета СКД по признаку оборотов между счетами.
//
Функция ИмяМакетаСКДПоСчетам(ЕстьКорСчет) Экспорт

	Возврат "ДанныеПоСчетам" + ?(ЕстьКорСчет, "ОборотыМеждуСчетами", "ОстаткиИОбороты");

КонецФункции

// Возвращает схему компоновки из макета справочника дбу_ЗапросыДанных.
//
Функция ПолучитьСхемуКомпоновки(ИмяМакета) Экспорт

	Возврат Справочники.дбу_ЗапросыДанных.ПолучитьМакет(ИмяМакета);

КонецФункции

// Настраивает отбор по счёту и заголовки субконто в схеме СКД.
//
Процедура НастроитьСубконтоИОтборПоСчету(Счет, ИмяПоляСчет, ИмяПоляСубконто, ПоляКомпоновки, НастройкиКомпоновки) Экспорт

	Если Не ЗначениеЗаполнено(Счет) Тогда
		Возврат;
	КонецЕсли;

	ЭлементОтбора = ПолучитьЭлементОтбора(НастройкиКомпоновки, ИмяПоляСчет);
	Если ЭлементОтбора <> Неопределено Тогда
		ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.ВИерархии;
		ЭлементОтбора.ПравоеЗначение = Счет;
		ЭлементОтбора.Использование = Истина;
	КонецЕсли;

	Для НомерСубконто = 1 По 3 Цикл

		ИмяПоля = ИмяПоляСубконто + Строка(НомерСубконто);
		Поле = ПоляКомпоновки.Найти(ИмяПоля);

		Если Поле = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Если НомерСубконто > Счет.ВидыСубконто.Количество() Тогда

			Поле.ОграничениеИспользования.Условие = Истина;
			Поле.ОграничениеИспользованияРеквизитов.Условие = Истина;

			ЭлементОтбораСубконто = ПолучитьЭлементОтбора(НастройкиКомпоновки, ИмяПоля);
			Если ЭлементОтбораСубконто <> Неопределено Тогда
				НастройкиКомпоновки.Отбор.Элементы.Удалить(ЭлементОтбораСубконто);
			КонецЕсли;

		Иначе

			СтрокаСубконто = Счет.ВидыСубконто[НомерСубконто - 1];
			Поле.Заголовок = ?(ИмяПоляСубконто = "КорСубконто", "Корр. субконто", ИмяПоляСубконто)
				+ " " + Строка(НомерСубконто) + " (" + Строка(СтрокаСубконто.ВидСубконто) + ")";
			Поле.ТипЗначения = Новый ОписаниеТипов(СтрокаСубконто.ВидСубконто.ТипЗначения);
			Поле.ОграничениеИспользования.Условие = Ложь;
			Поле.ОграничениеИспользованияРеквизитов.Условие = Ложь;

		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

// Компилирует настройки СКД в пакет запроса (текст, параметры, представление).
//
Функция СкомпилироватьПакетЗапроса(СхемаКомпоновки, НастройкиКомпоновки, Счет = Неопределено, КорСчет = Неопределено, ВидыСубконто = "") Экспорт

	Результат = Новый Структура(
		"СхемаКомпоновки, НастройкиКомпоновки, ТекстЗапроса, ЗначенияПараметров, Представление, Счет, КорСчет, ВидыСубконто",
		СхемаКомпоновки, НастройкиКомпоновки, "", Новый Структура, "", Счет, КорСчет, ВидыСубконто);

	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновки, НастройкиКомпоновки);

	ТекстЗапроса = МакетКомпоновки.НаборыДанных[0].Запрос;
	ЗначенияПараметров = Новый Структура;

	ПараметрыДляПереименования = ПараметрыМакетаДляПереименования(МакетКомпоновки);
	Для Каждого ПараметрКомпоновки Из ПараметрыДляПереименования Цикл

		ИмяПараметра = "Параметр_" + СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", "");
		ЗначенияПараметров.Вставить(ИмяПараметра, ПараметрКомпоновки.Значение);
		ТекстЗапроса = ЗаменитьИмяПараметраВТекстеЗапроса(ТекстЗапроса, ПараметрКомпоновки.Имя, ИмяПараметра);

	КонецЦикла;

	Если ЗначениеЗаполнено(Счет) И ЗначениеЗаполнено(ВидыСубконто) Тогда

		МассивВидовСубконто = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ВидыСубконто, ",", Истина, Истина);
		ТекстЗапросаСубконто = "";

		Для Каждого ВидСубконтоИмя Из МассивВидовСубконто Цикл

			ВидСубконто = ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные[СокрЛП(ВидСубконтоИмя)];
			СтрокаСубконто = Счет.ВидыСубконто.Найти(ВидСубконто);

			Если СтрокаСубконто <> Неопределено Тогда
				ТекстЗапросаСубконто = ТекстЗапросаСубконто
					+ ?(ЗначениеЗаполнено(ТекстЗапросаСубконто), Символы.ПС + Символы.Таб + Символы.Таб, "")
					+ "ХозрасчетныйОстаткиИОбороты.Субконто" + Строка(СтрокаСубконто.НомерСтроки) + " КАК " + ВидСубконтоИмя + ",";
			КонецЕсли;

		КонецЦикла;

		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, """ТекстЗапросаСубконто"" КАК ТекстЗапросаСубконто,", ТекстЗапросаСубконто);

	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "
		|		""ТекстЗапросаСубконто"" КАК ТекстЗапросаСубконто,", "");
	КонецЕсли;

	Результат.ТекстЗапроса = ТекстЗапроса;
	Результат.ЗначенияПараметров = ЗначенияПараметров;
	Результат.Представление = СформироватьПредставлениеЗапроса(НастройкиКомпоновки, СхемаКомпоновки, ВидыСубконто);

	Возврат Результат;

КонецФункции

// Заполняет реквизиты элемента справочника дбу_ЗапросыДанных из пакета СКД.
//
Процедура ОбновитьРеквизитыЗапросаИзПакета(ОбъектЗапроса, ПакетЗапроса) Экспорт

	ОбъектЗапроса.ТекстЗапроса = ПакетЗапроса.ТекстЗапроса;
	ОбъектЗапроса.ПредставлениеОтбора = ПакетЗапроса.Представление;
	ОбъектЗапроса.НастройкиСКД = Новый ХранилищеЗначения(ПакетЗапроса);
	ОбъектЗапроса.ХэшСумма = РассчитатьХэшНастроек(ПакетЗапроса.НастройкиКомпоновки);
	ОбновитьПараметрыЗапросаИзПакета(ОбъектЗапроса, ПакетЗапроса.ЗначенияПараметров);

КонецПроцедуры

// MD5-хэш выбранного поля и дерева отбора (дедупликация).
//
Функция РассчитатьХэшНастроек(НастройкиКомпоновки) Экспорт

	Если НастройкиКомпоновки = Неопределено
		Или НастройкиКомпоновки.Выбор.Элементы.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	СтрокаДанных = Строка(НастройкиКомпоновки.Выбор.Элементы[0].Поле);

	ТаблицаОтбора = Новый ТаблицаЗначений;
	ТаблицаОтбора.Колонки.Добавить("Поле", ОбщегоНазначения.ОписаниеТипаСтрока(100));
	ТаблицаОтбора.Колонки.Добавить("Отбор", ОбщегоНазначения.ОписаниеТипаСтрока(0));

	ЗаполнитьТаблицуОтбора(ТаблицаОтбора, НастройкиКомпоновки.Отбор.Элементы);
	ТаблицаОтбора.Сортировать("Поле");

	Для Каждого СтрокаПоле Из ТаблицаОтбора Цикл
		СтрокаДанных = СтрокаДанных + СтрокаПоле.Поле + СтрокаПоле.Отбор;
	КонецЦикла;

	Хэширование = Новый ХешированиеДанных(ХешФункция.MD5);
	Хэширование.Добавить(НРег(СтрЗаменить(СтрокаДанных, " ", "")));

	Возврат Строка(Хэширование.ХешСумма);

КонецФункции

// Настройки типовой ОСВ/анализа счёта из пакета СКД; Неопределено — drill-down недоступен.
//
Функция НастройкиРасшифровкиИзСКД(ПараметрыРасчета, ПакетЗапроса) Экспорт

	Если ПакетЗапроса = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	НастройкиКомпоновки = Неопределено;
	Если Не ПакетЗапроса.Свойство("НастройкиКомпоновки", НастройкиКомпоновки)
		Или НастройкиКомпоновки = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Настройки = НастройкиКомпоновки;
	Если Не ОтборСКДПоддерживаетТочныйDrillDown(Настройки) Тогда
		Возврат Неопределено;
	КонецЕсли;

	ОбщиеНастройки = Новый Структура(
		"Организация, НачалоПериода, КонецПериода",
		ПараметрыРасчета.Организация,
		ПараметрыРасчета.НачалоПериода,
		ПараметрыРасчета.КонецПериода);

	Счет = СчетИзНастроекСКД(Настройки, "Счет");
	КорСчет = СчетИзНастроекСКД(Настройки, "КорСчет");

	Если Не ЗначениеЗаполнено(Счет) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если ЗначениеЗаполнено(КорСчет) Тогда
		ДанныеРасшифровки = ЗаполнениеБухгалтерскойОтчетности.НастройкиАнализаСчета(ОбщиеНастройки, Счет, КорСчет);
	Иначе
		ДанныеРасшифровки = ЗаполнениеБухгалтерскойОтчетности.НастройкиОСВПоСчету(ОбщиеНастройки, Счет);
	КонецЕсли;

	Если ДанныеРасшифровки = Неопределено Или ДанныеРасшифровки.Отчет = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	ВыбранноеПоле = "";
	Если Настройки.Выбор.Элементы.Количество() > 0 Тогда
		ВыбранноеПоле = Строка(Настройки.Выбор.Элементы[0].Поле);
	КонецЕсли;

	Если ВыбранноеПоле = "СКДР" Или ВыбранноеПоле = "СККР" Или ВыбранноеПоле = "СНДР" Или ВыбранноеПоле = "СНКР" Тогда
		ДанныеРасшифровки.Отчет.НастройкиТиповогоОтчета.РазвернутоеСальдо = Истина;
	КонецЕсли;

	ВидыСубконто = "";
	Если ПакетЗапроса.Свойство("ВидыСубконто") Тогда
		ВидыСубконто = ПакетЗапроса.ВидыСубконто;
	КонецЕсли;

	ПрименитьОтборСубконтоКРасшифровке(ДанныеРасшифровки, Настройки, Счет, ВидыСубконто);

	Возврат ДанныеРасшифровки;

КонецФункции

// Применяет к типовой расшифровке развёрнутое сальдо и группировку по видам субконто операнда.
//
Процедура ПрименитьДетализациюОперандаКРасшифровке(ДанныеРасшифровки, СтрокаОперанда) Экспорт

	Если ДанныеРасшифровки = Неопределено Или ДанныеРасшифровки.Отчет = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Перечисления.дбу_СпособыРасчетаОперанда.РазвернутоеСальдо().Найти(СтрокаОперанда.СпособРасчета) <> Неопределено Тогда
		ДанныеРасшифровки.Отчет.НастройкиТиповогоОтчета.РазвернутоеСальдо = Истина;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(СтрокаОперанда.ВидыСубконто) Или Не ЗначениеЗаполнено(СтрокаОперанда.Счет) Тогда
		Возврат;
	КонецЕсли;

	ПрименитьГруппировкуВидовСубконтоКРасшифровке(ДанныеРасшифровки, СтрокаОперанда.Счет, СтрокаОперанда.ВидыСубконто);

КонецПроцедуры

// Истина, если все используемые отборы маппятся в типовую ОСВ.
//
Функция ОтборСКДПоддерживаетТочныйDrillDown(НастройкиКомпоновки) Экспорт

	Возврат Не ЕстьНеподдерживаемыеЭлементыОтбора(НастройкиКомпоновки.Отбор.Элементы);

КонецФункции

// Возвращает пакет СКД из элемента справочника дбу_ЗапросыДанных.
//
Функция ПакетЗапросаИзСправочника(ЗапросДанных) Экспорт

	Если Не ЗначениеЗаполнено(ЗапросДанных) Тогда
		Возврат Неопределено;
	КонецЕсли;

	НастройкиСКД = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЗапросДанных, "НастройкиСКД");
	Если НастройкиСКД = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Пакет = НастройкиСКД.Получить();
	Если ТипЗнч(Пакет) <> Тип("Структура") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Пакет;

КонецФункции

// Устанавливает параметры скомпилированного запроса СКД (типизированные значения из пакета).
//
Процедура УстановитьПараметрыСкомпилированногоЗапроса(Запрос, ЗапросДанных) Экспорт

	ПакетЗапроса = ПакетЗапросаИзСправочника(ЗапросДанных);
	Если ПакетЗапроса = Неопределено Тогда
		УстановитьПараметрыЗапросаИзТабличнойЧасти(Запрос, ЗапросДанных);
		Возврат;
	КонецЕсли;

	ПакетДляВыполнения = ПакетЗапросаДляВыполнения(ПакетЗапроса);
	Если ПакетДляВыполнения <> Неопределено Тогда
		Запрос.Текст = ПакетДляВыполнения.ТекстЗапроса;
	КонецЕсли;

	ЗначенияПараметров = ?(ПакетДляВыполнения <> Неопределено, ПакетДляВыполнения.ЗначенияПараметров, ПакетЗапроса.ЗначенияПараметров);
	Если ЗначенияПараметров <> Неопределено Тогда
		Для Каждого КлючИЗначение Из ЗначенияПараметров Цикл
			Запрос.УстановитьПараметр(КлючИЗначение.Ключ, КлючИЗначение.Значение);
		КонецЦикла;
	КонецЕсли;

	УстановитьПараметрВидыСубконтоЗапроса(Запрос, ПакетЗапроса);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Перекомпилирует пакет из сохранённых настроек СКД (актуальный текст и параметры).
//
Функция ПакетЗапросаДляВыполнения(ПакетЗапроса)

	Если ПакетЗапроса = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если Не ПакетЗапроса.Свойство("СхемаКомпоновки")
		Или ПакетЗапроса.СхемаКомпоновки = Неопределено
		Или Не ПакетЗапроса.Свойство("НастройкиКомпоновки")
		Или ПакетЗапроса.НастройкиКомпоновки = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Счет = Неопределено;
	КорСчет = Неопределено;
	ВидыСубконто = "";

	Если ПакетЗапроса.Свойство("Счет") Тогда
		Счет = ПакетЗапроса.Счет;
	КонецЕсли;
	Если ПакетЗапроса.Свойство("КорСчет") Тогда
		КорСчет = ПакетЗапроса.КорСчет;
	КонецЕсли;
	Если ПакетЗапроса.Свойство("ВидыСубконто") Тогда
		ВидыСубконто = ПакетЗапроса.ВидыСубконто;
	КонецЕсли;

	Возврат СкомпилироватьПакетЗапроса(
		ПакетЗапроса.СхемаКомпоновки,
		ПакетЗапроса.НастройкиКомпоновки,
		Счет,
		КорСчет,
		ВидыСубконто);

КонецФункции

// Параметры макета СКД для переименования, отсортированные по длине имени (убыв.).
//
Функция ПараметрыМакетаДляПереименования(МакетКомпоновки)

	Параметры = Новый Массив;

	Для Каждого ПараметрКомпоновки Из МакетКомпоновки.ЗначенияПараметров Цикл

		Если ПараметрКомпоновки.Имя = "Организация"
			Или ПараметрКомпоновки.Имя = "НачалоПериода"
			Или ПараметрКомпоновки.Имя = "КонецПериода"
			Или ПараметрКомпоновки.Имя = "ВидыСубконто" Тогда
			Продолжить;
		КонецЕсли;

		Параметры.Добавить(ПараметрКомпоновки);

	КонецЦикла;

	Для Индекс = 0 По Параметры.ВГраница() - 1 Цикл
		Для ИндексСледующий = Индекс + 1 По Параметры.ВГраница() Цикл
			Если СтрДлина(Параметры[ИндексСледующий].Имя) > СтрДлина(Параметры[Индекс].Имя) Тогда
				Временный = Параметры[Индекс];
				Параметры[Индекс] = Параметры[ИндексСледующий];
				Параметры[ИндексСледующий] = Временный;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Параметры;

КонецФункции

// Заменяет &ИмяСтарого на &ИмяНового с учётом границы имени (П vs П2, П vs Параметр_…).
//
Функция ЗаменитьИмяПараметраВТекстеЗапроса(ТекстЗапроса, ИмяСтарого, ИмяНового)

	ИскомаяПодстрока = "&" + ИмяСтарого;
	ПозицияПоиска = 1;

	Пока Истина Цикл

		Позиция = СтрНайти(ТекстЗапроса, ИскомаяПодстрока, , ПозицияПоиска);
		Если Позиция = 0 Тогда
			Прервать;
		КонецЕсли;

		ПозицияПосле = Позиция + СтрДлина(ИскомаяПодстрока);
		СледующийСимвол = "";
		Если ПозицияПосле <= СтрДлина(ТекстЗапроса) Тогда
			СледующийСимвол = Сред(ТекстЗапроса, ПозицияПосле, 1);
		КонецЕсли;

		Если Не ЭтоПродолжениеИмениПараметраЗапроса(СледующийСимвол) Тогда
			ТекстЗапроса = Лев(ТекстЗапроса, Позиция - 1) + "&" + ИмяНового
				+ Сред(ТекстЗапроса, ПозицияПосле);
			ПозицияПоиска = Позиция + СтрДлина(ИмяНового) + 1;
			Продолжить;
		КонецЕсли;

		ПозицияПоиска = Позиция + 1;

	КонецЦикла;

	Возврат ТекстЗапроса;

КонецФункции

Функция ЭтоПродолжениеИмениПараметраЗапроса(Символ)

	Если ПустаяСтрока(Символ) Тогда
		Возврат Ложь;
	КонецЕсли;

	Код = КодСимвола(Символ);

	Возврат (Символ >= "0" И Символ <= "9")
		Или (Символ >= "A" И Символ <= "Z")
		Или (Символ >= "a" И Символ <= "z")
		Или (Символ = "_")
		Или (Код >= 1040 И Код <= 1103);

КонецФункции

Функция ПолучитьЭлементОтбора(Настройки, ИмяПоля)

	Для Каждого ЭлементОтбора Из Настройки.Отбор.Элементы Цикл
		Если ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ИмяПоля) Тогда
			Возврат ЭлементОтбора;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

Функция СформироватьПредставлениеЗапроса(Настройки, СхемаКомпоновки, ВидыСубконто)

	ПоляКомпоновки = СхемаКомпоновки.НаборыДанных[0].Поля;

	Операции = Новый Соответствие;
	Операции.Вставить("СКД", "Сальдо на конец периода по дебету");
	Операции.Вставить("СКК", "Сальдо на конец периода по кредиту");
	Операции.Вставить("СКДР", "Сальдо (развернутое) на конец периода по дебету");
	Операции.Вставить("СККР", "Сальдо (развернутое) на конец периода по кредиту");
	Операции.Вставить("СНД", "Сальдо на начало периода по дебету");
	Операции.Вставить("СНК", "Сальдо на начало периода по кредиту");
	Операции.Вставить("СНДР", "Сальдо (развернутое) на начало периода по дебету");
	Операции.Вставить("СНКР", "Сальдо (развернутое) на начало периода по кредиту");
	Операции.Вставить("ДО", "Дебетовый оборот за период");
	Операции.Вставить("КО", "Кредитовый оборот за период");

	ВыбранноеПоле = Строка(Настройки.Выбор.Элементы[0].Поле);

	Если ВыбранноеПоле = "ДО" Или ВыбранноеПоле = "КО" Тогда
		Описание = Операции[ВыбранноеПоле] + ", где:";
	Иначе
		Описание = Операции[ВыбранноеПоле] + "%ВидыСубконто%, где:";
	КонецЕсли;

	СтрокаСубконто = "";
	Если ЗначениеЗаполнено(ВидыСубконто) Тогда
		МассивВидовСубконто = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ВидыСубконто, ",", Истина, Истина);
		Для Каждого ВидСубконтоИмя Из МассивВидовСубконто Цикл
			СтрокаСубконто = СтрокаСубконто + ?(ЗначениеЗаполнено(СтрокаСубконто), ", ", "")
				+ """" + Строка(ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные[ВидСубконтоИмя]) + """";
		КонецЦикла;
		СтрокаСубконто = ", с детализацией по субконто " + СтрокаСубконто;
	КонецЕсли;

	Описание = СтрЗаменить(Описание, "%ВидыСубконто%", СтрокаСубконто);
	ОписаниеОтбора = "";
	СформироватьОписаниеОтбораКомпоновкиДанных(ОписаниеОтбора, Настройки.Отбор.Элементы, ПоляКомпоновки);

	Возврат Описание + " " + ОписаниеОтбора;

КонецФункции

Процедура ОбновитьПараметрыЗапросаИзПакета(ОбъектЗапроса, ЗначенияПараметров)

	ОбъектЗапроса.Параметры.Очистить();

	Для Каждого КлючИЗначение Из ЗначенияПараметров Цикл
		СтрокаПараметра = ОбъектЗапроса.Параметры.Добавить();
		СтрокаПараметра.Имя = КлючИЗначение.Ключ;
		СтрокаПараметра.ЗначениеПоУмолчанию = Строка(КлючИЗначение.Значение);
	КонецЦикла;

КонецПроцедуры

Процедура УстановитьПараметрВидыСубконтоЗапроса(Запрос, ПакетЗапроса)

	Если Не ПакетЗапроса.Свойство("НастройкиКомпоновки")
		Или ПакетЗапроса.НастройкиКомпоновки = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ЗначениеПараметра = ПолучитьПараметр(ПакетЗапроса.НастройкиКомпоновки, "ВидыСубконто");
	Если ЗначениеПараметра = Неопределено Или Не ЗначениеПараметра.Использование Тогда
		Возврат;
	КонецЕсли;

	Запрос.УстановитьПараметр("ВидыСубконто", ЗначениеПараметра.Значение);

КонецПроцедуры

Процедура УстановитьПараметрыЗапросаИзТабличнойЧасти(Запрос, ЗапросДанных)

	ЗапросПараметров = Новый Запрос;
	ЗапросПараметров.Текст =
	"ВЫБРАТЬ
	|	Параметры.Имя КАК ИмяПараметра,
	|	Параметры.ЗначениеПоУмолчанию КАК ЗначениеПараметра
	|ИЗ
	|	Справочник.дбу_ЗапросыДанных.Параметры КАК Параметры
	|ГДЕ
	|	Параметры.Ссылка = &Ссылка";
	ЗапросПараметров.УстановитьПараметр("Ссылка", ЗапросДанных);

	Выборка = ЗапросПараметров.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ИмяПараметра = СокрЛП(Выборка.ИмяПараметра);
		Если Не ЗначениеЗаполнено(ИмяПараметра) Тогда
			Продолжить;
		КонецЕсли;
		Запрос.УстановитьПараметр(ИмяПараметра, Выборка.ЗначениеПараметра);
	КонецЦикла;

КонецПроцедуры

Процедура ЗаполнитьТаблицуОтбора(ТаблицаОтбора, ЭлементыОтбора)

	Для Каждого ЭлементОтбора Из ЭлементыОтбора Цикл

		Если Не ЭлементОтбора.Использование Тогда
			Продолжить;
		КонецЕсли;

		Если ТипЗнч(ЭлементОтбора) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда
			ЗаполнитьТаблицуОтбора(ТаблицаОтбора, ЭлементОтбора.Элементы);
			Продолжить;
		КонецЕсли;

		НоваяСтрока = ТаблицаОтбора.Добавить();
		НоваяСтрока.Поле = Строка(ЭлементОтбора.ЛевоеЗначение);
		НоваяСтрока.Отбор = Строка(ЭлементОтбора.ВидСравнения) + ПредставлениеПравогоЗначенияОтбора(ЭлементОтбора.ПравоеЗначение);

	КонецЦикла;

КонецПроцедуры

Функция ПредставлениеПравогоЗначенияОтбора(ПравоеЗначение)

	Если Не ЗначениеЗаполнено(ПравоеЗначение) Тогда
		Возврат "";
	КонецЕсли;

	Если Справочники.ТипВсеСсылки().СодержитТип(ТипЗнч(ПравоеЗначение))
		Или Документы.ТипВсеСсылки().СодержитТип(ТипЗнч(ПравоеЗначение))
		Или ПланыВидовХарактеристик.ТипВсеСсылки().СодержитТип(ТипЗнч(ПравоеЗначение))
		Или ПланыСчетов.ТипВсеСсылки().СодержитТип(ТипЗнч(ПравоеЗначение)) Тогда
		Возврат Строка(ПравоеЗначение.УникальныйИдентификатор());
	КонецЕсли;

	Если ТипЗнч(ПравоеЗначение) = Тип("СписокЗначений") Тогда
		Результат = "";
		ПравоеЗначение.СортироватьПоЗначению();
		Для Каждого ЭлементСписка Из ПравоеЗначение Цикл
			Результат = Результат + ПредставлениеПравогоЗначенияОтбора(ЭлементСписка.Значение);
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	Возврат Строка(ПравоеЗначение);

КонецФункции

Функция СчетИзНастроекСКД(Настройки, ИмяПоля)

	ЭлементОтбора = ПолучитьЭлементОтбора(Настройки, ИмяПоля);
	Если ЭлементОтбора = Неопределено Или Не ЭлементОтбора.Использование Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат ЭлементОтбора.ПравоеЗначение;

КонецФункции

Функция ЕстьНеподдерживаемыеЭлементыОтбора(ЭлементыОтбора)

	ДопустимыеПоля = "Счет,КорСчет,Подразделение,Субконто1,Субконто2,Субконто3,КорСубконто1,КорСубконто2,КорСубконто3";

	Для Каждого ЭлементОтбора Из ЭлементыОтбора Цикл

		Если Не ЭлементОтбора.Использование Тогда
			Продолжить;
		КонецЕсли;

		Если ТипЗнч(ЭлементОтбора) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда
			Если ЭлементОтбора.ТипГруппы <> ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ Тогда
				Возврат Истина;
			КонецЕсли;
			Если ЕстьНеподдерживаемыеЭлементыОтбора(ЭлементОтбора.Элементы) Тогда
				Возврат Истина;
			КонецЕсли;
			Продолжить;
		КонецЕсли;

		ИмяПоля = Строка(ЭлементОтбора.ЛевоеЗначение);
		Если СтрНайти(ДопустимыеПоля, ИмяПоля) = 0 Тогда
			Возврат Истина;
		КонецЕсли;

	КонецЦикла;

	Возврат Ложь;

КонецФункции

Процедура ПрименитьОтборСубконтоКРасшифровке(ДанныеРасшифровки, Настройки, Счет, ВидыСубконто)

	Если Не ЗначениеЗаполнено(ВидыСубконто) Тогда
		СкопироватьОтборСубконтоВОСВ(ДанныеРасшифровки, Настройки);
		Возврат;
	КонецЕсли;

	ПрименитьГруппировкуВидовСубконтоКРасшифровке(ДанныеРасшифровки, Счет, ВидыСубконто);
	СкопироватьОтборСубконтоВОСВ(ДанныеРасшифровки, Настройки);

КонецПроцедуры

Процедура ПрименитьГруппировкуВидовСубконтоКРасшифровке(ДанныеРасшифровки, Счет, ВидыСубконто)

	МассивВидовСубконто = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ВидыСубконто, ",", Истина, Истина);
	ТабличнаяЧастьГруппировка = Новый Массив;

	Для Каждого ВидСубконтоИмя Из МассивВидовСубконто Цикл

		ВидСубконто = ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные[ВидСубконтоИмя];
		СтрокаСубконто = Счет.ВидыСубконто.Найти(ВидСубконто);

		Если СтрокаСубконто <> Неопределено Тогда
			ОписаниеГруппировки = Новый Структура;
			ОписаниеГруппировки.Вставить("Использование", Истина);
			ОписаниеГруппировки.Вставить("Поле", "Субконто" + Строка(СтрокаСубконто.НомерСтроки));
			ОписаниеГруппировки.Вставить("Представление", Строка(ВидСубконто));
			ОписаниеГруппировки.Вставить("ТипГруппировки", 0);
			ТабличнаяЧастьГруппировка.Добавить(ОписаниеГруппировки);
		КонецЕсли;

	КонецЦикла;

	Если ТабличнаяЧастьГруппировка.Количество() > 0 Тогда
		ДанныеРасшифровки.Отчет.НастройкиТиповогоОтчета.Группировка = ТабличнаяЧастьГруппировка;
	КонецЕсли;

КонецПроцедуры

Процедура СкопироватьОтборСубконтоВОСВ(ДанныеРасшифровки, Настройки)

	ОтборПоАналитике = ОтборПоАналитикеИзНастроекСКД(Настройки.Отбор.Элементы);
	Если ОтборПоАналитике = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ДанныеРасшифровки.Отчет.НастройкиТиповогоОтчета.ОтборПоАналитике = ОтборПоАналитике;

КонецПроцедуры

// Формирует ОтборПоАналитике (Соответствие) для типовой ОСВ/анализа счёта из отбора СКД.
//
Функция ОтборПоАналитикеИзНастроекСКД(ЭлементыОтбора)

	ОтборПоАналитике = Новый Соответствие;
	ДобавитьОтборПоАналитикеИзЭлементовСКД(ЭлементыОтбора, ОтборПоАналитике);

	Если ОтборПоАналитике.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат ОтборПоАналитике;

КонецФункции

Процедура ДобавитьОтборПоАналитикеИзЭлементовСКД(ЭлементыОтбора, ОтборПоАналитике)

	ПоляРесурсов = ПоляРесурсовСКДДляТиповогоОтчета();

	Для Каждого ЭлементОтбора Из ЭлементыОтбора Цикл

		Если ТипЗнч(ЭлементОтбора) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда
			ДобавитьОтборПоАналитикеИзЭлементовСКД(ЭлементОтбора.Элементы, ОтборПоАналитике);
			Продолжить;
		КонецЕсли;

		Если ТипЗнч(ЭлементОтбора) <> Тип("ЭлементОтбораКомпоновкиДанных") Тогда
			Продолжить;
		КонецЕсли;

		Если Не ЭлементОтбора.Использование Тогда
			Продолжить;
		КонецЕсли;

		ИмяПоляИсточника = Строка(ЭлементОтбора.ЛевоеЗначение);
		Если ИмяПоляИсточника = "Счет" Или ИмяПоляИсточника = "КорСчет" Тогда
			Продолжить;
		КонецЕсли;

		ИмяРесурса = ПоляРесурсов[ИмяПоляИсточника];
		ИмяПоля = ?(ИмяРесурса = Неопределено, ИмяПоляИсточника, ИмяРесурса);

		ОтборПоАналитике.Вставить(ИмяПоля, ЗначениеОтбораПоАналитикеДляТиповогоОтчета(ЭлементОтбора));

	КонецЦикла;

КонецПроцедуры

Функция ПоляРесурсовСКДДляТиповогоОтчета()

	ПоляРесурсов = Новый Соответствие;
	ПоляРесурсов.Вставить("СНД", "СальдоНаНачалоПериода.БУНачальныйОстатокДт");
	ПоляРесурсов.Вставить("СНДР", "СальдоНаНачалоПериода.БУНачальныйРазвернутыйОстатокДт");
	ПоляРесурсов.Вставить("СНК", "СальдоНаНачалоПериода.БУНачальныйОстатокКт");
	ПоляРесурсов.Вставить("СНКР", "СальдоНаНачалоПериода.БУНачальныйРазвернутыйОстатокКт");
	ПоляРесурсов.Вставить("СКД", "СальдоНаКонецПериода.БУКонечныйОстатокДт");
	ПоляРесурсов.Вставить("СКДР", "СальдоНаКонецПериода.БУКонечныйРазвернутыйОстатокДт");
	ПоляРесурсов.Вставить("СКК", "СальдоНаКонецПериода.БУКонечныйОстатокКт");
	ПоляРесурсов.Вставить("СККР", "СальдоНаКонецПериода.БУКонечныйРазвернутыйОстатокКт");
	ПоляРесурсов.Вставить("ДО", "ОборотыЗаПериод.БУОборотДт");
	ПоляРесурсов.Вставить("КО", "ОборотыЗаПериод.БУОборотКт");

	Возврат ПоляРесурсов;

КонецФункции

// Значение элемента ОтборПоАналитике: ссылка при «Равно», иначе структура с видом сравнения.
//
Функция ЗначениеОтбораПоАналитикеДляТиповогоОтчета(ЭлементОтбора)

	Если ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно Тогда
		Возврат ЭлементОтбора.ПравоеЗначение;
	КонецЕсли;

	ЗначениеОтбора = ЗаполнениеРасшифровкаРегламентированнойОтчетности.НовыйЗначениеЭлементаОтбора();
	ЗначениеОтбора.ВидСравненияКомпоновкиДанных = ЭлементОтбора.ВидСравнения;

	ПравоеЗначение = ЭлементОтбора.ПравоеЗначение;
	Если ТипЗнч(ПравоеЗначение) = Тип("Массив") Тогда
		СписокЗначений = Новый СписокЗначений;
		СписокЗначений.ЗагрузитьЗначения(ОбщегоНазначенияКлиентСервер.СвернутьМассив(ПравоеЗначение));
		ПравоеЗначение = СписокЗначений;
	КонецЕсли;

	ЗначениеОтбора.Значение = ПравоеЗначение;

	Возврат ЗначениеОтбора;

КонецФункции

#КонецОбласти
