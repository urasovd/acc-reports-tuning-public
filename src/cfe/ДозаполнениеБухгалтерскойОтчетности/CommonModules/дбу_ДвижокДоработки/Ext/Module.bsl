// Движок применения правил доработки бухгалтерской отчётности по направлениям бизнеса.
// План: docs/urdv-dozapolnenie-buh-otchetnosti/01-план.md § 4

#Область ПрограммныйИнтерфейс

// Применяет настроенные доработки к дереву данных разделов отчёта.
//
// Параметры:
//  Организация - СправочникСсылка.Организации
//  ДатаКонцаПериодаОтчета - Дата
//  ДеревоДанныхРазделов - ДеревоЗначений
//  СтруктураРеквизитовФормы - Структура - реквизиты формы отчёта
//  РазделОтбора - ПеречислениеСсылка.дбу_РазделыБухОтчетности, Неопределено - если задан,
//                 применяются только правила этого раздела
//  ТолькоУказанныйРаздел - Булево - при Истина и пустом РазделОтбора доработки не применяются
//
Процедура ПрименитьДоработки(Организация, ДатаКонцаПериодаОтчета, ДеревоДанныхРазделов, СтруктураРеквизитовФормы,
	РазделОтбора = Неопределено, ТолькоУказанныйРаздел = Ложь) Экспорт

	Если Не ЗначениеЗаполнено(Организация) Или ДеревоДанныхРазделов = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если ТолькоУказанныйРаздел И РазделОтбора = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ПараметрыРасчета = ПараметрыРасчетаОтчета(Организация, ДатаКонцаПериодаОтчета, СтруктураРеквизитовФормы);
	Правила = ЗагрузитьПравилаДляОрганизации(Организация, ДатаКонцаПериодаОтчета);

	Для Каждого ОписаниеПравила Из Правила Цикл

		Если РазделОтбора <> Неопределено И ОписаниеПравила.Раздел <> РазделОтбора Тогда
			Продолжить;
		КонецЕсли;

		ПрименитьПравило(ОписаниеПравила, ПараметрыРасчета, ДеревоДанныхРазделов);

	КонецЦикла;

КонецПроцедуры

// Рассчитывает сумму по формуле правила (для пробного расчёта и отчёта).
//
Функция РассчитатьСуммуФормулы(Формула, ЗначенияОперандов) Экспорт

	Возврат ВычислитьФормулу(Формула, ЗначенияОперандов);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПараметрыРасчетаОтчета(Организация, ДатаКонцаПериодаОтчета, СтруктураРеквизитовФормы)

	ПараметрыРасчета = Новый Структура;
	ПараметрыРасчета.Вставить("Организация", Организация);
	ПараметрыРасчета.Вставить("КонецПериода", КонецДня(ДатаКонцаПериодаОтчета));

	НачалоПериода = ДатаКонцаПериодаОтчета;
	Если СтруктураРеквизитовФормы <> Неопределено
		И СтруктураРеквизитовФормы.Свойство("мДатаНачалаПериодаОтчета")
		И ЗначениеЗаполнено(СтруктураРеквизитовФормы.мДатаНачалаПериодаОтчета) Тогда
		НачалоПериода = СтруктураРеквизитовФормы.мДатаНачалаПериодаОтчета;
	Иначе
		НачалоПериода = НачалоГода(ДатаКонцаПериодаОтчета);
	КонецЕсли;

	ПараметрыРасчета.Вставить("НачалоПериода", НачалоДня(НачалоПериода));
	Возврат ПараметрыРасчета;

КонецФункции

Функция ЗагрузитьПравилаДляОрганизации(Организация, ДатаКонцаПериодаОтчета) Экспорт

	ПериодРегистра = НачалоМесяца(ДатаКонцаПериодаОтчета);
	Профили = дбу_ПрофилиДоработкиСервер.ПрофилиДляОрганизации(Организация, ПериодРегистра);

	Если Профили.Количество() = 0 Тогда
		Возврат Новый Массив;
	КонецЕсли;

	СписокПрофилей = Профили.ВыгрузитьКолонку("Профиль");

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Профили.Профиль КАК Профиль,
	|	Профили.Приоритет КАК Приоритет
	|ПОМЕСТИТЬ ВТПрофилиОрганизации
	|ИЗ
	|	&Профили КАК Профили
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Правила.Ссылка КАК Ссылка,
	|	Правила.Наименование КАК Наименование,
	|	Правила.ВидПравила КАК ВидПравила,
	|	Правила.Раздел КАК Раздел,
	|	Правила.ПрефиксРасшифровки КАК ПрефиксРасшифровки,
	|	Правила.ПрименятьС КАК ПрименятьС,
	|	Правила.НеПрименятьС КАК НеПрименятьС,
	|	Правила.Приоритет КАК ПриоритетПравила,
	|	Правила.Формула КАК Формула,
	|	Правила.Владелец КАК Профиль,
	|	ПрофилиДоработки.ПрефиксРасшифровки КАК ПрефиксПрофиля,
	|	ЕСТЬNULL(ПрофилиОрганизации.Приоритет, 1000) КАК ПриоритетПрофиля
	|ИЗ
	|	Справочник.дбу_ПравилаДоработки КАК Правила
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.дбу_ПрофилиДоработки КАК ПрофилиДоработки
	|		ПО Правила.Владелец = ПрофилиДоработки.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТПрофилиОрганизации КАК ПрофилиОрганизации
	|		ПО Правила.Владелец = ПрофилиОрганизации.Профиль
	|ГДЕ
	|	НЕ Правила.ПометкаУдаления
	|	И Правила.Активно
	|	И (Правила.ПрименятьС = &ПустаяДата ИЛИ Правила.ПрименятьС <= &ДатаОтчета)
	|	И (Правила.НеПрименятьС = &ПустаяДата ИЛИ Правила.НеПрименятьС > &ДатаОтчета)
	|	И Правила.Владелец В (&СписокПрофилей)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПриоритетПрофиля,
	|	ПрофилиДоработки.Наименование,
	|	Правила.Приоритет,
	|	Правила.Ссылка";

	Запрос.УстановитьПараметр("Профили", Профили);
	Запрос.УстановитьПараметр("СписокПрофилей", СписокПрофилей);
	Запрос.УстановитьПараметр("ДатаОтчета", КонецМесяца(ДатаКонцаПериодаОтчета));
	Запрос.УстановитьПараметр("ПустаяДата", Дата(1, 1, 1));
	Результат = Запрос.Выполнить().Выгрузить();

	Правила = Новый Массив;
	Для Каждого Строка Из Результат Цикл
		ОписаниеПравила = Новый Структура;
		ОписаниеПравила.Вставить("Ссылка", Строка.Ссылка);
		ОписаниеПравила.Вставить("Наименование", Строка.Наименование);
		ОписаниеПравила.Вставить("ВидПравила", Строка.ВидПравила);
		ОписаниеПравила.Вставить("Раздел", Строка.Раздел);
		ОписаниеПравила.Вставить("ПрефиксРасшифровки", Строка.ПрефиксРасшифровки);
		ОписаниеПравила.Вставить("ПрименятьС", Строка.ПрименятьС);
		ОписаниеПравила.Вставить("НеПрименятьС", Строка.НеПрименятьС);
		ОписаниеПравила.Вставить("Формула", Строка.Формула);
		ОписаниеПравила.Вставить("Профиль", Строка.Профиль);
		ОписаниеПравила.Вставить("ПрефиксПрофиля", Строка.ПрефиксПрофиля);
		Правила.Добавить(ОписаниеПравила);
	КонецЦикла;

	Возврат Правила;

КонецФункции

Функция ПрофилиДоработкиОрганизации(Организация, ПериодРегистра)

	Возврат дбу_ПрофилиДоработкиСервер.ПрофилиДляОрганизации(Организация, ПериодРегистра);

КонецФункции

Процедура ПрименитьПравило(ОписаниеПравила, ПараметрыРасчета, ДеревоДанныхРазделов)

	ПравилоОбъект = ОписаниеПравила.Ссылка.ПолучитьОбъект();
	ПрименитьПравилоСЦелями(ОписаниеПравила, ПравилоОбъект, ПараметрыРасчета, ДеревоДанныхРазделов);

КонецПроцедуры

Процедура ПрименитьПравилоСЦелями(ОписаниеПравила, ПравилоОбъект, ПараметрыРасчета,
	ДеревоДанныхРазделов, ПредрассчитанныеОперанды = Неопределено) Экспорт

	ИмяРаздела = дбу_СтруктураОтчетности.ИмяРазделаОтчета(ОписаниеПравила.Раздел);
	КонтекстПравила = КонтекстПравила(ОписаниеПравила, ПараметрыРасчета);

	НомерЦели = 0;
	Для Каждого СтрокаЦели Из ПравилоОбъект.Цели Цикл

		НомерЦели = НомерЦели + 1;
		Формула = ?(ЗначениеЗаполнено(СтрокаЦели.Формула), СтрокаЦели.Формула, ОписаниеПравила.Формула);

		Колонки = дбу_СтруктураОтчетности.КолонкиДляПрименения(СтрокаЦели.Колонка, ОписаниеПравила.Раздел);

		Для Каждого Колонка Из Колонки Цикл

			ПараметрыКолонки = дбу_СтруктураОтчетности.ПараметрыРасчетаДляКолонки(ПараметрыРасчета, Колонка);
			Если ПредрассчитанныеОперанды = Неопределено Тогда
				ЗначенияОперандов = РассчитатьОперандыПравила(ОписаниеПравила, ПравилоОбъект, ПараметрыКолонки);
			Иначе
				ЗначенияОперандов = ПредрассчитанныеОперанды;
			КонецЕсли;

			СуммаПравила = ВычислитьФормулу(Формула, ЗначенияОперандов);

			Действие = ДействиеДляЦели(ОписаниеПравила, СтрокаЦели, НомерЦели);
			АдресСтрокиЦели = дбу_СтруктураОтчетности.АдресСтрокиЦели(СтрокаЦели);
			ПроверитьЦельАрендногоПравила(ПравилоОбъект, АдресСтрокиЦели, Действие);

			СуммаПрименения = 0;
			Если СуммаПравила <> 0
				Или Действие = Перечисления.дбу_ДействияСПоказателем.Заменить Тогда

				СуммаПрименения = СуммаДляПрименения(ОписаниеПравила, СуммаПравила, Действие);
				РезультатРазрешения = ПрименитьЗначениеПоАдресу(
					ДеревоДанныхРазделов, ОписаниеПравила.Раздел, АдресСтрокиЦели,
					Колонка, СуммаПрименения, Действие);
			Иначе
				// Нулевая сумма показатель не меняет; строка расшифровки остаётся для прозрачности.
				РезультатРазрешения = дбу_СтруктураОтчетности.РазрешитьАдресПоказателя(
					ДеревоДанныхРазделов, ОписаниеПравила.Раздел, АдресСтрокиЦели, Колонка);
				РезультатРазрешения.Вставить("Изменено", Ложь);
				РезультатРазрешения.Вставить("СуммаИзменения", 0);
			КонецЕсли;
			Если РезультатРазрешения.Статус <> "Найдена" Тогда
				Продолжить;

			КонецЕсли;
			ПроверитьСторноТиповойАренды(ПравилоОбъект, АдресСтрокиЦели, Действие,
				РезультатРазрешения, СуммаПрименения, Колонка);

			// В расшифровку записывается именно изменение показателя. Для действия
			// «Заменить» это новая сумма минус исходное типовое значение: так типовая
			// часть сторнируется, а итог расшифровки совпадает с показателем.
			СуммаВкладаВРасшифровку = ?(РезультатРазрешения.Изменено,
				РезультатРазрешения.СуммаИзменения, 0);
			дбу_Расшифровка.ДобавитьСтрокуРасшифровки(
				РезультатРазрешения.СтрокаПоказателя,
				дбу_Расшифровка.ПараметрыРасшифровкиПравила(
					КонтекстПравила, ИмяРаздела, СуммаВкладаВРасшифровку, Действие,
					ПравилоОбъект, ЗначенияОперандов, Формула, ПараметрыКолонки));

			// Строка результата КДР уже содержит полный вклад формулы в типовую
			// расшифровку. Дополнительная компенсационная строка для того же
			// операнда задваивает вклад и искажает «Итого» расшифровки.

		КонецЦикла;

	КонецЦикла;

КонецПроцедуры

// Разрешает адрес и изменяет найденный показатель непосредственно в дереве.
// Позиционные суффиксы runtime не участвуют в адресации.
//
Функция ПрименитьЗначениеПоАдресу(ДеревоДанныхРазделов, Раздел, Адрес,
	Колонка, Значение, Действие) Экспорт

	Результат = ПолучитьТиповоеЗначениеПоАдресу(
		ДеревоДанныхРазделов, Раздел, Адрес, Колонка);
	Результат.Вставить("Изменено", Ложь);
	Результат.Вставить("НовоеЗначение", 0);
	Результат.Вставить("СуммаИзменения", 0);
	Если Результат.Статус <> "Найдена" Тогда
		Возврат Результат;
	КонецЕсли;

	ТекущееЗначение = Результат.ТиповоеЗначение;
	Если Действие = Перечисления.дбу_ДействияСПоказателем.Заменить Тогда
		НовоеЗначение = Значение;
	ИначеЕсли Действие = Перечисления.дбу_ДействияСПоказателем.Добавить Тогда
		НовоеЗначение = ТекущееЗначение + Значение;
	ИначеЕсли Действие = Перечисления.дбу_ДействияСПоказателем.УменьшитьТиповое Тогда
		НовоеЗначение = ТекущееЗначение - Значение;
	Иначе
		НовоеЗначение = ТекущееЗначение + Значение;
	КонецЕсли;

	Результат.СтрокаПоказателя.Данные = НовоеЗначение;
	Результат.НовоеЗначение = НовоеЗначение;
	Результат.СуммаИзменения = НовоеЗначение - ТекущееЗначение;
	Результат.Изменено = Истина;
	Возврат Результат;

КонецФункции

// Возвращает значение, которое типовое заполнение уже записало в адрес показателя.
// Функция ничего не изменяет и используется действием «Заменить» для вычисления сторно.
//
Функция ПолучитьТиповоеЗначениеПоАдресу(ДеревоДанныхРазделов, Раздел, Адрес, Колонка) Экспорт

	Результат = дбу_СтруктураОтчетности.РазрешитьАдресПоказателя(
		ДеревоДанныхРазделов, Раздел, Адрес, Колонка);
	Результат.Вставить("ТиповоеЗначение", 0);
	Если Результат.Статус = "Найдена" Тогда
		Результат.ТиповоеЗначение = ?(ЗначениеЗаполнено(Результат.СтрокаПоказателя.Данные),
			Результат.СтрокаПоказателя.Данные, 0);
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Не позволяет арендному расчету заменить агрегированную строку баланса целиком.
// Заменять можно только арендную строку расшифровки (например, вписанную строку
// «Обязательство по аренде» внутри 1520). В стандартную строку арендный расчет
// только добавляется: так прочие слагаемые той же строки ФСБУ сохраняются.
//
Процедура ПроверитьЦельАрендногоПравила(ПравилоОбъект, Адрес, Действие = Неопределено) Экспорт

	Если Не ПравилоИспользуетРасчетАренды(ПравилоОбъект) Тогда
		Возврат;
	КонецЕсли;

	Если Адрес.ВидСтрокиОтчетности <> Перечисления.дбу_ВидыСтрокОтчетности.Стандартная
		Или Действие <> Перечисления.дбу_ДействияСПоказателем.Заменить Тогда
		Возврат;
	КонецЕсли;

	ВызватьИсключение НСтр(
		"ru = 'Расчет аренды не может заменить стандартную строку баланса целиком. Выберите строку расшифровки (например, «Обязательство по аренде» внутри строки 1520) или действие «Добавить».'");

КонецПроцедуры

// Сторно типовой аренды отдельной строкой «Уменьшить» точно, только если механизм посчитал
// ту же сумму, что записало типовое заполнение. Проверяется строка расшифровки (вписанная
// или прямая): в ней лежит одна типовая сумма. Цель «Уменьшить» должна идти в правиле
// раньше цели «Добавить», иначе сравнивается уже изменённое значение.
//
Процедура ПроверитьСторноТиповойАренды(ПравилоОбъект, Адрес, Действие, РезультатРазрешения,
	СуммаСторно, Колонка)

	Если Действие <> Перечисления.дбу_ДействияСПоказателем.УменьшитьТиповое
		Или Адрес.ВидСтрокиОтчетности = Перечисления.дбу_ВидыСтрокОтчетности.Стандартная
		Или Не РезультатРазрешения.Свойство("ТиповоеЗначение")
		Или Не ПравилоИспользуетРасчетАренды(ПравилоОбъект) Тогда
		Возврат;
	КонецЕсли;

	Расхождение = РезультатРазрешения.ТиповоеЗначение - СуммаСторно;
	Если Расхождение <= 1 И Расхождение >= -1 Тогда
		Возврат;
	КонецЕсли;

	ОбщегоНазначения.СообщитьПользователю(СтрШаблон(
		НСтр("ru = 'Правило «%1», строка %2 «%3», %4: типовое заполнение записало %5, а сторнировано %6. В строке остался остаток %7 — проверьте расчет аренды.'"),
		ПравилоОбъект.Наименование, Адрес.КодСтрокиФСБУ, Адрес.НаименованиеСтроки, Строка(Колонка),
		Формат(РезультатРазрешения.ТиповоеЗначение, "ЧДЦ=2; ЧН=0; ЧГ=3,0"),
		Формат(СуммаСторно, "ЧДЦ=2; ЧН=0; ЧГ=3,0"),
		Формат(Расхождение, "ЧДЦ=2; ЧН=0; ЧГ=3,0")));

КонецПроцедуры

Функция ПравилоИспользуетРасчетАренды(ПравилоОбъект)

	Для Каждого СтрокаОперанда Из ПравилоОбъект.Операнды Цикл
		Если дбу_РасчетАрендныхОбязательств.ЭтоСпособРасчетаАренды(СтрокаОперанда.СпособРасчета) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция РассчитатьОперандыПравила(ОписаниеПравила, ПравилоОбъект, ПараметрыРасчета)

	ЗначенияОперандов = дбу_ОперандыУчета.РассчитатьОперанды(ПараметрыРасчета, ПравилоОбъект.Операнды);

	Если ОписаниеПравила.ВидПравила <> Перечисления.дбу_ВидыПравил.ПроизвольныйЗапрос Тогда
		Возврат ЗначенияОперандов;
	КонецЕсли;

	Для Каждого СтрокаОперанда Из ПравилоОбъект.Операнды Цикл
		Если СтрокаОперанда.СпособРасчета <> Перечисления.дбу_СпособыРасчетаОперанда.Запрос Тогда
			Продолжить;
		КонецЕсли;
		Идентификатор = ВРег(СокрЛП(Строка(СтрокаОперанда.Идентификатор)));
		ЗначенияОперандов.Вставить(Идентификатор, дбу_ОперандыУчета.ВыполнитьЗапросДанных(ПараметрыРасчета, СтрокаОперанда.ЗапросДанных));
	КонецЦикла;

	Возврат ЗначенияОперандов;

КонецФункции

Функция КонтекстПравила(ОписаниеПравила, ПараметрыРасчета)

	ЭффективныйПрефикс = дбу_Расшифровка.ЭффективныйПрефиксРасшифровки(
		ОписаниеПравила.ПрефиксРасшифровки, ОписаниеПравила.ПрефиксПрофиля);

	Контекст = Новый Структура;
	Контекст.Вставить("СсылкаПравила", ОписаниеПравила.Ссылка);
	Контекст.Вставить("НаименованиеПравила", ОписаниеПравила.Наименование);
	Контекст.Вставить("ПрефиксРасшифровки", ОписаниеПравила.ПрефиксРасшифровки);
	Контекст.Вставить("ПрефиксПрофиля", ОписаниеПравила.ПрефиксПрофиля);
	Контекст.Вставить("ЭффективныйПрефикс", ЭффективныйПрефикс);
	Контекст.Вставить("Профиль", ОписаниеПравила.Профиль);
	Контекст.Вставить("Организация", ПараметрыРасчета.Организация);
	Возврат Контекст;

КонецФункции

Функция ДействиеДляЦели(ОписаниеПравила, СтрокаЦели, НомерЦели)

	Если ЗначениеЗаполнено(СтрокаЦели.Действие) Тогда
		Возврат СтрокаЦели.Действие;
	КонецЕсли;

	Если ОписаниеПравила.ВидПравила = Перечисления.дбу_ВидыПравил.ПереносМеждуСтроками Тогда
		Если НомерЦели = 1 Тогда
			Возврат Перечисления.дбу_ДействияСПоказателем.УменьшитьТиповое;
		КонецЕсли;
		Возврат Перечисления.дбу_ДействияСПоказателем.Добавить;
	КонецЕсли;

	Если ОписаниеПравила.ВидПравила = Перечисления.дбу_ВидыПравил.СверткаСчетов Тогда
		Возврат Перечисления.дбу_ДействияСПоказателем.УменьшитьТиповое;
	КонецЕсли;

	Возврат Перечисления.дбу_ДействияСПоказателем.Добавить;

КонецФункции

// Сумма для записи в дерево и расшифровку с учётом вида правила и действия.
//
Функция СуммаДляПрименения(ОписаниеПравила, СуммаПравила, Действие)

	Сумма = СуммаПравила;

	Если ОписаниеПравила.ВидПравила = Перечисления.дбу_ВидыПравил.ПереносМеждуСтроками Тогда
		Сумма = ?(Сумма < 0, -Сумма, Сумма);
	ИначеЕсли Действие = Перечисления.дбу_ДействияСПоказателем.УменьшитьТиповое Тогда
		Сумма = ?(Сумма < 0, -Сумма, Сумма);
	КонецЕсли;

	Возврат Сумма;

КонецФункции

Функция ВычислитьФормулу(Формула, ЗначенияОперандов)

	Выражение = НормализоватьТекстФормулы(Формула);
	Если Не ЗначениеЗаполнено(Выражение) Тогда
		Возврат 0;
	КонецЕсли;

	Идентификаторы = ИдентификаторыВФормуле(Выражение);
	СортироватьИдентификаторыПоДлине(Идентификаторы);

	Для Каждого Идентификатор Из Идентификаторы Цикл
		Значение = ЗначениеОперандаДляФормулы(ЗначенияОперандов, Идентификатор);
		ТекстЧисла = Формат(Значение, "ЧРД=.; ЧН=0; ЧГ=0");
		Выражение = ЗаменитьИдентификаторВВыражении(Выражение, Идентификатор, ТекстЧисла);
	КонецЦикла;

	Если ЕстьНезаменённыеИдентификаторы(Выражение) Тогда
		ВызватьИсключение СтрШаблон(
			НСтр("ru = 'В формуле ""%1"" остались неизвестные операнды. Проверьте идентификаторы A, B… в ТЧ «Операнды».'"),
			Формула);
	КонецЕсли;

	Если Не ФормулаБезопасна(Выражение) Тогда
		ВызватьИсключение НСтр("ru = 'Формула правила содержит недопустимые символы.'");
	КонецЕсли;

	Попытка
		Возврат Вычислить(Выражение);
	Исключение
		ВызватьИсключение СтрШаблон(
			НСтр("ru = 'Ошибка вычисления формулы ""%1"" (выражение ""%2""): %3'"),
			Формула, Выражение, ОписаниеОшибки());
	КонецПопытки;

КонецФункции

// Проверяет синтаксис формулы после подстановки тестовых значений операндов (для UI).
//
// Параметры:
//  Формула - Строка
//  ИдентификаторыОперандов - Массив из Строка - A, B, …
//
// Возвращаемое значение:
//  Структура - Успех (Булево), ТекстОшибки (Строка)
//
Функция ПроверитьФормулу(Формула, ИдентификаторыОперандов) Экспорт

	Результат = Новый Структура("Успех, ТекстОшибки", Ложь, "");

	Если Не ЗначениеЗаполнено(СокрЛП(Формула)) Тогда
		Результат.Успех = Истина;
		Возврат Результат;
	КонецЕсли;

	ЗначенияОперандов = Новый Соответствие;
	Для Каждого Идентификатор Из ИдентификаторыОперандов Цикл
		ИдентификаторНорм = ВРег(СокрЛП(Строка(Идентификатор)));
		Если ЗначениеЗаполнено(ИдентификаторНорм) Тогда
			ЗначенияОперандов.Вставить(ИдентификаторНорм, 1);
		КонецЕсли;
	КонецЦикла;

	Попытка
		ВычислитьФормулу(Формула, ЗначенияОперандов);
		Результат.Успех = Истина;
	Исключение
		Результат.ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Приводит формулу к виду, пригодному для подстановки операндов и Вычислить().
//
Функция НормализоватьТекстФормулы(Формула)

	Выражение = СокрЛП(Формула);
	Выражение = СтрЗаменить(Выражение, "−", "-");
	Выражение = СтрЗаменить(Выражение, "–", "-");
	Выражение = СтрЗаменить(Выражение, "—", "-");
	Выражение = НормализоватьИмяФункцииВФормуле(Выражение, "Min", "Мин");
	Выражение = НормализоватьИмяФункцииВФормуле(Выражение, "Max", "Макс");
	Возврат Выражение;

КонецФункции

// Заменяет латинское имя функции на кириллическое (Min → Мин) без учёта регистра.
//
Функция НормализоватьИмяФункцииВФормуле(Выражение, ИмяЛатинское, ИмяКириллическое)

	Результат = "";
	Индекс = 1;
	ДлинаИмени = СтрДлина(ИмяЛатинское);

	Пока Индекс <= СтрДлина(Выражение) Цикл

		Фрагмент = Сред(Выражение, Индекс, ДлинаИмени);
		Если ВРег(Фрагмент) = ВРег(ИмяЛатинское) И ИмяФункцииВПозиции(Выражение, Индекс, ДлинаИмени) Тогда
			Результат = Результат + ИмяКириллическое;
			Индекс = Индекс + ДлинаИмени;
		Иначе
			Результат = Результат + Сред(Выражение, Индекс, 1);
			Индекс = Индекс + 1;
		КонецЕсли;

	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ИмяФункцииВПозиции(Выражение, Позиция, ДлинаИмени)

	Если Позиция > 1 И ЭтоБукваИдентификатора(Сред(Выражение, Позиция - 1, 1)) Тогда
		Возврат Ложь;
	КонецЕсли;

	ПозицияПосле = Позиция + ДлинаИмени;
	Если ПозицияПосле <= СтрДлина(Выражение) И ЭтоБукваИдентификатора(Сред(Выражение, ПозицияПосле, 1)) Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат Истина;

КонецФункции

// Извлекает латинские идентификаторы операндов (A, B, AA…) из текста формулы.
//
Функция ИдентификаторыВФормуле(Выражение)

	Идентификаторы = Новый Массив;
	Индекс = 1;

	Пока Индекс <= СтрДлина(Выражение) Цикл

		Символ = Сред(Выражение, Индекс, 1);
		Если ЭтоБукваИдентификатора(Символ) Тогда

			Начало = Индекс;
			Пока Индекс <= СтрДлина(Выражение) И ЭтоБукваИдентификатора(Сред(Выражение, Индекс, 1)) Цикл
				Индекс = Индекс + 1;
			КонецЦикла;

			Идентификатор = ВРег(Сред(Выражение, Начало, Индекс - Начало));
			Если Не ЭтоЗарезервированноеИмяФункции(Идентификатор)
				И Идентификаторы.Найти(Идентификатор) = Неопределено Тогда
				Идентификаторы.Добавить(Идентификатор);
			КонецЕсли;

		Иначе
			Индекс = Индекс + 1;
		КонецЕсли;

	КонецЦикла;

	Возврат Идентификаторы;

КонецФункции

Функция ЭтоБукваИдентификатора(Символ)

	Код = КодСимвола(Символ);
	Возврат (Код >= КодСимвола("A") И Код <= КодСимвола("Z"))
		Или (Код >= КодСимвола("a") И Код <= КодСимвола("z"));

КонецФункции

Функция ЭтоЗарезервированноеИмяФункции(ИдентификаторВРег)

	Возврат ИдентификаторВРег = "MIN" Или ИдентификаторВРег = "MAX";

КонецФункции

// Значение операнда для подстановки; отсутствующий в соответствии — 0.
//
Функция ЗначениеОперандаДляФормулы(ЗначенияОперандов, Идентификатор)

	ИдентификаторВРег = ВРег(Идентификатор);
	Значение = ЗначенияОперандов.Получить(ИдентификаторВРег);
	Если Значение <> Неопределено Тогда
		Возврат ЧислоДляФормулы(Значение);
	КонецЕсли;

	Для Каждого КлючИЗначение Из ЗначенияОперандов Цикл
		Если ВРег(КлючИЗначение.Ключ) = ИдентификаторВРег Тогда
			Возврат ЧислоДляФормулы(КлючИЗначение.Значение);
		КонецЕсли;
	КонецЦикла;

	Возврат 0;

КонецФункции

Функция ЧислоДляФормулы(Значение)

	Если Значение = Неопределено Или Значение = Null Тогда
		Возврат 0;
	КонецЕсли;

	Возврат Значение;

КонецФункции

// Заменяет идентификатор целиком (не подстроку внутри другого идентификатора).
//
Функция ЗаменитьИдентификаторВВыражении(Выражение, Идентификатор, ТекстЧисла)

	ИдентификаторВРег = ВРег(Идентификатор);
	ДлинаИдентификатора = СтрДлина(ИдентификаторВРег);
	Результат = "";
	Индекс = 1;

	Пока Индекс <= СтрДлина(Выражение) Цикл

		Если ИдентификаторНачинаетсяВПозиции(Выражение, Индекс, ИдентификаторВРег) Тогда
			Результат = Результат + ТекстЧисла;
			Индекс = Индекс + ДлинаИдентификатора;
		Иначе
			Результат = Результат + Сред(Выражение, Индекс, 1);
			Индекс = Индекс + 1;
		КонецЕсли;

	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ИдентификаторНачинаетсяВПозиции(Выражение, Позиция, Идентификатор)

	ДлинаИдентификатора = СтрДлина(Идентификатор);
	Если ВРег(Сред(Выражение, Позиция, ДлинаИдентификатора)) <> Идентификатор Тогда
		Возврат Ложь;
	КонецЕсли;

	Если Позиция > 1 И ЭтоБукваИдентификатора(Сред(Выражение, Позиция - 1, 1)) Тогда
		Возврат Ложь;
	КонецЕсли;

	ПозицияПосле = Позиция + ДлинаИдентификатора;
	Если ПозицияПосле <= СтрДлина(Выражение) И ЭтоБукваИдентификатора(Сред(Выражение, ПозицияПосле, 1)) Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат Истина;

КонецФункции

Функция ЕстьНезаменённыеИдентификаторы(Выражение)

	Возврат ИдентификаторыВФормуле(Выражение).Количество() > 0;

КонецФункции

Функция ФормулаБезопасна(Выражение)

	ВыражениеПроверки = УдалитьДопустимыеИменаФункций(Выражение);
	ДопустимыеСимволы = "0123456789.+-*/()<>=?, ";

	Для Индекс = 1 По СтрДлина(ВыражениеПроверки) Цикл
		Символ = Сред(ВыражениеПроверки, Индекс, 1);
		Если СтрНайти(ДопустимыеСимволы, Символ) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

// Удаляет из выражения имена разрешённых функций (Мин, Макс, ?) перед проверкой символов.
//
Функция УдалитьДопустимыеИменаФункций(Выражение)

	Результат = Выражение;
	ИменаФункций = Новый Массив;
	ИменаФункций.Добавить("Мин");
	ИменаФункций.Добавить("Макс");
	ИменаФункций.Добавить("мин");
	ИменаФункций.Добавить("макс");
	ИменаФункций.Добавить("Min");
	ИменаФункций.Добавить("Max");
	ИменаФункций.Добавить("MIN");
	ИменаФункций.Добавить("MAX");

	Для Каждого ИмяФункции Из ИменаФункций Цикл
		Результат = СтрЗаменить(Результат, ИмяФункции, "");
	КонецЦикла;

	Возврат Результат;

КонецФункции

Процедура СортироватьИдентификаторыПоДлине(Идентификаторы)

	Для Индекс1 = 0 По Идентификаторы.ВГраница() Цикл
		Для Индекс2 = Индекс1 + 1 По Идентификаторы.ВГраница() Цикл
			Если СтрДлина(Идентификаторы[Индекс2]) > СтрДлина(Идентификаторы[Индекс1]) Тогда
				Временное = Идентификаторы[Индекс1];
				Идентификаторы[Индекс1] = Идентификаторы[Индекс2];
				Идентификаторы[Индекс2] = Временное;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
