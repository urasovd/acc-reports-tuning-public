// Временный hotfix для типовой ошибки «Противоречивая связь #3».
// Удалить после обновления основной конфигурации 1С, если типовой модуль
// начнёт приводить составной Субконто2 к ссылке ДоговорыКонтрагентов сам.

&Вместо("ДополнитьЗапросДаннымиПоСрокамОплаты")
Процедура дбу_ДополнитьЗапросДаннымиПоСрокамОплаты(ТекстЗапроса, ПараметрыСвязи, ПараметрыЗапроса)

	УсловиеДанныеПервичныхДокументов = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(
		"[ИмяТаблицы].[ИмяПоляОрганизация] = ДанныеПервичныхДокументов.Организация И [ИмяТаблицы].[ИмяПоляДокумент] = ДанныеПервичныхДокументов.Документ",
		ПараметрыСвязи);
	УсловиеДоговоры = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(
		"ВЫРАЗИТЬ([ИмяТаблицы].[ИмяПоляДоговор] КАК Справочник.ДоговорыКонтрагентов) = ДоговорыКонтрагентов.Ссылка",
		ПараметрыСвязи);
	УсловиеСрокиОплатыДокументов = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(
		"[ИмяТаблицы].[ИмяПоляОрганизация] = СрокиОплатыДокументов.Организация И [ИмяТаблицы].[ИмяПоляДокумент] = СрокиОплатыДокументов.Документ",
		ПараметрыСвязи);

	ТекстЗапроса = дбу_ДобавитьСоединенияВТекстЗапроса(ТекстЗапроса,
		УсловиеДанныеПервичныхДокументов,
		УсловиеДоговоры,
		УсловиеСрокиОплатыДокументов);
	ТекстЗапроса = дбу_ДобавитьПолеЗапроса(ТекстЗапроса, "ДатаРегистратора",
		"ЕСТЬNULL(ДанныеПервичныхДокументов.ДатаРегистратора, ДАТАВРЕМЯ(1, 1, 1))");

	ТекстЗапроса = дбу_ДобавитьПолеЗапроса(ТекстЗапроса, "ЕстьДокументРасчетов",
		"НЕ ДанныеПервичныхДокументов.ДатаРегистратора ЕСТЬ NULL");

	ТекстЗапроса = дбу_ДобавитьПолеЗапроса(ТекстЗапроса, "СрокОплаты",
		"ВЫБОР
		| КОГДА (ДоговорыКонтрагентов.ВидДоговора В (&ВидыДоговоровПоставщиков)
		|             И &ИспользуютсяСрокиОплатыПоставщикам
		|         ИЛИ ДоговорыКонтрагентов.ВидДоговора В (&ВидыДоговоровПокупателей)
		|             И &ИспользуютсяСрокиОплатыПокупателей)
		|     И СрокиОплатыДокументов.СрокОплаты <> ДАТАВРЕМЯ(1, 1, 1)
		|     ТОГДА СрокиОплатыДокументов.СрокОплаты
		| КОГДА ДоговорыКонтрагентов.УстановленСрокОплаты
		|     И ДоговорыКонтрагентов.ДатаОплаты <> ДАТАВРЕМЯ(1, 1, 1)
		|     ТОГДА ДоговорыКонтрагентов.ДатаОплаты
		| КОГДА НЕ ДанныеПервичныхДокументов.ДатаРегистратора ЕСТЬ NULL
		|     И ВЫБОР
		|         КОГДА ДоговорыКонтрагентов.УстановленСрокОплаты
		|             ТОГДА ДоговорыКонтрагентов.СрокОплаты
		|         КОГДА ДоговорыКонтрагентов.ВидДоговора В (&ВидыДоговоровПокупателей)
		|             ТОГДА &СрокОплатыПокупателей
		|         КОГДА ДоговорыКонтрагентов.ВидДоговора В (&ВидыДоговоровПоставщиков)
		|             ТОГДА &СрокОплатыПоставщикам
		|         ИНАЧЕ 0
		|       КОНЕЦ <> 0
		|     ТОГДА ДОБАВИТЬКДАТЕ(ДанныеПервичныхДокументов.ДатаРегистратора, ДЕНЬ, ВЫБОР
		|         КОГДА ДоговорыКонтрагентов.УстановленСрокОплаты
		|             ТОГДА ДоговорыКонтрагентов.СрокОплаты
		|         КОГДА ДоговорыКонтрагентов.ВидДоговора В (&ВидыДоговоровПокупателей)
		|             ТОГДА &СрокОплатыПокупателей
		|         КОГДА ДоговорыКонтрагентов.ВидДоговора В (&ВидыДоговоровПоставщиков)
		|             ТОГДА &СрокОплатыПоставщикам
		|         ИНАЧЕ 0
		|       КОНЕЦ)
		| ИНАЧЕ ДАТАВРЕМЯ(1, 1, 1)
		| КОНЕЦ");

	ТекстЗапроса = дбу_ДобавитьПолеЗапроса(ТекстЗапроса, "ИсточникСрокаОплаты",
		"ВЫБОР
		| КОГДА (ДоговорыКонтрагентов.ВидДоговора В (&ВидыДоговоровПоставщиков)
		|             И &ИспользуютсяСрокиОплатыПоставщикам
		|         ИЛИ ДоговорыКонтрагентов.ВидДоговора В (&ВидыДоговоровПокупателей)
		|             И &ИспользуютсяСрокиОплатыПокупателей)
		|     И СрокиОплатыДокументов.СрокОплаты <> ДАТАВРЕМЯ(1, 1, 1)
		|     ТОГДА СрокиОплатыДокументов.Документ
		| КОГДА ДоговорыКонтрагентов.УстановленСрокОплаты
		|     И ДоговорыКонтрагентов.ДатаОплаты <> ДАТАВРЕМЯ(1, 1, 1)
		|     ТОГДА ДоговорыКонтрагентов.Ссылка
		| КОГДА НЕ ДанныеПервичныхДокументов.ДатаРегистратора ЕСТЬ NULL
		|     И ВЫБОР
		|         КОГДА ДоговорыКонтрагентов.УстановленСрокОплаты
		|             ТОГДА ДоговорыКонтрагентов.СрокОплаты
		|         ИНАЧЕ 0
		|       КОНЕЦ <> 0
		|     ТОГДА ДоговорыКонтрагентов.Ссылка
		| КОГДА НЕ ДанныеПервичныхДокументов.ДатаРегистратора ЕСТЬ NULL
		|     И ВЫБОР
		|         КОГДА ДоговорыКонтрагентов.ВидДоговора В (&ВидыДоговоровПокупателей)
		|             ТОГДА &СрокОплатыПокупателей
		|         КОГДА ДоговорыКонтрагентов.ВидДоговора В (&ВидыДоговоровПоставщиков)
		|             ТОГДА &СрокОплатыПоставщикам
		|         ИНАЧЕ 0
		|       КОНЕЦ <> 0
		|     ТОГДА ""Настройка сроков оплаты""
		| ИНАЧЕ НЕОПРЕДЕЛЕНО
		| КОНЕЦ");

	ПараметрыЗапроса.Вставить("ИспользуютсяСрокиОплатыПокупателей", ПолучитьФункциональнуюОпцию("ИспользоватьПланированиеПлатежейОтПокупателей"));
	ПараметрыЗапроса.Вставить("ВидыДоговоровПокупателей", БухгалтерскиеОтчеты.ВидыДоговоровПокупателей());
	ПараметрыЗапроса.Вставить("СрокОплатыПокупателей", Константы.СрокОплатыПокупателей.Получить());
	ПараметрыЗапроса.Вставить("ИспользуютсяСрокиОплатыПоставщикам", ПолучитьФункциональнуюОпцию("ИспользоватьПланированиеПлатежейПоставщикам"));
	ПараметрыЗапроса.Вставить("ВидыДоговоровПоставщиков", БухгалтерскиеОтчеты.ВидыДоговоровПоставщиков());
	ПараметрыЗапроса.Вставить("СрокОплатыПоставщикам", Константы.СрокОплатыПоставщикам.Получить());

КонецПроцедуры

Функция дбу_ДобавитьСоединенияВТекстЗапроса(ТекстЗапроса, УсловиеДанныеПервичныхДокументов, УсловиеДоговоры, УсловиеСрокиОплатыДокументов)
	Соединения = СтрШаблон(
		" ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДанныеПервичныхДокументов КАК ДанныеПервичныхДокументов ПО %1 ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов ПО %2 ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СрокиОплатыДокументов КАК СрокиОплатыДокументов ПО %3 ",
		УсловиеДанныеПервичныхДокументов,
		УсловиеДоговоры,
		УсловиеСрокиОплатыДокументов);

	// В типовой конфигурации встречаются запросы и без раздела ГДЕ.
	// Соединения должны располагаться после источников и до группировки,
	// сортировки или других завершающих операторов запроса.
	ТекстЗапросаВРегистре = ВРег(ТекстЗапроса);
	Позиция = 0;
	РазделыЗапроса = Новый Массив;
	РазделыЗапроса.Добавить("ГДЕ");
	РазделыЗапроса.Добавить("СГРУППИРОВАТЬ ПО");
	РазделыЗапроса.Добавить("ИМЕЮЩИЕ");
	РазделыЗапроса.Добавить("УПОРЯДОЧИТЬ ПО");
	РазделыЗапроса.Добавить("ОБЪЕДИНИТЬ");
	Для Каждого РазделЗапроса Из РазделыЗапроса Цикл
		ПозицияРаздела = СтрНайти(ТекстЗапросаВРегистре, РазделЗапроса);
		Если ПозицияРаздела > 0 И (Позиция = 0 ИЛИ ПозицияРаздела < Позиция) Тогда
			Позиция = ПозицияРаздела;
		КонецЕсли;
	КонецЦикла;

	Если Позиция = 0 Тогда
		Возврат ТекстЗапроса + Соединения;
	КонецЕсли;

	Возврат Лев(ТекстЗапроса, Позиция - 1) + Соединения + Сред(ТекстЗапроса, Позиция);
КонецФункции

Функция дбу_ДобавитьПолеЗапроса(ТекстЗапроса, Псевдоним, Выражение)
	// Конструктор схемы не используется: платформа падает при добавлении связи
	// для составного Субконто2 ещё до выполнения запроса. Все добавления
	// выполняются в тексте запроса после исходного списка полей.
	Выражение = СтрЗаменить(Выражение, "|", " ");
	Выражение = СтрЗаменить(Выражение, Символы.ПС, " ");
	Поле = СтрШаблон(", %1 КАК %2 ", Выражение, Псевдоним);

	Позиция = СтрНайти(ВРег(ТекстЗапроса), "ПОМЕСТИТЬ");
	Если Позиция = 0 Тогда
		Позиция = СтрНайти(ВРег(ТекстЗапроса), "ИЗ");
	КонецЕсли;
	Если Позиция = 0 Тогда
		ВызватьИсключение "Не найден конец списка полей запроса классификации задолженности";
	КонецЕсли;

	Возврат Лев(ТекстЗапроса, Позиция - 1) + Поле + Сред(ТекстЗапроса, Позиция);
КонецФункции
