// Клиентские вызовы расшифровки формулы КДР (уровень 2).
// Не вызывает серверный дбу_Расшифровка — только открытие формы.

#Область ПрограммныйИнтерфейс

// Открывает форму расшифровки формулы по ДополнительныеПараметры строки КДР.
//
Процедура ОткрытьРасшифровкуФормулы(ДополнительныеПараметры) Экспорт

	Если Не ЭтоПакетРасшифровкиФормулы(ДополнительныеПараметры) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Нет данных расшифровки формулы КДР.'"));
		Возврат;
	КонецЕсли;

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ДополнительныеПараметры", ДополнительныеПараметры);

	ОткрытьФорму(
		"Справочник.дбу_ПравилаДоработки.Форма.ФормаРасшифровкиФормулы",
		ПараметрыФормы,
		,
		Истина);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЭтоПакетРасшифровкиФормулы(ДополнительныеПараметры)

	Если ТипЗнч(ДополнительныеПараметры) <> Тип("Структура") Тогда
		Возврат Ложь;
	КонецЕсли;

	Флаг = Ложь;
	Возврат ДополнительныеПараметры.Свойство("ЭтоРасшифровкаФормулыКДР", Флаг) И Флаг = Истина;

КонецФункции

#КонецОбласти
