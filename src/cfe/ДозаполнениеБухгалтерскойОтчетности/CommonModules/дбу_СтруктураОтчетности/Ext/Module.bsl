// Строки регламентированной бухотчётности читаются из макета формы 2025Кв1.

// План: docs/urdv-dozapolnenie-buh-otchetnosti/01-план.md § 3.5

#Область ПрограммныйИнтерфейс



// Версия формы отчёта, из макета которой читаются строки.

//

// Возвращаемое значение:

//  Строка

//

Функция ВерсияФормыПоУмолчанию() Экспорт



	Возврат "2025Кв1";



КонецФункции



// Формирует имя показателя движка отчёта (П000010{код}{графа}).

//

// Параметры:

//  КодСтроки - Строка

//  КолонкаПоказателя - ПеречислениеСсылка.дбу_КолонкиПоказателя

//

// Возвращаемое значение:

//  Строка

//

Функция ИмяПоказателя(КодСтроки, КолонкаПоказателя) Экспорт



	Возврат "П000010" + КодСтроки + НомерКолонкиПоказателя(КолонкаПоказателя);



КонецФункции

// Возвращает семантический вид цели. Пустое значение в старых правилах
// означает стандартную строку и не требует миграции данных.
//
Функция ВидСтрокиЦели(СтрокаЦели) Экспорт

	Если Не ЗначениеЗаполнено(СтрокаЦели.ВидСтрокиОтчетности) Тогда
		Возврат Перечисления.дбу_ВидыСтрокОтчетности.Стандартная;
	КонецЕсли;

	Возврат СтрокаЦели.ВидСтрокиОтчетности;

КонецФункции

// Возвращает единый адрес цели без изменения сохраненной строки.
// Пустая версия адреса совместима с моделью стандартной строки.
//
Функция АдресСтрокиЦели(СтрокаЦели) Экспорт

	ВерсияАдреса = СтрокаЦели.ВерсияАдреса;
	Если Не ЗначениеЗаполнено(ВерсияАдреса) Тогда
		ВерсияАдреса = 1;
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("ВерсияАдреса", ВерсияАдреса);
	Результат.Вставить("ВидСтрокиОтчетности", ВидСтрокиЦели(СтрокаЦели));
	Результат.Вставить("КодСтрокиФСБУ", СокрЛП(СтрокаЦели.КодСтрокиФСБУ));
	Результат.Вставить("НаименованиеСтроки", СокрЛП(СтрокаЦели.НаименованиеСтроки));
	Результат.Вставить("КодСтрокиВОтчете", СокрЛП(СтрокаЦели.КодСтрокиВОтчете));
	Результат.Вставить("НаименованиеРодительскойСтроки", СокрЛП(СтрокаЦели.НаименованиеРодительскойСтроки));
	Результат.Вставить("КодРодительскойСтроки", СокрЛП(СтрокаЦели.КодРодительскойСтроки));
	Результат.Вставить("ТехническийВидМСЧ", СокрЛП(СтрокаЦели.ТехническийВидМСЧ));

	Возврат Результат;

КонецФункции

// Проверяет семантическую форму сохраненного адреса до записи правила.
// Наличие строки в конкретном экземпляре отчета проверяется resolver-ом;
// здесь проверяются обязательные части адреса и совместимость вида МСЧ.
//
// Возвращаемое значение:
//  Структура - Успех, Поле, ТекстОшибки
//
Функция ПроверитьАдресСтрокиЦели(Раздел, СтрокаЦели) Экспорт

	Адрес = АдресСтрокиЦели(СтрокаЦели);
	Результат = Новый Структура("Успех,Поле,ТекстОшибки", Истина, "", "");

	Если Адрес.ВерсияАдреса <> 1 Тогда
		Возврат ОшибкаАдресаЦели("ВерсияАдреса", "Поддерживается только версия адреса 1.");
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Адрес.КодСтрокиФСБУ) Тогда
		Возврат ОшибкаАдресаЦели("КодСтрокиФСБУ", "Для цели не указан базовый код строки ФСБУ.");
	КонецЕсли;

	Описание = ОписаниеСтроки(Раздел, Адрес.КодСтрокиФСБУ);
	Если (Раздел = Перечисления.дбу_РазделыБухОтчетности.Баланс
		Или Раздел = Перечисления.дбу_РазделыБухОтчетности.ОФР)
		И Описание = Неопределено Тогда
		Возврат ОшибкаАдресаЦели("КодСтрокиФСБУ",
			"Базовый код строки отсутствует в доступном макете отчета.");
	КонецЕсли;

	ВидСтроки = Адрес.ВидСтрокиОтчетности;
	Если ВидСтроки = Перечисления.дбу_ВидыСтрокОтчетности.Стандартная Тогда
		Если ЗначениеЗаполнено(Адрес.НаименованиеСтроки)
			Или ЗначениеЗаполнено(Адрес.КодСтрокиВОтчете)
			Или ЗначениеЗаполнено(Адрес.НаименованиеРодительскойСтроки)
			Или ЗначениеЗаполнено(Адрес.КодРодительскойСтроки)
			Или ЗначениеЗаполнено(Адрес.ТехническийВидМСЧ) Тогда
			Возврат ОшибкаАдресаЦели("ВидСтрокиОтчетности",
				"Для стандартной строки нельзя указывать реквизиты МСЧ.");
		КонецЕсли;
	Иначе
		Если Не ЗначениеЗаполнено(Адрес.НаименованиеСтроки) Тогда
			Возврат ОшибкаАдресаЦели("НаименованиеСтроки",
				"Для строки МСЧ обязательно наименование.");
		КонецЕсли;
		Если НормализоватьТекст(Адрес.НаименованиеСтроки) = "В ТОМ ЧИСЛЕ:" Тогда
			Возврат ОшибкаАдресаЦели("НаименованиеСтроки",
				"Заголовок «в том числе:» не является целью.");
		КонецЕсли;
	КонецЕсли;
	Если ВидСтроки = Перечисления.дбу_ВидыСтрокОтчетности.Стандартная Тогда
		Возврат Результат;
	КонецЕсли;

	Если ВидСтроки = Перечисления.дбу_ВидыСтрокОтчетности.ПрямаяРасшифровка Тогда
		Если ЗначениеЗаполнено(Адрес.НаименованиеРодительскойСтроки)
			Или ЗначениеЗаполнено(Адрес.КодРодительскойСтроки) Тогда
			Возврат ОшибкаАдресаЦели("НаименованиеРодительскойСтроки",
				"Для прямой расшифровки родительская строка не указывается.");
		КонецЕсли;
		Возврат ПроверитьТехническийВидМСЧ(Адрес, "П100010");
	ИначеЕсли ВидСтроки = Перечисления.дбу_ВидыСтрокОтчетности.Вписанная Тогда
		Если ЗначениеЗаполнено(Адрес.КодСтрокиВОтчете)
			Или ЗначениеЗаполнено(Адрес.НаименованиеРодительскойСтроки)
			Или ЗначениеЗаполнено(Адрес.КодРодительскойСтроки) Тогда
			Возврат ОшибкаАдресаЦели("КодСтрокиВОтчете",
				"Для вписанной строки код и родительская строка не указываются.");
		КонецЕсли;
		Возврат ПроверитьТехническийВидМСЧ(Адрес, "П10001А");
	ИначеЕсли ВидСтроки = Перечисления.дбу_ВидыСтрокОтчетности.ВложеннаяРасшифровка Тогда
		Если Не ЗначениеЗаполнено(Адрес.НаименованиеРодительскойСтроки) Тогда
			Возврат ОшибкаАдресаЦели("НаименованиеРодительскойСтроки",
				"Для вложенной расшифровки обязательно имя родительской строки.");
		КонецЕсли;
		Возврат ПроверитьТехническийВидМСЧ(Адрес, "П10001Б");
	Иначе
		Возврат ОшибкаАдресаЦели("ВидСтрокиОтчетности", "Неизвестный вид строки отчетности.");
	КонецЕсли;

КонецФункции

Функция ОшибкаАдресаЦели(Поле, ТекстОшибки)

	Возврат Новый Структура("Успех,Поле,ТекстОшибки", Ложь, Поле, ТекстОшибки);

КонецФункции

Функция ПроверитьТехническийВидМСЧ(Адрес, ОжидаемыйВид)

	Если ЗначениеЗаполнено(Адрес.ТехническийВидМСЧ)
		И НормализоватьТекст(Адрес.ТехническийВидМСЧ) <> ВРег(ОжидаемыйВид) Тогда
		Возврат ОшибкаАдресаЦели("ТехническийВидМСЧ",
			"Технический вид МСЧ не соответствует выбранному виду строки.");
	КонецЕсли;

	Возврат Новый Структура("Успех,Поле,ТекстОшибки", Истина, "", "");

КонецФункции



// Возвращает колонки показателя, к которым применяется цель правила.
//
// Пустая колонка и «Все периоды» — все графы раздела (для ОФР без 06).
//
Функция КолонкиДляПрименения(КолонкаПоказателя, Раздел) Экспорт

	Результат = Новый Массив;

	Если Не ЗначениеЗаполнено(КолонкаПоказателя)
		Или КолонкаПоказателя = Перечисления.дбу_КолонкиПоказателя.ВсеПериоды Тогда

		Результат.Добавить(Перечисления.дбу_КолонкиПоказателя.Колонка04);
		Результат.Добавить(Перечисления.дбу_КолонкиПоказателя.Колонка05);

		Если Раздел <> Перечисления.дбу_РазделыБухОтчетности.ОФР Тогда
			Результат.Добавить(Перечисления.дбу_КолонкиПоказателя.Колонка06);
		КонецЕсли;

	Иначе
		Результат.Добавить(КолонкаПоказателя);
	КонецЕсли;

	Возврат Результат;

КонецФункции



// Параметры расчёта операндов для графы отчёта (как в типовом заполнении 2025Кв1).
//
Функция ПараметрыРасчетаДляКолонки(ПараметрыРасчета, КолонкаПоказателя) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Организация", ПараметрыРасчета.Организация);

	НачалоОтчета = ПараметрыРасчета.НачалоПериода;
	КонецОтчета = КонецДня(ПараметрыРасчета.КонецПериода);

	Если КолонкаПоказателя = Перечисления.дбу_КолонкиПоказателя.Колонка04 Тогда

		Результат.Вставить("НачалоПериода", НачалоОтчета);
		Результат.Вставить("КонецПериода", КонецОтчета);

	ИначеЕсли КолонкаПоказателя = Перечисления.дбу_КолонкиПоказателя.Колонка05 Тогда

		НачалоПредыдущегоГода = НачалоГода(ДобавитьМесяц(НачалоОтчета, -12));
		КонецПредыдущегоГода = КонецДня(КонецГода(НачалоПредыдущегоГода));
		Результат.Вставить("НачалоПериода", НачалоПредыдущегоГода);
		Результат.Вставить("КонецПериода", КонецПредыдущегоГода);

	ИначеЕсли КолонкаПоказателя = Перечисления.дбу_КолонкиПоказателя.Колонка06 Тогда

		НачалоПредыдущегоГода = НачалоГода(ДобавитьМесяц(НачалоОтчета, -12));
		НачалоГодаПредшествующегоПредыдущему = НачалоГода(ДобавитьМесяц(НачалоПредыдущегоГода, -12));
		КонецГодаПредшествующегоПредыдущему = КонецДня(КонецГода(НачалоГодаПредшествующегоПредыдущему));
		Результат.Вставить("НачалоПериода", НачалоГодаПредшествующегоПредыдущему);
		Результат.Вставить("КонецПериода", КонецГодаПредшествующегоПредыдущему);

	Иначе
		ВызватьИсключение НСтр("ru = 'Неизвестная колонка показателя для расчёта периода.'");
	КонецЕсли;

	Возврат Результат;

КонецФункции



// Строки баланса и ОФР из макета регламентированного отчёта. В базу не записываются.
//
Функция ОписанияСтрок(ВерсияФормы = "") Экспорт

	Если Не ЗначениеЗаполнено(ВерсияФормы) Тогда
		ВерсияФормы = ВерсияФормыПоУмолчанию();
	КонецЕсли;

	ОписанияСтрок = Новый Соответствие;
	Для Каждого ОписаниеРаздела Из РазделыДляИмпорта() Цикл
		ДополнитьСтрокиИзМакета(ВерсияФормы, ОписаниеРаздела, ОписанияСтрок);
	КонецЦикла;
	ПрименитьПризнакиСтрокГруппы(ОписанияСтрок);
	Возврат ОписанияСтрок;

КонецФункции

// Описание рабочей строки раздела. Неопределено, если кода нет или строку нельзя выбрать.
//
Функция ОписаниеСтроки(Раздел, КодСтроки, ВерсияФормы = "") Экспорт

	Код = СокрЛП(КодСтроки);
	Если Не ЗначениеЗаполнено(Код) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Описание = ОписанияСтрок(ВерсияФормы).Получить(КлючСтроки(Раздел, Код));
	Если Описание = Неопределено Или Не СтрокаДоступнаДляВыбора(Описание) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Описание;

КонецФункции

Функция СтрокаДоступнаДляВыбора(Описание)

	Возврат Не Описание.ЭтоИтоговаяСтрока И Описание.Доступна;

КонецФункции



// Возвращает имя раздела отчёта по значению перечисления.
//
Функция ИмяРазделаОтчета(Раздел) Экспорт

	Если Раздел = Перечисления.дбу_РазделыБухОтчетности.Баланс Тогда
		Возврат "Баланс";
	ИначеЕсли Раздел = Перечисления.дбу_РазделыБухОтчетности.ОФР Тогда
		Возврат "ОФР";
	ИначеЕсли Раздел = Перечисления.дбу_РазделыБухОтчетности.ОДДС Тогда
		Возврат "ОДДС";
	КонецЕсли;

	ВызватьИсключение НСтр("ru = 'Неподдерживаемый раздел отчётности для доработки.'");

КонецФункции

// Возвращает раздел бухотчётности по имени страницы формы отчёта.
// Для неподдерживаемых страниц (пояснения, титульный и т.п.) — Неопределено.
//
Функция РазделБухОтчетностиПоИмени(ИмяРаздела) Экспорт

	Если ИмяРаздела = "Баланс" Тогда
		Возврат Перечисления.дбу_РазделыБухОтчетности.Баланс;
	ИначеЕсли ИмяРаздела = "ОФР" Тогда
		Возврат Перечисления.дбу_РазделыБухОтчетности.ОФР;
	ИначеЕсли ИмяРаздела = "ОДДС" Тогда
		Возврат Перечисления.дбу_РазделыБухОтчетности.ОДДС;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции



// Возвращает адресуемые строки раздела из фактического дерева отчёта.
// В результат не попадают заголовки и позиционные индексы строк.
//
Функция ПеречислитьДоступныеСтроки(ДеревоДанныхРазделов, Раздел) Экспорт

	Результат = Новый Массив;
	Ключи = Новый Соответствие;
	РазделОтчета = РазделДерева(ДеревоДанныхРазделов, ИмяРазделаОтчета(Раздел));
	Если РазделОтчета = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Узлы = Новый Массив;
	СобратьУзлы(РазделОтчета.Строки, "Показатель", "", Узлы, "");
	Для Каждого НайденныйУзел Из Узлы Цикл
		Идентификатор = НайденныйУзел.Строка.Идентификатор;
		Если Лев(Идентификатор, 7) <> "П000010" Тогда
			Продолжить;
		КонецЕсли;
		Суффикс = Сред(Идентификатор, 8);
		НомерКолонки = Прав(Суффикс, 2);
		Если НомерКолонки <> "04" И НомерКолонки <> "05" И НомерКолонки <> "06" Тогда
			Продолжить;
		КонецЕсли;
		КодСтроки = Лев(Суффикс, СтрДлина(Суффикс) - 2);
		Если Не СтандартнаяСтрокаДоступнаВВыборе(Раздел, КодСтроки) Тогда
			Продолжить;
		КонецЕсли;
		ДобавитьАдресВРезультат(Результат, Ключи,
			Перечисления.дбу_ВидыСтрокОтчетности.Стандартная,
			КодСтроки, "", "", "", "", "");
	КонецЦикла;

	УзлыМСЧ = Новый Массив;
	СобратьУзлы(РазделОтчета.Строки, "МногострочнаяЧасть", "", УзлыМСЧ, "");
	Для Каждого НайденныйУзел Из УзлыМСЧ Цикл
		ИдентификаторМСЧ = НайденныйУзел.Строка.Идентификатор;
		Если Лев(ИдентификаторМСЧ, 7) = "П100010" Тогда
			ДобавитьАдресаМСЧ(Результат, Ключи, НайденныйУзел.Строка,
				Перечисления.дбу_ВидыСтрокОтчетности.ПрямаяРасшифровка,
				Сред(ИдентификаторМСЧ, 8), "", Ложь);
		ИначеЕсли Лев(ИдентификаторМСЧ, 7) = "П10001А" Тогда
			ДобавитьАдресаМСЧ(Результат, Ключи, НайденныйУзел.Строка,
				Перечисления.дбу_ВидыСтрокОтчетности.Вписанная,
				Сред(ИдентификаторМСЧ, 8), "", Истина);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция СтандартнаяСтрокаДоступнаВВыборе(Раздел, КодСтроки)

	Описания = ОписанияСтрок();
	Описание = Описания.Получить(КлючСтроки(Раздел, КодСтроки));
	Если Описание = Неопределено Тогда
		// Для раздела, у которого ещё нет описаний в локальном макете,
		// фактическое дерево остаётся источником доступных строк.
		Возврат Истина;
	КонецЕсли;

	Возврат СтрокаДоступнаДляВыбора(Описание);

КонецФункции

// Единая точка разрешения адреса в фактическом дереве отчёта.
// При нуле или нескольких совпадениях дерево не изменяется.
//
Функция РазрешитьАдресПоказателя(ДеревоДанныхРазделов, Раздел, Адрес, Колонка) Экспорт

	Результат = НовыйРезультатРазрешения(Адрес);
	РазделОтчета = РазделДерева(ДеревоДанныхРазделов, ИмяРазделаОтчета(Раздел));
	Если РазделОтчета = Неопределено Тогда
		Результат.Диагностика = "Раздел отчёта не найден или неоднозначен.";
		Возврат Результат;
	КонецЕсли;

	ВидСтроки = ВидАдреса(Адрес);
	КодСтроки = СокрЛП(Адрес.КодСтрокиФСБУ);
	Если ВидСтроки = Перечисления.дбу_ВидыСтрокОтчетности.Стандартная Тогда
		РазрешитьСтандартнуюСтроку(Результат, РазделОтчета, КодСтроки, Колонка);
	ИначеЕсли ВидСтроки = Перечисления.дбу_ВидыСтрокОтчетности.ПрямаяРасшифровка Тогда
		РазрешитьМСЧ(Результат, РазделОтчета, "П100010" + КодСтроки,
			Адрес.НаименованиеСтроки, Адрес.КодСтрокиВОтчете, Колонка, Ложь);
	ИначеЕсли ВидСтроки = Перечисления.дбу_ВидыСтрокОтчетности.Вписанная Тогда
		Если ЗначениеЗаполнено(Адрес.КодСтрокиВОтчете) Тогда
			Результат.Статус = "Неподдерживается";
			Результат.Диагностика = "У вписанной строки код дополнительной строки отсутствует.";
			Возврат Результат;
		КонецЕсли;
		РазрешитьМСЧ(Результат, РазделОтчета, "П10001А" + КодСтроки,
			Адрес.НаименованиеСтроки, "", Колонка, Истина);
	ИначеЕсли ВидСтроки = Перечисления.дбу_ВидыСтрокОтчетности.ВложеннаяРасшифровка Тогда
		РазрешитьВложеннуюСтроку(Результат, РазделОтчета, Адрес, Колонка);
	Иначе
		Результат.Статус = "Неподдерживается";
		Результат.Диагностика = "Неизвестный вид строки отчётности.";
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Возвращает строку показателя в дереве раздела.
//
Функция СтрокаПоказателяВДереве(ДеревоДанныхРазделов, ИмяРаздела, ИмяПоказателя) Экспорт

	РазделОтчета = РазделДерева(ДеревоДанныхРазделов, ИмяРаздела);
	Если РазделОтчета = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	ПараметрыПоиска = Новый Структура("Тип, Идентификатор", "Показатель", ИмяПоказателя);
	СтрокиПоказателей = РазделОтчета.Строки.НайтиСтроки(ПараметрыПоиска);

	Если СтрокиПоказателей.Количество() <> 1 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат СтрокиПоказателей[0];

КонецФункции



// Возвращает текущее значение показателя в дереве раздела.
//
Функция ЗначениеПоказателяВДереве(ДеревоДанныхРазделов, ИмяРаздела, ИмяПоказателя) Экспорт

	СтрокаПоказателя = СтрокаПоказателяВДереве(ДеревоДанныхРазделов, ИмяРаздела, ИмяПоказателя);
	Если СтрокаПоказателя = Неопределено Тогда
		Возврат 0;
	КонецЕсли;

	Возврат ?(ЗначениеЗаполнено(СтрокаПоказателя.Данные), СтрокаПоказателя.Данные, 0);

КонецФункции



// Устанавливает значение показателя с учётом действия.
//
// Возвращаемое значение:
//  Булево - Истина, если показатель найден и изменён
//
Функция УстановитьЗначениеПоказателяВДереве(ДеревоДанныхРазделов, ИмяРаздела, ИмяПоказателя, Значение, Действие) Экспорт

	СтрокаПоказателя = СтрокаПоказателяВДереве(ДеревоДанныхРазделов, ИмяРаздела, ИмяПоказателя);
	Если СтрокаПоказателя = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	ТекущееЗначение = ?(ЗначениеЗаполнено(СтрокаПоказателя.Данные), СтрокаПоказателя.Данные, 0);

	Если Действие = Перечисления.дбу_ДействияСПоказателем.Заменить Тогда
		НовоеЗначение = Значение;
	ИначеЕсли Действие = Перечисления.дбу_ДействияСПоказателем.Добавить Тогда
		НовоеЗначение = ТекущееЗначение + Значение;
	ИначеЕсли Действие = Перечисления.дбу_ДействияСПоказателем.УменьшитьТиповое Тогда
		НовоеЗначение = ТекущееЗначение - Значение;
	Иначе
		НовоеЗначение = ТекущееЗначение + Значение;
	КонецЕсли;

	СтрокаПоказателя.Данные = НовоеЗначение;
	Возврат Истина;

КонецФункции



// Дерево рабочих строк раздела из макета отчёта. Итоги и скрытые коды не показываются,
// их дочерние строки остаются в корне, чтобы список не пустел.
//
Функция ДеревоСтрокДляВыбора(Раздел, ВерсияФормы = "",
	ДеревоДанныхРазделов = Неопределено) Экспорт

	Если Не ЗначениеЗаполнено(ВерсияФормы) Тогда
		ВерсияФормы = ВерсияФормыПоУмолчанию();
	КонецЕсли;

	Дерево = Новый ДеревоЗначений;
	Дерево.Колонки.Добавить("КодСтроки");
	Дерево.Колонки.Добавить("Наименование");
	Дерево.Колонки.Добавить("ЭтоГруппа", Новый ОписаниеТипов("Булево"));
	Дерево.Колонки.Добавить("Доступна", Новый ОписаниеТипов("Булево"));
	Дерево.Колонки.Добавить("ВидСтрокиОтчетности");
	Дерево.Колонки.Добавить("ПолныйПуть");
	Дерево.Колонки.Добавить("Диагностика");
	Дерево.Колонки.Добавить("ВерсияАдреса");
	Дерево.Колонки.Добавить("НаименованиеСтроки");
	Дерево.Колонки.Добавить("КодСтрокиВОтчете");
	Дерево.Колонки.Добавить("НаименованиеРодительскойСтроки");
	Дерево.Колонки.Добавить("КодРодительскойСтроки");
	Дерево.Колонки.Добавить("ТехническийВидМСЧ");

	Если ДеревоДанныхРазделов <> Неопределено Тогда
		Адреса = ПеречислитьДоступныеСтроки(ДеревоДанныхРазделов, Раздел);
		ЗаполнитьДеревоВыбораПоАдресам(Дерево, Раздел, Адреса, ДеревоДанныхРазделов);
		ПометитьГруппыДереваСтрок(Дерево.Строки);
		Возврат Дерево;
	КонецЕсли;

	Описания = ОписанияСтрок(ВерсияФормы);
	Узлы = Новый Соответствие;
	Ожидающие = Новый Массив;

	Для Каждого КлючИЗначение Из Описания Цикл
		Описание = КлючИЗначение.Значение;
		Если Описание.Раздел <> Раздел Или Не СтрокаДоступнаДляВыбора(Описание) Тогда
			Продолжить;
		КонецЕсли;
		Если РодительДоступенДляВыбора(Описания, Раздел, Описание.КодРодителя) Тогда
			Ожидающие.Добавить(Описание);
			Продолжить;
		КонецЕсли;
		Узел = Дерево.Строки.Добавить();
		ЗаполнитьУзелСтроки(Узел, Описание);
		Узлы.Вставить(Описание.КодСтроки, Узел);
	КонецЦикла;

	Для Каждого Описание Из Ожидающие Цикл
		УзелРодителя = Узлы.Получить(Описание.КодРодителя);
		Если УзелРодителя = Неопределено Тогда
			Узел = Дерево.Строки.Добавить();
		Иначе
			Узел = УзелРодителя.Строки.Добавить();
		КонецЕсли;
		ЗаполнитьУзелСтроки(Узел, Описание);
		Узлы.Вставить(Описание.КодСтроки, Узел);
	КонецЦикла;

	ПометитьГруппыДереваСтрок(Дерево.Строки);
	Возврат Дерево;

КонецФункции

Процедура ЗаполнитьУзелСтроки(Узел, Описание)

	Узел.КодСтроки = Описание.КодСтроки;
	Узел.Наименование = Описание.Наименование;
	Узел.ЭтоГруппа = Ложь;
	Узел.Доступна = Описание.Доступна;
	Узел.ВидСтрокиОтчетности = Перечисления.дбу_ВидыСтрокОтчетности.Стандартная;
	Узел.ПолныйПуть = СтрШаблон("%1 — %2 (стандартная)",
		Описание.КодСтроки, Описание.Наименование);
	Узел.Диагностика = "";
	Узел.ВерсияАдреса = 1;
	Узел.НаименованиеСтроки = "";
	Узел.КодСтрокиВОтчете = "";
	Узел.НаименованиеРодительскойСтроки = "";
	Узел.КодРодительскойСтроки = "";
	Узел.ТехническийВидМСЧ = "";

КонецПроцедуры

Процедура ЗаполнитьДеревоВыбораПоАдресам(Дерево, Раздел, Адреса, ДеревоДанныхРазделов)

	Узлы = Новый Соответствие;
	Для Каждого Адрес Из Адреса Цикл
		Если Адрес.ВидСтрокиОтчетности = Перечисления.дбу_ВидыСтрокОтчетности.Стандартная Тогда
			Ключ = КлючУзлаСтандартнойСтроки(Адрес.КодСтрокиФСБУ);
			Узел = Узлы.Получить(Ключ);
			Если Узел = Неопределено Тогда
				Узел = Дерево.Строки.Добавить();
				ЗаполнитьУзелАдресом(Узел, Адрес, СтрокаДляАдреса(Раздел, Адрес), Раздел,
					ДеревоДанныхРазделов);
				Узлы.Вставить(Ключ, Узел);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Для Каждого Адрес Из Адреса Цикл
		Если Адрес.ВидСтрокиОтчетности = Перечисления.дбу_ВидыСтрокОтчетности.Стандартная
			Или Адрес.ВидСтрокиОтчетности = Перечисления.дбу_ВидыСтрокОтчетности.ВложеннаяРасшифровка Тогда
			Продолжить;
		КонецЕсли;

		КлючРодителя = КлючУзлаСтандартнойСтроки(Адрес.КодСтрокиФСБУ);
		УзелРодителя = Узлы.Получить(КлючРодителя);
		Если УзелРодителя = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Узел = УзелРодителя.Строки.Добавить();
		ПолныйПуть = УзелРодителя.ПолныйПуть + " / " + ПредставлениеАдреса(Адрес, Раздел);
		ЗаполнитьУзелАдресом(Узел, Адрес, ПолныйПуть, Раздел, ДеревоДанныхРазделов);
		Узлы.Вставить(КлючУзлаАдреса(Адрес), Узел);
	КонецЦикла;

	// Вложенная расшифровка добавляется только после своего конкретного
	// родителя П10001А, независимо от порядка узлов типовой формы.
	Для Каждого Адрес Из Адреса Цикл
		Если Адрес.ВидСтрокиОтчетности <> Перечисления.дбу_ВидыСтрокОтчетности.ВложеннаяРасшифровка Тогда
			Продолжить;
		КонецЕсли;

		КлючРодителя = КлючУзлаВписаннойСтроки(
			Адрес.КодСтрокиФСБУ, Адрес.НаименованиеРодительскойСтроки,
			Адрес.КодРодительскойСтроки);
		УзелРодителя = Узлы.Получить(КлючРодителя);
		Если УзелРодителя = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Узел = УзелРодителя.Строки.Добавить();
		ПолныйПуть = УзелРодителя.ПолныйПуть + " / " + ПредставлениеАдреса(Адрес, Раздел);
		ЗаполнитьУзелАдресом(Узел, Адрес, ПолныйПуть, Раздел, ДеревоДанныхРазделов);
		Узлы.Вставить(КлючУзлаАдреса(Адрес), Узел);
	КонецЦикла;

КонецПроцедуры

Процедура ЗаполнитьУзелАдресом(Узел, Адрес, ПолныйПуть, Раздел = Неопределено,
	ДеревоДанныхРазделов = Неопределено)

	Узел.КодСтроки = Адрес.КодСтрокиФСБУ;
	Узел.Наименование = ПредставлениеАдреса(Адрес, Раздел);
	Узел.ЭтоГруппа = Ложь;
	Узел.Доступна = Истина;
	Узел.ВидСтрокиОтчетности = Адрес.ВидСтрокиОтчетности;
	Узел.ПолныйПуть = ПолныйПуть;
	Узел.Диагностика = "";
	Узел.ВерсияАдреса = Адрес.ВерсияАдреса;
	Узел.НаименованиеСтроки = Адрес.НаименованиеСтроки;
	Узел.КодСтрокиВОтчете = Адрес.КодСтрокиВОтчете;
	Узел.НаименованиеРодительскойСтроки = Адрес.НаименованиеРодительскойСтроки;
	Узел.КодРодительскойСтроки = Адрес.КодРодительскойСтроки;
	Узел.ТехническийВидМСЧ = Адрес.ТехническийВидМСЧ;

	Если ДеревоДанныхРазделов <> Неопределено Тогда
		Проверка = РазрешитьАдресПоказателя(
			ДеревоДанныхРазделов, Раздел, Адрес,
			Перечисления.дбу_КолонкиПоказателя.Колонка04);
		Узел.Доступна = Проверка.Статус = "Найдена";
		Узел.Диагностика = Проверка.Диагностика;
	КонецЕсли;

КонецПроцедуры

Функция ПредставлениеАдреса(Адрес, Раздел = Неопределено) Экспорт

	Если Адрес.ВидСтрокиОтчетности = Перечисления.дбу_ВидыСтрокОтчетности.Стандартная Тогда
		Возврат СтрШаблон("%1 — %2 (стандартная)", Адрес.КодСтрокиФСБУ,
			СтрокаДляАдреса(Раздел, Адрес));
	ИначеЕсли Адрес.ВидСтрокиОтчетности = Перечисления.дбу_ВидыСтрокОтчетности.ПрямаяРасшифровка Тогда
		Возврат СтрШаблон("%1 (расшифровка, %2)", Адрес.НаименованиеСтроки,
			ПредставлениеКодаСтроки(Адрес.КодСтрокиВОтчете));
	ИначеЕсли Адрес.ВидСтрокиОтчетности = Перечисления.дбу_ВидыСтрокОтчетности.Вписанная Тогда
		Возврат СтрШаблон("%1 (вписанная)", Адрес.НаименованиеСтроки);
	КонецЕсли;

	Возврат СтрШаблон("%1 (вложенная, родитель: %2)", Адрес.НаименованиеСтроки,
		Адрес.НаименованиеРодительскойСтроки);

КонецФункции

Функция СтрокаДляАдреса(Раздел, Адрес)

	Если Адрес.ВидСтрокиОтчетности <> Перечисления.дбу_ВидыСтрокОтчетности.Стандартная Тогда
		Возврат Адрес.НаименованиеСтроки;
	КонецЕсли;

	Описание = Неопределено;
	Если Раздел <> Неопределено Тогда
		Описание = ОписаниеСтроки(Раздел, Адрес.КодСтрокиФСБУ);
	КонецЕсли;
	Если Описание <> Неопределено И ЗначениеЗаполнено(Описание.Наименование) Тогда
		Возврат Описание.Наименование;
	КонецЕсли;

	Возврат Адрес.КодСтрокиФСБУ;

КонецФункции

Функция ПредставлениеКодаСтроки(Код)

	Если ЗначениеЗаполнено(Код) Тогда
		Возврат "код " + Код;
	КонецЕсли;

	Возврат "без кода";

КонецФункции

Функция КлючУзлаСтандартнойСтроки(Код)

	Возврат "S|" + НормализоватьТекст(Код);

КонецФункции

Функция КлючУзлаВписаннойСтроки(Код, Наименование, КодРодителя)

	Возврат "A|" + НормализоватьТекст(Код) + "|"
		+ НормализоватьТекст(Наименование) + "|" + НормализоватьТекст(КодРодителя);

КонецФункции

Функция КлючУзлаАдреса(Адрес)

	Если Адрес.ВидСтрокиОтчетности = Перечисления.дбу_ВидыСтрокОтчетности.Вписанная Тогда
		Возврат КлючУзлаВписаннойСтроки(Адрес.КодСтрокиФСБУ,
			Адрес.НаименованиеСтроки, Адрес.КодРодительскойСтроки);
	КонецЕсли;

	Возврат Строка(Адрес.ВидСтрокиОтчетности) + "|"
		+ НормализоватьТекст(Адрес.КодСтрокиФСБУ) + "|"
		+ НормализоватьТекст(Адрес.НаименованиеСтроки) + "|"
		+ НормализоватьТекст(Адрес.КодСтрокиВОтчете) + "|"
		+ НормализоватьТекст(Адрес.НаименованиеРодительскойСтроки);

КонецФункции

Функция РодительДоступенДляВыбора(Описания, Раздел, КодРодителя)

	Если Не ЗначениеЗаполнено(КодРодителя) Тогда
		Возврат Ложь;
	КонецЕсли;
	ОписаниеРодителя = Описания.Получить(КлючСтроки(Раздел, КодРодителя));
	Возврат ОписаниеРодителя <> Неопределено И СтрокаДоступнаДляВыбора(ОписаниеРодителя);

КонецФункции

#КонецОбласти



#Область СлужебныеПроцедурыИФункции

Функция НовыйРезультатРазрешения(Адрес)

	Результат = Новый Структура;
	Результат.Вставить("Статус", "НеНайдена");
	Результат.Вставить("СтрокаПоказателя", Неопределено);
	Результат.Вставить("СтрокаМСЧ", Неопределено);
	Результат.Вставить("СтрокаРодителя", Неопределено);
	Результат.Вставить("Путь", "");
	Результат.Вставить("КоличествоСовпадений", 0);
	Результат.Вставить("Диагностика", "");
	Результат.Вставить("ВидСтрокиОтчетности", ВидАдреса(Адрес));
	Возврат Результат;

КонецФункции

Функция ВидАдреса(Адрес)

	Если Адрес = Неопределено Или Не ЗначениеЗаполнено(Адрес.ВидСтрокиОтчетности) Тогда
		Возврат Перечисления.дбу_ВидыСтрокОтчетности.Стандартная;
	КонецЕсли;

	Возврат Адрес.ВидСтрокиОтчетности;

КонецФункции

Процедура РазрешитьСтандартнуюСтроку(Результат, РазделОтчета, КодСтроки, Колонка)

	Если Не ЗначениеЗаполнено(КодСтроки) Тогда
		Результат.Статус = "Неподдерживается";
		Результат.Диагностика = "Для стандартной строки не указан код ФСБУ.";
		Возврат;
	КонецЕсли;

	ИмяПоказателяОтчета = ИмяПоказателя(КодСтроки, Колонка);
	Узлы = Новый Массив;
	СобратьУзлы(РазделОтчета.Строки, "Показатель", ИмяПоказателяОтчета, Узлы, "");
	Результат.КоличествоСовпадений = Узлы.Количество();
	Если Узлы.Количество() = 0 Тогда
		Результат.Диагностика = "Стандартный показатель не найден: " + ИмяПоказателяОтчета;
		Возврат;
	ИначеЕсли Узлы.Количество() > 1 Тогда
		Результат.Статус = "Неоднозначна";
		Результат.Диагностика = "Стандартный показатель найден более одного раза: " + ИмяПоказателяОтчета;
		Возврат;
	КонецЕсли;

	Результат.Статус = "Найдена";
	Результат.СтрокаПоказателя = Узлы[0].Строка;
	Результат.Путь = Узлы[0].Путь;

КонецПроцедуры

Процедура РазрешитьМСЧ(Результат, РазделОтчета, ИдентификаторМСЧ,
	НаименованиеСтроки, КодСтрокиВОтчете, Колонка, ТолькоБезКода)

	УзлыМСЧ = Новый Массив;
	СобратьУзлы(РазделОтчета.Строки, "МногострочнаяЧасть", ИдентификаторМСЧ, УзлыМСЧ, "");
	Если УзлыМСЧ.Количество() = 0 Тогда
		Результат.Диагностика = "Многострочная часть не найдена: " + ИдентификаторМСЧ;
		Возврат;
	ИначеЕсли УзлыМСЧ.Количество() > 1 Тогда
		Результат.Статус = "Неоднозначна";
		Результат.КоличествоСовпадений = УзлыМСЧ.Количество();
		Результат.Диагностика = "Многострочная часть найдена более одного раза: " + ИдентификаторМСЧ;
		Возврат;
	КонецЕсли;

	Совпадения = СтрокиМСЧПоАдресу(УзлыМСЧ[0].Строка, ИдентификаторМСЧ,
		НаименованиеСтроки, КодСтрокиВОтчете, ТолькоБезКода);
	Результат.КоличествоСовпадений = Совпадения.Количество();
	Если Совпадения.Количество() = 0 Тогда
		Результат.Диагностика = "Строка МСЧ не найдена по имени и коду.";
		Возврат;
	ИначеЕсли Совпадения.Количество() > 1 Тогда
		Результат.Статус = "Неоднозначна";
		Результат.Диагностика = "Строка МСЧ найдена более одного раза по имени и коду.";
		Возврат;
	КонецЕсли;

	СуффиксКолонки = НомерКолонкиПоказателя(Колонка);
	Показатели = Новый Массив;
	СобратьУзлы(Совпадения[0].Строка.Строки, "Показатель",
		ИдентификаторМСЧ + СуффиксКолонки, Показатели, "");
	Если Показатели.Количество() <> 1 Тогда
		Результат.КоличествоСовпадений = Показатели.Количество();
		Результат.Диагностика = "Графа строки МСЧ отсутствует или неоднозначна.";
		Возврат;
	КонецЕсли;

	Результат.Статус = "Найдена";
	Результат.СтрокаМСЧ = УзлыМСЧ[0].Строка;
	Результат.СтрокаПоказателя = Показатели[0].Строка;
	Результат.Путь = УзлыМСЧ[0].Путь + " / " + Совпадения[0].Путь;

КонецПроцедуры

Процедура РазрешитьВложеннуюСтроку(Результат, РазделОтчета, Адрес, Колонка)

	Если Не ЗначениеЗаполнено(Адрес.НаименованиеРодительскойСтроки) Тогда
		Результат.Диагностика = "Для вложенной строки не указано имя родительской вписанной строки.";
		Возврат;
	КонецЕсли;

	УзлыМСЧА = Новый Массив;
	СобратьУзлы(РазделОтчета.Строки, "МногострочнаяЧасть", "П10001А" + СокрЛП(Адрес.КодСтрокиФСБУ), УзлыМСЧА, "");
	Если УзлыМСЧА.Количество() = 0 Тогда
		Результат.Диагностика = "Родительская вписанная часть не найдена.";
		Возврат;
	ИначеЕсли УзлыМСЧА.Количество() > 1 Тогда
		Результат.Статус = "Неоднозначна";
		Результат.КоличествоСовпадений = УзлыМСЧА.Количество();
		Результат.Диагностика = "Родительская вписанная часть неоднозначна.";
		Возврат;
	КонецЕсли;

	Родители = СтрокиМСЧПоАдресу(УзлыМСЧА[0].Строка,
		"П10001А" + СокрЛП(Адрес.КодСтрокиФСБУ),
		Адрес.НаименованиеРодительскойСтроки, Адрес.КодРодительскойСтроки, Истина);
	Результат.КоличествоСовпадений = Родители.Количество();
	Если Родители.Количество() = 0 Тогда
		Результат.Диагностика = "Родительская вписанная строка не найдена.";
		Возврат;
	ИначеЕсли Родители.Количество() > 1 Тогда
		Результат.Статус = "Неоднозначна";
		Результат.Диагностика = "Родительская вписанная строка неоднозначна.";
		Возврат;
	КонецЕсли;

	ИдентификаторМСЧБ = "П10001Б" + СокрЛП(Адрес.КодСтрокиФСБУ);
	УзлыМСЧБ = Новый Массив;
	СобратьУзлы(Родители[0].Строка.Строки, "МногострочнаяЧасть", ИдентификаторМСЧБ, УзлыМСЧБ, "");
	Если УзлыМСЧБ.Количество() = 0 Тогда
		Результат.Диагностика = "Вложенная расшифровка не найдена внутри родителя.";
		Возврат;
	ИначеЕсли УзлыМСЧБ.Количество() > 1 Тогда
		Результат.Статус = "Неоднозначна";
		Результат.КоличествоСовпадений = УзлыМСЧБ.Количество();
		Результат.Диагностика = "Вложенная расшифровка неоднозначна внутри родителя.";
		Возврат;
	КонецЕсли;

	Совпадения = СтрокиМСЧПоАдресу(УзлыМСЧБ[0].Строка, ИдентификаторМСЧБ,
		Адрес.НаименованиеСтроки, Адрес.КодСтрокиВОтчете, Ложь);
	Результат.КоличествоСовпадений = Совпадения.Количество();
	Если Совпадения.Количество() = 0 Тогда
		Результат.Диагностика = "Вложенная строка не найдена по имени и коду.";
		Возврат;
	ИначеЕсли Совпадения.Количество() > 1 Тогда
		Результат.Статус = "Неоднозначна";
		Результат.Диагностика = "Вложенная строка неоднозначна по имени и коду.";
		Возврат;
	КонецЕсли;

	Показатели = Новый Массив;
	СобратьУзлы(Совпадения[0].Строка.Строки, "Показатель",
		ИдентификаторМСЧБ + НомерКолонкиПоказателя(Колонка), Показатели, "");
	Если Показатели.Количество() <> 1 Тогда
		Результат.КоличествоСовпадений = Показатели.Количество();
		Результат.Диагностика = "Графа вложенной строки отсутствует или неоднозначна.";
		Возврат;
	КонецЕсли;

	Результат.Статус = "Найдена";
	Результат.СтрокаРодителя = Родители[0].Строка;
	Результат.СтрокаМСЧ = УзлыМСЧБ[0].Строка;
	Результат.СтрокаПоказателя = Показатели[0].Строка;
	Результат.Путь = УзлыМСЧА[0].Путь + " / " + Родители[0].Путь
		+ " / " + УзлыМСЧБ[0].Путь + " / " + Совпадения[0].Путь;

КонецПроцедуры

Функция СтрокиМСЧПоАдресу(СтрокаМСЧ, ИдентификаторМСЧ,
	НаименованиеСтроки, КодСтрокиВОтчете, ТолькоБезКода)

	Результат = Новый Массив;
	ИмяСтроки = НормализоватьТекст(НаименованиеСтроки);
	Если Не ЗначениеЗаполнено(ИмяСтроки) Или ИмяСтроки = "В ТОМ ЧИСЛЕ:" Тогда
		Возврат Результат;
	КонецЕсли;
	КодСтроки = НормализоватьТекст(КодСтрокиВОтчете);
	Для Каждого СтрокаМСЧДерева Из СтрокаМСЧ.Строки Цикл
		Если СтрокаМСЧДерева.Тип <> "Строка" Тогда
			Продолжить;
		КонецЕсли;
		Имена = Новый Массив;
		СобратьУзлы(СтрокаМСЧДерева.Строки, "Показатель", ИдентификаторМСЧ + "02", Имена, "");
		Если Имена.Количество() <> 1 Или НормализоватьТекст(Имена[0].Строка.Данные) <> ИмяСтроки Тогда
			Продолжить;
		КонецЕсли;

		Коды = Новый Массив;
		СобратьУзлы(СтрокаМСЧДерева.Строки, "Показатель", ИдентификаторМСЧ + "03", Коды, "");
		Если Коды.Количество() > 1 Тогда
			Продолжить;
		КонецЕсли;
		КодДерева = "";
		Если Коды.Количество() = 1 Тогда
			КодДерева = НормализоватьТекст(Коды[0].Строка.Данные);
		КонецЕсли;
		Если ТолькоБезКода И ЗначениеЗаполнено(КодДерева) Тогда
			Продолжить;
		КонецЕсли;
		Если КодДерева <> КодСтроки Тогда
			Продолжить;
		КонецЕсли;

		Результат.Добавить(Новый Структура("Строка,Путь", СтрокаМСЧДерева,
			Имена[0].Путь));
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция НормализоватьТекст(Значение)

	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат "";
	КонецЕсли;

	Текст = ВРег(СокрЛП(Строка(Значение)));
	Пока СтрНайти(Текст, "  ") > 0 Цикл
		Текст = СтрЗаменить(Текст, "  ", " ");
	КонецЦикла;
	Возврат Текст;

КонецФункции

Процедура СобратьУзлы(СтрокиДерева, ТипУзла, Идентификатор,
	Результат, ПутьРодителя)

	Для Каждого СтрокаДерева Из СтрокиДерева Цикл
		Путь = ПутьРодителя;
		Если ЗначениеЗаполнено(Путь) Тогда
			Путь = Путь + " / ";
		КонецЕсли;
		Путь = Путь + СокрЛП(Строка(СтрокаДерева.Идентификатор));

		Если СтрокаДерева.Тип = ТипУзла
			И (Не ЗначениеЗаполнено(Идентификатор)
				Или СтрокаДерева.Идентификатор = Идентификатор) Тогда
			Результат.Добавить(Новый Структура("Строка,Путь", СтрокаДерева, Путь));
		КонецЕсли;

		СобратьУзлы(СтрокаДерева.Строки, ТипУзла, Идентификатор, Результат, Путь);
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьАдресаМСЧ(Результат, Ключи, СтрокаМСЧ,
	ВидСтроки, КодСтрокиФСБУ, НаименованиеРодителя, ТолькоБезКода)

	ИдентификаторМСЧ = СтрокаМСЧ.Идентификатор;
	Для Каждого СтрокаМСЧДерева Из СтрокаМСЧ.Строки Цикл
		Если СтрокаМСЧДерева.Тип <> "Строка" Тогда
			Продолжить;
		КонецЕсли;
		Имена = Новый Массив;
		СобратьУзлы(СтрокаМСЧДерева.Строки, "Показатель", ИдентификаторМСЧ + "02", Имена, "");
		Если Имена.Количество() <> 1 Тогда
			Продолжить;
		КонецЕсли;
		Имя = Имена[0].Строка.Данные;
		Если Не ЗначениеЗаполнено(НормализоватьТекст(Имя))
			Или НормализоватьТекст(Имя) = "В ТОМ ЧИСЛЕ:" Тогда
			Продолжить;
		КонецЕсли;

		Коды = Новый Массив;
		СобратьУзлы(СтрокаМСЧДерева.Строки, "Показатель", ИдентификаторМСЧ + "03", Коды, "");
		Если Коды.Количество() > 1 Тогда
			Продолжить;
		КонецЕсли;
		Код = "";
		Если Коды.Количество() = 1 Тогда
			Код = Коды[0].Строка.Данные;
		КонецЕсли;
		Если ТолькоБезКода И ЗначениеЗаполнено(Код) Тогда
			Продолжить;
		КонецЕсли;

		ДобавитьАдресВРезультат(Результат, Ключи, ВидСтроки,
			КодСтрокиФСБУ, Имя, Код,
			НаименованиеРодителя, "", ИдентификаторМСЧ);

		Если ВидСтроки = Перечисления.дбу_ВидыСтрокОтчетности.Вписанная Тогда
			ВложенныеМСЧ = Новый Массив;
			СобратьУзлы(СтрокаМСЧДерева.Строки, "МногострочнаяЧасть",
				"П10001Б" + КодСтрокиФСБУ, ВложенныеМСЧ, "");
			Для Каждого ВложеннаяМСЧ Из ВложенныеМСЧ Цикл
				ДобавитьАдресаМСЧ(Результат, Ключи, ВложеннаяМСЧ.Строка,
					Перечисления.дбу_ВидыСтрокОтчетности.ВложеннаяРасшифровка,
					КодСтрокиФСБУ, Имя, Ложь);
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьАдресВРезультат(Результат, Ключи, ВидСтроки,
	КодСтрокиФСБУ, НаименованиеСтроки, КодСтрокиВОтчете,
	НаименованиеРодителя, КодРодителя, ТехническийВидМСЧ)

	Ключ = Строка(ВидСтроки) + "|" + НормализоватьТекст(КодСтрокиФСБУ)
		+ "|" + НормализоватьТекст(НаименованиеСтроки)
		+ "|" + НормализоватьТекст(КодСтрокиВОтчете)
		+ "|" + НормализоватьТекст(НаименованиеРодителя)
		+ "|" + НормализоватьТекст(КодРодителя);
	Если Ключи.Получить(Ключ) <> Неопределено Тогда
		Возврат;
	КонецЕсли;

	Адрес = Новый Структура;
	Адрес.Вставить("ВерсияАдреса", 1);
	Адрес.Вставить("ВидСтрокиОтчетности", ВидСтроки);
	Адрес.Вставить("КодСтрокиФСБУ", СокрЛП(КодСтрокиФСБУ));
	Адрес.Вставить("НаименованиеСтроки", СокрЛП(НаименованиеСтроки));
	Адрес.Вставить("КодСтрокиВОтчете", СокрЛП(КодСтрокиВОтчете));
	Адрес.Вставить("НаименованиеРодительскойСтроки", СокрЛП(НаименованиеРодителя));
	Адрес.Вставить("КодРодительскойСтроки", СокрЛП(КодРодителя));
	Адрес.Вставить("ТехническийВидМСЧ", СокрЛП(ТехническийВидМСЧ));
	Ключи.Вставить(Ключ, Адрес);
	Результат.Добавить(Адрес);

КонецПроцедуры



// Для HierarchyOfItems: узел с дочерними строками помечаем как группу (нельзя выбрать в форме).
//
Процедура ПометитьГруппыДереваСтрок(СтрокиДерева)

	Для Каждого СтрокаДерева Из СтрокиДерева Цикл
		ПометитьГруппыДереваСтрок(СтрокаДерева.Строки);
		СтрокаДерева.ЭтоГруппа = СтрокаДерева.Строки.Количество() > 0;
	КонецЦикла;

КонецПроцедуры

Функция РазделДерева(ДеревоДанныхРазделов, ИмяРаздела)

	Разделы = ДеревоДанныхРазделов.Строки.НайтиСтроки(Новый Структура("Тип, Идентификатор", "Раздел", ИмяРаздела));
	Если Разделы.Количество() <> 1 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Разделы[0];

КонецФункции



Функция НомерКолонкиПоказателя(КолонкаПоказателя)



	Если КолонкаПоказателя = Перечисления.дбу_КолонкиПоказателя.Колонка04 Тогда

		Возврат "04";

	ИначеЕсли КолонкаПоказателя = Перечисления.дбу_КолонкиПоказателя.Колонка05 Тогда

		Возврат "05";

	ИначеЕсли КолонкаПоказателя = Перечисления.дбу_КолонкиПоказателя.Колонка06 Тогда

		Возврат "06";

	КонецЕсли;



	ВызватьИсключение НСтр("ru = 'Неизвестная колонка показателя для строки отчётности.'");



КонецФункции



Функция РазделыДляИмпорта()



	Разделы = Новый Массив;

	Разделы.Добавить(Новый Структура("Раздел, ИмяМакета", Перечисления.дбу_РазделыБухОтчетности.Баланс, "Баланс"));

	Разделы.Добавить(Новый Структура("Раздел, ИмяМакета", Перечисления.дбу_РазделыБухОтчетности.ОФР, "ОФР"));



	Возврат Разделы;



КонецФункции



Процедура ДополнитьСтрокиИзМакета(ВерсияФормы, ОписаниеРаздела, ОписанияСтрок)



	ИмяМакета = "ФормаОтчета" + ВерсияФормы + "_" + ОписаниеРаздела.ИмяМакета;

	Макет = Отчеты.РегламентированныйОтчетБухОтчетность.ПолучитьМакет(ИмяМакета);



	Для Каждого ОбластьМакета Из Макет.Области Цикл



		ИмяОбласти = ОбластьМакета.Имя;

		Если Не СтрНачинаетсяС(ИмяОбласти, "П000010") Тогда

			Продолжить;

		КонецЕсли;



		Если ОбластьМакета.ТипОбласти <> ТипОбластиЯчеекТабличногоДокумента.Прямоугольник Тогда

			Продолжить;

		КонецЕсли;



		Суффикс = Сред(ИмяОбласти, 8);

		Если СтрДлина(Суффикс) < 3 Тогда

			Продолжить;

		КонецЕсли;



		НомерКолонки = Прав(Суффикс, 2);

		КодСтроки = Лев(Суффикс, СтрДлина(Суффикс) - 2);

		Если Не ЗначениеЗаполнено(КодСтроки) Тогда

			Продолжить;

		КонецЕсли;



		Ключ = КлючСтроки(ОписаниеРаздела.Раздел, КодСтроки);

		Описание = ОписанияСтрок.Получить(Ключ);

		Если Описание = Неопределено Тогда

			Описание = НовоеОписаниеСтроки(ОписаниеРаздела.Раздел, КодСтроки);

			ОписанияСтрок.Вставить(Ключ, Описание);

		КонецЕсли;



		Если НомерКолонки = "01" Тогда

			Если ОбластьМакета.СодержитЗначение Тогда

				Описание.Наименование = СокрЛП(Строка(ОбластьМакета.Значение));

			Иначе

				Описание.Наименование = СокрЛП(ОбластьМакета.Текст);

			КонецЕсли;

		КонецЕсли;



	КонецЦикла;



КонецПроцедуры



Функция НовоеОписаниеСтроки(Раздел, КодСтроки)



	Описание = Новый Структура;

	Описание.Вставить("Раздел", Раздел);

	Описание.Вставить("КодСтроки", КодСтроки);

	Описание.Вставить("Наименование", КодСтроки);

	Описание.Вставить("ЭтоИтоговаяСтрока", ЭтоИтоговыйКодСтроки(КодСтроки));

	Описание.Вставить("ЕстьМногострочнаяЧасть", Ложь);

	Описание.Вставить("Доступна", Истина);

	Описание.Вставить("КодРодителя", КодРодительскойСтроки(КодСтроки));



	Возврат Описание;



КонецФункции



Процедура ПрименитьПризнакиСтрокГруппы(ОписанияСтрок)



	Для Каждого КлючИЗначение Из ОписанияСтрок Цикл

		Описание = КлючИЗначение.Значение;

		СтрокиГруппы = СтрокиГруппыРаздела(Описание.Раздел);

		Если КодВМассиве(СтрокиГруппы, Описание.КодСтроки) Тогда

			Описание.ЭтоИтоговаяСтрока = Ложь;

		КонецЕсли;

		Если КодВМассиве(СтрокиСМногострочнойЧастью(Описание.Раздел), Описание.КодСтроки) Тогда

			Описание.ЕстьМногострочнаяЧасть = Истина;

		КонецЕсли;

		Если КодВМассиве(СкрытыеСтрокиРаздела(Описание.Раздел), Описание.КодСтроки) Тогда

			Описание.Доступна = Ложь;

		КонецЕсли;

	КонецЦикла;



КонецПроцедуры


Функция КлючСтроки(Раздел, КодСтроки)



	Возврат Строка(Раздел) + "|" + КодСтроки;



КонецФункции



Функция КодРодительскойСтроки(КодСтроки)



	Если СтрДлина(КодСтроки) < 4 Тогда

		Возврат "";

	КонецЕсли;



	КодРодителя = Лев(КодСтроки, 2) + "00";

	Если КодРодителя = КодСтроки Тогда

		Возврат "";

	КонецЕсли;



	Возврат КодРодителя;



КонецФункции



Функция ЭтоИтоговыйКодСтроки(КодСтроки)



	ИтоговыеКоды = "1100, 1200, 1300, 1400, 1500, 1600, 1700,

		|2100, 2200, 2300, 2400, 2500, 2900";



	Возврат КодВМассиве(СписокКодов(ИтоговыеКоды), КодСтроки);



КонецФункции



Функция СтрокиГруппыРаздела(Раздел)



	Если Раздел = Перечисления.дбу_РазделыБухОтчетности.Баланс Тогда

		Возврат СписокКодов(

			"1105, 1110, 1130, 1140, 1150, 1160, 1170, 1180, 1190,

			|1210, 1215, 1220, 1230, 1240, 1250, 1260,

			|1310, 1320, 1340, 1350, 1360, 1370,

			|1410, 1420, 1430, 1450,

			|1510, 1520, 1530, 1540, 1550");

	ИначеЕсли Раздел = Перечисления.дбу_РазделыБухОтчетности.ОФР Тогда

		Возврат СписокКодов(

			"2110, 2120, 2210, 2220, 2310, 2320, 2330, 2340, 2350,

			|2410, 2411, 2412, 2420, 2460, 2510, 2520, 2530, 2900, 2910");

	КонецЕсли;



	Возврат Новый Массив;



КонецФункции



Функция СтрокиСМногострочнойЧастью(Раздел)



	Если Раздел = Перечисления.дбу_РазделыБухОтчетности.Баланс Тогда

		Возврат СписокКодов(

			"1105, 1110, 1130, 1140, 1150, 1160, 1170, 1180, 1190,

			|1210, 1215, 1220, 1230, 1240, 1250, 1260,

			|1310, 1320, 1340, 1350, 1360, 1370,

			|1410, 1420, 1430, 1450,

			|1510, 1520, 1530, 1540, 1550");

	ИначеЕсли Раздел = Перечисления.дбу_РазделыБухОтчетности.ОФР Тогда

		Возврат СписокКодов(

			"2110, 2120, 2210, 2220, 2310, 2320, 2330, 2340, 2350,

			|2410, 2420, 2460, 2510, 2520, 2530");

	КонецЕсли;



	Возврат Новый Массив;



КонецФункции



Функция СкрытыеСтрокиРаздела(Раздел)



	Если Раздел = Перечисления.дбу_РазделыБухОтчетности.Баланс Тогда

		Возврат СписокКодов("1105, 1130, 1140, 1530");

	ИначеЕсли Раздел = Перечисления.дбу_РазделыБухОтчетности.ОФР Тогда

		Возврат СписокКодов("2460");

	КонецЕсли;



	Возврат Новый Массив;



КонецФункции



Функция КодВМассиве(МассивКодов, КодСтроки)

	Возврат МассивКодов.Найти(КодСтроки) <> Неопределено;

КонецФункции

Функция СписокКодов(СтрокаКодов)



	Результат = Новый Массив;

	Для Каждого Фрагмент Из СтрРазделить(СтрокаКодов, ",", Ложь) Цикл

		Код = СокрЛП(Фрагмент);

		Если ЗначениеЗаполнено(Код) Тогда

			Результат.Добавить(Код);

		КонецЕсли;

	КонецЦикла;



	Возврат Результат;



КонецФункции



#КонецОбласти
