// Единая граница доступа КДР по организациям.
//
// Список рассчитывается штатным механизмом БСП по RLS для обычных
// пользователей. Пользователь с ролью ПолныеПрава получает полный список
// организаций обычным запросом без включения привилегированного режима.

#Область ПрограммныйИнтерфейс

// Возвращает организации, доступные текущему пользователю.
//
// ПравоНаИзменение оставлено в сигнатуре для будущих сценариев публикации
// формул. Рабочее место использует общий список чтения, а право изменения
// правил проверяется отдельно ролями расширения.
Функция ДоступныеОрганизации(ПравоНаИзменение = Ложь) Экспорт

	Если РольДоступна("ПолныеПрава") Тогда
		Возврат ВсеОрганизации();
	КонецЕсли;

	// Не вызывать эту функцию из привилегированного кода: штатный механизм
	// БСП кеширует результат с учётом текущего пользователя и режима.
	Возврат ОбщегоНазначенияБПВызовСервераПовтИсп.ОрганизацииРазрешенныеПользователю();

КонецФункции

// Проверяет доступ текущего пользователя к конкретной организации.
Функция ОрганизацияДоступна(Организация, ПравоНаИзменение = Ложь) Экспорт

	Если Не ЗначениеЗаполнено(Организация) Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Каждого ДоступнаяОрганизация Из ДоступныеОрганизации(ПравоНаИзменение) Цикл
		Если ДоступнаяОрганизация = Организация Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция ВсеОрганизации()

	Результат = Новый Массив;
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		| Организации.Ссылка
		|ИЗ
		| Справочник.Организации КАК Организации
		|ГДЕ
		| НЕ Организации.ПометкаУдаления");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Добавить(Выборка.Ссылка);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Возвращает текст ошибки без раскрытия сведений о недоступной организации.
Функция ТекстОшибкиДоступа() Экспорт

	Возврат НСтр("ru = 'У вас нет доступа к данным выбранной организации. Выберите организацию из списка доступных или обратитесь к администратору.'");

КонецФункции

#КонецОбласти
