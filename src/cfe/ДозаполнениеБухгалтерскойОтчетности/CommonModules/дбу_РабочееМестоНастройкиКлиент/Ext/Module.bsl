// Клиентские вызовы рабочего места настройки КДР.

#Область ПрограммныйИнтерфейс

// Открывает форму правила доработки.
//
Процедура ОткрытьПравило(
	Правило,
	ВладелецФормы = Неопределено,
	ОписаниеОповещенияОЗакрытии = Неопределено,
	Организация = Неопределено,
	Период = Неопределено) Экспорт

	Если Не ЗначениеЗаполнено(Правило) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Выберите правило в списке.'"));
		Возврат;
	КонецЕсли;

	ПараметрыФормы = Новый Структура("Ключ", Правило);
	Если ЗначениеЗаполнено(Организация) Тогда
		ПараметрыФормы.Вставить("Организация", Организация);
	КонецЕсли;
	Если ЗначениеЗаполнено(Период) Тогда
		ПараметрыФормы.Вставить("Период", Период);
	КонецЕсли;
	ОткрытьФорму(
		"Справочник.дбу_ПравилаДоработки.Форма.ФормаЭлемента",
		ПараметрыФормы,
		ВладелецФормы,
	,
	,
	,
	ОписаниеОповещенияОЗакрытии);

КонецПроцедуры

// Создаёт новое правило в профиле.
//
Процедура СоздатьПравило(
	Профиль,
	ВладелецФормы = Неопределено,
	ОписаниеОповещенияОЗакрытии = Неопределено,
	Организация = Неопределено,
	Период = Неопределено) Экспорт

	Если Не ЗначениеЗаполнено(Профиль) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Выберите профиль доработки.'"));
		Возврат;
	КонецЕсли;

	ЗначенияЗаполнения = Новый Структура;
	ЗначенияЗаполнения.Вставить("Владелец", Профиль);
	ЗначенияЗаполнения.Вставить(
		"Раздел",
		ПредопределенноеЗначение("Перечисление.дбу_РазделыБухОтчетности.Баланс"));
	ЗначенияЗаполнения.Вставить("Активно", Истина);
	ЗначенияЗаполнения.Вставить("Приоритет", 100);
	ЗначенияЗаполнения.Вставить(
		"ВидПравила",
		ПредопределенноеЗначение("Перечисление.дбу_ВидыПравил.КорректировкаПоказателя"));
	ПараметрыФормы = Новый Структура("ЗначенияЗаполнения", ЗначенияЗаполнения);
	Если ЗначениеЗаполнено(Организация) Тогда
		ПараметрыФормы.Вставить("Организация", Организация);
	КонецЕсли;
	Если ЗначениеЗаполнено(Период) Тогда
		ПараметрыФормы.Вставить("Период", Период);
	КонецЕсли;
	ОткрытьФорму(
		"Справочник.дбу_ПравилаДоработки.Форма.ФормаЭлемента",
		ПараметрыФормы,
		ВладелецФормы,
	,
	,
	,
	ОписаниеОповещенияОЗакрытии);

КонецПроцедуры

// Открывает пробный расчёт выбранного правила.
//
Процедура ОткрытьПробныйРасчет(АдресДанныхПравила, ВладелецФормы = Неопределено) Экспорт

	Если Не ЗначениеЗаполнено(АдресДанныхПравила) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Не удалось подготовить данные правила.'"));
		Возврат;
	КонецЕсли;

	ПараметрыФормы = Новый Структура("АдресДанныхПравила", АдресДанныхПравила);
	ОткрытьФорму(
		"Справочник.дбу_ПравилаДоработки.Форма.ФормаПробногоРасчета",
		ПараметрыФормы,
		ВладелецФормы,
		,
		,
		,
		,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

// Открывает журнал 1С-Отчётности (РС ЖурналОтчетовСтатусы) с отбором по бухгалтерской отчётности.
//
Процедура ОткрытьБухОтчетность(Организация = Неопределено) Экспорт

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Раздел",
		ПредопределенноеЗначение("Перечисление.СтраницыЖурналаОтчетность.Отчеты"));
	// Как в реквизите НаименованиеОтчета регистра ЖурналОтчетовСтатусы
	// (см. также ОбщаяКоманда.ОтчетностьПо6НДФЛ).
	ПараметрыФормы.Вставить("ВидОтчета", "Бухгалтерская отчетность");
	Если ЗначениеЗаполнено(Организация) Тогда
		ПараметрыФормы.Вставить("Организация", Организация);
	КонецЕсли;

	ОткрытьФорму(
		"ОбщаяФорма.РегламентированнаяОтчетность",
		ПараметрыФормы,
		,
		"1С-Отчетность");

	Оповестить("Открытие формы 1С-Отчетность", ПараметрыФормы);

КонецПроцедуры

// Открывает произвольную форму по имени.
//
Процедура ОткрытьФормуПоИмени(ИмяФормы) Экспорт

	Если Не ЗначениеЗаполнено(ИмяФормы) Тогда
		Возврат;
	КонецЕсли;

	ОткрытьФорму(ИмяФормы);

КонецПроцедуры

#КонецОбласти
