// Расчёт операндов правил доработки по данным регистра бухгалтерии.
// План: docs/urdv-dozapolnenie-buh-otchetnosti/01-план.md § 3.3

#Область ПрограммныйИнтерфейс

// Рассчитывает значения операндов правила.
//
// Параметры:
//  ПараметрыРасчета - Структура - Организация, НачалоПериода, КонецПериода
//  Операнды - ТаблицаЗначений, Массив из Структура, ДанныеФормыКоллекция - строки ТЧ «Операнды»
//
// Возвращаемое значение:
//  Соответствие - ключ: идентификатор операнда (A, B, …), значение: Число
//
Функция РассчитатьОперанды(ПараметрыРасчета, Операнды) Экспорт

	Результат = Новый Соответствие;

	Для Каждого СтрокаОперанда Из Операнды Цикл

		Идентификатор = ВРег(СокрЛП(Строка(СтрокаОперанда.Идентификатор)));
		Если Не ЗначениеЗаполнено(Идентификатор) Тогда
			Продолжить;
		КонецЕсли;

		Сумма = РассчитатьОперанд(ПараметрыРасчета, СтрокаОперанда);
		Знак = ?(СтрокаОперанда.Знак = 0, 1, СтрокаОперанда.Знак);
		Результат.Вставить(Идентификатор, Сумма * Знак);

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Рассчитывает значение одного операнда.
//
Функция РассчитатьОперанд(ПараметрыРасчета, СтрокаОперанда) Экспорт

	СпособРасчета = СтрокаОперанда.СпособРасчета;

	ИмяПоказателяАренды = дбу_РасчетАрендныхОбязательств.ИмяПоказателяСпособаРасчета(СпособРасчета);
	Если ЗначениеЗаполнено(ИмяПоказателяАренды) Тогда
		Возврат дбу_РасчетАрендныхОбязательств.ЗначениеПоказателяПоОрганизации(
			ПараметрыРасчета.Организация, ПараметрыРасчета.КонецПериода, ИмяПоказателяАренды);
	КонецЕсли;

	Если СпособРасчета = Перечисления.дбу_СпособыРасчетаОперанда.Запрос
		Или СпособРасчета = Перечисления.дбу_СпособыРасчетаОперанда.ОтборСКД Тогда
		Возврат ВыполнитьЗапросДанных(ПараметрыРасчета, СтрокаОперанда.ЗапросДанных);
	КонецЕсли;

	Если Не ЗначениеЗаполнено(СтрокаОперанда.Счет) Тогда
		Возврат 0;
	КонецЕсли;

	Если СпособРасчета = Перечисления.дбу_СпособыРасчетаОперанда.ДО
		Или СпособРасчета = Перечисления.дбу_СпособыРасчетаОперанда.КО Тогда
		Возврат СуммаОстаткаИлиОборота(ПараметрыРасчета, СтрокаОперанда, СпособРасчета);
	КонецЕсли;

	Возврат СуммаОстаткаИлиОборота(ПараметрыРасчета, СтрокаОперанда, СпособРасчета);

КонецФункции

// Выполняет произвольный запрос из справочника дбу_ЗапросыДанных.
// Ожидается одна числовая колонка «Сумма» в результате.
//
Функция ВыполнитьЗапросДанных(ПараметрыРасчета, ЗапросДанных) Экспорт

	Если Не ЗначениеЗаполнено(ЗапросДанных) Тогда
		Возврат 0;
	КонецЕсли;

	ТекстЗапроса = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЗапросДанных, "ТекстЗапроса");
	Если Не ЗначениеЗаполнено(ТекстЗапроса) Тогда
		Возврат 0;
	КонецЕсли;

	ПроверитьБезопасностьТекстаЗапроса(ТекстЗапроса);

	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("Организация", ПараметрыРасчета.Организация);
	Запрос.УстановитьПараметр("НачалоПериода", ПараметрыРасчета.НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", ПараметрыРасчета.КонецПериода);

	дбу_СКДОперандов.УстановитьПараметрыСкомпилированногоЗапроса(Запрос, ЗапросДанных);

	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат 0;
	КонецЕсли;

	Выборка = Результат.Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат 0;
	КонецЕсли;

	Возврат ЧислоИзВыборкиЗапроса(Результат, Выборка);

КонецФункции

// Извлекает числовое значение из первой строки результата запроса операнда.
// Приоритет — колонка «Сумма», иначе первая колонка результата.
//
Функция ЧислоИзВыборкиЗапроса(Результат, Выборка)

	Если Результат.Колонки.Найти("Сумма") <> Неопределено Тогда
		Возврат ЧислоИлиНоль(Выборка.Сумма);
	КонецЕсли;

	Если Результат.Колонки.Количество() = 0 Тогда
		Возврат 0;
	КонецЕсли;

	Возврат ЧислоИлиНоль(Выборка.Получить(0));

КонецФункции

Функция ЧислоИлиНоль(Значение)

	Если Значение = Null Или Значение = Неопределено Тогда
		Возврат 0;
	КонецЕсли;

	Возврат Значение;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СуммаОстаткаИлиОборота(ПараметрыРасчета, СтрокаОперанда, СпособРасчета)

	ИмяРесурса = ИмяРесурсаОстатковИОборотов(СпособРасчета);
	Если Не ЗначениеЗаполнено(ИмяРесурса) Тогда
		Возврат 0;
	КонецЕсли;

	Псевдоним = ПсевдонимСпособаРасчета(СпособРасчета);
	ИмяКолонки = ИмяКолонкиРезультата(Псевдоним, СтрокаОперанда.ЗнакСальдо, СпособРасчета);

	РазвернутоеСальдо = Перечисления.дбу_СпособыРасчетаОперанда.РазвернутоеСальдо().Найти(СпособРасчета) <> Неопределено;
	СвернутоеСальдо = Перечисления.дбу_СпособыРасчетаОперанда.СвернутоеСальдо().Найти(СпособРасчета) <> Неопределено;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация", ПараметрыРасчета.Организация);
	Запрос.УстановитьПараметр("НачалоПериода", ПараметрыРасчета.НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", ПараметрыРасчета.КонецПериода);
	Запрос.УстановитьПараметр("Счет", СтрокаОперанда.Счет);

	Если РазвернутоеСальдо И ЗначениеЗаполнено(СтрокаОперанда.ВидыСубконто) Тогда
		Запрос.Текст = ТекстЗапросаРазвернутогоСальдо(ИмяРесурса, Псевдоним, СвернутоеСальдо, СтрокаОперанда);
		УстановитьПараметрВидыСубконто(Запрос, СтрокаОперанда);
	Иначе
		Запрос.Текст = ТекстЗапросаСвернутогоСальдоИОборотов(ИмяРесурса, Псевдоним, СвернутоеСальдо);
	КонецЕсли;

	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат 0;
	КонецЕсли;

	Возврат ЧислоИлиНоль(Выборка[ИмяКолонки]);

КонецФункции

Функция ИмяРесурсаОстатковИОборотов(СпособРасчета)

	Ресурсы = Новый Соответствие;
	Ресурсы.Вставить(Перечисления.дбу_СпособыРасчетаОперанда.СНД, "СуммаНачальныйОстатокДт");
	Ресурсы.Вставить(Перечисления.дбу_СпособыРасчетаОперанда.СНДР, "СуммаНачальныйРазвернутыйОстатокДт");
	Ресурсы.Вставить(Перечисления.дбу_СпособыРасчетаОперанда.СНК, "СуммаНачальныйОстатокКт");
	Ресурсы.Вставить(Перечисления.дбу_СпособыРасчетаОперанда.СНКР, "СуммаНачальныйРазвернутыйОстатокКт");
	Ресурсы.Вставить(Перечисления.дбу_СпособыРасчетаОперанда.СКД, "СуммаКонечныйОстатокДт");
	Ресурсы.Вставить(Перечисления.дбу_СпособыРасчетаОперанда.СКДР, "СуммаКонечныйРазвернутыйОстатокДт");
	Ресурсы.Вставить(Перечисления.дбу_СпособыРасчетаОперанда.СКК, "СуммаКонечныйОстатокКт");
	Ресурсы.Вставить(Перечисления.дбу_СпособыРасчетаОперанда.СККР, "СуммаКонечныйРазвернутыйОстатокКт");
	Ресурсы.Вставить(Перечисления.дбу_СпособыРасчетаОперанда.ДО, "СуммаОборотДт");
	Ресурсы.Вставить(Перечисления.дбу_СпособыРасчетаОперанда.КО, "СуммаОборотКт");

	Возврат Ресурсы[СпособРасчета];

КонецФункции

Функция ПсевдонимСпособаРасчета(СпособРасчета)

	Псевдонимы = Новый Соответствие;
	Псевдонимы.Вставить(Перечисления.дбу_СпособыРасчетаОперанда.СНД, "СНД");
	Псевдонимы.Вставить(Перечисления.дбу_СпособыРасчетаОперанда.СНДР, "СНДР");
	Псевдонимы.Вставить(Перечисления.дбу_СпособыРасчетаОперанда.СНК, "СНК");
	Псевдонимы.Вставить(Перечисления.дбу_СпособыРасчетаОперанда.СНКР, "СНКР");
	Псевдонимы.Вставить(Перечисления.дбу_СпособыРасчетаОперанда.СКД, "СКД");
	Псевдонимы.Вставить(Перечисления.дбу_СпособыРасчетаОперанда.СКДР, "СКДР");
	Псевдонимы.Вставить(Перечисления.дбу_СпособыРасчетаОперанда.СКК, "СКК");
	Псевдонимы.Вставить(Перечисления.дбу_СпособыРасчетаОперанда.СККР, "СККР");
	Псевдонимы.Вставить(Перечисления.дбу_СпособыРасчетаОперанда.ДО, "ДО");
	Псевдонимы.Вставить(Перечисления.дбу_СпособыРасчетаОперанда.КО, "КО");

	Возврат Псевдонимы[СпособРасчета];

КонецФункции

Функция ИмяКолонкиРезультата(Псевдоним, ЗнакСальдо, СпособРасчета)

	Если Перечисления.дбу_СпособыРасчетаОперанда.СвернутоеСальдо().Найти(СпособРасчета) <> Неопределено
		И ЗначениеЗаполнено(ЗнакСальдо) Тогда

		Если ЗнакСальдо = "+" Тогда
			Возврат Псевдоним + "Положительный";
		ИначеЕсли ЗнакСальдо = "-" Тогда
			Возврат Псевдоним + "Отрицательный";
		КонецЕсли;

	КонецЕсли;

	Возврат Псевдоним;

КонецФункции

Функция ТекстЗапросаСвернутогоСальдоИОборотов(ИмяРесурса, Псевдоним, ДобавитьЗнаковыеКолонки)

	ТекстПоказатели = "СУММА(ОстаткиИОбороты." + ИмяРесурса + ") КАК " + Псевдоним;

	Если ДобавитьЗнаковыеКолонки Тогда
		ТекстПоказатели = ТекстПоказатели + ",
		|	СУММА(ВЫБОР
		|			КОГДА ОстаткиИОбороты." + ИмяРесурса + " > 0
		|				ТОГДА ОстаткиИОбороты." + ИмяРесурса + "
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК " + Псевдоним + "Положительный,
		|	СУММА(ВЫБОР
		|			КОГДА ОстаткиИОбороты." + ИмяРесурса + " < 0
		|				ТОГДА -ОстаткиИОбороты." + ИмяРесурса + "
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК " + Псевдоним + "Отрицательный";
	КонецЕсли;

	Возврат
	"ВЫБРАТЬ
	|	" + ТекстПоказатели + "
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.ОстаткиИОбороты(
	|			&НачалоПериода,
	|			&КонецПериода,
	|			,
	|			ДвиженияИГраницыПериода,
	|			Счет В ИЕРАРХИИ (&Счет),
	|			,
	|			Организация = &Организация) КАК ОстаткиИОбороты";

КонецФункции

Функция ТекстЗапросаРазвернутогоСальдо(ИмяРесурса, Псевдоним, ДобавитьЗнаковыеКолонки, СтрокаОперанда)

	ТекстСубконто = "";
	МассивВидовСубконто = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(
		СтрокаОперанда.ВидыСубконто, ",", Истина, Истина);
	НомерСубконто = 1;

	Для Каждого ВидСубконтоИмя Из МассивВидовСубконто Цикл

		ТекстСубконто = ТекстСубконто
			+ ?(ЗначениеЗаполнено(ТекстСубконто), Символы.ПС + Символы.Таб + Символы.Таб, "")
			+ "ОстаткиИОбороты.Субконто" + Строка(НомерСубконто) + ",";
		НомерСубконто = НомерСубконто + 1;

	КонецЦикла;

	ТекстПоказателиДетали = "ОстаткиИОбороты." + ИмяРесурса + " КАК " + Псевдоним;

	Если ДобавитьЗнаковыеКолонки Тогда
		ТекстПоказателиДетали = ТекстПоказателиДетали + ",
		|			ВЫБОР
		|				КОГДА ОстаткиИОбороты." + ИмяРесурса + " > 0
		|					ТОГДА ОстаткиИОбороты." + ИмяРесурса + "
		|				ИНАЧЕ 0
		|			КОНЕЦ КАК " + Псевдоним + "Положительный,
		|			ВЫБОР
		|				КОГДА ОстаткиИОбороты." + ИмяРесурса + " < 0
		|					ТОГДА -ОстаткиИОбороты." + ИмяРесурса + "
		|				ИНАЧЕ 0
		|			КОНЕЦ КАК " + Псевдоним + "Отрицательный";
	КонецЕсли;

	ТекстПоказателиГруппировка = "СУММА(ВложенныйЗапрос." + Псевдоним + ") КАК " + Псевдоним;

	Если ДобавитьЗнаковыеКолонки Тогда
		ТекстПоказателиГруппировка = ТекстПоказателиГруппировка + ",
		|	СУММА(ВложенныйЗапрос." + Псевдоним + "Положительный) КАК " + Псевдоним + "Положительный,
		|	СУММА(ВложенныйЗапрос." + Псевдоним + "Отрицательный) КАК " + Псевдоним + "Отрицательный";
	КонецЕсли;

	Возврат
	"ВЫБРАТЬ
	|	" + ТекстПоказателиГруппировка + "
	|ИЗ
	|	(ВЫБРАТЬ
	|		" + ТекстПоказателиДетали + "
	|	ИЗ
	|		РегистрБухгалтерии.Хозрасчетный.ОстаткиИОбороты(
	|				&НачалоПериода,
	|				&КонецПериода,
	|				,
	|				ДвиженияИГраницыПериода,
	|				Счет В ИЕРАРХИИ (&Счет),
	|				&ВидыСубконто,
	|				Организация = &Организация) КАК ОстаткиИОбороты) КАК ВложенныйЗапрос";

КонецФункции

Процедура УстановитьПараметрВидыСубконто(Запрос, СтрокаОперанда)

	СписокВидовСубконто = Новый СписокЗначений;
	МассивВидовСубконто = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(
		СтрокаОперанда.ВидыСубконто, ",", Истина, Истина);

	Для Каждого ВидСубконтоИмя Из МассивВидовСубконто Цикл
		ВидСубконто = ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные[СокрЛП(ВидСубконтоИмя)];
		СписокВидовСубконто.Добавить(ВидСубконто);
	КонецЦикла;

	Запрос.УстановитьПараметр("ВидыСубконто", СписокВидовСубконто);

КонецПроцедуры

Процедура ПроверитьБезопасностьТекстаЗапроса(ТекстЗапроса)

	ВерхнийТекст = ВРег(ТекстЗапроса);
	ЗапрещенныеФрагменты = "УДАЛИТЬ|ИЗМЕНИТЬ|ОБНОВИТЬ|ВСТАВИТЬ|DROP|DELETE|UPDATE|INSERT";

	Для Каждого Фрагмент Из СтрРазделить(ЗапрещенныеФрагменты, "|") Цикл
		Если СтрНайти(ВерхнийТекст, Фрагмент) > 0 Тогда
			ВызватьИсключение НСтр("ru = 'Запрос данных содержит запрещённые операторы изменения данных.'");
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
