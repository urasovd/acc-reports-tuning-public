// Клиентские вызовы пробного расчёта и drill-down в типовые отчёты.

#Область ПрограммныйИнтерфейс

// Открывает типовой отчёт по параметрам расшифровки операнда.
//
Процедура ОткрытьТиповуюРасшифровку(ПараметрыОткрытия) Экспорт

	Если ПараметрыОткрытия = Неопределено Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Для выбранной строки расшифровка недоступна.'"));
		Возврат;
	КонецЕсли;

	ИмяФормы = ПараметрыОткрытия.ИмяФормы;
	ПараметрыФормы = ПараметрыОткрытия.ПараметрыФормы;

	Если Не ЗначениеЗаполнено(ИмяФормы) Или ПараметрыФормы = Неопределено Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Не удалось подготовить параметры типового отчёта.'"));
		Возврат;
	КонецЕсли;

	ОткрытьФорму(ИмяФормы, ПараметрыФормы, , Истина);

КонецПроцедуры

#КонецОбласти
