Функция НайтиПоНаименованию(Менеджер, Наименование)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Т.Ссылка КАК Ссылка
	|ИЗ
	|	&Таблица КАК Т
	|ГДЕ
	|	Т.Наименование = &Наименование
	|	И НЕ Т.ПометкаУдаления";
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Таблица", Менеджер.ПустаяСсылка().Метаданные().ПолноеИмя());
	Запрос.УстановитьПараметр("Наименование", Наименование);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

