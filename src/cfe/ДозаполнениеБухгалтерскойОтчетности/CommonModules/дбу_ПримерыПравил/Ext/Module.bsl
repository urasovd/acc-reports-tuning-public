Функция НайтиИлиСоздатьПравилоСверткаФормула(
	Наименование, Профиль, СчетA, СчетB, Формула, Перезаписать, Активно)

	Ссылка = НайтиПравилоПрофиля(Профиль, Наименование);
	Если ЗначениеЗаполнено(Ссылка) И Не Перезаписать Тогда
		Возврат Ссылка;
	КонецЕсли;

	Если ЗначениеЗаполнено(Ссылка) Тогда
		Объект = Ссылка.ПолучитьОбъект();
		Объект.Операнды.Очистить();
		Объект.Цели.Очистить();
	Иначе
		Объект = Справочники.дбу_ПравилаДоработки.СоздатьЭлемент();
		Объект.Владелец = Профиль;
		Объект.Наименование = Наименование;
	КонецЕсли;

	Объект.ВидПравила = Перечисления.дбу_ВидыПравил.СверткаСчетов;
	Объект.Раздел = Перечисления.дбу_РазделыБухОтчетности.Баланс;
	Объект.ПрефиксРасшифровки = "КДР: ";
	Объект.Приоритет = 150;
	Объект.Активно = Активно;
	Объект.Формула = Формула;

	ЗаполнитьОперандСКД(Объект, "A", СчетA);
	ЗаполнитьОперандСКД(Объект, "B", ?(ЗначениеЗаполнено(СчетB), СчетB, СчетA));

	СтрокаИсточник = Объект.Цели.Добавить();
	СтрокаИсточник.КодСтрокиФСБУ = "1250";
	СтрокаИсточник.Колонка = Перечисления.дбу_КолонкиПоказателя.ВсеПериоды;
	СтрокаИсточник.Действие = Перечисления.дбу_ДействияСПоказателем.УменьшитьТиповое;

	СтрокаПриемник = Объект.Цели.Добавить();
	СтрокаПриемник.КодСтрокиФСБУ = "1230";
	СтрокаПриемник.Колонка = Перечисления.дбу_КолонкиПоказателя.ВсеПериоды;
	СтрокаПриемник.Действие = Перечисления.дбу_ДействияСПоказателем.Добавить;

	Объект.Записать();
	Возврат Объект.Ссылка;

