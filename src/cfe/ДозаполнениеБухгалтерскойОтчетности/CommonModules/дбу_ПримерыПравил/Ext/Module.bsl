Функция НайтиИлиСоздатьЗапросСКДПоСчету(Счет, Наименование, Перезаписать)

	Ссылка = НайтиПоНаименованию(Справочники.дбу_ЗапросыДанных, Наименование);
	Если ЗначениеЗаполнено(Ссылка) И Не Перезаписать Тогда
		Возврат Ссылка;
	КонецЕсли;

	ИмяМакета = дбу_СКДОперандов.ИмяМакетаСКДПоСчетам(Ложь);
	СхемаКомпоновки = дбу_СКДОперандов.ПолучитьСхемуКомпоновки(ИмяМакета);
	НастройкиКомпоновки = СхемаКомпоновки.НастройкиПоУмолчанию;
	ПоляКомпоновки = СхемаКомпоновки.НаборыДанных[0].Поля;

	дбу_СКДОперандов.НастроитьСубконтоИОтборПоСчету(Счет, "Счет", "Субконто", ПоляКомпоновки, НастройкиКомпоновки);
	НастройкиКомпоновки.Выбор.Элементы.Очистить();
	дбу_СКДОперандов.ДобавитьВыбранноеПоле(НастройкиКомпоновки, "СКД");

	ПакетЗапроса = дбу_СКДОперандов.СкомпилироватьПакетЗапроса(СхемаКомпоновки, НастройкиКомпоновки, Счет, , "");

	Если ЗначениеЗаполнено(Ссылка) Тогда
		Объект = Ссылка.ПолучитьОбъект();
	Иначе
		Объект = Справочники.дбу_ЗапросыДанных.СоздатьЭлемент();
		Объект.Наименование = Наименование;
	КонецЕсли;

	дбу_СКДОперандов.ОбновитьРеквизитыЗапросаИзПакета(Объект, ПакетЗапроса);
	Объект.Записать();

	Возврат Объект.Ссылка;

КонецФункции

Функция СформироватьПротоколПолигон(Организация, ПериодПрименения, Профиль, БазовыйРезультат)

	СтрокиПротокола = Новый Массив;
