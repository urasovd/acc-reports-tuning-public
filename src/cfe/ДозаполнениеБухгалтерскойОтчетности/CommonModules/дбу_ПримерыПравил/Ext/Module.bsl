	СтрокиПротокола.Добавить("");
	СтрокиПротокола.Добавить(НСтр("ru = 'Дополнительные правила полигона:'"));
	СтрокиПротокола.Добавить(НСтр("ru = '  • Макс(A-B,0) — формула шаг 9'"));
	СтрокиПротокола.Добавить(НСтр("ru = '  • ?(A>0,A,0) — условная формула'"));
	СтрокиПротокола.Добавить(НСтр("ru = '  • ДО 51↔57 — drill-down в анализ счёта'"));
	СтрокиПротокола.Добавить(НСтр("ru = '  • Отбор СКД 62.01 — при наличии счёта в плане'"));
	СтрокиПротокола.Добавить(НСтр("ru = '  • Неактивное правило — контроль флага Активно'"));
	СтрокиПротокола.Добавить("");
	СтрокиПротокола.Добавить(НСтр("ru = 'См. docs/urdv-dozapolnenie-buh-otchetnosti/12-план-тестирования.md'"));

	Возврат СтрСоединить(СтрокиПротокола, Символы.ПС);

