#Область ПрограммныйИнтерфейс

// Создаёт (или обновляет) демонстрационную цепочку:
// профиль → правило «добавить СКД 51 в строку 1250» → применение для организации.
//
// Параметры:
//  Организация - СправочникСсылка.Организации
//  ПериодПрименения - Дата - месяц применения направления (берётся начало месяца)
//  ПерезаписатьСуществующее - Булево - обновить найденные демо-объекты
//
// Возвращаемое значение:
//  Структура - Успех, Правило, Профиль, Протокол, ТекстОшибки
//
Функция СоздатьПримерДобавлениеСчета51(Организация, ПериодПрименения, ПерезаписатьСуществующее = Истина) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Правило", Справочники.дбу_ПравилаДоработки.ПустаяСсылка());
	Результат.Вставить("Профиль", Справочники.дбу_ПрофилиДоработки.ПустаяСсылка());
	Результат.Вставить("Протокол", "");
	Результат.Вставить("ТекстОшибки", "");

	Если Не ЗначениеЗаполнено(Организация) Тогда
		Результат.ТекстОшибки = НСтр("ru = 'Укажите организацию.'");
		Возврат Результат;
	КонецЕсли;

	Строка1250 = СтрокаОтчетностиПоКоду("1250", Перечисления.дбу_РазделыБухОтчетности.Баланс);
	Если Не ЗначениеЗаполнено(Строка1250) Тогда
		Результат.ТекстОшибки = НСтр("ru = 'Не найдена строка 1250 в макете баланса.'");
		Возврат Результат;
	КонецЕсли;

	Счет51 = ПланыСчетов.Хозрасчетный.НайтиПоКоду("51");
	Если Не ЗначениеЗаполнено(Счет51) Тогда
		Результат.ТекстОшибки = НСтр("ru = 'Не найден счёт 51 в плане счетов Хозрасчетный.'");
		Возврат Результат;
	КонецЕсли;

	ИмяПрофиля = "Демо: добавление остатка по счёту 51";
	ИмяПравила = "Добавить остаток по счёту 51 в строку 1250 (пример)";

	Профиль = НайтиИлиСоздатьПрофиль(ИмяПрофиля, ПерезаписатьСуществующее);
	Правило = НайтиИлиСоздатьПравилоДобавлениеСчет51(ИмяПравила, Профиль, Счет51, ПерезаписатьСуществующее, Истина);

	ЗаписатьПрименениеПрофиля(Организация, Профиль, ПериодПрименения);

	Протокол = СформироватьПротокол(Организация, ПериодПрименения, Профиль, Правило);

	Результат.Успех = Истина;
	Результат.Правило = Правило;
	Результат.Профиль = Профиль;
	Результат.Протокол = Протокол;

	Возврат Результат;

КонецФункции

// Создаёт полный демо-набор: все 4 вида правил в одном профиле (по умолчанию активен перенос).
//
Функция СоздатьДемоНаборДляПроверки(Организация, ПериодПрименения, ПерезаписатьСуществующее = Истина) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Правило", Справочники.дбу_ПравилаДоработки.ПустаяСсылка());
	Результат.Вставить("ПравилоКорректировка", Справочники.дбу_ПравилаДоработки.ПустаяСсылка());
	Результат.Вставить("ПравилоПеренос", Справочники.дбу_ПравилаДоработки.ПустаяСсылка());
	Результат.Вставить("ПравилоСвертка", Справочники.дбу_ПравилаДоработки.ПустаяСсылка());
	Результат.Вставить("ПравилоЗапрос", Справочники.дбу_ПравилаДоработки.ПустаяСсылка());
	Результат.Вставить("ЗапросДанных", Справочники.дбу_ЗапросыДанных.ПустаяСсылка());
	Результат.Вставить("Профиль", Справочники.дбу_ПрофилиДоработки.ПустаяСсылка());
	Результат.Вставить("Протокол", "");
	Результат.Вставить("ТекстОшибки", "");

	Если Не ЗначениеЗаполнено(Организация) Тогда
		Результат.ТекстОшибки = НСтр("ru = 'Укажите организацию.'");
		Возврат Результат;
	КонецЕсли;

	Строка1230 = СтрокаОтчетностиПоКоду("1230", Перечисления.дбу_РазделыБухОтчетности.Баланс);
	Строка1250 = СтрокаОтчетностиПоКоду("1250", Перечисления.дбу_РазделыБухОтчетности.Баланс);
	Если Не ЗначениеЗаполнено(Строка1230) Или Не ЗначениеЗаполнено(Строка1250) Тогда
		Результат.ТекстОшибки = НСтр("ru = 'Не найдены строки 1230 и/или 1250 в макете баланса.'");
		Возврат Результат;
	КонецЕсли;

	Счет51 = ПланыСчетов.Хозрасчетный.НайтиПоКоду("51");
	Счет57 = ПланыСчетов.Хозрасчетный.НайтиПоКоду("57");
	Если Не ЗначениеЗаполнено(Счет51) Тогда
		Результат.ТекстОшибки = НСтр("ru = 'Не найден счёт 51 в плане счетов Хозрасчетный.'");
		Возврат Результат;
	КонецЕсли;

	ИмяПрофиля = "Демо: все виды правил КДР";

	Профиль = НайтиИлиСоздатьПрофильДемоНабор(ИмяПрофиля, ПерезаписатьСуществующее);
	ЗапросДанных = НайтиИлиСоздатьЗапросДемоСКД51(ПерезаписатьСуществующее);

	ПравилоКорректировка = НайтиИлиСоздатьПравилоДобавлениеСчет51(
		"Демо: корректировка — добавить СКД 51 в 1250", Профиль, Счет51, ПерезаписатьСуществующее, Ложь);
	ПравилоПеренос = НайтиИлиСоздатьПравилоПереносСчет51(
		"Демо: перенос — СКД 51 из 1230 в 1250", Профиль, Счет51, ПерезаписатьСуществующее, Истина);
	ПравилоСвертка = НайтиИлиСоздатьПравилоСверткаСчет51(
		"Демо: свёртка — нетто СКД 51 минус СКД 57", Профиль, Счет51, Счет57, ПерезаписатьСуществующее, Ложь);
	ПравилоЗапрос = НайтиИлиСоздатьПравилоЗапросСчет51(
		"Демо: произвольный запрос — СКД 51 в 1250", Профиль, ЗапросДанных, ПерезаписатьСуществующее, Ложь);

	ЗаписатьПрименениеПрофиля(Организация, Профиль, ПериодПрименения);

	ОписаниеПравил = Новый Структура;
	ОписаниеПравил.Вставить("Корректировка", ПравилоКорректировка);
	ОписаниеПравил.Вставить("Перенос", ПравилоПеренос);
	ОписаниеПравил.Вставить("Свертка", ПравилоСвертка);
	ОписаниеПравил.Вставить("Запрос", ПравилоЗапрос);

	Протокол = СформироватьПротоколДемоНабор(
		Организация, ПериодПрименения, Профиль, ОписаниеПравил, ЗапросДанных);

	Результат.Успех = Истина;
	Результат.Правило = ПравилоПеренос;
	Результат.ПравилоКорректировка = ПравилоКорректировка;
	Результат.ПравилоПеренос = ПравилоПеренос;
	Результат.ПравилоСвертка = ПравилоСвертка;
	Результат.ПравилоЗапрос = ПравилоЗапрос;
	Результат.ЗапросДанных = ЗапросДанных;
	Результат.Профиль = Профиль;
	Результат.Протокол = Протокол;

	Возврат Результат;

КонецФункции

// Создаёт расширенный полигон «Полигон КДР»: базовые 4 вида + формулы, СКД-отбор, анализ счёта, неактивное правило.
//
Функция СоздатьПолигонТестирования(Организация, ПериодПрименения, ПерезаписатьСуществующее = Истина) Экспорт

	Результат = СоздатьДемоНаборДляПроверки(Организация, ПериодПрименения, ПерезаписатьСуществующее);
	Если Не Результат.Успех Тогда
		Возврат Результат;
	КонецЕсли;

	Счет51 = ПланыСчетов.Хозрасчетный.НайтиПоКоду("51");
	Счет57 = ПланыСчетов.Хозрасчетный.НайтиПоКоду("57");
	Счет6201 = ПланыСчетов.Хозрасчетный.НайтиПоКоду("62.01");

	ПрофильПолигон = НайтиИлиСоздатьПрофильПолигон("Полигон КДР", ПерезаписатьСуществующее);

	ПравилоМакс = НайтиИлиСоздатьПравилоСверткаФормула(
		"Полигон: нетто Макс(A-B,0)", ПрофильПолигон, Счет51, Счет57,
		"Макс(A-B,0)", ПерезаписатьСуществующее, Истина);
	ПравилоУсловие = НайтиИлиСоздатьПравилоСверткаФормула(
		"Полигон: условие ?(A>0,A,0)", ПрофильПолигон, Счет51, Счет57,
		"?(A>0,A,0)", ПерезаписатьСуществующее, Ложь);
	ПравилоАнализ = НайтиИлиСоздатьПравилоОборотМеждуСчетами(
		"Полигон: ДО 51↔57", ПрофильПолигон, Счет51, Счет57, ПерезаписатьСуществующее, Ложь);
	ПравилоНеактивное = НайтиИлиСоздатьПравилоДобавлениеСчет51(
		"Полигон: неактивное (контроль)", ПрофильПолигон, Счет51, ПерезаписатьСуществующее, Ложь);

	ЗапросСКД = Справочники.дбу_ЗапросыДанных.ПустаяСсылка();
	ПравилоОтборСКД = Справочники.дбу_ПравилаДоработки.ПустаяСсылка();
	Если ЗначениеЗаполнено(Счет6201) Тогда
		ЗапросСКД = НайтиИлиСоздатьЗапросСКДПоСчету(Счет6201, "Полигон: СКД 62.01", ПерезаписатьСуществующее);
		ПравилоОтборСКД = НайтиИлиСоздатьПравилоОтборСКД(
			"Полигон: отбор СКД 62.01", ПрофильПолигон, ЗапросСКД, ПерезаписатьСуществующее, Ложь);
	КонецЕсли;

	ЗаписатьПрименениеПрофиля(Организация, ПрофильПолигон, ПериодПрименения);

	Результат.Профиль = ПрофильПолигон;
	Результат.Правило = ПравилоМакс;
	Результат.Протокол = СформироватьПротоколПолигон(
		Организация, ПериодПрименения, ПрофильПолигон, Результат);

	Возврат Результат;

КонецФункции

// Создаёт только правило переноса 1230 → 1250 (для отдельной проверки шага 2).
//
Функция СоздатьПримерПереносСчета51(Организация, ПериодПрименения, ПерезаписатьСуществующее = Истина) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Правило", Справочники.дбу_ПравилаДоработки.ПустаяСсылка());
	Результат.Вставить("Профиль", Справочники.дбу_ПрофилиДоработки.ПустаяСсылка());
	Результат.Вставить("Протокол", "");
	Результат.Вставить("ТекстОшибки", "");

	Если Не ЗначениеЗаполнено(Организация) Тогда
		Результат.ТекстОшибки = НСтр("ru = 'Укажите организацию.'");
		Возврат Результат;
	КонецЕсли;

	Строка1230 = СтрокаОтчетностиПоКоду("1230", Перечисления.дбу_РазделыБухОтчетности.Баланс);
	Строка1250 = СтрокаОтчетностиПоКоду("1250", Перечисления.дбу_РазделыБухОтчетности.Баланс);
	Если Не ЗначениеЗаполнено(Строка1230) Или Не ЗначениеЗаполнено(Строка1250) Тогда
		Результат.ТекстОшибки = НСтр("ru = 'Не найдены строки 1230 и/или 1250 в макете баланса.'");
		Возврат Результат;
	КонецЕсли;

	Счет51 = ПланыСчетов.Хозрасчетный.НайтиПоКоду("51");
	Если Не ЗначениеЗаполнено(Счет51) Тогда
		Результат.ТекстОшибки = НСтр("ru = 'Не найден счёт 51.'");
		Возврат Результат;
	КонецЕсли;

	ИмяПрофиля = "Демо: перенос остатка 51";
	ИмяПравила = "Перенос СКД 51: 1230 → 1250 (пример)";

	Профиль = НайтиИлиСоздатьПрофиль(ИмяПрофиля, ПерезаписатьСуществующее);
	Правило = НайтиИлиСоздатьПравилоПереносСчет51(ИмяПравила, Профиль, Счет51, ПерезаписатьСуществующее);

	ЗаписатьПрименениеПрофиля(Организация, Профиль, ПериодПрименения);

	Результат.Успех = Истина;
	Результат.Правило = Правило;
	Результат.Профиль = Профиль;
	Результат.Протокол = СформироватьПротоколПеренос(
		Организация, ПериодПрименения, Профиль, Правило);

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СтрокаОтчетностиПоКоду(КодСтроки, Раздел)

	Описание = дбу_СтруктураОтчетности.ОписаниеСтроки(Раздел, КодСтроки);
	Если Описание = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Возврат Описание.КодСтроки;

КонецФункции

Функция НайтиИлиСоздатьПрофиль(Наименование, Перезаписать)

	Ссылка = НайтиПоНаименованию(Справочники.дбу_ПрофилиДоработки, Наименование);
	Если ЗначениеЗаполнено(Ссылка) И Не Перезаписать Тогда
		Возврат Ссылка;
	КонецЕсли;

	Если ЗначениеЗаполнено(Ссылка) Тогда
		Объект = Ссылка.ПолучитьОбъект();
	Иначе
		Объект = Справочники.дбу_ПрофилиДоработки.СоздатьЭлемент();
		Объект.Наименование = Наименование;
	КонецЕсли;

	Объект.Комментарий = НСтр("ru = 'Демо-профиль: одно правило добавления СКД 51.'");
	Объект.Записать();

	Возврат Объект.Ссылка;

КонецФункции

Функция НайтиИлиСоздатьПрофильДемоНабор(Наименование, Перезаписать)

	Ссылка = НайтиПоНаименованию(Справочники.дбу_ПрофилиДоработки, Наименование);
	Если ЗначениеЗаполнено(Ссылка) И Не Перезаписать Тогда
		Возврат Ссылка;
	КонецЕсли;

	Если ЗначениеЗаполнено(Ссылка) Тогда
		Объект = Ссылка.ПолучитьОбъект();
	Иначе
		Объект = Справочники.дбу_ПрофилиДоработки.СоздатьЭлемент();
		Объект.Наименование = Наименование;
	КонецЕсли;

	Объект.Комментарий = НСтр("ru = 'Демо-профиль: по одному примеру на каждый вид правила (счёт 51). Включайте по одному правилу для проверки.'");
	Объект.Записать();

	Возврат Объект.Ссылка;

КонецФункции

Функция НайтиИлиСоздатьПравилоДобавлениеСчет51(Наименование, Профиль, Счет51, Перезаписать, Активно)

	Ссылка = НайтиПравилоПрофиля(Профиль, Наименование);
	Если ЗначениеЗаполнено(Ссылка) И Не Перезаписать Тогда
		Возврат Ссылка;
	КонецЕсли;

	Если ЗначениеЗаполнено(Ссылка) Тогда
		Объект = Ссылка.ПолучитьОбъект();
		Объект.Операнды.Очистить();
		Объект.Цели.Очистить();
	Иначе
		Объект = Справочники.дбу_ПравилаДоработки.СоздатьЭлемент();
		Объект.Владелец = Профиль;
		Объект.Наименование = Наименование;
	КонецЕсли;

	Объект.ВидПравила = Перечисления.дбу_ВидыПравил.КорректировкаПоказателя;
	Объект.Раздел = Перечисления.дбу_РазделыБухОтчетности.Баланс;
	Объект.ПрефиксРасшифровки = "КДР: ";
	Объект.Приоритет = 200;
	Объект.Активно = Активно;
	Объект.Формула = "A";
	Объект.Комментарий =
		НСтр("ru = 'Демо: добавление СКД 51 в 1250. По умолчанию выключено — включите для сравнения с переносом.'");

	ЗаполнитьОперандСчет51(Объект, Счет51);

	СтрокаЦели = Объект.Цели.Добавить();
	СтрокаЦели.КодСтрокиФСБУ = "1250";
	СтрокаЦели.Колонка = Перечисления.дбу_КолонкиПоказателя.ВсеПериоды;
	СтрокаЦели.Действие = Перечисления.дбу_ДействияСПоказателем.Добавить;

	Объект.Записать();

	Возврат Объект.Ссылка;

КонецФункции

Функция НайтиИлиСоздатьПравилоПереносСчет51(Наименование, Профиль, Счет51, Перезаписать, Активно = Истина)

	Ссылка = НайтиПравилоПрофиля(Профиль, Наименование);
	Если ЗначениеЗаполнено(Ссылка) И Не Перезаписать Тогда
		Возврат Ссылка;
	КонецЕсли;

	Если ЗначениеЗаполнено(Ссылка) Тогда
		Объект = Ссылка.ПолучитьОбъект();
		Объект.Операнды.Очистить();
		Объект.Цели.Очистить();
	Иначе
		Объект = Справочники.дбу_ПравилаДоработки.СоздатьЭлемент();
		Объект.Владелец = Профиль;
		Объект.Наименование = Наименование;
	КонецЕсли;

	Объект.ВидПравила = Перечисления.дбу_ВидыПравил.ПереносМеждуСтроками;
	Объект.Раздел = Перечисления.дбу_РазделыБухОтчетности.Баланс;
	Объект.ПрефиксРасшифровки = "КДР: ";
	Объект.Приоритет = 110;
	Объект.Активно = Активно;
