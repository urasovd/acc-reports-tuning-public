Функция НайтиПравилоПрофиля(Профиль, Наименование)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Правила.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.дбу_ПравилаДоработки КАК Правила
	|ГДЕ
	|	Правила.Владелец = &Профиль
	|	И Правила.Наименование = &Наименование
	|	И НЕ Правила.ПометкаУдаления";
	Запрос.УстановитьПараметр("Профиль", Профиль);
	Запрос.УстановитьПараметр("Наименование", Наименование);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Возврат Справочники.дбу_ПравилаДоработки.ПустаяСсылка();

