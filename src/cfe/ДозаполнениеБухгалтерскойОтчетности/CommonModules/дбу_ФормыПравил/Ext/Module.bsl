// Подсказки и параметры форм настройки правил КДР.

#Область ПрограммныйИнтерфейс

// Возвращает текст подсказки по виду правила.
Функция ТекстПодсказкиВидаПравила(ВидПравила) Экспорт

	Если ВидПравила = Перечисления.дбу_ВидыПравил.ПереносМеждуСтроками Тогда
		Возврат НСтр("ru = 'Перенос: первая цель — источник (уменьшение), вторая и далее — приёмник (добавление). Минимум 2 цели в одном разделе.'");
	ИначеЕсли ВидПравила = Перечисления.дбу_ВидыПравил.СверткаСчетов Тогда
		Возврат НСтр("ru = 'Свёртка: формула A-B (или иная) по операндам; цели с действием Уменьшить/Добавить.'");
	ИначеЕсли ВидПравила = Перечисления.дбу_ВидыПравил.КорректировкаПоказателя Тогда
		Возврат НСтр("ru = 'Корректировка: добавление суммы к показателю строки (действие Добавить).'");
	ИначеЕсли ВидПравила = Перечисления.дбу_ВидыПравил.ПроизвольныйЗапрос Тогда
		Возврат НСтр("ru = 'Произвольный запрос: операнд со способом Запрос и ссылкой на дбу_ЗапросыДанных.'");
	КонецЕсли;

	Возврат "";

КонецФункции

// Возвращает текст подсказки по формуле.
Функция ТекстПодсказкиФормулы(ВидПравила) Экспорт

	Если ВидПравила = Перечисления.дбу_ВидыПравил.СверткаСчетов Тогда
		Возврат НСтр("ru = 'Формула: идентификаторы A, B…, операции + −, функции Мин(), Макс(), ?(условие, да, нет). Пример: A-B или Макс(A-B,0).'");
	ИначеЕсли ВидПравила = Перечисления.дбу_ВидыПравил.ПроизвольныйЗапрос Тогда
		Возврат НСтр("ru = 'Формула не используется — сумма берётся из запроса операнда.'");
	Иначе
		Возврат НСтр("ru = 'Формула: операнд A или выражение; допускаются Мин(), Макс(), ?(условие, да, нет).'");
	КонецЕсли;

КонецФункции

// Возвращает краткую подсказку на форме (подробности — в справке F1).
//
Функция ТекстИнструкцииФормы() Экспорт

	Возврат НСтр("ru = 'Шапка: вид правила, раздел, формула. Подробная инструкция по всем сценариям — F1 (Справка).'");

КонецФункции

// Возвращает краткую подсказку на вкладке «Операнды».
//
Функция ТекстИнструкцииОперанды() Экспорт

	Возврат НСтр("ru = 'Состав полей зависит от способа расчёта. Таблица способов и примеры — F1 (Справка).'");

КонецФункции

// Возвращает краткую подсказку на вкладке «Цели».
//
Функция ТекстИнструкцииЦели() Экспорт

	Возврат НСтр("ru = 'Строки отчёта и действие с показателем. Сценарии переноса и свёртки — F1 (Справка).'");

КонецФункции

// Возвращает настройки доступности полей строки операнда по способу расчёта.
//
// Возвращаемое значение:
//  Структура - флаги доступности и видимости полей формы.
//
Функция НастройкиДоступностиОперанда(СпособРасчета) Экспорт

	Настройки = Новый Структура;
	Настройки.Вставить("СчетДоступен", Ложь);
	Настройки.Вставить("КорСчетДоступен", Ложь);
	Настройки.Вставить("ЗнакСальдоДоступен", Ложь);
	Настройки.Вставить("ВидыСубконтоДоступен", Ложь);
	Настройки.Вставить("ЗапросДанныхВидим", Ложь);
	Настройки.Вставить("ЗапросДанныхРедактирование", Ложь);
	Настройки.Вставить("КомандаНастроитьОтборСКД", Ложь);

	Если Не ЗначениеЗаполнено(СпособРасчета) Тогда
		Возврат Настройки;
	КонецЕсли;

	Если СпособРасчета = Перечисления.дбу_СпособыРасчетаОперанда.ОтборСКД Тогда

		Настройки.СчетДоступен = Истина;
		Настройки.КорСчетДоступен = Истина;
		Настройки.ВидыСубконтоДоступен = Истина;
		Настройки.ЗапросДанныхВидим = Истина;
		Настройки.КомандаНастроитьОтборСКД = Истина;
		Возврат Настройки;

	КонецЕсли;

	Если СпособРасчета = Перечисления.дбу_СпособыРасчетаОперанда.Запрос Тогда

		Настройки.ЗапросДанныхВидим = Истина;
		Настройки.ЗапросДанныхРедактирование = Истина;
		Возврат Настройки;

	КонецЕсли;

	Если СпособРасчета = Перечисления.дбу_СпособыРасчетаОперанда.ДО
		Или СпособРасчета = Перечисления.дбу_СпособыРасчетаОперанда.КО Тогда

		Настройки.СчетДоступен = Истина;
		Настройки.КорСчетДоступен = Истина;
		Возврат Настройки;

	КонецЕсли;

	Если Перечисления.дбу_СпособыРасчетаОперанда.СвернутоеСальдо().Найти(СпособРасчета) <> Неопределено Тогда

		Настройки.СчетДоступен = Истина;
		Настройки.ЗнакСальдоДоступен = Истина;
		Настройки.ВидыСубконтоДоступен = Истина;
		Возврат Настройки;

	КонецЕсли;

	Если Перечисления.дбу_СпособыРасчетаОперанда.РазвернутоеСальдо().Найти(СпособРасчета) <> Неопределено Тогда

		Настройки.СчетДоступен = Истина;
		Настройки.ВидыСубконтоДоступен = Истина;
		Возврат Настройки;

	КонецЕсли;

	Возврат Настройки;

КонецФункции

// Возвращает настройки доступности полей шапки и целей по виду правила.
//
Функция НастройкиДоступностиПравила(ВидПравила) Экспорт

	Настройки = Новый Структура;
	ЭтоПроизвольныйЗапрос = ВидПравила = Перечисления.дбу_ВидыПравил.ПроизвольныйЗапрос;
	ЭтоСвертка = ВидПравила = Перечисления.дбу_ВидыПравил.СверткаСчетов;

	Настройки.Вставить("ФормулаДоступна", Не ЭтоПроизвольныйЗапрос);
	Настройки.Вставить("СторонаСверткиДоступна", ЭтоСвертка);

	Возврат Настройки;

КонецФункции

// Очищает в целях поля, не применимые к выбранному виду правила.
//
Процедура СкорректироватьЦелиПоВидуПравила(Цели, ВидПравила) Экспорт

	Если ВидПравила = Перечисления.дбу_ВидыПравил.СверткаСчетов Тогда
		Возврат;
	КонецЕсли;

	Для Каждого СтрокаЦели Из Цели Цикл
		СтрокаЦели.СторонаСвертки = Перечисления.дбу_СторонаСвертки.ПустаяСсылка();
	КонецЦикла;

КонецПроцедуры

// Очищает в строке операнда поля, не применимые к выбранному способу расчёта.
//
Процедура СкорректироватьСтрокуОперандаПоСпособу(СтрокаОперанда) Экспорт

	Если СтрокаОперанда = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Настройки = НастройкиДоступностиОперанда(СтрокаОперанда.СпособРасчета);

	Если Не Настройки.КорСчетДоступен Тогда
		СтрокаОперанда.КорСчет = ПланыСчетов.Хозрасчетный.ПустаяСсылка();
	КонецЕсли;

	Если Не Настройки.ЗнакСальдоДоступен Тогда
		СтрокаОперанда.ЗнакСальдо = "";
	КонецЕсли;

	Если Не Настройки.ВидыСубконтоДоступен Тогда
		СтрокаОперанда.ВидыСубконто = "";
	КонецЕсли;

	Если Не Настройки.ЗапросДанныхВидим Тогда
		СтрокаОперанда.ЗапросДанных = Справочники.дбу_ЗапросыДанных.ПустаяСсылка();
	КонецЕсли;

	Если Не Настройки.СчетДоступен Тогда
		СтрокаОперанда.Счет = ПланыСчетов.Хозрасчетный.ПустаяСсылка();
	КонецЕсли;

	СкорректироватьОборотныеВидыСубконто(СтрокаОперанда);

КонецПроцедуры

// Возвращает Истина для способов расчёта по остаткам (свёрнутое и развёрнутое сальдо).
//
Функция ЭтоСпособСальдо(СпособРасчета) Экспорт

	Если Не ЗначениеЗаполнено(СпособРасчета) Тогда
		Возврат Ложь;
	КонецЕсли;

	Если Перечисления.дбу_СпособыРасчетаОперанда.СвернутоеСальдо().Найти(СпособРасчета) <> Неопределено Тогда
		Возврат Истина;
	КонецЕсли;

	Если Перечисления.дбу_СпособыРасчетаОперанда.РазвернутоеСальдо().Найти(СпособРасчета) <> Неопределено Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат Ложь;

КонецФункции

// Удаляет из детализации виды субконто «только обороты», если способ расчёта — сальдо.
//
Процедура СкорректироватьОборотныеВидыСубконто(СтрокаОперанда) Экспорт

	Если СтрокаОперанда = Неопределено
		Или Не ЭтоСпособСальдо(СтрокаОперанда.СпособРасчета)
		Или Не ЗначениеЗаполнено(СтрокаОперанда.ВидыСубконто)
		Или Не ЗначениеЗаполнено(СтрокаОперанда.Счет) Тогда
		Возврат;
	КонецЕсли;

	СтрокаОперанда.ВидыСубконто = СтрокаВидовСубконтоБезОборотных(СтрокаОперанда.Счет, СтрокаОперанда.ВидыСубконто);

КонецПроцедуры

// Возвращает заголовок вида субконто для формы выбора детализации.
//
Функция ЗаголовокВидаСубконтоДляВыбора(ВидСубконто, ТолькоОбороты) Экспорт

	Заголовок = Строка(ВидСубконто);

	Если ТолькоОбороты Тогда
		Заголовок = Заголовок + НСтр("ru = ' (только обороты)'");
	КонецЕсли;

	Возврат Заголовок;

КонецФункции

// Возвращает подсказку для оборотного субконто на форме выбора детализации.
//
Функция ПодсказкаОборотногоСубконто(ДляСпособаСальдо = Ложь) Экспорт

	Если ДляСпособаСальдо Тогда
		Возврат НСтр(
			"ru = 'По этому субконто остатки не ведутся. Для способов расчёта по сальдо детализация недоступна. Используйте обороты (ДО/КО) или отбор СКД.'");
	КонецЕсли;

	Возврат НСтр("ru = 'По этому субконто ведутся только обороты, остатки не хранятся.'");

КонецФункции

// Возвращает данные правила из формы/объекта для пробного расчёта.
//
Функция ДанныеПравилаДляПробногоРасчета(ПравилоОбъект) Экспорт

	Данные = Новый Структура;
	Данные.Вставить("Ссылка", ПравилоОбъект.Ссылка);
	Данные.Вставить("Наименование", ПравилоОбъект.Наименование);
	Данные.Вставить("ВидПравила", ПравилоОбъект.ВидПравила);
	Данные.Вставить("Раздел", ПравилоОбъект.Раздел);
	Данные.Вставить("Формула", ПравилоОбъект.Формула);
	Данные.Вставить("ПрефиксРасшифровки", ПравилоОбъект.ПрефиксРасшифровки);
	Данные.Вставить("Владелец", ПравилоОбъект.Владелец);
	Данные.Вставить("Операнды", ПравилоОбъект.Операнды.Выгрузить());
	Данные.Вставить("Цели", ПравилоОбъект.Цели.Выгрузить());

	Возврат Данные;

КонецФункции

// Параметры открытия формы выбора строки отчётности.
Функция ПараметрыВыбораСтроки(Раздел, ВерсияФормы = "",
	ДеревоДанныхРазделов = Неопределено) Экспорт

	Если Не ЗначениеЗаполнено(ВерсияФормы) Тогда
		ВерсияФормы = дбу_СтруктураОтчетности.ВерсияФормыПоУмолчанию();
	КонецЕсли;

	Параметры = Новый Структура;
	Параметры.Вставить("Раздел", Раздел);
	Параметры.Вставить("ВерсияФормы", ВерсияФормы);
	Если ДеревоДанныхРазделов <> Неопределено Тогда
		Параметры.Вставить("ДеревоДанныхРазделов", ДеревоДанныхРазделов);
	КонецЕсли;
	Возврат Параметры;

КонецФункции

// Возвращает текстовое описание операнда для формы и расшифровки.
// Для СКД/запроса использует ПредставлениеОтбора из справочника запросов данных.
//
Функция СформироватьОписаниеОперанда(СтрокаОперанда) Экспорт

	Если СтрокаОперанда = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	СпособРасчета = СтрокаОперанда.СпособРасчета;

	Если СпособРасчета = Перечисления.дбу_СпособыРасчетаОперанда.ОтборСКД
		Или СпособРасчета = Перечисления.дбу_СпособыРасчетаОперанда.Запрос Тогда

		ОписаниеЗапроса = ОписаниеОперандаИзЗапросаДанных(СтрокаОперанда);
		Если ЗначениеЗаполнено(ОписаниеЗапроса) Тогда
			Возврат ОписаниеЗапроса;
		КонецЕсли;

	КонецЕсли;

	Возврат ОписаниеОперандаУчета(СтрокаОперанда);

КонецФункции

// Возвращает сохранённое или вычисленное описание операнда.
//
Функция ОписаниеОперандаДляОтображения(СтрокаОперанда) Экспорт

	Если СтрокаОперанда = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Представление = ПредставлениеОперандаИзСтроки(СтрокаОперанда);
	Если ЗначениеЗаполнено(Представление) Тогда
		Возврат Представление;
	КонецЕсли;

	Возврат СформироватьОписаниеОперанда(СтрокаОперанда);

КонецФункции

// Обновляет представления всех операндов правила.
//
Процедура ОбновитьПредставленияОперандов(Операнды) Экспорт

	Для Каждого СтрокаОперанда Из Операнды Цикл
		СтрокаОперанда.Представление = СформироватьОписаниеОперанда(СтрокаОперанда);
	КонецЦикла;

КонецПроцедуры

// Возвращает строку состояния правила для панели статуса формы.
//
Функция ТекстСтатусаПравила(ВидПравила, Формула, Операнды, Цели) Экспорт

	Части = Новый Массив;
	Части.Добавить(СтрШаблон(НСтр("ru = 'Операндов: %1'"), Операнды.Количество()));
	Части.Добавить(СтрШаблон(НСтр("ru = 'Целей: %1'"), Цели.Количество()));

	Если ВидПравила <> Перечисления.дбу_ВидыПравил.ПроизвольныйЗапрос
		И ЗначениеЗаполнено(СокрЛП(Формула)) Тогда

		Идентификаторы = Новый Массив;
		Для Каждого СтрокаОперанда Из Операнды Цикл
			Идентификатор = ВРег(СокрЛП(Строка(СтрокаОперанда.Идентификатор)));
			Если ЗначениеЗаполнено(Идентификатор) Тогда
				Идентификаторы.Добавить(Идентификатор);
			КонецЕсли;
		КонецЦикла;

		РезультатПроверки = дбу_ДвижокДоработки.ПроверитьФормулу(Формула, Идентификаторы);
		Если РезультатПроверки.Успех Тогда
			Части.Добавить(НСтр("ru = 'Формула: OK'"));
		Иначе
			Части.Добавить(РезультатПроверки.ТекстОшибки);
		КонецЕсли;

		Для Каждого Идентификатор Из Идентификаторы Цикл
			Если СтрНайти(ВРег(Формула), Идентификатор) = 0 Тогда
				Части.Добавить(СтрШаблон(НСтр("ru = 'Операнд %1 не в формуле'"), Идентификатор));
			КонецЕсли;
		КонецЦикла;

	КонецЕсли;

	Возврат СтрСоединить(Части, " · ");

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПредставлениеОперандаИзСтроки(СтрокаОперанда)

	Если ТипЗнч(СтрокаОперанда) = Тип("Структура") Тогда
		Значение = "";
		Если СтрокаОперанда.Свойство("Представление", Значение) Тогда
			Возврат Значение;
		КонецЕсли;
		Возврат "";
	КонецЕсли;

	Возврат СтрокаОперанда.Представление;

КонецФункции

Функция ОписаниеОперандаИзЗапросаДанных(СтрокаОперанда)

	Если Не ЗначениеЗаполнено(СтрокаОперанда.ЗапросДанных) Тогда
		Возврат ОписаниеОперандаУчета(СтрокаОперанда);
	КонецЕсли;

	ПредставлениеОтбора = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаОперанда.ЗапросДанных, "ПредставлениеОтбора");
	Если ЗначениеЗаполнено(ПредставлениеОтбора) Тогда
		Возврат ПредставлениеОтбора;
	КонецЕсли;

	ПакетЗапроса = дбу_СКДОперандов.ПакетЗапросаИзСправочника(СтрокаОперанда.ЗапросДанных);
	Если ПакетЗапроса <> Неопределено И ПакетЗапроса.Свойство("Представление") Тогда
		Возврат ПакетЗапроса.Представление;
	КонецЕсли;

	Возврат ОписаниеОперандаУчета(СтрокаОперанда);

КонецФункции

Функция ОписаниеОперандаУчета(СтрокаОперанда)

	ШаблонСтрокиСальдо = "%ЗнакСальдо% %СпособРасчета% счета %Счет%%ВидыСубконто%";
	ШаблонСтрокиОборот = "%СпособРасчета% по счету %Счет% %Корреспонденция%";

	ЗнакиСальдо = Новый Соответствие;
	ЗнакиСальдо.Вставить("+", "Положительное");
	ЗнакиСальдо.Вставить("-", "Отрицательное");

	Операции = ОписанияСпособовРасчетаОперанда();

	СпособРасчета = СтрокаОперанда.СпособРасчета;

	Если дбу_РасчетАрендныхОбязательств.ЭтоСпособРасчетаАренды(СпособРасчета) Тогда
		Возврат Операции[СпособРасчета];
	КонецЕсли;

	Если СпособРасчета = Перечисления.дбу_СпособыРасчетаОперанда.ДО
		Или СпособРасчета = Перечисления.дбу_СпособыРасчетаОперанда.КО Тогда

		Результат = СтрЗаменить(ШаблонСтрокиОборот, "%СпособРасчета%", Операции[СпособРасчета]);
		Результат = СтрЗаменить(Результат, "%Счет%", Строка(СтрокаОперанда.Счет));

		СтрокаКорреспонденция = "";
		Если ЗначениеЗаполнено(СтрокаОперанда.КорСчет) Тогда
			СтрокаКорреспонденция = "в корреспонденции со счетом " + Строка(СтрокаОперанда.КорСчет);
		КонецЕсли;

		Возврат СокрЛП(СтрЗаменить(Результат, "%Корреспонденция%", СтрокаКорреспонденция));

	КонецЕсли;

	ТекстСпособа = Операции.Получить(СпособРасчета);
	Если ТекстСпособа = Неопределено Тогда
		ТекстСпособа = Строка(СпособРасчета);
	КонецЕсли;

	Результат = СокрЛП(СтрЗаменить(ШаблонСтрокиСальдо, "%ЗнакСальдо%",
		?(ЗначениеЗаполнено(СтрокаОперанда.ЗнакСальдо), ЗнакиСальдо[СтрокаОперанда.ЗнакСальдо], "")));
	Результат = СтрЗаменить(Результат, "%СпособРасчета%",
		?(ЗначениеЗаполнено(СтрокаОперанда.ЗнакСальдо), НРег(ТекстСпособа), ТекстСпособа));
	Результат = СтрЗаменить(Результат, "%Счет%", Строка(СтрокаОперанда.Счет));
	Результат = СтрЗаменить(Результат, "%ВидыСубконто%", ТекстДетализацииСубконто(СтрокаОперанда.ВидыСубконто));

	Возврат СокрЛП(Результат);

КонецФункции

Функция СтрокаВидовСубконтоБезОборотных(Счет, ВидыСубконто)

	МассивВидовСубконто = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ВидыСубконто, ",", , Истина);
	ОтфильтрованныеВиды = Новый Массив;

	Для Каждого ИмяВидаСубконто Из МассивВидовСубконто Цикл

		Если ВидСубконтоСчетаТолькоОбороты(Счет, ИмяВидаСубконто) Тогда
			Продолжить;
		КонецЕсли;

		ОтфильтрованныеВиды.Добавить(ИмяВидаСубконто);

	КонецЦикла;

	Возврат СтрСоединить(ОтфильтрованныеВиды, ", ");

КонецФункции

Функция ВидСубконтоСчетаТолькоОбороты(Счет, ИмяВидаСубконто)

	Для Каждого СтрокаСубконто Из Счет.ВидыСубконто Цикл

		Если СтрокаСубконто.ВидСубконто.ИмяПредопределенныхДанных = ИмяВидаСубконто Тогда
			Возврат СтрокаСубконто.ТолькоОбороты;
		КонецЕсли;

	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция ТекстДетализацииСубконто(ВидыСубконто)

	Если Не ЗначениеЗаполнено(ВидыСубконто) Тогда
		Возврат "";
	КонецЕсли;

	СтрокаСубконто = "";
	МассивВидовСубконто = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ВидыСубконто, ",", Истина, Истина);

	Для Каждого ВидСубконтоИмя Из МассивВидовСубконто Цикл
		СтрокаСубконто = СтрокаСубконто + ?(ЗначениеЗаполнено(СтрокаСубконто), ", ", "")
			+ """" + Строка(ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные[ВидСубконтоИмя]) + """";
	КонецЦикла;

	Возврат ", с детализацией по субконто " + СтрокаСубконто;

КонецФункции

