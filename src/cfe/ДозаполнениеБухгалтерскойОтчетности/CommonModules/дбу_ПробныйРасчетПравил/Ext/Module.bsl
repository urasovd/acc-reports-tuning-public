// Пробный расчёт правила доработки без заполнения отчёта.

#Область ПрограммныйИнтерфейс

// Выполняет пробный расчёт правила по данным формы/объекта.
//
// Параметры:
//  ДанныеПравила - Структура - см. дбу_ФормыПравил.ДанныеПравилаДляПробногоРасчета
//  ПараметрыРасчета - Структура - Организация, НачалоПериода, КонецПериода
//  АдресХранилища - УникальныйИдентификатор - для временного хранилища расшифровок
//
// Возвращаемое значение:
//  Структура - Успех, ТекстОшибки, Итог, ТаблицаСтрок, АдресПараметровРасшифровки
//
Функция ВыполнитьРасчет(ДанныеПравила, ПараметрыРасчета, АдресХранилища) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("ТекстОшибки", "");
	Результат.Вставить("Итог", 0);
	Результат.Вставить("ТаблицаСтрок", Новый ТаблицаЗначений);
	Результат.Вставить("АдресПараметровРасшифровки", "");
	Результат.Вставить("Цели", Новый Массив);
	Результат.Вставить("ПроверкиЦелей", Новый Массив);
	Результат.Вставить("СтатусПроверкиЦелей",
		НСтр("ru = 'Сумма рассчитана, но строка отчёта не проверена. Выберите отчёт-образец.'"));

	Если ДанныеПравила = Неопределено Тогда
		Результат.ТекстОшибки = НСтр("ru = 'Не переданы данные правила.'");
		Возврат Результат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ПараметрыРасчета.Организация) Тогда
		Результат.ТекстОшибки = НСтр("ru = 'Укажите организацию.'");
		Возврат Результат;
	КонецЕсли;

	НормализоватьПериодРасчета(ПараметрыРасчета);
	ПроверкаЦелей = ПроверитьЦелиПробногоРасчета(ДанныеПравила, ПараметрыРасчета);
	Если Не ПроверкаЦелей.Успех Тогда
		Результат.ТекстОшибки = ПроверкаЦелей.ТекстОшибки;
		Возврат Результат;
	КонецЕсли;
	Результат.Цели = ПроверкаЦелей.Цели;
	Результат.ПроверкиЦелей = ПроверкаЦелей.Проверки;
	Результат.СтатусПроверкиЦелей = ПроверкаЦелей.СтатусПроверкиЦелей;

	КонтекстПравила = КонтекстПробногоРасчета(ДанныеПравила, ПараметрыРасчета);
	ИмяРаздела = ИмяРазделаДляРасшифровки(ДанныеПравила.Раздел);
	ЗначенияОперандов = РассчитатьЗначенияОперандов(ДанныеПравила, ПараметрыРасчета);

	Формула = ФормулаДляПробногоРасчета(ДанныеПравила);
	Попытка
		Итог = дбу_ДвижокДоработки.РассчитатьСуммуФормулы(Формула, ЗначенияОперандов);
	Исключение
		Результат.ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Результат;
	КонецПопытки;

	ТаблицаСтрок = ТаблицаСтрокРасшифровки();
	ПараметрыРасшифровкиПоСтрокам = Новый Соответствие;
	НомерСтроки = 0;

	// Строка 1: итог формулы (уровень 1). Операнды ниже — только детализация, не слагаемые отчёта.
	ПараметрыФормулы = дбу_Расшифровка.ПараметрыРасшифровкиПравила(
		КонтекстПравила, ИмяРаздела, Итог, Перечисления.дбу_ДействияСПоказателем.Добавить,
		ДанныеПравила, ЗначенияОперандов, Формула, ПараметрыРасчета);

	НомерСтроки = НомерСтроки + 1;
	СтрокаИтога = ТаблицаСтрок.Добавить();
	СтрокаИтога.НомерСтроки = НомерСтроки;
	СтрокаИтога.ИдентификаторОперанда = "";
	СтрокаИтога.ЗнакОперации = ПараметрыФормулы.ЗнакОперации;
	СтрокаИтога.НаименованиеСлагаемого = ПараметрыФормулы.НаименованиеСлагаемого;
	СтрокаИтога.Сумма = ПараметрыФормулы.Сумма;
	СтрокаИтога.ДоступнаРасшифровка = дбу_Расшифровка.ЭтоРасшифровкаФормулыКДР(ПараметрыФормулы.ДополнительныеПараметры)
		Или ДоступнаТиповаяРасшифровка(ПараметрыФормулы.ДополнительныеПараметры);
	ПараметрыРасшифровкиПоСтрокам.Вставить(НомерСтроки, ПараметрыФормулы.ДополнительныеПараметры);

	// Для простой формулы «A» строка итога уже получила типовую
	// расшифровку самого операнда. Повторная строка A в этом окне
	// является тем же самым drill-down, а не отдельным слагаемым.
	ПоказыватьОперанды = Истина;
	Если ТипЗнч(ПараметрыФормулы.ДополнительныеПараметры) = Тип("Структура")
		И ПараметрыФормулы.ДополнительныеПараметры.Свойство("Отчет")
		И Не дбу_Расшифровка.ЭтоРасшифровкаФормулыКДР(ПараметрыФормулы.ДополнительныеПараметры) Тогда
		ПоказыватьОперанды = Ложь;
	КонецЕсли;

	Если ПоказыватьОперанды Тогда
	Для Каждого СтрокаОперанда Из ДанныеПравила.Операнды Цикл

		Идентификатор = ВРег(СокрЛП(Строка(СтрокаОперанда.Идентификатор)));
		Если Не ЗначениеЗаполнено(Идентификатор) Тогда
			Продолжить;
		КонецЕсли;

		СуммаОперанда = ЗначенияОперандов.Получить(Идентификатор);
		Если СуммаОперанда = Неопределено Тогда
			СуммаОперанда = 0;
		КонецЕсли;

		ПараметрыСтроки = дбу_Расшифровка.ПараметрыРасшифровкиОперандаДляПробногоРасчета(
			КонтекстПравила, ИмяРаздела, СтрокаОперанда, СуммаОперанда, ПараметрыРасчета);

		НомерСтроки = НомерСтроки + 1;
		НоваяСтрока = ТаблицаСтрок.Добавить();
		НоваяСтрока.НомерСтроки = НомерСтроки;
		НоваяСтрока.ИдентификаторОперанда = Идентификатор;
		НоваяСтрока.ЗнакОперации = ПараметрыСтроки.ЗнакОперации;
		НоваяСтрока.НаименованиеСлагаемого = ПараметрыСтроки.НаименованиеСлагаемого;
		НоваяСтрока.Сумма = ПараметрыСтроки.Сумма;
		НоваяСтрока.ДоступнаРасшифровка = ДоступнаТиповаяРасшифровка(ПараметрыСтроки.ДополнительныеПараметры);

		ПараметрыРасшифровкиПоСтрокам.Вставить(НомерСтроки, ПараметрыСтроки.ДополнительныеПараметры);

	КонецЦикла;
	КонецЕсли;

	Результат.Успех = Истина;
	Результат.Итог = Итог;
	Результат.ТаблицаСтрок = ТаблицаСтрок;
	Результат.АдресПараметровРасшифровки = ПоместитьВоВременноеХранилище(ПараметрыРасшифровкиПоСтрокам, АдресХранилища);

	Возврат Результат;

КонецФункции

// Проверяет цели тем же адресным контрактом, что используется движком.
// Если вызывающий контекст передал фактическое дерево отчета, дополнительно
// выполняется resolver по каждой графе; без дерева сохраняется диагностика
// «проверка при применении», без создания отсутствующих строк.
//
Функция ПроверитьЦелиПробногоРасчета(ДанныеПравила, ПараметрыРасчета)

	Результат = Новый Структура;
	Результат.Вставить("Успех", Истина);
	Результат.Вставить("ТекстОшибки", "");
	Результат.Вставить("Цели", Новый Массив);
	Результат.Вставить("Проверки", Новый Массив);
	Результат.Вставить("СтатусПроверкиЦелей", "");

	Цели = Неопределено;
	Если Не ДанныеПравила.Свойство("Цели", Цели) Тогда
		Возврат Результат;
	КонецЕсли;

	ДеревоДанныхРазделов = Неопределено;
	ПараметрыРасчета.Свойство("ДеревоДанныхРазделов", ДеревоДанныхРазделов);
	ОтчетОбразецВыбран = Ложь;
	ПризнакОбразца = Неопределено;
	Если ДанныеПравила.Свойство("ОтчетОбразецВыбран", ПризнакОбразца) Тогда
		Если ТипЗнч(ПризнакОбразца) = Тип("Булево") Тогда
			ОтчетОбразецВыбран = ПризнакОбразца;
		КонецЕсли;
	КонецЕсли;

	Если ДеревоДанныхРазделов = Неопределено Тогда
		Результат.СтатусПроверкиЦелей = НСтр(
			"ru = 'Сумма рассчитана, но строка отчёта не проверена. Выберите отчёт-образец.'");
		Если ОтчетОбразецВыбран Тогда
			Результат.Успех = Ложь;
			Результат.ТекстОшибки = НСтр(
				"ru = 'Выбран отчёт-образец, но его дерево строк не удалось получить.'");
			Результат.СтатусПроверкиЦелей = НСтр(
				"ru = 'Не удалось получить фактическое дерево выбранного отчёта-образца.'");
		КонецЕсли;
	Иначе
		Результат.СтатусПроверкиЦелей = НСтр("ru = 'Строки отчёта проверены.'");
	КонецЕсли;

	Для Каждого СтрокаЦели Из Цели Цикл
		Адрес = дбу_СтруктураОтчетности.АдресСтрокиЦели(СтрокаЦели);
		ПроверкаАдреса = дбу_СтруктураОтчетности.ПроверитьАдресСтрокиЦели(
			ДанныеПравила.Раздел, СтрокаЦели);
		Если Не ПроверкаАдреса.Успех Тогда
			Результат.Успех = Ложь;
			Результат.ТекстОшибки = ПроверкаАдреса.ТекстОшибки;
			Возврат Результат;
		КонецЕсли;

		ДиагностикаЦели = Новый Структура;
		ДиагностикаЦели.Вставить("Адрес", Адрес);
		ДиагностикаЦели.Вставить("Статус", "Проверка при применении");
		ДиагностикаЦели.Вставить("Путь", "");
		ДиагностикаЦели.Вставить("Диагностика", "");
		ДиагностикаЦели.Вставить("КодБазовойСтроки", Адрес.КодСтрокиФСБУ);
		ДиагностикаЦели.Вставить("НаименованиеСтроки", Адрес.НаименованиеСтроки);
		ДиагностикаЦели.Вставить("НаименованиеРодительскойСтроки", Адрес.НаименованиеРодительскойСтроки);
		ДиагностикаЦели.Вставить("ПолныйПуть", "");

		Если ДеревоДанныхРазделов <> Неопределено Тогда
			Колонки = дбу_СтруктураОтчетности.КолонкиДляПрименения(
				СтрокаЦели.Колонка, ДанныеПравила.Раздел);
			Для Каждого Колонка Из Колонки Цикл
				Разрешение = дбу_СтруктураОтчетности.РазрешитьАдресПоказателя(
					ДеревоДанныхРазделов, ДанныеПравила.Раздел, Адрес, Колонка);
				Если Разрешение.Статус <> "Найдена" Тогда
					Результат.Успех = Ложь;
					Результат.ТекстОшибки = СтрШаблон(
						НСтр("ru = 'Цель %1: %2'"),
						дбу_СтруктураОтчетности.ПредставлениеАдреса(Адрес, ДанныеПравила.Раздел),
						Разрешение.Диагностика);
					Возврат Результат;
				КонецЕсли;
				ДиагностикаЦели.Статус = "Найдена";
				ДиагностикаЦели.Путь = Разрешение.Путь;
				ДиагностикаЦели.ПолныйПуть = дбу_СтруктураОтчетности.ПредставлениеАдреса(
					Адрес, ДанныеПравила.Раздел);
				ПроверкаЦели = Новый Структура;
				ПроверкаЦели.Вставить("Статус", "Найдена");
				ПроверкаЦели.Вставить("Графа", Строка(Колонка));
				ПроверкаЦели.Вставить("ПолныйПуть", ДиагностикаЦели.ПолныйПуть);
				ПроверкаЦели.Вставить("КодБазовойСтроки", Адрес.КодСтрокиФСБУ);
				ПроверкаЦели.Вставить("НаименованиеСтроки", Адрес.НаименованиеСтроки);
				ПроверкаЦели.Вставить("НаименованиеРодительскойСтроки", Адрес.НаименованиеРодительскойСтроки);
				Результат.Проверки.Добавить(ПроверкаЦели);
			КонецЦикла;
		КонецЕсли;

		Результат.Цели.Добавить(ДиагностикаЦели);
	КонецЦикла;

	Если Результат.Проверки.Количество() > 0 Тогда
		Результат.СтатусПроверкиЦелей = НСтр("ru = 'Строки отчёта проверены: все адреса найдены.'");
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Готовит параметры открытия типового отчёта по строке пробной расшифровки.
//
Функция ПодготовитьОткрытиеТиповойРасшифровки(НомерСтроки, АдресПараметровРасшифровки, НаименованиеСтроки) Экспорт

	Если Не ЗначениеЗаполнено(АдресПараметровРасшифровки) Тогда
		Возврат Неопределено;
	КонецЕсли;

	ПараметрыПоСтрокам = ПолучитьИзВременногоХранилища(АдресПараметровРасшифровки);
	Если ТипЗнч(ПараметрыПоСтрокам) <> Тип("Соответствие") Тогда
		Возврат Неопределено;
	КонецЕсли;

	ДополнительныеПараметры = ПараметрыПоСтрокам.Получить(НомерСтроки);
	Если Не ДоступнаТиповаяРасшифровка(ДополнительныеПараметры) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Отчет = ДополнительныеПараметры.Отчет;
	ПараметрыФормы = Новый Структура;

	Если Отчет.Свойство("ПараметрыФормы") Тогда
		Для Каждого ЭлементНастройки Из Отчет.ПараметрыФормы Цикл
			ПараметрыФормы.Вставить(ЭлементНастройки.Ключ, ЭлементНастройки.Значение);
		КонецЦикла;
	КонецЕсли;

	Если Отчет.Свойство("НастройкиТиповогоОтчета") Тогда
		ПараметрыФормы.Вставить("ПользовательскиеНастройки",
			ПользовательскиеНастройкиТиповогоОтчета(Отчет.НастройкиТиповогоОтчета));
	ИначеЕсли Отчет.Свойство("ПользовательскиеНастройки") Тогда
		ПараметрыФормы.Вставить("ПользовательскиеНастройки", Отчет.ПользовательскиеНастройки);
	КонецЕсли;

	ПараметрыФормы.Вставить("НаименованиеСтроки", НаименованиеСтроки);
	ПараметрыФормы.Вставить("НаименованиеПоказателя", "");

	Результат = Новый Структура;
	Результат.Вставить("ИмяФормы", Отчет.ИмяОтчета);
	Результат.Вставить("ПараметрыФормы", ПараметрыФормы);

	Возврат Результат;

КонецФункции

// Возвращает ДополнительныеПараметры строки пробной расшифровки (формула или операнд).
//
Функция ДополнительныеПараметрыСтрокиПробногоРасчета(НомерСтроки, АдресПараметровРасшифровки) Экспорт

	Если Не ЗначениеЗаполнено(АдресПараметровРасшифровки) Тогда
		Возврат Неопределено;
	КонецЕсли;

	ПараметрыПоСтрокам = ПолучитьИзВременногоХранилища(АдресПараметровРасшифровки);
	Если ТипЗнч(ПараметрыПоСтрокам) <> Тип("Соответствие") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат ПараметрыПоСтрокам.Получить(НомерСтроки);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ТаблицаСтрокРасшифровки()

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("НомерСтроки", Новый ОписаниеТипов("Число"));
	Таблица.Колонки.Добавить("ИдентификаторОперанда", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(10)));
	Таблица.Колонки.Добавить("ЗнакОперации", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(1)));
	Таблица.Колонки.Добавить("НаименованиеСлагаемого", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("Сумма", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2)));
	Таблица.Колонки.Добавить("ДоступнаРасшифровка", Новый ОписаниеТипов("Булево"));

	Возврат Таблица;

КонецФункции

Функция КонтекстПробногоРасчета(ДанныеПравила, ПараметрыРасчета)

	ПрефиксПрофиля = "";
	Если ЗначениеЗаполнено(ДанныеПравила.Владелец) Тогда
		РеквизитыПрофиля = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
			ДанныеПравила.Владелец, "ПрефиксРасшифровки");
		ПрефиксПрофиля = РеквизитыПрофиля.ПрефиксРасшифровки;
	КонецЕсли;

	ЭффективныйПрефикс = дбу_Расшифровка.ЭффективныйПрефиксРасшифровки(
		ДанныеПравила.ПрефиксРасшифровки, ПрефиксПрофиля);

	Контекст = Новый Структура;
	Контекст.Вставить("СсылкаПравила", ДанныеПравила.Ссылка);
	Контекст.Вставить("НаименованиеПравила", ДанныеПравила.Наименование);
	Контекст.Вставить("ПрефиксРасшифровки", ДанныеПравила.ПрефиксРасшифровки);
	Контекст.Вставить("ПрефиксПрофиля", ПрефиксПрофиля);
	Контекст.Вставить("ЭффективныйПрефикс", ЭффективныйПрефикс);
	Контекст.Вставить("Профиль", ДанныеПравила.Владелец);
	Контекст.Вставить("Организация", ПараметрыРасчета.Организация);

	Возврат Контекст;

КонецФункции

Функция ИмяРазделаДляРасшифровки(Раздел)

	Если Не ЗначениеЗаполнено(Раздел) Тогда
		Возврат "ПробныйРасчет";
	КонецЕсли;

	Возврат дбу_СтруктураОтчетности.ИмяРазделаОтчета(Раздел);

КонецФункции

Функция РассчитатьЗначенияОперандов(ДанныеПравила, ПараметрыРасчета)

	ЗначенияОперандов = дбу_ОперандыУчета.РассчитатьОперанды(ПараметрыРасчета, ДанныеПравила.Операнды);

	Если ДанныеПравила.ВидПравила = Перечисления.дбу_ВидыПравил.ПроизвольныйЗапрос Тогда
		Для Каждого СтрокаОперанда Из ДанныеПравила.Операнды Цикл
			Если СтрокаОперанда.СпособРасчета <> Перечисления.дбу_СпособыРасчетаОперанда.Запрос Тогда
				Продолжить;
			КонецЕсли;
			Идентификатор = ВРег(СокрЛП(Строка(СтрокаОперанда.Идентификатор)));
			ЗначенияОперандов.Вставить(Идентификатор,
				дбу_ОперандыУчета.ВыполнитьЗапросДанных(ПараметрыРасчета, СтрокаОперанда.ЗапросДанных));
		КонецЦикла;
	КонецЕсли;

	Возврат ЗначенияОперандов;

КонецФункции

Функция ФормулаДляПробногоРасчета(ДанныеПравила)

	Если ДанныеПравила.ВидПравила = Перечисления.дбу_ВидыПравил.ПроизвольныйЗапрос Тогда
		Возврат "A";
	КонецЕсли;

	Возврат ДанныеПравила.Формула;

КонецФункции

Процедура НормализоватьПериодРасчета(ПараметрыРасчета)

	Если ПараметрыРасчета.Свойство("НачалоПериода") И ЗначениеЗаполнено(ПараметрыРасчета.НачалоПериода) Тогда
		ПараметрыРасчета.НачалоПериода = НачалоДня(ПараметрыРасчета.НачалоПериода);
	КонецЕсли;

	Если ПараметрыРасчета.Свойство("КонецПериода") И ЗначениеЗаполнено(ПараметрыРасчета.КонецПериода) Тогда
		ПараметрыРасчета.КонецПериода = КонецДня(ПараметрыРасчета.КонецПериода);
	КонецЕсли;

КонецПроцедуры

Функция ДоступнаТиповаяРасшифровка(ДополнительныеПараметры)

	Возврат ТипЗнч(ДополнительныеПараметры) = Тип("Структура")
		И ДополнительныеПараметры.Свойство("Отчет")
		И ТипЗнч(ДополнительныеПараметры.Отчет) = Тип("Структура")
		И ДополнительныеПараметры.Отчет.Свойство("ИмяОтчета")
		И ЗначениеЗаполнено(ДополнительныеПараметры.Отчет.ИмяОтчета);

КонецФункции

Функция ПользовательскиеНастройкиТиповогоОтчета(НастройкиТиповогоОтчета)

	Если НастройкиТиповогоОтчета.Отчет = "ОСВ" Тогда
		Возврат ПользовательскиеНастройкиОСВ(НастройкиТиповогоОтчета);
	ИначеЕсли НастройкиТиповогоОтчета.Отчет = "Анализ" Тогда
		Возврат ПользовательскиеНастройкиАнализаСчета(НастройкиТиповогоОтчета);
	ИначеЕсли НастройкиТиповогоОтчета.Отчет = "ОборотыСчета" Тогда
		Возврат ПользовательскиеНастройкиОборотовСчета(НастройкиТиповогоОтчета);
	ИначеЕсли НастройкиТиповогоОтчета.Отчет = "АнализСубконто" Тогда
		Возврат ПользовательскиеНастройкиАнализаСубконто(НастройкиТиповогоОтчета);
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

Функция ПользовательскиеНастройкиОСВ(НастройкиТиповогоОтчета)

	ПользовательскиеНастройки = Новый ПользовательскиеНастройкиКомпоновкиДанных;
	ДополнительныеСвойства = ПользовательскиеНастройки.ДополнительныеСвойства;

	ДобавитьСтандартныеРеквизитыТиповогоОтчета(ДополнительныеСвойства);
	ДополнительныеСвойства.Вставить("Счет", ПланыСчетов.Хозрасчетный.ПустаяСсылка());
	ДополнительныеСвойства.Вставить("ПоСубсчетам", Истина);
	ЗаполнитьЗначенияСвойств(ДополнительныеСвойства, НастройкиТиповогоОтчета);
	НастроитьПоказателиТиповогоОтчета(ДополнительныеСвойства);

	ДобавитьОтборПоАналитике(ПользовательскиеНастройки, НастройкиТиповогоОтчета.ОтборПоАналитике);

	Если НастройкиТиповогоОтчета.Свойство("Группировка")
		И НастройкиТиповогоОтчета.Группировка <> Неопределено Тогда
		ДополнительныеСвойства.Вставить("Группировка", НастройкиТиповогоОтчета.Группировка);
	КонецЕсли;

	ДополнительныеСвойства.Вставить("РазвернутоеСальдо",
		?(НастройкиТиповогоОтчета.Свойство("РазвернутоеСальдо"), НастройкиТиповогоОтчета.РазвернутоеСальдо, Ложь));

	Возврат ПользовательскиеНастройки;

КонецФункции

Функция ПользовательскиеНастройкиАнализаСчета(НастройкиТиповогоОтчета)

	ПользовательскиеНастройки = Новый ПользовательскиеНастройкиКомпоновкиДанных;
	ДополнительныеСвойства = ПользовательскиеНастройки.ДополнительныеСвойства;

	ДобавитьСтандартныеРеквизитыТиповогоОтчета(ДополнительныеСвойства);
	ДополнительныеСвойства.Вставить("Счет", ПланыСчетов.Хозрасчетный.ПустаяСсылка());
	ДополнительныеСвойства.Вставить("ПоСубсчетам", Ложь);
	ДополнительныеСвойства.Вставить("ПоСубсчетамКорСчетов", Ложь);
	ЗаполнитьЗначенияСвойств(ДополнительныеСвойства, НастройкиТиповогоОтчета);
	НастроитьПоказателиТиповогоОтчета(ДополнительныеСвойства);

	Отбор = ПользовательскиеНастройки.Элементы.Добавить(Тип("ОтборКомпоновкиДанных"));
	Отбор.ИдентификаторПользовательскойНастройки = "Отбор";

	КорСчет = НастройкиТиповогоОтчета.КорСчет;
	Если ЗначениеЗаполнено(КорСчет) Тогда
		ПолеКомпоновкиДанных = Новый ПолеКомпоновкиДанных("КорСчет");
		ДобавитьЗначениеВОтборКомпоновки(Отбор, ПолеКомпоновкиДанных, ВидСравненияКомпоновкиДанных.ВИерархии, КорСчет);
	КонецЕсли;

	ДобавитьЭлементыОтбораПоАналитике(Отбор, НастройкиТиповогоОтчета.ОтборПоАналитике);

	Возврат ПользовательскиеНастройки;

КонецФункции

Функция ПользовательскиеНастройкиОборотовСчета(НастройкиТиповогоОтчета)

	ПользовательскиеНастройки = Новый ПользовательскиеНастройкиКомпоновкиДанных;
	ДополнительныеСвойства = ПользовательскиеНастройки.ДополнительныеСвойства;

	ДобавитьСтандартныеРеквизитыТиповогоОтчета(ДополнительныеСвойства);
	ДополнительныеСвойства.Вставить("Счет", ПланыСчетов.Хозрасчетный.ПустаяСсылка());
	ДополнительныеСвойства.Вставить("ПоСубсчетам", Ложь);
	ДополнительныеСвойства.Вставить("ПоСубсчетамКорСчетов", Ложь);
	ЗаполнитьЗначенияСвойств(ДополнительныеСвойства, НастройкиТиповогоОтчета);

	ДополнительныеСвойства.Вставить("ОборотыСоСчетамиДт", Истина);
	ДополнительныеСвойства.Вставить("ОборотыСоСчетамиКт", Истина);

	ДобавитьОтборПоАналитике(ПользовательскиеНастройки, НастройкиТиповогоОтчета.ОтборПоАналитике);

	Возврат ПользовательскиеНастройки;

КонецФункции

Функция ПользовательскиеНастройкиАнализаСубконто(НастройкиТиповогоОтчета)

	ПользовательскиеНастройки = Новый ПользовательскиеНастройкиКомпоновкиДанных;
	ДополнительныеСвойства = ПользовательскиеНастройки.ДополнительныеСвойства;

	ДобавитьСтандартныеРеквизитыТиповогоОтчета(ДополнительныеСвойства);
	ЗаполнитьЗначенияСвойств(ДополнительныеСвойства, НастройкиТиповогоОтчета);
	НастроитьПоказателиТиповогоОтчета(ДополнительныеСвойства);

	ДополнительныеСвойства.Вставить("СписокВидовСубконто", Новый СписокЗначений);
	Если НастройкиТиповогоОтчета.Свойство("ВидыСубконто") Тогда
		ДополнительныеСвойства.СписокВидовСубконто.ЗагрузитьЗначения(НастройкиТиповогоОтчета.ВидыСубконто);
	КонецЕсли;

	Если НастройкиТиповогоОтчета.Свойство("Группировка") Тогда
		ДополнительныеСвойства.Вставить("Группировка", НастройкиТиповогоОтчета.Группировка);
	КонецЕсли;

	ДобавитьОтборПоАналитике(ПользовательскиеНастройки, НастройкиТиповогоОтчета.ОтборПоАналитике);

	Возврат ПользовательскиеНастройки;

КонецФункции

Процедура ДобавитьСтандартныеРеквизитыТиповогоОтчета(ДополнительныеСвойства)

	ДополнительныеСвойства.Вставить("Организация", Справочники.Организации.ПустаяСсылка());
	ДополнительныеСвойства.Вставить("НачалоПериода", Дата(1, 1, 1));
	ДополнительныеСвойства.Вставить("КонецПериода", Дата(1, 1, 1));
	ДополнительныеСвойства.Вставить("ВидПериода", 0);

КонецПроцедуры

Процедура НастроитьПоказателиТиповогоОтчета(ДополнительныеСвойства)

	ДополнительныеСвойства.Вставить("ПоказательБУ", Истина);
	ДополнительныеСвойства.Вставить("ПоказательНУ", Ложь);
	ДополнительныеСвойства.Вставить("ПоказательСверкаНУ", Ложь);
	ДополнительныеСвойства.Вставить("ПоказательПР", Ложь);
	ДополнительныеСвойства.Вставить("ПоказательВР", Ложь);
	ДополнительныеСвойства.Вставить("ПоказательКонтроль", Ложь);
	ДополнительныеСвойства.Вставить("ПоказательВалютнаяСумма", Ложь);
	ДополнительныеСвойства.Вставить("ПоказательКоличество", Ложь);

КонецПроцедуры

Процедура ДобавитьОтборПоАналитике(ПользовательскиеНастройки, ОтборПоАналитике, СоздаватьОтборЕслиПустой = Истина)

	Если ОтборПоАналитике = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Отбор = Неопределено;
	Если СоздаватьОтборЕслиПустой Или ОтборПоАналитике.Количество() > 0 Тогда
		Отбор = ПользовательскиеНастройки.Элементы.Добавить(Тип("ОтборКомпоновкиДанных"));
		Отбор.ИдентификаторПользовательскойНастройки = "Отбор";
	КонецЕсли;

	Если Отбор = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ДобавитьЭлементыОтбораПоАналитике(Отбор, ОтборПоАналитике);

КонецПроцедуры

Процедура ДобавитьЭлементыОтбораПоАналитике(Отбор, ОтборПоАналитике)

	Если Отбор = Неопределено Или ОтборПоАналитике = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Для Каждого ЭлементОтбора Из ОтборПоАналитике Цикл
		ПолеКомпоновкиДанных = Новый ПолеКомпоновкиДанных(ЭлементОтбора.Ключ);
		Если ТипЗнч(ЭлементОтбора.Значение) = Тип("Структура") Тогда
			ЗначениеЭлементаОтбора = ЭлементОтбора.Значение;
			ДобавитьЗначениеВОтборКомпоновки(Отбор, ПолеКомпоновкиДанных,
				ЗначениеЭлементаОтбора.ВидСравненияКомпоновкиДанных, ЗначениеЭлементаОтбора.Значение);
		Иначе
			ДобавитьЗначениеВОтборКомпоновки(Отбор, ПолеКомпоновкиДанных,
				ВидСравненияКомпоновкиДанных.Равно, ЭлементОтбора.Значение);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьЗначениеВОтборКомпоновки(Отбор, ЛевоеЗначение, ВидСравнения, ПравоеЗначение)

	ЭлементОтбора = Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = ЛевоеЗначение;
	ЭлементОтбора.ВидСравнения = ВидСравнения;
	ЭлементОтбора.ПравоеЗначение = ПравоеЗначение;
	ЭлементОтбора.Использование = Истина;
	ЭлементОтбора.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ;

КонецПроцедуры

#КонецОбласти
