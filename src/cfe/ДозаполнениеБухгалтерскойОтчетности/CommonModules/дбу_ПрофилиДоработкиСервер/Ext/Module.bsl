// Серверная работа с профилями доработки.
// Назначения хранятся только в табличной части профиля интервалами:
// организация + начало применения + необязательное начало отключения.
// Старые направления и регистр отсутствуют физически.

#Область ПрограммныйИнтерфейс

// Возвращает профили, действующие для организации на дату.
// Интервал полуоткрытый: ПрименятьС <= Период < НеПрименятьС.
Функция ПрофилиДляОрганизации(Организация, Период) Экспорт

	Результат = НоваяТаблицаПрофилей();
	Если Не ЗначениеЗаполнено(Организация) Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого Состояние Из СрезПрофилей(Организация, НачалоГода(Период)) Цикл
		ДобавитьПрофильВСрезе(Результат, Состояние.Профиль, Состояние.Приоритет);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Возвращает организации, доступные пользователю, и их текущее состояние.
// Состояние всех организаций получается одним пакетным запросом.
Функция ТаблицаРазницыДляПрофиля(Профиль, Период) Экспорт

	Таблица = НоваяТаблицаРазницы();
	Организации = дбу_ДоступОрганизаций.ДоступныеОрганизации();
	Если Организации.Количество() = 0 Тогда
		Возврат Таблица;
	КонецЕсли;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		| Организации.Ссылка КАК Организация,
		| Применения.ПрименятьС КАК ПрименятьС,
		| Применения.НеПрименятьС КАК НеПрименятьС,
		| Применения.Активно КАК Активно
		|ИЗ
		| Справочник.Организации КАК Организации
		| ЛЕВОЕ СОЕДИНЕНИЕ Справочник.дбу_ПрофилиДоработки.Применения КАК Применения
		| ПО Применения.Ссылка = &Профиль
		|  И Применения.Организация = Организации.Ссылка
		|  И Применения.ПрименятьС <= &Период
		|ГДЕ Организации.Ссылка В (&Организации)
		|УПОРЯДОЧИТЬ ПО Организации.Наименование, Применения.ПрименятьС УБЫВ");
	Запрос.УстановитьПараметр("Профиль", Профиль);
	Запрос.УстановитьПараметр("Период", НачалоГода(Период));
	Запрос.УстановитьПараметр("Организации", Организации);

	Обработанные = Новый Соответствие;
	ВыборкаОрганизаций = Запрос.Выполнить().Выбрать();
	Пока ВыборкаОрганизаций.Следующий() Цикл
		ДанныеОрганизации = ВыборкаОрганизаций;
		Ключ = Строка(ДанныеОрганизации.Организация);
		Если Обработанные.Получить(Ключ) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Обработанные.Вставить(Ключ, Истина);

		СтрокаРазницы = Таблица.Добавить();
		СтрокаРазницы.Организация = ДанныеОрганизации.Организация;
		СтрокаРазницы.ОрганизацияПредставление = Строка(ДанныеОрганизации.Организация);
		СтрокаРазницы.Выбрано = Ложь;
		СтрокаРазницы.ПрименятьС = ДанныеОрганизации.ПрименятьС;
		СтрокаРазницы.НеПрименятьС = ДанныеОрганизации.НеПрименятьС;
		Если ЗначениеЗаполнено(ДанныеОрганизации.ПрименятьС)
			И ДанныеОрганизации.Активно Тогда
			СтрокаРазницы.Состояние = "Применяется с "
				+ Формат(ДанныеОрганизации.ПрименятьС, "ДФ=MM.yyyy");
			Если ЗначениеЗаполнено(ДанныеОрганизации.НеПрименятьС) Тогда
				СтрокаРазницы.Состояние = СтрокаРазницы.Состояние + ", не применять с "
					+ Формат(ДанныеОрганизации.НеПрименятьС, "ДФ=MM.yyyy");
			КонецЕсли;
		Иначе
			СтрокаРазницы.Состояние = "Не применяется";
		КонецЕсли;
	КонецЦикла;

	Возврат Таблица;

КонецФункции

// Возвращает только назначения текущего профиля, доступные пользователю.
// В отличие от таблицы разницы не разворачивает полный список организаций.
Функция ПримененияПрофиля(Профиль) Экспорт

	Таблица = НоваяТаблицаПрименений();
	Если Не ЗначениеЗаполнено(Профиль) Тогда
		Возврат Таблица;
	КонецЕсли;

	ДоступныеОрганизации = дбу_ДоступОрганизаций.ДоступныеОрганизации();
	ТекущийГод = НачалоГода(ТекущаяДата());
	ПрофильОбъект = Профиль.ПолучитьОбъект();
	Для Каждого СтрокаПрименения Из ПрофильОбъект.Применения Цикл
		Если Не СтрокаПрименения.Активно
			Или ДоступныеОрганизации.Найти(СтрокаПрименения.Организация) = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		СтрокаТаблицы = Таблица.Добавить();
		СтрокаТаблицы.Организация = СтрокаПрименения.Организация;
		СтрокаТаблицы.ОрганизацияПредставление = Строка(СтрокаПрименения.Организация);
		СтрокаТаблицы.ГодНачалаПрименения = Год(СтрокаПрименения.ПрименятьС);
		Если ЗначениеЗаполнено(СтрокаПрименения.НеПрименятьС) Тогда
			СтрокаТаблицы.ПоследнийГодПрименения = Год(СтрокаПрименения.НеПрименятьС) - 1;
		КонецЕсли;
		Если СтрокаПрименения.ПрименятьС > ТекущийГод Тогда
			СтрокаТаблицы.Состояние = "Начнёт действовать";
		ИначеЕсли ЗначениеЗаполнено(СтрокаПрименения.НеПрименятьС)
			И СтрокаПрименения.НеПрименятьС <= ТекущийГод Тогда
			СтрокаТаблицы.Состояние = "Завершено";
		Иначе
			СтрокаТаблицы.Состояние = "Действует";
		КонецЕсли;
	КонецЦикла;

	Таблица.Сортировать("ОрганизацияПредставление, ГодНачалаПрименения Убыв");
	Возврат Таблица;

КонецФункции

// Возвращает доступные организации для нового назначения.
// Организация с действующим интервалом не предлагается повторно,
// но организация с закрытой историей доступна для подключения после перерыва.
Функция СписокОрганизацийДляПодключения(Профиль) Экспорт

	Результат = Новый СписокЗначений;
	ДоступныеОрганизации = дбу_ДоступОрганизаций.ДоступныеОрганизации();
	Активные = Новый Соответствие;

	Если ЗначениеЗаполнено(Профиль) Тогда
		ПрофильОбъект = Профиль.ПолучитьОбъект();
		Для Каждого СтрокаПрименения Из ПрофильОбъект.Применения Цикл
			Если СтрокаПрименения.Активно
				И Не ЗначениеЗаполнено(СтрокаПрименения.НеПрименятьС) Тогда
				Активные.Вставить(Строка(СтрокаПрименения.Организация), Истина);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Для Каждого Организация Из ДоступныеОрганизации Цикл
		Если Активные.Получить(Строка(Организация)) = Истина Тогда
			Продолжить;
		КонецЕсли;
		Результат.Добавить(Организация, Строка(Организация));
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Повторно проверяет доступ и записывает выбранные назначения одним объектом профиля.
Процедура ПрименитьВыбранныеПрофили(Профиль, Период, ТаблицаРазницы) Экспорт

	Если Не ЗначениеЗаполнено(Профиль) Тогда
		ВызватьИсключение НСтр("ru = 'Не выбран профиль доработки.'");
	КонецЕсли;

	Выбранные = Новый Массив;
	Для Каждого СтрокаРазницы Из ТаблицаРазницы Цикл
		Если СтрокаРазницы.Выбрано Тогда
			ПроверитьДоступКОрганизации(СтрокаРазницы.Организация);
			Выбранные.Добавить(СтрокаРазницы.Организация);
		КонецЕсли;
	КонецЦикла;

	Если Выбранные.Количество() = 0 Тогда
		ВызватьИсключение НСтр("ru = 'Не выбрана ни одна организация.'");
	КонецЕсли;

	ПрофильОбъект = Профиль.ПолучитьОбъект();
	НачатьТранзакцию();
	Попытка
		Для Каждого Организация Из Выбранные Цикл
			ДобавитьИлиПереоткрытьПрименение(
				ПрофильОбъект, Организация, Период, 100);
		КонецЦикла;
		ПрофильОбъект.Записать();
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

// Идемпотентная запись назначения профиля в табличную часть.
Процедура ЗаписатьПрименениеПрофиля(Организация, Профиль, Период, Активно = Истина, Приоритет = 100) Экспорт

	Если Не ЗначениеЗаполнено(Организация) Или Не ЗначениеЗаполнено(Профиль) Тогда
		ВызватьИсключение НСтр("ru = 'Для применения профиля нужны организация и профиль.'");
	КонецЕсли;

	ПроверитьДоступКОрганизации(Организация);
	НачатьТранзакцию();
	Попытка
		ПрофильОбъект = Профиль.ПолучитьОбъект();
		ДобавитьИлиПереоткрытьПрименение(
			ПрофильОбъект, Организация, Период, Приоритет, Активно);
		ПрофильОбъект.Записать();
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

// Завершает выбранный интервал одной организации.
Процедура ПрекратитьПрименениеПрофиля(Профиль, Организация, ПрименятьС, Период) Экспорт

	Если Не ЗначениеЗаполнено(Профиль) Или Не ЗначениеЗаполнено(Организация) Тогда
		ВызватьИсключение НСтр("ru = 'Выберите организацию профиля.'");
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Период) Тогда
		ВызватьИсключение НСтр("ru = 'Укажите последний год применения.'");
	КонецЕсли;

	ПроверитьДоступКОрганизации(Организация);
	ГодПрекращения = НачалоГода(Период);
	НачалоПрекращения = Дата(Год(Период) + 1, 1, 1);
	ПрофильОбъект = Профиль.ПолучитьОбъект();
	Найдено = Ложь;
	Для Каждого СтрокаПрименения Из ПрофильОбъект.Применения Цикл
		Если СтрокаПрименения.Организация <> Организация
			Или СтрокаПрименения.ПрименятьС <> ПрименятьС Тогда
			Продолжить;
		КонецЕсли;
		Если ЗначениеЗаполнено(СтрокаПрименения.НеПрименятьС) Тогда
			ВызватьИсключение НСтр("ru = 'Выбранный интервал уже завершён.'");
		КонецЕсли;
		Если НачалоПрекращения <= СтрокаПрименения.ПрименятьС Тогда
			ВызватьИсключение НСтр("ru = 'Последний год применения должен быть не раньше года начала.'");
		КонецЕсли;
		СтрокаПрименения.НеПрименятьС = НачалоПрекращения;
		Найдено = Истина;
		Прервать;
	КонецЦикла;

	Если Не Найдено Тогда
		ВызватьИсключение НСтр("ru = 'Выбранное применение профиля не найдено.'");
	КонецЕсли;

	НачатьТранзакцию();
	Попытка
		ПрофильОбъект.Записать();
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

// Завершает действующие назначения с указанного месяца. История сохраняется.
Процедура ПрекратитьВыбранныеПрофили(Профиль, Период, ТаблицаРазницы) Экспорт

	Если Не ЗначениеЗаполнено(Профиль) Тогда
		ВызватьИсключение НСтр("ru = 'Не выбран профиль доработки.'");
	КонецЕсли;

	ПрофильОбъект = Профиль.ПолучитьОбъект();
	ГодПрекращения = НачалоГода(Период);
	НачалоПрекращения = Дата(Год(Период) + 1, 1, 1);
	КоличествоИзменений = 0;
	Для Каждого СтрокаРазницы Из ТаблицаРазницы Цикл
		Если Не СтрокаРазницы.Выбрано Тогда
			Продолжить;
		КонецЕсли;
		ПроверитьДоступКОрганизации(СтрокаРазницы.Организация);
		Для Каждого СтрокаПрименения Из ПрофильОбъект.Применения Цикл
			Если СтрокаПрименения.Организация = СтрокаРазницы.Организация
				И ИнтервалВключаетДату(СтрокаПрименения, ГодПрекращения) Тогда
				Если НачалоПрекращения <= СтрокаПрименения.ПрименятьС Тогда
					ВызватьИсключение НСтр("ru = 'Последний год применения должен быть не раньше года начала.'");
				КонецЕсли;
				СтрокаПрименения.НеПрименятьС = НачалоПрекращения;
				КоличествоИзменений = КоличествоИзменений + 1;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Если КоличествоИзменений = 0 Тогда
		ВызватьИсключение НСтр("ru = 'Для выбранных организаций нет действующих назначений на этот период.'");
	КонецЕсли;

	НачатьТранзакцию();
	Попытка
		ПрофильОбъект.Записать();
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

Функция ИсторияПрименения(Профиль, Организация) Экспорт

	ПроверитьДоступКОрганизации(Организация);
	ПрофильОбъект = Профиль.ПолучитьОбъект();
	История = Новый Массив;
	Для Каждого СтрокаПрименения Из ПрофильОбъект.Применения Цикл
		Если СтрокаПрименения.Организация <> Организация Тогда
			Продолжить;
		КонецЕсли;
		Текст = Строка(Год(СтрокаПрименения.ПрименятьС)) + " — ";
		Если ЗначениеЗаполнено(СтрокаПрименения.НеПрименятьС) Тогда
			Текст = Текст + Строка(Год(СтрокаПрименения.НеПрименятьС) - 1);
		Иначе
			Текст = Текст + "бессрочно";
		КонецЕсли;
		История.Добавить(Текст);
	КонецЦикла;
	Возврат СтрСоединить(История, Символы.ПС);

КонецФункции

// Сухая проверка уже перенесённой модели. Ничего не записывает.
// Пустое начало правила допустимо для старых правил и означает открытый интервал с начала учёта.
Функция ПроверитьПереходнуюМодель() Экспорт

	Ошибки = Новый Массив;
	Предупреждения = Новый Массив;
	КоличествоПрименений = 0;
	КоличествоПравил = 0;

	ВыборкаПрофилей = Справочники.дбу_ПрофилиДоработки.Выбрать();
	Пока ВыборкаПрофилей.Следующий() Цикл
		ПрофильОбъект = ВыборкаПрофилей.Ссылка.ПолучитьОбъект();
		Для Каждого СтрокаПрименения Из ПрофильОбъект.Применения Цикл
			КоличествоПрименений = КоличествоПрименений + 1;
			Если Не ЗначениеЗаполнено(СтрокаПрименения.Организация) Тогда
				Ошибки.Добавить("Профиль " + Строка(ПрофильОбъект.Ссылка)
					+ ": применение без организации.");
			КонецЕсли;
			Если Не ЗначениеЗаполнено(СтрокаПрименения.ПрименятьС) Тогда
				Ошибки.Добавить("Профиль " + Строка(ПрофильОбъект.Ссылка)
					+ ": применение без даты начала.");
			ИначеЕсли ЗначениеЗаполнено(СтрокаПрименения.НеПрименятьС)
				И СтрокаПрименения.НеПрименятьС <= СтрокаПрименения.ПрименятьС Тогда
				Ошибки.Добавить("Профиль " + Строка(ПрофильОбъект.Ссылка)
					+ ": дата окончания применения не позже даты начала.");
			КонецЕсли;
		КонецЦикла;

		Для НомерСтроки = 0 По ПрофильОбъект.Применения.Количество() - 1 Цикл
			Строка1 = ПрофильОбъект.Применения[НомерСтроки];
			Для НомерСледующейСтроки = НомерСтроки + 1
				По ПрофильОбъект.Применения.Количество() - 1 Цикл
				Строка2 = ПрофильОбъект.Применения[НомерСледующейСтроки];
				Если Строка1.Организация = Строка2.Организация
					И ИнтервалыПересекаются(
						Строка1.ПрименятьС, Строка1.НеПрименятьС,
						Строка2.ПрименятьС, Строка2.НеПрименятьС) Тогда
					Ошибки.Добавить("Профиль " + Строка(ПрофильОбъект.Ссылка)
						+ ": пересекающиеся интервалы одной организации.");
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;

	ВыборкаПравил = Справочники.дбу_ПравилаДоработки.Выбрать();
	Пока ВыборкаПравил.Следующий() Цикл
		ПравилоОбъект = ВыборкаПравил.Ссылка.ПолучитьОбъект();
		КоличествоПравил = КоличествоПравил + 1;
		Если ЗначениеЗаполнено(ПравилоОбъект.НеПрименятьС)
			И Не ЗначениеЗаполнено(ПравилоОбъект.ПрименятьС) Тогда
			Ошибки.Добавить("Правило " + Строка(ПравилоОбъект.Ссылка)
				+ ": дата окончания без даты начала.");
		ИначеЕсли ЗначениеЗаполнено(ПравилоОбъект.ПрименятьС)
			И ЗначениеЗаполнено(ПравилоОбъект.НеПрименятьС)
			И ПравилоОбъект.НеПрименятьС <= ПравилоОбъект.ПрименятьС Тогда
			Ошибки.Добавить("Правило " + Строка(ПравилоОбъект.Ссылка)
				+ ": дата окончания не позже даты начала.");
		КонецЕсли;
		Если Не ЗначениеЗаполнено(ПравилоОбъект.ПрименятьС) Тогда
			Предупреждения.Добавить("Правило " + Строка(ПравилоОбъект.Ссылка)
				+ ": начало не задано, используется открытый исторический интервал.");
		КонецЕсли;
		Если ПравилоОбъект.ПредыдущееПравило = ПравилоОбъект.Ссылка Тогда
			Ошибки.Добавить("Правило " + Строка(ПравилоОбъект.Ссылка)
				+ ": ссылка на предыдущую версию указывает на себя.");
		КонецЕсли;
	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("Успех", Ошибки.Количество() = 0);
	Результат.Вставить("КоличествоПрименений", КоличествоПрименений);
	Результат.Вставить("КоличествоПравил", КоличествоПравил);
	Результат.Вставить("Ошибки", Ошибки);
	Результат.Вставить("Предупреждения", Предупреждения);
	Результат.Вставить("Протокол", СтрСоединить(Ошибки, Символы.ПС));
	Возврат Результат;

КонецФункции

// Одноразово нормализует пересечения, возникшие при переходе со старой модели.
// Более ранний интервал закрывается на начало следующего. Объекты и строки
// профилей не удаляются; одинаковые даты начала требуют ручного решения.
Функция НормализоватьПереходныеИнтервалы() Экспорт

	Ошибки = Новый Массив;
	ПрофилиНаЗапись = Новый Массив;
	КоличествоИсправлений = 0;

	ВыборкаПрофилей = Справочники.дбу_ПрофилиДоработки.Выбрать();
	Пока ВыборкаПрофилей.Следующий() Цикл
		ПрофильОбъект = ВыборкаПрофилей.Ссылка.ПолучитьОбъект();
		Изменен = Ложь;

		Для НомерСтроки = 0 По ПрофильОбъект.Применения.Количество() - 1 Цикл
			Строка1 = ПрофильОбъект.Применения[НомерСтроки];
			Если Не ЗначениеЗаполнено(Строка1.Организация)
				Или Не ЗначениеЗаполнено(Строка1.ПрименятьС) Тогда
				Продолжить;
			КонецЕсли;

			Для НомерСледующейСтроки = НомерСтроки + 1
				По ПрофильОбъект.Применения.Количество() - 1 Цикл
				Строка2 = ПрофильОбъект.Применения[НомерСледующейСтроки];
				Если Строка1.Организация <> Строка2.Организация
					Или Не ЗначениеЗаполнено(Строка2.ПрименятьС) Тогда
					Продолжить;
				КонецЕсли;

				Если Строка1.ПрименятьС = Строка2.ПрименятьС Тогда
					Ошибки.Добавить("Профиль " + Строка(ПрофильОбъект.Ссылка)
						+ ": одинаковые даты начала у одной организации.");
					Продолжить;
				КонецЕсли;

				Если Строка1.ПрименятьС < Строка2.ПрименятьС
					И ИнтервалыПересекаются(
						Строка1.ПрименятьС, Строка1.НеПрименятьС,
						Строка2.ПрименятьС, Строка2.НеПрименятьС)
					Тогда
					Строка1.НеПрименятьС = Строка2.ПрименятьС;
					Изменен = Истина;
					КоличествоИсправлений = КоличествоИсправлений + 1;
				ИначеЕсли Строка2.ПрименятьС < Строка1.ПрименятьС
					И ИнтервалыПересекаются(
						Строка1.ПрименятьС, Строка1.НеПрименятьС,
						Строка2.ПрименятьС, Строка2.НеПрименятьС)
					Тогда
					Строка2.НеПрименятьС = Строка1.ПрименятьС;
					Изменен = Истина;
					КоличествоИсправлений = КоличествоИсправлений + 1;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;

		Если Изменен Тогда
			ПрофилиНаЗапись.Добавить(ПрофильОбъект);
		КонецЕсли;
	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("Успех", Ошибки.Количество() = 0);
	Результат.Вставить("КоличествоИсправлений", КоличествоИсправлений);
	Результат.Вставить("Ошибки", Ошибки);
	Результат.Вставить("Протокол", СтрСоединить(Ошибки, Символы.ПС));

	Если Ошибки.Количество() > 0 Тогда
		Возврат Результат;
	КонецЕсли;

	НачатьТранзакцию();
	Попытка
		Для Каждого ПрофильОбъект Из ПрофилиНаЗапись Цикл
			ПрофильОбъект.Записать();
		КонецЦикла;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

	Возврат Результат;

КонецФункции

// В новом движке разные профили могут применяться к одной организации.
Функция ТекстКонфликтаСовместимости(Организация, Период, Профиль) Экспорт
	Возврат "";
КонецФункции

// Готовит адрес данных правила для пробного расчёта.
Функция АдресДанныхПравилаДляПробногоРасчета(
	Правило, АдресХранилища, Организация = Неопределено, Период = Неопределено) Экспорт

	ПравилоОбъект = Правило.ПолучитьОбъект();
	Если ЗначениеЗаполнено(Организация)
		И Не дбу_ДоступОрганизаций.ОрганизацияДоступна(Организация) Тогда
		ВызватьИсключение дбу_ДоступОрганизаций.ТекстОшибкиДоступа();
	КонецЕсли;

	ДанныеПравила = дбу_ФормыПравил.ДанныеПравилаДляПробногоРасчета(ПравилоОбъект);
	Если ЗначениеЗаполнено(Организация) Тогда
		ДанныеПравила.Вставить("Организация", Организация);
	КонецЕсли;
	Если ЗначениеЗаполнено(Период) Тогда
		ДанныеПравила.Вставить("КонецПериода", КонецМесяца(Период));
	КонецЕсли;

	Возврат ПоместитьВоВременноеХранилище(ДанныеПравила, АдресХранилища);

КонецФункции

// Создаёт новую версию правила атомарно: старая версия закрывается,
// новая получает начало действия и ссылку на предыдущую версию.
Функция СоздатьНовуюВерсиюПравила(Правило, Период) Экспорт

	Если Не ЗначениеЗаполнено(Правило) Тогда
		ВызватьИсключение НСтр("ru = 'Не выбрано правило.'");
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Период) Тогда
		ВызватьИсключение НСтр("ru = 'Укажите период начала новой версии.'");
	КонецЕсли;

	ПериодНовойВерсии = НачалоГода(Период);
	СтароеПравило = Правило.ПолучитьОбъект();
	Если Не ЗначениеЗаполнено(СтароеПравило.ПрименятьС) Тогда
		ЗапросНачалаПрофиля = Новый Запрос(
			"ВЫБРАТЬ МИНИМУМ(Применения.ПрименятьС) КАК ПрименятьС
			|ИЗ Справочник.дбу_ПрофилиДоработки.Применения КАК Применения
			|ГДЕ Применения.Ссылка = &Профиль
			| И Применения.ПрименятьС <> &ПустаяДата");
		ЗапросНачалаПрофиля.УстановитьПараметр("Профиль", СтароеПравило.Владелец);
		ЗапросНачалаПрофиля.УстановитьПараметр("ПустаяДата", Дата(1, 1, 1));
		ВыборкаНачалаПрофиля = ЗапросНачалаПрофиля.Выполнить().Выбрать();
		Если Не ВыборкаНачалаПрофиля.Следующий()
			Или Не ЗначениеЗаполнено(ВыборкаНачалаПрофиля.ПрименятьС) Тогда
			ВызватьИсключение НСтр("ru = 'У исходного правила не указан год начала применения, а начало профиля не найдено.'");
		КонецЕсли;
		СтароеПравило.ПрименятьС = НачалоГода(ВыборкаНачалаПрофиля.ПрименятьС);
	КонецЕсли;
	Если ЗначениеЗаполнено(СтароеПравило.ПрименятьС)
		И ПериодНовойВерсии <= СтароеПравило.ПрименятьС Тогда
		ВызватьИсключение НСтр("ru = 'Новая версия должна начинаться позже старой.'");
	КонецЕсли;
	ЗапросСуществующейВерсии = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 2 Правила.Ссылка, Правила.ПрименятьС
		|ИЗ Справочник.дбу_ПравилаДоработки КАК Правила
		|ГДЕ Правила.Владелец = &Владелец
		| И Правила.ПредыдущееПравило = &ПредыдущееПравило
		| И Правила.ПрименятьС >= &Период
		| И Правила.Активно
		| И НЕ Правила.ПометкаУдаления
		|УПОРЯДОЧИТЬ ПО Правила.ПрименятьС, Правила.Ссылка");
	ЗапросСуществующейВерсии.УстановитьПараметр("Владелец", СтароеПравило.Владелец);
	ЗапросСуществующейВерсии.УстановитьПараметр("ПредыдущееПравило", СтароеПравило.Ссылка);
	ЗапросСуществующейВерсии.УстановитьПараметр("Период", ПериодНовойВерсии);
	ВыборкаСуществующейВерсии = ЗапросСуществующейВерсии.Выполнить().Выбрать();
	Если ВыборкаСуществующейВерсии.Следующий() Тогда
		Если ВыборкаСуществующейВерсии.ПрименятьС = ПериодНовойВерсии Тогда
			Возврат ВыборкаСуществующейВерсии.Ссылка;
		КонецЕсли;
		ВызватьИсключение НСтр("ru = 'Новая версия пересекает уже существующую следующую версию.'");
	КонецЕсли;
	Если ЗначениеЗаполнено(СтароеПравило.НеПрименятьС)
		И СтароеПравило.НеПрименятьС <= ПериодНовойВерсии Тогда
		ВызватьИсключение НСтр("ru = 'Старая версия уже закрыта до указанного периода.'");
	КонецЕсли;

	НоваяВерсия = СтароеПравило.Скопировать();
	НоваяВерсия.Наименование = НовоеНаименованиеВерсии(СтароеПравило.Наименование, ПериодНовойВерсии);
	НоваяВерсия.ПрименятьС = ПериодНовойВерсии;
	НоваяВерсия.НеПрименятьС = Дата(1, 1, 1);
	НоваяВерсия.ПредыдущееПравило = СтароеПравило.Ссылка;
	НоваяВерсия.Активно = Истина;

	НачатьТранзакцию();
	Попытка
		СтароеПравило.НеПрименятьС = ПериодНовойВерсии;
		СтароеПравило.Записать();
		НоваяВерсия.Записать();
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

	Возврат НоваяВерсия.Ссылка;

КонецФункции

Функция НовоеНаименованиеВерсии(Наименование, Период)
	МаркерВерсии = " (с ";
	ПозицияМаркера = СтрНайти(Наименование, МаркерВерсии);
	Если ПозицияМаркера > 0 Тогда
		ХвостНаименования = Сред(Наименование, ПозицияМаркера + СтрДлина(МаркерВерсии));
		Если СтрДлина(ХвостНаименования) <= 7
			И Прав(ХвостНаименования, 1) = ")" Тогда
			Наименование = Лев(Наименование, ПозицияМаркера - 1);
		КонецЕсли;
	КонецЕсли;

	ГодВерсии = Формат(Год(Период), "ЧГ=0");
	Возврат Наименование + МаркерВерсии + ГодВерсии + ")";
КонецФункции

// Используется загрузчиком КБО и диагностикой профиля.
Функция КоличествоАктивныхПравилПрофиля(Профиль) Экспорт

	Если Не ЗначениеЗаполнено(Профиль) Тогда
		Возврат 0;
	КонецЕсли;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ КОЛИЧЕСТВО(Правила.Ссылка) КАК Количество
		|ИЗ Справочник.дбу_ПравилаДоработки КАК Правила
		|ГДЕ Правила.Владелец = &Профиль
		|И НЕ Правила.ПометкаУдаления
		|И Правила.Активно");
	Запрос.УстановитьПараметр("Профиль", Профиль);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Количество;
	КонецЕсли;

	Возврат 0;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СрезПрофилей(Организация, Период)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	| Применение.Ссылка КАК Профиль,
	| Применение.Приоритет
	|ИЗ
	| Справочник.дбу_ПрофилиДоработки.Применения КАК Применение
	|ГДЕ Применение.Организация = &Организация
	| И Применение.ПрименятьС <= &Период
	| И (Применение.НеПрименятьС = &ПустаяДата
	|  ИЛИ Применение.НеПрименятьС > &Период)
	| И Применение.Активно
	|УПОРЯДОЧИТЬ ПО Применение.Приоритет, Применение.Ссылка";
	Запрос.УстановитьПараметр("Период", НачалоГода(Период));
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ПустаяДата", Дата(1, 1, 1));
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

Функция НоваяТаблицаПрофилей()
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Профиль", Новый ОписаниеТипов("СправочникСсылка.дбу_ПрофилиДоработки"));
	Таблица.Колонки.Добавить("Приоритет", Новый ОписаниеТипов("Число"));
	Возврат Таблица;
КонецФункции

Процедура ДобавитьПрофильВСрезе(Таблица, Профиль, Приоритет)
	Если Не ЗначениеЗаполнено(Профиль) Тогда
		Возврат;
	КонецЕсли;
	Для Каждого СтрокаПрофиля Из Таблица Цикл
		Если СтрокаПрофиля.Профиль = Профиль Тогда
			Если Приоритет < СтрокаПрофиля.Приоритет Тогда
				СтрокаПрофиля.Приоритет = Приоритет;
			КонецЕсли;
			Возврат;
		КонецЕсли;
	КонецЦикла;
	НоваяСтрока = Таблица.Добавить();
	НоваяСтрока.Профиль = Профиль;
	НоваяСтрока.Приоритет = Приоритет;
КонецПроцедуры

Функция ПредставлениеПрофилей(Организация, Период)
	Профили = Новый Массив;
	Для Каждого СтрокаПрофиля Из ПрофилиДляОрганизации(Организация, Период) Цикл
		Профили.Добавить(Строка(СтрокаПрофиля.Профиль));
	КонецЦикла;
	Возврат СтрСоединить(Профили, ", ");
КонецФункции

Процедура ПроверитьДоступКОрганизации(Организация)
	Если Не дбу_ДоступОрганизаций.ОрганизацияДоступна(Организация, Истина) Тогда
		ВызватьИсключение дбу_ДоступОрганизаций.ТекстОшибкиДоступа();
	КонецЕсли;
КонецПроцедуры

Функция ТекущееАктивноеПрименение(Организация, Период)
	Профили = ПрофилиДляОрганизации(Организация, Период);
	Профили.Сортировать("Приоритет, Профиль");
	Если Профили.Количество() > 0 Тогда
		Возврат Профили[0].Профиль;
	КонецЕсли;
	Возврат Справочники.дбу_ПрофилиДоработки.ПустаяСсылка();
КонецФункции

Функция НоваяТаблицаРазницы()
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Организация", Новый ОписаниеТипов("СправочникСсылка.Организации"));
	Таблица.Колонки.Добавить("ОрганизацияПредставление", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("Выбрано", Новый ОписаниеТипов("Булево"));
	Таблица.Колонки.Добавить("ПрименятьС", Новый ОписаниеТипов("Дата"));
	Таблица.Колонки.Добавить("НеПрименятьС", Новый ОписаниеТипов("Дата"));
	Таблица.Колонки.Добавить("Состояние", Новый ОписаниеТипов("Строка"));
	Возврат Таблица;
КонецФункции

Функция НоваяТаблицаПрименений()
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Организация", Новый ОписаниеТипов("СправочникСсылка.Организации"));
	Таблица.Колонки.Добавить("ОрганизацияПредставление", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("ГодНачалаПрименения", Новый ОписаниеТипов("Число"));
	Таблица.Колонки.Добавить("ПоследнийГодПрименения", Новый ОписаниеТипов("Число"));
	Таблица.Колонки.Добавить("Состояние", Новый ОписаниеТипов("Строка"));
	Возврат Таблица;
КонецФункции

Процедура ДобавитьИлиПереоткрытьПрименение(
	ПрофильОбъект, Организация, Период, Приоритет, Активно = Истина)

	ПроверитьДоступКОрганизации(Организация);
	ПериодГода = НачалоГода(Период);

	Для Каждого СтрокаПрименения Из ПрофильОбъект.Применения Цикл
		Если СтрокаПрименения.Организация <> Организация Тогда
			Продолжить;
		КонецЕсли;

		Если СтрокаПрименения.ПрименятьС = ПериодГода
			Или ИнтервалВключаетДату(СтрокаПрименения, ПериодГода) Тогда
			ВызватьИсключение НСтр("ru = 'Организация уже подключена в этом году или интервал пересекается с существующим.'");
		КонецЕсли;
	КонецЦикла;

	НоваяСтрока = ПрофильОбъект.Применения.Добавить();
	НоваяСтрока.Организация = Организация;
	НоваяСтрока.ПрименятьС = ПериодГода;
	НоваяСтрока.НеПрименятьС = Дата(1, 1, 1);
	НоваяСтрока.Активно = Активно;
	НоваяСтрока.Приоритет = Приоритет;
	ПроверитьНепересечениеИнтервалов(ПрофильОбъект, НоваяСтрока);

КонецПроцедуры

Функция ИнтервалВключаетДату(СтрокаПрименения, ДатаПроверки)
	Если Не ЗначениеЗаполнено(СтрокаПрименения.ПрименятьС)
		Или СтрокаПрименения.ПрименятьС > ДатаПроверки Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Не ЗначениеЗаполнено(СтрокаПрименения.НеПрименятьС)
		Или СтрокаПрименения.НеПрименятьС > ДатаПроверки;
КонецФункции

Процедура ПроверитьНепересечениеИнтервалов(ПрофильОбъект, НоваяСтрока)
	Если ЗначениеЗаполнено(НоваяСтрока.НеПрименятьС)
		И НоваяСтрока.НеПрименятьС <= НоваяСтрока.ПрименятьС Тогда
		ВызватьИсключение НСтр("ru = 'Дата окончания должна быть позже даты начала.'");
	КонецЕсли;

	Для Каждого СтрокаПрименения Из ПрофильОбъект.Применения Цикл
		Если СтрокаПрименения = НоваяСтрока
			Или СтрокаПрименения.Организация <> НоваяСтрока.Организация Тогда
			Продолжить;
		КонецЕсли;
		Если ИнтервалыПересекаются(
			СтрокаПрименения.ПрименятьС, СтрокаПрименения.НеПрименятьС,
			НоваяСтрока.ПрименятьС, НоваяСтрока.НеПрименятьС) Тогда
			ВызватьИсключение НСтр("ru = 'Интервалы применения одной организации пересекаются.'");
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Функция ИнтервалыПересекаются(Начало1, Конец1, Начало2, Конец2)
	Возврат (Не ЗначениеЗаполнено(Конец1) Или Начало2 < Конец1)
		И (Не ЗначениеЗаполнено(Конец2) Или Начало1 < Конец2);
КонецФункции

#КонецОбласти
