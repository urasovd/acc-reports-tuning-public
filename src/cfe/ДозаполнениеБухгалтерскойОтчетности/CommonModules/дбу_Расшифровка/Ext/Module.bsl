// Строки расшифровки показателей с префиксом КДР.

// План: docs/urdv-dozapolnenie-buh-otchetnosti/01-план.md § 3.3



#Область ПрограммныйИнтерфейс



// Добавляет строку расшифровки к показателю в дереве раздела.

//

Процедура ДобавитьСтрокуРасшифровки(СтрокаПоказателя, ПараметрыРасшифровки) Экспорт



	Если СтрокаПоказателя = Неопределено Тогда

		Возврат;

	КонецЕсли;



	СтрокаРасшифровки = СтрокаПоказателя.Строки.Добавить();

	СтрокаРасшифровки.Тип = "Расшифровка";

	СтрокаРасшифровки.Идентификатор = "";

	СтрокаРасшифровки.Данные = ПараметрыРасшифровки;



КонецПроцедуры



// Добавляет компенсирующие строки к типовым слагаемым расшифровки (при УменьшитьТиповое).

//

Процедура ДобавитьКомпенсациюТиповыхСлагаемых(

	СтрокаПоказателя, КонтекстПравила, ИмяРаздела, ПравилоОбъект, ЗначенияОперандов) Экспорт



	Если СтрокаПоказателя = Неопределено Тогда

		Возврат;

	КонецЕсли;



	Для Каждого СтрокаОперанда Из ПравилоОбъект.Операнды Цикл

		Если Не ЗначениеЗаполнено(СтрокаОперанда.Счет) Тогда

			Продолжить;

		КонецЕсли;



		Идентификатор = ВРег(СокрЛП(Строка(СтрокаОперанда.Идентификатор)));

		СуммаОперанда = ЗначенияОперандов.Получить(Идентификатор);

		Если СуммаОперанда = Неопределено Или СуммаОперанда = 0 Тогда

			Продолжить;

		КонецЕсли;



		КодСчета = СокрЛП(Строка(СтрокаОперанда.Счет.Код));

		Если Не ЗначениеЗаполнено(КодСчета) Тогда

			Продолжить;

		КонецЕсли;



		СтрокаТиповогоСлагаемого = НайтиТиповоеСлагаемоеПоСчету(СтрокаПоказателя, КодСчета);

		Если СтрокаТиповогоСлагаемого = Неопределено Тогда

			Продолжить;

		КонецЕсли;



		СуммаКомпенсации = ?(СуммаОперанда < 0, -СуммаОперанда, СуммаОперанда);

		ПараметрыРасшифровки = ПараметрыКомпенсацииТиповогоСлагаемого(

			КонтекстПравила, ИмяРаздела, СтрокаОперанда, СуммаКомпенсации, СтрокаТиповогоСлагаемого);

		ДобавитьСтрокуРасшифровки(СтрокаПоказателя, ПараметрыРасшифровки);

	КонецЦикла;



КонецПроцедуры



// Истина для действия «Уменьшить» (перенос-источник, свёртка на уменьшаемой строке).

//

Функция НужнаКомпенсацияТиповыхСлагаемых(Действие) Экспорт



	Возврат Действие = Перечисления.дбу_ДействияСПоказателем.УменьшитьТиповое;



КонецФункции



// Формирует параметры расшифровки для применённого правила КДР (уровень 1 типовой расшифровки).
//
// НаименованиеПоказателя намеренно пустое — шапку окна расшифровки задаёт типовое
// заполнение (первая строка показателя). Атрибуция КДР — в НаименованиеСлагаемого.
// Одна строка = результат формулы. Операнды не выводятся как соседние +/- слагаемые
// (типовой механизм умеет только простые операции). Детализация операндов — в
// ДополнительныеПараметры для формы уровня 2, либо типовой Отчет при формуле = один операнд.
//
Функция ПараметрыРасшифровкиПравила(КонтекстПравила, ИмяРаздела, Сумма, Действие, ПравилоОбъект,
	ЗначенияОперандов, Формула = "", ПараметрыРасчета = Неопределено) Экспорт



	ТекстФормулы = СокрЛП(Формула);

	Если Не ЗначениеЗаполнено(ТекстФормулы) Тогда

		ТекстФормулы = СокрЛП(ПравилоОбъект.Формула);

	КонецЕсли;



	// Типовая расшифровка считает «Итого» как сумма всех Сумма (знак секции +/- только для подписи).
	// Поэтому в Сумма нужен вклад в итог со знаком, как в типовом заполнении ("-", -ДО).
	СуммаВклада = СуммаВкладаВРасшифровку(Сумма, Действие);

	ЗнакОперации = ЗнакОперацииПоСумме(СуммаВклада);



	ПараметрыРасшифровки = Новый Структура;

	ПараметрыРасшифровки.Вставить("НаименованиеПоказателя", "");

	ПараметрыРасшифровки.Вставить("ЗнакОперации", ЗнакОперации);

	ПараметрыРасшифровки.Вставить("НаименованиеСлагаемого",

		НаименованиеСлагаемогоДоработки(КонтекстПравила, Действие, ТекстФормулы, СуммаВклада,
			ОписаниеАрендногоОперандаФормулы(ПравилоОбъект, ТекстФормулы)));

	ПараметрыРасшифровки.Вставить("Сумма", СуммаВклада);

	ПараметрыРасшифровки.Вставить("ИмяРаздела", ИмяРаздела);

	ПараметрыРасшифровки.Вставить("ДополнительныеПараметры",

		ДополнительныеПараметрыСтрокиФормулы(

			КонтекстПравила, ИмяРаздела, ПравилоОбъект, ЗначенияОперандов, ТекстФормулы, Сумма, ПараметрыРасчета));

	ПараметрыРасшифровки.Вставить("Организация", КонтекстПравила.Организация);



	Возврат ПараметрыРасшифровки;



КонецФункции



// Истина, если в ДополнительныеПараметры лежит пакет расшифровки формулы КДР (уровень 2).
//
Функция ЭтоРасшифровкаФормулыКДР(ДополнительныеПараметры) Экспорт



	Если ТипЗнч(ДополнительныеПараметры) <> Тип("Структура") Тогда

		Возврат Ложь;

	КонецЕсли;



	Флаг = Ложь;

	Возврат ДополнительныеПараметры.Свойство("ЭтоРасшифровкаФормулыКДР", Флаг) И Флаг = Истина;



КонецФункции



// Формирует краткое описание операнда для расшифровки (без идентификатора A, B…).

//

Функция НаименованиеОперанда(СтрокаОперанда, Сумма) Экспорт



	Возврат СтрШаблон("%1 = %2", ОписаниеСпособаИСчета(СтрокаОперанда), Формат(Сумма, "ЧДЦ=2; ЧГ=3,0"));



КонецФункции



// Добавляет строки расшифровки по каждому операнду правила (для drill-down в типовые отчёты).

//

Процедура ДобавитьСтрокиРасшифровкиПравила(

	СтрокаПоказателя, КонтекстПравила, ИмяРаздела, ПравилоОбъект, ЗначенияОперандов, ПараметрыРасчета) Экспорт



	Если СтрокаПоказателя = Неопределено Тогда

		Возврат;

	КонецЕсли;



	Для Каждого СтрокаОперанда Из ПравилоОбъект.Операнды Цикл

		Идентификатор = ВРег(СокрЛП(Строка(СтрокаОперанда.Идентификатор)));

		СуммаОперанда = ЗначенияОперандов.Получить(Идентификатор);

		Если СуммаОперанда = Неопределено Тогда

			Продолжить;

		КонецЕсли;



		ПараметрыРасшифровки = ПараметрыРасшифровкиОперанда(

			КонтекстПравила, ИмяРаздела, СтрокаОперанда, СуммаОперанда, ПараметрыРасчета);

		ДобавитьСтрокуРасшифровки(СтрокаПоказателя, ПараметрыРасшифровки);

	КонецЦикла;



КонецПроцедуры



// Возвращает параметры строки расшифровки операнда (для пробного расчёта правила).
//
Функция ПараметрыРасшифровкиОперандаДляПробногоРасчета(
	КонтекстПравила, ИмяРаздела, СтрокаОперанда, СуммаОперанда, ПараметрыРасчета) Экспорт

	Возврат ПараметрыРасшифровкиОперанда(КонтекстПравила, ИмяРаздела, СтрокаОперанда, СуммаОперанда, ПараметрыРасчета);

КонецФункции

#КонецОбласти



#Область СлужебныеПроцедурыИФункции



Функция ПараметрыКомпенсацииТиповогоСлагаемого(

	КонтекстПравила, ИмяРаздела, СтрокаОперанда, СуммаКомпенсации, СтрокаТиповогоСлагаемого)



	ПараметрыРасшифровки = Новый Структура;

	ПараметрыРасшифровки.Вставить("НаименованиеПоказателя", "");

	// Вклад в «Итого» отрицательный: типовая форма всегда делает Итого + Сумма.
	СуммаВклада = ?(СуммаКомпенсации < 0, СуммаКомпенсации, -СуммаКомпенсации);

	ПараметрыРасшифровки.Вставить("ЗнакОперации", "-");

	ПараметрыРасшифровки.Вставить("НаименованиеСлагаемого",

		НаименованиеКомпенсацииТипового(КонтекстПравила, СтрокаОперанда, ?(СуммаВклада < 0, -СуммаВклада, СуммаВклада)));

	ПараметрыРасшифровки.Вставить("Сумма", СуммаВклада);

	ПараметрыРасшифровки.Вставить("ИмяРаздела", ИмяРаздела);

	ПараметрыРасшифровки.Вставить("ДополнительныеПараметры",

		ДополнительныеПараметрыКомпенсации(КонтекстПравила, СтрокаТиповогоСлагаемого));

	ПараметрыРасшифровки.Вставить("Организация", КонтекстПравила.Организация);



	Возврат ПараметрыРасшифровки;



КонецФункции



Функция НаименованиеКомпенсацииТипового(КонтекстПравила, СтрокаОперанда, СуммаКомпенсации)



	МеткаПрефикса = МеткаПрефиксаДляОтображения(КонтекстПравила.ЭффективныйПрефикс);

	ОписаниеСчета = ОписаниеСпособаИСчета(СтрокаОперанда);



	// Знак операции и отрицательное числовое значение уже выводятся отдельно.
	// В тексте оставляем только модуль суммы, чтобы минус не показывался дважды.
	СуммаКомпенсацииТекст = Формат(?(СуммаКомпенсации < 0, -СуммаКомпенсации, СуммаКомпенсации), "ЧДЦ=2; ЧГ=3,0");

	Возврат СтрШаблон(

		НСтр("ru = '%1 исключено КДР — %2 = %3'"),

		МеткаПрефикса,

		ОписаниеСчета,

		СуммаКомпенсацииТекст);



КонецФункции



Функция ДополнительныеПараметрыКомпенсации(КонтекстПравила, СтрокаТиповогоСлагаемого)



	ДополнительныеПараметры = ДополнительныеПараметрыИзТиповогоСлагаемого(СтрокаТиповогоСлагаемого);

	Если ДополнительныеПараметры = Неопределено Тогда

		ДополнительныеПараметры = ДополнительныеПараметрыДоработки(КонтекстПравила);

	Иначе

		ДополнительныеПараметры.Вставить("ЭтоДоработкаКДР", Истина);

		ДополнительныеПараметры.Вставить("СсылкаПравила", КонтекстПравила.СсылкаПравила);

	КонецЕсли;

	ДополнительныеПараметры.Вставить("ЭтоКомпенсацияТипового", Истина);



	Возврат ДополнительныеПараметры;



КонецФункции



Функция НайтиТиповоеСлагаемоеПоСчету(СтрокаПоказателя, КодСчета)



	Для Каждого СтрокаРасшифровки Из СтрокаПоказателя.Строки Цикл

		Если СтрокаРасшифровки.Тип <> "Расшифровка" Тогда

			Продолжить;

		КонецЕсли;



		Если ЭтоСтрокаДоработкиКДР(СтрокаРасшифровки.Данные) Тогда

			Продолжить;

		КонецЕсли;



		НаименованиеСлагаемого = "";

		Если ТипЗнч(СтрокаРасшифровки.Данные) = Тип("Структура")

			И СтрокаРасшифровки.Данные.Свойство("НаименованиеСлагаемого", НаименованиеСлагаемого)

			И НаименованиеСодержитКодСчета(НаименованиеСлагаемого, КодСчета) Тогда

			Возврат СтрокаРасшифровки;

		КонецЕсли;

	КонецЦикла;



	Возврат Неопределено;



КонецФункции



Функция ЭтоСтрокаДоработкиКДР(ДанныеРасшифровки)



	Если ТипЗнч(ДанныеРасшифровки) <> Тип("Структура") Тогда

		Возврат Ложь;

	КонецЕсли;



	ДополнительныеПараметры = Неопределено;

	Если ДанныеРасшифровки.Свойство("ДополнительныеПараметры", ДополнительныеПараметры)

		И ТипЗнч(ДополнительныеПараметры) = Тип("Структура") Тогда

		ЭтоДоработка = Ложь;

		Если ДополнительныеПараметры.Свойство("ЭтоДоработкаКДР", ЭтоДоработка) И ЭтоДоработка = Истина Тогда

			Возврат Истина;

		КонецЕсли;

	КонецЕсли;



	НаименованиеСлагаемого = "";

	Если ДанныеРасшифровки.Свойство("НаименованиеСлагаемого", НаименованиеСлагаемого) Тогда

		Возврат СтрНачинаетсяС(СокрЛП(НаименованиеСлагаемого), "[");

	КонецЕсли;



	Возврат Ложь;



КонецФункции



Функция НаименованиеСодержитКодСчета(НаименованиеСлагаемого, КодСчета)



	Текст = СокрЛП(НаименованиеСлагаемого);

	Если Не ЗначениеЗаполнено(Текст) Или Не ЗначениеЗаполнено(КодСчета) Тогда

		Возврат Ложь;

	КонецЕсли;



	ПозицияПоиска = 1;

	ДлинаКода = СтрДлина(КодСчета);



	Пока Истина Цикл

		Позиция = СтрНайти(Текст, КодСчета, , ПозицияПоиска);

		Если Позиция = 0 Тогда

			Возврат Ложь;

		КонецЕсли;



		СимволПеред = ?(Позиция > 1, Сред(Текст, Позиция - 1, 1), "");

		ПозицияПосле = Позиция + ДлинаКода;

		СимволПосле = ?(ПозицияПосле <= СтрДлина(Текст), Сред(Текст, ПозицияПосле, 1), "");



		Если (СимволПеред = "" Или Не ЭтоЦифра(СимволПеред))

			И (СимволПосле = "" Или Не ЭтоЦифра(СимволПосле)) Тогда

			Возврат Истина;

		КонецЕсли;



		ПозицияПоиска = Позиция + 1;

	КонецЦикла;



КонецФункции



Функция ЭтоЦифра(Символ)



	Возврат СтрНайти("0123456789", Символ) > 0;



КонецФункции



// Для цели арендного правила с формулой из одного операнда (например, «B» — сторно
// типовой аренды) возвращает описание этого операнда, чтобы строки «сторно типового»
// и «наш расчет» одного правила различались в расшифровке. Иначе пустая строка.
//
Функция ОписаниеАрендногоОперандаФормулы(ПравилоОбъект, ТекстФормулы)

	Идентификатор = ВРег(СокрЛП(ТекстФормулы));
	Если Не ЗначениеЗаполнено(Идентификатор) Тогда
		Возврат "";
	КонецЕсли;

	Для Каждого СтрокаОперанда Из ПравилоОбъект.Операнды Цикл
		Если ВРег(СокрЛП(Строка(СтрокаОперанда.Идентификатор))) = Идентификатор
			И дбу_РасчетАрендныхОбязательств.ЭтоСпособРасчетаАренды(СтрокаОперанда.СпособРасчета) Тогда
			Возврат дбу_ФормыПравил.ОписаниеОперандаДляОтображения(СтрокаОперанда);
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

Функция НаименованиеСлагаемогоДоработки(КонтекстПравила, Действие, ТекстФормулы, Сумма,
	ОписаниеОперанда = "")

	МеткаПрефикса = МеткаПрефиксаДляОтображения(КонтекстПравила.ЭффективныйПрефикс);

	ЗаголовокПравила = ЗаголовокПравилаДляРасшифровки(КонтекстПравила);
	Если ЗначениеЗаполнено(ОписаниеОперанда) Тогда
		ЗаголовокПравила = ЗаголовокПравила + ": " + ОписаниеОперанда;
	КонецЕсли;

	// Знак операции и отрицательное числовое значение уже выводятся отдельно.
	// В тексте оставляем только модуль суммы, чтобы минус не показывался дважды.
	СуммаТекст = Формат(?(Сумма < 0, -Сумма, Сумма), "ЧДЦ=2; ЧГ=3,0");



	Если ЗначениеЗаполнено(ТекстФормулы) Тогда

		Возврат СтрШаблон("%1 %2 = %3", МеткаПрефикса, ЗаголовокПравила, СуммаТекст);

	КонецЕсли;



	ДействиеТекст = НРег(Строка(Действие));

	Возврат СтрШаблон("%1 %2 — %3 = %4", МеткаПрефикса, ЗаголовокПравила, ДействиеТекст, СуммаТекст);



КонецФункции



Функция ОписаниеСпособаИСчета(СтрокаОперанда)

	Возврат дбу_ФормыПравил.ОписаниеОперандаДляОтображения(СтрокаОперанда);

КонецФункции



Функция МеткаПрефиксаДляОтображения(ЭффективныйПрефикс)



	ТекстПрефикса = СокрЛП(ЭффективныйПрефикс);

	ТекстПрефикса = СтрЗаменить(ТекстПрефикса, ":", "");

	ТекстПрефикса = СокрЛП(ТекстПрефикса);



	Если Не ЗначениеЗаполнено(ТекстПрефикса) Тогда

		ТекстПрефикса = "КДР";

	КонецЕсли;



	Возврат "[" + ТекстПрефикса + "]";



КонецФункции



Функция ЭффективныйПрефиксРасшифровки(ПрефиксПравила, ПрефиксПрофиля = "") Экспорт



	Если ЗначениеЗаполнено(ПрефиксПравила) Тогда

		Возврат ПрефиксПравила;

	КонецЕсли;

	Если ЗначениеЗаполнено(ПрефиксПрофиля) Тогда

		Возврат ПрефиксПрофиля;

	КонецЕсли;



	Возврат "КДР: ";



КонецФункции



Функция ДополнительныеПараметрыДоработки(КонтекстПравила)



	ДополнительныеПараметры = Новый Структура;

	ДополнительныеПараметры.Вставить("Ссылка", КонтекстПравила.СсылкаПравила);

	ДополнительныеПараметры.Вставить("СсылкаПравила", КонтекстПравила.СсылкаПравила);

	ДополнительныеПараметры.Вставить("Профиль", КонтекстПравила.Профиль);

	ДополнительныеПараметры.Вставить("ЭтоДоработкаКДР", Истина);



	Возврат ДополнительныеПараметры;



КонецФункции



Функция ЗнакОперацииПоСумме(Сумма)



	Если Сумма < 0 Тогда

		Возврат "-";

	КонецЕсли;



	Возврат "+";



КонецФункции



// Вклад строки КДР в «Итого» типовой расшифровки (там всегда Итого = Итого + Сумма).
//
Функция СуммаВкладаВРасшифровку(СуммаПрименения, Действие)



	Если Действие = Перечисления.дбу_ДействияСПоказателем.УменьшитьТиповое Тогда

		// В показатель пишется Текущее - abs(Сумма) → вклад в расшифровку отрицательный.
		МодульСуммы = ?(СуммаПрименения < 0, -СуммаПрименения, СуммаПрименения);
		Возврат -МодульСуммы;

	КонецЕсли;



	// Добавить / Заменить: в показатель уходит сумма как есть (может быть < 0).
	Возврат СуммаПрименения;



КонецФункции



Функция ПараметрыРасшифровкиОперанда(КонтекстПравила, ИмяРаздела, СтрокаОперанда, СуммаОперанда, ПараметрыРасчета)



	// Сумма операнда со знаком (для «Итого» типовой расшифровки: Итого + Сумма).
	ПараметрыРасшифровки = Новый Структура;

	ПараметрыРасшифровки.Вставить("НаименованиеПоказателя", "");

	ПараметрыРасшифровки.Вставить("ЗнакОперации", ЗнакОперацииПоСумме(СуммаОперанда));

	ПараметрыРасшифровки.Вставить("НаименованиеСлагаемого",

		НаименованиеСлагаемогоОперанда(КонтекстПравила, СтрокаОперанда, СуммаОперанда));

	ПараметрыРасшифровки.Вставить("Сумма", СуммаОперанда);

	ПараметрыРасшифровки.Вставить("ИмяРаздела", ИмяРаздела);

	ПараметрыРасшифровки.Вставить("ДополнительныеПараметры",

		ДополнительныеПараметрыОперанда(КонтекстПравила, ПараметрыРасчета, СтрокаОперанда));

	ПараметрыРасшифровки.Вставить("Организация", КонтекстПравила.Организация);



	Возврат ПараметрыРасшифровки;



КонецФункции



Функция НаименованиеСлагаемогоОперанда(КонтекстПравила, СтрокаОперанда, СуммаОперанда)



	МеткаПрефикса = МеткаПрефиксаДляОтображения(КонтекстПравила.ЭффективныйПрефикс);

	Идентификатор = ВРег(СокрЛП(Строка(СтрокаОперанда.Идентификатор)));

	ЗаголовокПравила = ЗаголовокПравилаДляРасшифровки(КонтекстПравила);



	Возврат СтрШаблон("%1 %2 — %3: %4",

		МеткаПрефикса,

		ЗаголовокПравила,

		Идентификатор,

		НаименованиеОперанда(СтрокаОперанда, СуммаОперанда));



КонецФункции



Функция ЗаголовокПравилаДляРасшифровки(КонтекстПравила)



	Возврат КонтекстПравила.НаименованиеПравила;



КонецФункции



Функция ДополнительныеПараметрыОперанда(КонтекстПравила, ПараметрыРасчета, СтрокаОперанда)



	НастройкиТипового = НастройкиРасшифровкиТиповымОтчетом(ПараметрыРасчета, СтрокаОперанда);

	Если НастройкиТипового <> Неопределено Тогда

		Возврат ОбъединитьНастройкиТиповогоИМетаданныеКДР(НастройкиТипового, КонтекстПравила);

	КонецЕсли;



	Возврат ДополнительныеПараметрыДоработки(КонтекстПравила);



КонецФункции



Функция НастройкиРасшифровкиТиповымОтчетом(ПараметрыРасчета, СтрокаОперанда)



	Если СтрокаОперанда.СпособРасчета = Перечисления.дбу_СпособыРасчетаОперанда.Запрос Тогда

		Возврат Неопределено;

	КонецЕсли;



	Если СтрокаОперанда.СпособРасчета = Перечисления.дбу_СпособыРасчетаОперанда.ОтборСКД Тогда

		ПакетЗапроса = дбу_СКДОперандов.ПакетЗапросаИзСправочника(СтрокаОперанда.ЗапросДанных);
		Если ПакетЗапроса <> Неопределено Тогда

			Если Не ПакетЗапроса.Свойство("ВидыСубконто") Тогда
				ПакетЗапроса.Вставить("ВидыСубконто", "");
			КонецЕсли;

			Если Не ЗначениеЗаполнено(ПакетЗапроса.ВидыСубконто)
				И ЗначениеЗаполнено(СтрокаОперанда.ВидыСубконто) Тогда
				ПакетЗапроса.ВидыСубконто = СтрокаОперанда.ВидыСубконто;
			КонецЕсли;

		КонецЕсли;

		Возврат дбу_СКДОперандов.НастройкиРасшифровкиИзСКД(ПараметрыРасчета, ПакетЗапроса);

	КонецЕсли;



	Если Не ЗначениеЗаполнено(СтрокаОперанда.Счет) Тогда

		Возврат Неопределено;

	КонецЕсли;



	ОбщиеНастройки = ОбщиеНастройкиДляТиповойРасшифровки(ПараметрыРасчета);



	Если (СтрокаОперанда.СпособРасчета = Перечисления.дбу_СпособыРасчетаОперанда.ДО

		Или СтрокаОперанда.СпособРасчета = Перечисления.дбу_СпособыРасчетаОперанда.КО)

		И ЗначениеЗаполнено(СтрокаОперанда.КорСчет) Тогда

		Возврат ЗаполнениеБухгалтерскойОтчетности.НастройкиАнализаСчета(

			ОбщиеНастройки, СтрокаОперанда.Счет, СтрокаОперанда.КорСчет);

	КонецЕсли;



	ДанныеРасшифровки = ЗаполнениеБухгалтерскойОтчетности.НастройкиОСВПоСчету(
		ОбщиеНастройки,
		СтрокаОперанда.Счет,
		ОтборПоАналитикеЗнакаСальдо(СтрокаОперанда));

	дбу_СКДОперандов.ПрименитьДетализациюОперандаКРасшифровке(ДанныеРасшифровки, СтрокаОперанда);

	Возврат ДанныеРасшифровки;

КонецФункции

Функция ОтборПоАналитикеЗнакаСальдо(СтрокаОперанда)

	Если Не ЗначениеЗаполнено(СтрокаОперанда.ЗнакСальдо) Тогда
		Возврат Неопределено;
	КонецЕсли;

	ПоказателиСтандартныхОтчетов = ПоказателиСтандартныхОтчетовДляЗнакаСальдо();
	Показатель = ПоказателиСтандартныхОтчетов[СтрокаОперанда.СпособРасчета];
	Если Показатель = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	ВидыСравнений = Новый Соответствие;
	ВидыСравнений.Вставить("+", ВидСравненияКомпоновкиДанных.Больше);
	ВидыСравнений.Вставить("-", ВидСравненияКомпоновкиДанных.Меньше);

	ОтборПоАналитике = Новый Соответствие;
	СтруктураОтбора = Новый Структура(
		"ВидСравненияКомпоновкиДанных, Значение",
		ВидыСравнений[СтрокаОперанда.ЗнакСальдо],
		0);
	ОтборПоАналитике.Вставить(Показатель, СтруктураОтбора);

	Возврат ОтборПоАналитике;

КонецФункции

Функция ПоказателиСтандартныхОтчетовДляЗнакаСальдо()

	Показатели = Новый Соответствие;
	Показатели.Вставить(Перечисления.дбу_СпособыРасчетаОперанда.СНД, "СальдоНаНачалоПериода.БУНачальныйОстатокДт");
	Показатели.Вставить(Перечисления.дбу_СпособыРасчетаОперанда.СНДР, "СальдоНаНачалоПериода.БУНачальныйРазвернутыйОстатокДт");
	Показатели.Вставить(Перечисления.дбу_СпособыРасчетаОперанда.СНК, "СальдоНаНачалоПериода.БУНачальныйОстатокКт");
	Показатели.Вставить(Перечисления.дбу_СпособыРасчетаОперанда.СНКР, "СальдоНаНачалоПериода.БУНачальныйРазвернутыйОстатокКт");
	Показатели.Вставить(Перечисления.дбу_СпособыРасчетаОперанда.СКД, "СальдоНаКонецПериода.БУКонечныйОстатокДт");
	Показатели.Вставить(Перечисления.дбу_СпособыРасчетаОперанда.СКДР, "СальдоНаКонецПериода.БУКонечныйРазвернутыйОстатокДт");
	Показатели.Вставить(Перечисления.дбу_СпособыРасчетаОперанда.СКК, "СальдоНаКонецПериода.БУКонечныйОстатокКт");
	Показатели.Вставить(Перечисления.дбу_СпособыРасчетаОперанда.СККР, "СальдоНаКонецПериода.БУКонечныйРазвернутыйОстатокКт");

	Возврат Показатели;

КонецФункции



Функция ОбщиеНастройкиДляТиповойРасшифровки(ПараметрыРасчета)

	Возврат Новый Структура(
		"Организация, НачалоПериода, КонецПериода",
		ПараметрыРасчета.Организация,
		ПараметрыРасчета.НачалоПериода,
		ПараметрыРасчета.КонецПериода);

КонецФункции



Функция ОбъединитьНастройкиТиповогоИМетаданныеКДР(НастройкиТипового, КонтекстПравила)



	ДополнительныеПараметры = Новый Структура;

	ДополнительныеПараметры.Вставить("Организация", НастройкиТипового.Организация);

	ДополнительныеПараметры.Вставить("Отчет", НастройкиТипового.Отчет);

	ДополнительныеПараметры.Вставить("Ссылка", КонтекстПравила.СсылкаПравила);

	ДополнительныеПараметры.Вставить("СсылкаПравила", КонтекстПравила.СсылкаПравила);

	ДополнительныеПараметры.Вставить("Профиль", КонтекстПравила.Профиль);

	ДополнительныеПараметры.Вставить("ЭтоДоработкаКДР", Истина);



	Возврат ДополнительныеПараметры;



КонецФункции



Функция ДополнительныеПараметрыИзТиповогоСлагаемого(СтрокаТиповогоСлагаемого)



	Если СтрокаТиповогоСлагаемого = Неопределено Тогда

		Возврат Неопределено;

	КонецЕсли;



	Данные = СтрокаТиповогоСлагаемого.Данные;

	Если ТипЗнч(Данные) <> Тип("Структура") Тогда

		Возврат Неопределено;

	КонецЕсли;



	ДополнительныеПараметры = Неопределено;

	Если Не Данные.Свойство("ДополнительныеПараметры", ДополнительныеПараметры)

		Или ТипЗнч(ДополнительныеПараметры) <> Тип("Структура")

		Или Не ДополнительныеПараметры.Свойство("Отчет") Тогда

		Возврат Неопределено;

	КонецЕсли;



	Возврат ОбщегоНазначенияКлиентСервер.СкопироватьСтруктуру(ДополнительныеПараметры);



КонецФункции



Функция ДополнительныеПараметрыСтрокиФормулы(КонтекстПравила, ИмяРаздела, ПравилоОбъект,
	ЗначенияОперандов, ТекстФормулы, Сумма, ПараметрыРасчета)



	ДополнительныеПараметры = ДополнительныеПараметрыДоработки(КонтекстПравила);



	ИдентификаторПростойФормулы = ИдентификаторПростойФормулыОдногоОперанда(ТекстФормулы);

	Если ЗначениеЗаполнено(ИдентификаторПростойФормулы) И ПараметрыРасчета <> Неопределено Тогда



		СтрокаОперанда = СтрокаОперандаПоИдентификатору(ПравилоОбъект, ИдентификаторПростойФормулы);

		Если СтрокаОперанда <> Неопределено Тогда

			СуммаОперанда = ЗначенияОперандов.Получить(ИдентификаторПростойФормулы);

			Если СуммаОперанда = Неопределено Тогда

				СуммаОперанда = 0;

			КонецЕсли;

			ПараметрыОперанда = ПараметрыРасшифровкиОперанда(

				КонтекстПравила, ИмяРаздела, СтрокаОперанда, СуммаОперанда, ПараметрыРасчета);

			Если ТипЗнч(ПараметрыОперанда.ДополнительныеПараметры) = Тип("Структура")

				И ПараметрыОперанда.ДополнительныеПараметры.Свойство("Отчет") Тогда

				Возврат ПараметрыОперанда.ДополнительныеПараметры;

			КонецЕсли;

		КонецЕсли;



	КонецЕсли;



	ПакетОперандов = ПакетОперандовДляРасшифровкиФормулы(

		КонтекстПравила, ИмяРаздела, ПравилоОбъект, ЗначенияОперандов, ПараметрыРасчета);



	ДополнительныеПараметры.Вставить("ЭтоРасшифровкаФормулыКДР", Истина);

	ДополнительныеПараметры.Вставить("Формула", ТекстФормулы);

	ДополнительныеПараметры.Вставить("Итог", Сумма);

	ДополнительныеПараметры.Вставить("НаименованиеПравила", КонтекстПравила.НаименованиеПравила);

	ДополнительныеПараметры.Вставить("Операнды", ПакетОперандов);



	// Типовая форма РасшифровкаПоказателейРегламентированныхОтчетов:
	// при клике сначала смотрит Отчет, иначе Ссылка → открывает правило.
	// Кладём Отчет на нашу форму уровня 2 (без цикличной ссылки на эту же структуру).
	ПакетДляФормы = Новый Структура;

	ПакетДляФормы.Вставить("ЭтоРасшифровкаФормулыКДР", Истина);

	ПакетДляФормы.Вставить("Формула", ТекстФормулы);

	ПакетДляФормы.Вставить("Итог", Сумма);

	ПакетДляФормы.Вставить("НаименованиеПравила", КонтекстПравила.НаименованиеПравила);

	ПакетДляФормы.Вставить("Операнды", ПакетОперандов);

	ПакетДляФормы.Вставить("СсылкаПравила", КонтекстПравила.СсылкаПравила);



	ПараметрыФормыОтчета = Новый Структура;

	ПараметрыФормыОтчета.Вставить("ДополнительныеПараметры", ПакетДляФормы);



	Отчет = Новый Структура;

	Отчет.Вставить("ИмяОтчета", "Справочник.дбу_ПравилаДоработки.Форма.ФормаРасшифровкиФормулы");

	Отчет.Вставить("ПараметрыФормы", ПараметрыФормыОтчета);

	ДополнительныеПараметры.Вставить("Отчет", Отчет);



	Возврат ДополнительныеПараметры;



КонецФункции



Функция ПакетОперандовДляРасшифровкиФормулы(КонтекстПравила, ИмяРаздела, ПравилоОбъект,
	ЗначенияОперандов, ПараметрыРасчета)



	Пакет = Новый Массив;

	Если ПараметрыРасчета = Неопределено Тогда

		Возврат Пакет;

	КонецЕсли;



	Для Каждого СтрокаОперанда Из ПравилоОбъект.Операнды Цикл



		Идентификатор = ВРег(СокрЛП(Строка(СтрокаОперанда.Идентификатор)));

		Если Не ЗначениеЗаполнено(Идентификатор) Тогда

			Продолжить;

		КонецЕсли;



		СуммаОперанда = ЗначенияОперандов.Получить(Идентификатор);

		Если СуммаОперанда = Неопределено Тогда

			СуммаОперанда = 0;

		КонецЕсли;



		ПараметрыОперанда = ПараметрыРасшифровкиОперанда(

			КонтекстПравила, ИмяРаздела, СтрокаОперанда, СуммаОперанда, ПараметрыРасчета);



		Элемент = Новый Структура;

		Элемент.Вставить("Идентификатор", Идентификатор);

		Элемент.Вставить("НаименованиеСлагаемого", ПараметрыОперанда.НаименованиеСлагаемого);

		Элемент.Вставить("Сумма", СуммаОперанда);

		Элемент.Вставить("ЗнакОперации", ПараметрыОперанда.ЗнакОперации);

		Элемент.Вставить("ДополнительныеПараметры", ПараметрыОперанда.ДополнительныеПараметры);

		Пакет.Добавить(Элемент);



	КонецЦикла;



	Возврат Пакет;



КонецФункции



// Формула вида "A" / " a " — один операнд без операций; иначе пустая строка.
//
Функция ИдентификаторПростойФормулыОдногоОперанда(ТекстФормулы)



	Выражение = ВРег(СтрЗаменить(СокрЛП(ТекстФормулы), " ", ""));

	Если Не ЗначениеЗаполнено(Выражение) Тогда

		Возврат "";

	КонецЕсли;



	Для Индекс = 1 По СтрДлина(Выражение) Цикл

		Символ = Сред(Выражение, Индекс, 1);

		Код = КодСимвола(Символ);

		Если Не ((Код >= КодСимвола("A") И Код <= КодСимвола("Z"))) Тогда

			Возврат "";

		КонецЕсли;

	КонецЦикла;



	Возврат Выражение;



КонецФункции



Функция СтрокаОперандаПоИдентификатору(ПравилоОбъект, Идентификатор)



	ИдентификаторВРег = ВРег(СокрЛП(Идентификатор));

	Для Каждого СтрокаОперанда Из ПравилоОбъект.Операнды Цикл

		Если ВРег(СокрЛП(Строка(СтрокаОперанда.Идентификатор))) = ИдентификаторВРег Тогда

			Возврат СтрокаОперанда;

		КонецЕсли;

	КонецЦикла;



	Возврат Неопределено;



КонецФункции



#КонецОбласти
