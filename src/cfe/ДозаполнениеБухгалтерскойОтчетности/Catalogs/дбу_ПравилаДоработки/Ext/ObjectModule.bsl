// Правила доработки бухотчётности.

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ)

	ПроверитьПериоды(Отказ);
	ПроверитьКодыСтрокЦелей(Отказ);
	дбу_ФормыПравил.ОбновитьПредставленияОперандов(Операнды);
	ПроверитьЦелиАрендногоПравила(Отказ);
	ПроверитьФормулыПравила(Отказ);

КонецПроцедуры

#КонецОбласти

#Область ПроверкаПериодов

Процедура ПроверитьПериоды(Отказ)

	Если ЗначениеЗаполнено(НеПрименятьС)
		И Не ЗначениеЗаполнено(ПрименятьС) Тогда
		Отказ = Истина;
		ОбщегоНазначения.СообщитьПользователю(
			НСтр("ru = 'Укажите дату начала правила перед датой окончания.'"),
			ЭтотОбъект, "ПрименятьС", , Отказ);
		Возврат;
	КонецЕсли;

	Если ЗначениеЗаполнено(ПрименятьС)
		И ЗначениеЗаполнено(НеПрименятьС)
		И НеПрименятьС <= ПрименятьС Тогда
		Отказ = Истина;
		ОбщегоНазначения.СообщитьПользователю(
			НСтр("ru = 'Дата окончания правила должна быть позже даты начала.'"),
			ЭтотОбъект, "НеПрименятьС", , Отказ);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьКодыСтрокЦелей(Отказ)

	Для Каждого СтрокаЦели Из Цели Цикл
		СтрокаЦели.КодСтрокиФСБУ = СокрЛП(СтрокаЦели.КодСтрокиФСБУ);
		ПроверкаАдреса = дбу_СтруктураОтчетности.ПроверитьАдресСтрокиЦели(
			Раздел, СтрокаЦели);
		Если ПроверкаАдреса.Успех Тогда
			Продолжить;
		КонецЕсли;
		Отказ = Истина;
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = ПроверкаАдреса.ТекстОшибки;
		Сообщение.Поле = "Цели[" + Формат(СтрокаЦели.НомерСтроки - 1, "ЧГ=0") + "]."
			+ ПроверкаАдреса.Поле;
		Сообщение.УстановитьДанные(ЭтотОбъект);
		Сообщение.Сообщить();
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьЦелиАрендногоПравила(Отказ)

	Для Каждого СтрокаЦели Из Цели Цикл
		Адрес = дбу_СтруктураОтчетности.АдресСтрокиЦели(СтрокаЦели);
		Попытка
			дбу_ДвижокДоработки.ПроверитьЦельАрендногоПравила(ЭтотОбъект, Адрес, СтрокаЦели.Действие);
		Исключение
			Отказ = Истина;
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = ОписаниеОшибки();
			Сообщение.Поле = "Цели[" + Формат(СтрокаЦели.НомерСтроки - 1, "ЧГ=0")
				+ "].СтрокаОтчетности";
			Сообщение.УстановитьДанные(ЭтотОбъект);
			Сообщение.Сообщить();
		КонецПопытки;
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьФормулыПравила(Отказ)

	ИдентификаторыОперандов = ИдентификаторыОперандовПравила();

	Если ЗначениеЗаполнено(СокрЛП(Формула)) Тогда
		ПроверитьОднуФормулу(Формула, ИдентификаторыОперандов, НСтр("ru = 'Формула правила'"), Отказ);
	КонецЕсли;

	Для Каждого СтрокаЦели Из Цели Цикл

		Если Не ЗначениеЗаполнено(СокрЛП(СтрокаЦели.Формула)) Тогда
			Продолжить;
		КонецЕсли;

		ПроверитьОднуФормулу(
			СтрокаЦели.Формула,
			ИдентификаторыОперандов,
			СтрШаблон(НСтр("ru = 'Формула цели (строка %1)'"), СтрокаЦели.НомерСтроки),
			Отказ);

	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьОднуФормулу(ТекстФормулы, ИдентификаторыОперандов, ПредставлениеПоля, Отказ)

	РезультатПроверки = дбу_ДвижокДоработки.ПроверитьФормулу(ТекстФормулы, ИдентификаторыОперандов);
	Если РезультатПроверки.Успех Тогда
		Возврат;
	КонецЕсли;

	ОбщегоНазначения.СообщитьПользователю(
		СтрШаблон("%1: %2", ПредставлениеПоля, РезультатПроверки.ТекстОшибки),
		ЭтотОбъект,
		"Формула",
		,
		Отказ);

КонецПроцедуры

Функция ИдентификаторыОперандовПравила()

	Идентификаторы = Новый Массив;

	Для Каждого СтрокаОперанда Из Операнды Цикл
		Идентификатор = СокрЛП(Строка(СтрокаОперанда.Идентификатор));
		Если ЗначениеЗаполнено(Идентификатор) Тогда
			Идентификаторы.Добавить(Идентификатор);
		КонецЕсли;
	КонецЦикла;

	Возврат Идентификаторы;

КонецФункции

#КонецОбласти

#КонецЕсли
