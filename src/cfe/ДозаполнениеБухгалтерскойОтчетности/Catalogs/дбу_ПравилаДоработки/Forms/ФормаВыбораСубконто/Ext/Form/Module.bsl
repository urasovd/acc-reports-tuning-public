
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Параметры.Свойство("Счет")
		И Параметры.Свойство("ВидыСубконто") Тогда

		Счет = Параметры.Счет;
		СпособРасчета = Неопределено;

		Если Параметры.Свойство("СпособРасчета") Тогда
			СпособРасчета = Параметры.СпособРасчета;
		КонецЕсли;

		ДляСальдо = дбу_ФормыПравил.ЭтоСпособСальдо(СпособРасчета);

		Если Счет.ВидыСубконто.Количество() = 0 Тогда
			ВызватьИсключение НСтр("ru = 'На счёте не определено ни одного вида субконто.'");
		КонецЕсли;

		ВыбранныеСубконто = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(Параметры.ВидыСубконто, ",", , Истина);

		Элементы.ВыбранВидСубконто1.Видимость = Ложь;
		Элементы.ВыбранВидСубконто2.Видимость = Ложь;
		Элементы.ВыбранВидСубконто3.Видимость = Ложь;

		Для Каждого СтрокаСубконто Из Счет.ВидыСубконто Цикл

			НомерСтроки = Строка(СтрокаСубконто.НомерСтроки);
			ИмяСубконто = СтрокаСубконто.ВидСубконто.ИмяПредопределенныхДанных;
			ИмяЭлемента = "ВыбранВидСубконто" + НомерСтроки;
			ТолькоОбороты = СтрокаСубконто.ТолькоОбороты;

			ЭтаФорма["ВидСубконто" + НомерСтроки] = ИмяСубконто;
			Элементы[ИмяЭлемента].Заголовок = дбу_ФормыПравил.ЗаголовокВидаСубконтоДляВыбора(
				СтрокаСубконто.ВидСубконто, ТолькоОбороты);
			Элементы[ИмяЭлемента].Видимость = Истина;

			Выбран = ВыбранныеСубконто.Найти(ИмяСубконто) <> Неопределено;
			Если ТолькоОбороты И ДляСальдо Тогда
				ЭтаФорма[ИмяЭлемента] = Ложь;
				Элементы[ИмяЭлемента].Доступность = Ложь;
				Элементы[ИмяЭлемента].Подсказка = дбу_ФормыПравил.ПодсказкаОборотногоСубконто(Истина);
			Иначе
				ЭтаФорма[ИмяЭлемента] = Выбран;
				Элементы[ИмяЭлемента].Доступность = Истина;
				Если ТолькоОбороты Тогда
					Элементы[ИмяЭлемента].Подсказка = дбу_ФормыПравил.ПодсказкаОборотногоСубконто(Ложь);
				КонецЕсли;
			КонецЕсли;

		КонецЦикла;

	Иначе
		ВызватьИсключение НСтр("ru = 'Неверные параметры формы.'");
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКоманд

&НаКлиенте
Процедура ВыбратьВидыСубконто(Команда)

	СтрокаСубконто = "";

	Если ВыбранВидСубконто1 Тогда
		СтрокаСубконто = СтрокаСубконто + ВидСубконто1;
	КонецЕсли;

	Если ВыбранВидСубконто2 Тогда
		СтрокаСубконто = СтрокаСубконто + ?(ЗначениеЗаполнено(СтрокаСубконто), ", ", "") + ВидСубконто2;
	КонецЕсли;

	Если ВыбранВидСубконто3 Тогда
		СтрокаСубконто = СтрокаСубконто + ?(ЗначениеЗаполнено(СтрокаСубконто), ", ", "") + ВидСубконто3;
	КонецЕсли;

	Закрыть(СтрокаСубконто);

КонецПроцедуры

#КонецОбласти
