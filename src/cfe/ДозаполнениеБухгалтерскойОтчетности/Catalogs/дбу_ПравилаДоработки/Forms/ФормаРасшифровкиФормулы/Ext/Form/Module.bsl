
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Не Параметры.Свойство("ДополнительныеПараметры") Тогда
		ВызватьИсключение НСтр("ru = 'Не переданы данные расшифровки формулы.'");
	КонецЕсли;

	ДанныеФормулы = Параметры.ДополнительныеПараметры;
	Если ТипЗнч(ДанныеФормулы) <> Тип("Структура") Тогда
		ВызватьИсключение НСтр("ru = 'Неверный формат данных расшифровки формулы.'");
	КонецЕсли;

	Если Не дбу_Расшифровка.ЭтоРасшифровкаФормулыКДР(ДанныеФормулы) Тогда
		ВызватьИсключение НСтр("ru = 'Переданные данные не являются расшифровкой формулы КДР.'");
	КонецЕсли;

	ДанныеФормулы.Свойство("НаименованиеПравила", НаименованиеПравила);
	ДанныеФормулы.Свойство("Формула", Формула);
	ДанныеФормулы.Свойство("Итог", Итог);

	Заголовок = СтрШаблон(НСтр("ru = 'Расшифровка формулы: %1'"),
		?(ЗначениеЗаполнено(НаименованиеПравила), НаименованиеПравила, Формула));

	ПараметрыПоСтрокам = Новый Соответствие;
	НомерСтроки = 0;
	Операнды.Очистить();

	ПакетОперандов = Неопределено;
	Если ДанныеФормулы.Свойство("Операнды", ПакетОперандов) И ТипЗнч(ПакетОперандов) = Тип("Массив") Тогда

		Для Каждого ЭлементОперанда Из ПакетОперандов Цикл

			Если ТипЗнч(ЭлементОперанда) <> Тип("Структура") Тогда
				Продолжить;
			КонецЕсли;

			НомерСтроки = НомерСтроки + 1;
			НоваяСтрока = Операнды.Добавить();
			НоваяСтрока.НомерСтроки = НомерСтроки;

			Идентификатор = "";
			ЭлементОперанда.Свойство("Идентификатор", Идентификатор);
			НоваяСтрока.Идентификатор = Идентификатор;

			НаименованиеСлагаемого = "";
			ЭлементОперанда.Свойство("НаименованиеСлагаемого", НаименованиеСлагаемого);
			НоваяСтрока.НаименованиеСлагаемого = НаименованиеСлагаемого;

			СуммаОперанда = 0;
			ЭлементОперанда.Свойство("Сумма", СуммаОперанда);
			НоваяСтрока.Сумма = СуммаОперанда;

			ДополнительныеПараметрыОперанда = Неопределено;
			ЭлементОперанда.Свойство("ДополнительныеПараметры", ДополнительныеПараметрыОперанда);
			НоваяСтрока.ДоступнаРасшифровка = ДоступнаТиповаяРасшифровка(ДополнительныеПараметрыОперанда);

			Если НоваяСтрока.ДоступнаРасшифровка Тогда
				ПараметрыПоСтрокам.Вставить(НомерСтроки, ДополнительныеПараметрыОперанда);
			КонецЕсли;

		КонецЦикла;

	КонецЕсли;

	АдресПараметровРасшифровки = ПоместитьВоВременноеХранилище(ПараметрыПоСтрокам, УникальныйИдентификатор);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыОперанды

&НаКлиенте
Процедура ОперандыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ОткрытьТиповуюРасшифровку(Неопределено);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОткрытьТиповуюРасшифровку(Команда)

	ТекущаяСтрока = Элементы.Операнды.ТекущиеДанные;
	Если ТекущаяСтрока = Неопределено Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Выберите операнд в таблице.'"));
		Возврат;
	КонецЕсли;

	Если Не ТекущаяСтрока.ДоступнаРасшифровка Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Для выбранного операнда типовая расшифровка недоступна.'"));
		Возврат;
	КонецЕсли;

	ПараметрыОткрытия = ПодготовитьОткрытиеРасшифровкиНаСервере(
		ТекущаяСтрока.НомерСтроки, ТекущаяСтрока.НаименованиеСлагаемого);

	дбу_ПробныйРасчетКлиент.ОткрытьТиповуюРасшифровку(ПараметрыОткрытия);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ПодготовитьОткрытиеРасшифровкиНаСервере(НомерСтроки, НаименованиеСтроки)

	Возврат дбу_ПробныйРасчетПравил.ПодготовитьОткрытиеТиповойРасшифровки(
		НомерСтроки, АдресПараметровРасшифровки, НаименованиеСтроки);

КонецФункции

&НаСервере
Функция ДоступнаТиповаяРасшифровка(ДополнительныеПараметры)

	Возврат ТипЗнч(ДополнительныеПараметры) = Тип("Структура")
		И ДополнительныеПараметры.Свойство("Отчет")
		И ТипЗнч(ДополнительныеПараметры.Отчет) = Тип("Структура")
		И ДополнительныеПараметры.Отчет.Свойство("ИмяОтчета")
		И ЗначениеЗаполнено(ДополнительныеПараметры.Отчет.ИмяОтчета);

КонецФункции

#КонецОбласти
