#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Раздел = Перечисления.дбу_РазделыБухОтчетности.ПустаяСсылка();
	ВерсияФормы = "";
	ДеревоДанныхРазделов = Неопределено;

	Если Параметры.Свойство("Раздел") Тогда
		Раздел = Параметры.Раздел;
	КонецЕсли;

	Если Параметры.Свойство("ВерсияФормы") Тогда
		ВерсияФормы = Параметры.ВерсияФормы;
	КонецЕсли;
	Если Параметры.Свойство("ДеревоДанныхРазделов") Тогда
		ДеревоДанныхРазделов = Параметры.ДеревоДанныхРазделов;
	КонецЕсли;

	Дерево = дбу_СтруктураОтчетности.ДеревоСтрокДляВыбора(
		Раздел, ВерсияФормы, ДеревоДанныхРазделов);
	ЗначениеВРеквизитФормы(Дерево, "ДеревоСтрок");

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыДеревоСтрок

&НаКлиенте
Процедура ДеревоСтрокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	ВыбратьТекущуюСтроку();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Выбрать(Команда)

	ВыбратьТекущуюСтроку();

КонецПроцедуры

&НаКлиенте
Процедура Отмена(Команда)

	Закрыть();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ВыбратьТекущуюСтроку()

	ТекущиеДанные = Элементы.ДеревоСтрок.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Не ТекущиеДанные.Доступна Тогда
		Текст = ТекущиеДанные.Диагностика;
		Если Не ЗначениеЗаполнено(Текст) Тогда
			Текст = НСтр("ru = 'Эта строка недоступна для выбора.'");
		КонецЕсли;
		ПоказатьПредупреждение(, Текст);
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ТекущиеДанные.КодСтроки) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Выберите строку отчётности.'"));
		Возврат;
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("ВерсияАдреса", ТекущиеДанные.ВерсияАдреса);
	Результат.Вставить("ВидСтрокиОтчетности", ТекущиеДанные.ВидСтрокиОтчетности);
	Результат.Вставить("КодСтрокиФСБУ", ТекущиеДанные.КодСтроки);
	Результат.Вставить("НаименованиеСтроки", ТекущиеДанные.НаименованиеСтроки);
	Результат.Вставить("КодСтрокиВОтчете", ТекущиеДанные.КодСтрокиВОтчете);
	Результат.Вставить("НаименованиеРодительскойСтроки",
		ТекущиеДанные.НаименованиеРодительскойСтроки);
	Результат.Вставить("КодРодительскойСтроки", ТекущиеДанные.КодРодительскойСтроки);
	Результат.Вставить("ТехническийВидМСЧ", ТекущиеДанные.ТехническийВидМСЧ);
	Результат.Вставить("ПолныйПуть", ТекущиеДанные.ПолныйПуть);
	Закрыть(Результат);

КонецПроцедуры

#КонецОбласти
