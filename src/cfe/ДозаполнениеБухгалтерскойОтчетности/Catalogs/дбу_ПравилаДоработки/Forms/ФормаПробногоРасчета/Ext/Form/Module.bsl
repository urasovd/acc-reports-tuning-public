
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Не Параметры.Свойство("АдресДанныхПравила") Тогда
		ВызватьИсключение НСтр("ru = 'Не переданы данные правила для пробного расчёта.'");
	КонецЕсли;

	АдресДанныхПравила = Параметры.АдресДанныхПравила;
	ДанныеПравила = ПолучитьИзВременногоХранилища(АдресДанныхПравила);
	Если ТипЗнч(ДанныеПравила) <> Тип("Структура") Тогда
		ВызватьИсключение НСтр("ru = 'Неверные данные правила для пробного расчёта.'");
	КонецЕсли;

	НаименованиеПравила = ДанныеПравила.Наименование;
	ОрганизацияИзДанных = Неопределено;
	Если ДанныеПравила.Свойство("Организация", ОрганизацияИзДанных) Тогда
		Организация = ОрганизацияИзДанных;
	КонецЕсли;
	Формула = ?(ДанныеПравила.ВидПравила = Перечисления.дбу_ВидыПравил.ПроизвольныйЗапрос,
		"A",
		ДанныеПравила.Формула);
	ПроверкаЦелей = НСтр("ru = 'Строки отчёта будут проверены после расчёта.'");
	ОтчетОбразецВыбран = Ложь;
	ПризнакОбразца = Неопределено;
	Если ДанныеПравила.Свойство("ОтчетОбразецВыбран", ПризнакОбразца) Тогда
		Если ТипЗнч(ПризнакОбразца) = Тип("Булево") Тогда
			ОтчетОбразецВыбран = ПризнакОбразца;
		КонецЕсли;
	КонецЕсли;
	Если Не ОтчетОбразецВыбран Тогда
		ПроверкаЦелей = НСтр("ru = 'Выберите отчёт-образец, чтобы проверить адреса строк.'");
	КонецЕсли;

	КонецПериодаИзДанных = Неопределено;
	Если ДанныеПравила.Свойство("КонецПериода", КонецПериодаИзДанных)
		И ЗначениеЗаполнено(КонецПериодаИзДанных) Тогда
		КонецПериода = КонецДня(КонецМесяца(КонецПериодаИзДанных));
	Иначе
		КонецПериода = КонецДня(КонецМесяца(ДобавитьМесяц(ТекущаяДатаСеанса(), -1)));
	КонецЕсли;
	НачалоПериода = НачалоГода(КонецПериода);

	Заголовок = СтрШаблон(НСтр("ru = 'Пробный расчёт: %1'"), НаименованиеПравила);

	СтрокиРасшифровки.Очистить();
	УстановитьДоступностьКомандыРасшифровки();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСтрокиРасшифровки

&НаКлиенте
Процедура СтрокиРасшифровкиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ОткрытьРасшифровкуСтроки(Неопределено);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Рассчитать(Команда)

	РассчитатьНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьРасшифровку(Команда)

	ОткрытьРасшифровкуСтроки(Неопределено);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура РассчитатьНаСервере()

	ТекстОшибки = "";
	Итог = 0;
	СтрокиРасшифровки.Очистить();
	АдресПараметровРасшифровки = "";

	Если Не ЗначениеЗаполнено(Организация) Тогда
		ТекстОшибки = НСтр("ru = 'Укажите организацию.'");
		УстановитьДоступностьКомандыРасшифровки();
		Возврат;
	КонецЕсли;

	ДанныеПравила = ПолучитьИзВременногоХранилища(АдресДанныхПравила);
	ПараметрыРасчета = Новый Структура;
	ПараметрыРасчета.Вставить("Организация", Организация);
	ПараметрыРасчета.Вставить("НачалоПериода", НачалоДня(НачалоПериода));
	ПараметрыРасчета.Вставить("КонецПериода", КонецДня(КонецПериода));
	ДеревоДанныхРазделов = Неопределено;
	ДанныеПравила.Свойство("ДеревоДанныхРазделов", ДеревоДанныхРазделов);
	ПараметрыРасчета.Вставить("ДеревоДанныхРазделов", ДеревоДанныхРазделов);

	РезультатРасчета = дбу_ПробныйРасчетПравил.ВыполнитьРасчет(ДанныеПравила, ПараметрыРасчета, УникальныйИдентификатор);

	Если Не РезультатРасчета.Успех Тогда
		ТекстОшибки = РезультатРасчета.ТекстОшибки;
		ПроверкаЦелей = НСтр("ru = 'Проверка адресов строк завершилась ошибкой.'");
		УстановитьДоступностьКомандыРасшифровки();
		Возврат;
	КонецЕсли;

	Итог = РезультатРасчета.Итог;
	ПроверкаЦелей = РезультатРасчета.СтатусПроверкиЦелей;
	АдресПараметровРасшифровки = РезультатРасчета.АдресПараметровРасшифровки;
	СтрокиРасшифровки.Загрузить(РезультатРасчета.ТаблицаСтрок);

	УстановитьДоступностьКомандыРасшифровки();

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьРасшифровкуСтроки(Команда)

	ТекущаяСтрока = Элементы.СтрокиРасшифровки.ТекущиеДанные;
	Если ТекущаяСтрока = Неопределено Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Выберите строку в таблице расшифровки.'"));
		Возврат;
	КонецЕсли;

	Если Не ТекущаяСтрока.ДоступнаРасшифровка Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Для выбранной строки расшифровка недоступна (произвольный запрос или не настроен счёт).'"));
		Возврат;
	КонецЕсли;

	ДополнительныеПараметры = ДополнительныеПараметрыСтрокиНаСервере(ТекущаяСтрока.НомерСтроки);

	// Сложная формула — уровень 2 (своя форма). Простая «A» — сразу типовой Отчет.
	Если ЭтоПакетФормулыКДРНаКлиенте(ДополнительныеПараметры) Тогда
		дбу_РасшифровкаКлиент.ОткрытьРасшифровкуФормулы(ДополнительныеПараметры);
		Возврат;
	КонецЕсли;

	ПараметрыОткрытия = ПодготовитьОткрытиеРасшифровкиНаСервере(
		ТекущаяСтрока.НомерСтроки, ТекущаяСтрока.НаименованиеСлагаемого);

	дбу_ПробныйРасчетКлиент.ОткрытьТиповуюРасшифровку(ПараметрыОткрытия);

КонецПроцедуры

&НаСервере
Функция ПодготовитьОткрытиеРасшифровкиНаСервере(НомерСтроки, НаименованиеСтроки)

	Возврат дбу_ПробныйРасчетПравил.ПодготовитьОткрытиеТиповойРасшифровки(
		НомерСтроки, АдресПараметровРасшифровки, НаименованиеСтроки);

КонецФункции

&НаСервере
Функция ДополнительныеПараметрыСтрокиНаСервере(НомерСтроки)

	Возврат дбу_ПробныйРасчетПравил.ДополнительныеПараметрыСтрокиПробногоРасчета(
		НомерСтроки, АдресПараметровРасшифровки);

КонецФункции

&НаКлиенте
Функция ЭтоПакетФормулыКДРНаКлиенте(ДополнительныеПараметры)

	Если ТипЗнч(ДополнительныеПараметры) <> Тип("Структура") Тогда
		Возврат Ложь;
	КонецЕсли;

	Флаг = Ложь;
	Возврат ДополнительныеПараметры.Свойство("ЭтоРасшифровкаФормулыКДР", Флаг) И Флаг = Истина;

КонецФункции

&НаСервере
Процедура УстановитьДоступностьКомандыРасшифровки()

	Элементы.ФормаОткрытьРасшифровку.Доступность = СтрокиРасшифровки.Количество() > 0;

КонецПроцедуры

#КонецОбласти
