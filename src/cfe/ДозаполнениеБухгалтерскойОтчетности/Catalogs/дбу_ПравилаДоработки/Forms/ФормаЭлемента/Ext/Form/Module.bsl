КонецПроцедуры

&НаКлиенте
Процедура ВыборВидовСубконтоЗавершение(Результат, ДополнительныеПараметры) Экспорт

	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ТекущаяСтрока = Элементы.Операнды.ТекущиеДанные;
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ТекущаяСтрока.ВидыСубконто = Результат;
	ОбновитьПредставлениеОперандаНаСервере(ТекущаяСтрока.ПолучитьИдентификатор());
	ОбновитьДеталиОперандаНаСервере(ТекущаяСтрока.ПолучитьИдентификатор());
	Модифицированность = Истина;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПроверитьФормулу(Команда)

	РезультатПроверки = ПроверитьФормулуНаСервере();
	ОбновитьСтатусПравилаНаСервере();
	Если РезультатПроверки.Успех Тогда
		ПоказатьОповещениеПользователя(, , НСтр("ru = 'Формула корректна.'"));
	Иначе
		ПоказатьПредупреждение(, РезультатПроверки.ТекстОшибки);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПробныйРасчет(Команда)

	АдресДанныхПравила = ПодготовитьПробныйРасчетНаСервере();
	ПараметрыФормы = Новый Структура("АдресДанныхПравила", АдресДанныхПравила);
	ОткрытьФорму(
		"Справочник.дбу_ПравилаДоработки.Форма.ФормаПробногоРасчета",
		ПараметрыФормы,
		ЭтаФорма,
		,
		,
		,
		,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаКлиенте
Процедура ВставитьМакс(Команда)

	ВставитьФрагментВФормулу("Макс(,0)");

КонецПроцедуры

&НаКлиенте
Процедура ВставитьМин(Команда)

	ВставитьФрагментВФормулу("Мин(,0)");

КонецПроцедуры

&НаКлиенте
Процедура ВставитьШаблонСвертка(Команда)

	ВставитьФрагментВФормулу("Макс(A-B,0)");

КонецПроцедуры

&НаКлиенте
Процедура ВставитьОперандВФормулу(Команда)

	ТекущиеДанные = Элементы.Операнды.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Выберите строку операнда.'"));
		Возврат;
	КонецЕсли;

	Идентификатор = СокрЛП(Строка(ТекущиеДанные.Идентификатор));
	Если Не ЗначениеЗаполнено(Идентификатор) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Укажите идентификатор операнда (A, B, …).'"));
		Возврат;
	КонецЕсли;

	Объект.Формула = ФормулаСБуквой(Объект.Формула, Идентификатор);
	Модифицированность = Истина;
	ОбновитьСтатусПравилаНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура НастроитьОтборСКД(Команда)

	ТекущиеДанные = Элементы.Операнды.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если ТекущиеДанные.СпособРасчета <> ПредопределенноеЗначение("Перечисление.дбу_СпособыРасчетаОперанда.ОтборСКД") Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Команда доступна для способа расчёта «Остатки и обороты с отбором».'"));
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ТекущиеДанные.Счет) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Укажите счёт операнда перед настройкой отбора.'"));
		Возврат;
	КонецЕсли;

	ПараметрыФормы = ПараметрыФормыОтбораСКД(ТекущиеДанные.ПолучитьИдентификатор());
	Оповещение = Новый ОписаниеОповещения("ПослеНастройкиОтбораСКД", ЭтотОбъект, ТекущиеДанные.ПолучитьИдентификатор());
	ОткрытьФорму(
		"Справочник.дбу_ЗапросыДанных.Форма.ФормаРедактированияОтбора",
		ПараметрыФормы,
		ЭтотОбъект,
		,
		,
		,
		Оповещение,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаКлиенте
Процедура ПослеНастройкиОтбораСКД(АдресПакета, ИдентификаторСтроки) Экспорт

	Если Не ЭтоАдресВременногоХранилища(АдресПакета) Тогда
		Возврат;
	КонецЕсли;

	СохранитьПакетОтбораОперанда(ИдентификаторСтроки, АдресПакета);

КонецПроцедуры

&НаКлиенте
Процедура СоставСтрокиБалансаПометкаПриИзменении(Элемент)

	СтрокаСостава = Элементы.СоставСтрокиБаланса.ТекущиеДанные;
	Если СтрокаСостава = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если СтрокаСостава.Пометка И Не СтрокаСостава.МожноВыбрать Тогда
		СтрокаСостава.Пометка = Ложь;
		ПоказатьПредупреждение(, СтрокаСостава.Причина);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ВзятьИзСтрокиБаланса(Команда)

	Если Не ЗначениеЗаполнено(ОрганизацияКонтекста) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Откройте правило из рабочего места: нужна организация.'"));
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ПериодКонтекста) Тогда
		Оповещение = Новый ОписаниеОповещения("ВзятьИзСтрокиБалансаПослеВводаПериода", ЭтотОбъект);
		ПоказатьВводДаты(Оповещение, КонецМесяца(ОбщегоНазначенияКлиент.ДатаСеанса()), НСтр("ru = 'Дата отчёта'"), ЧастиДаты.Дата);
		Возврат;
	КонецЕсли;

	ПоказатьВыборСтрокиБаланса();

КонецПроцедуры

&НаКлиенте
Процедура ВзятьИзСтрокиБалансаПослеВводаПериода(Период, ДополнительныеПараметры) Экспорт

	Если Не ЗначениеЗаполнено(Период) Тогда
		Возврат;
	КонецЕсли;

	ПериодКонтекста = Период;
	ПоказатьВыборСтрокиБаланса();

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьВыборСтрокиБаланса()

	Подготовка = ПодготовитьСтрокиБалансаНаСервере();
	Если ЗначениеЗаполнено(Подготовка.Ошибка) Тогда
		ПоказатьПредупреждение(, Подготовка.Ошибка);
		Возврат;
	КонецЕсли;

	Список = Новый СписокЗначений;
	Для Каждого СтрокаБаланса Из Подготовка.Строки Цикл
		Список.Добавить(СтрокаБаланса.Номер, СтрокаБаланса.Номер + " " + СтрокаБаланса.Наименование);
	КонецЦикла;

	Оповещение = Новый ОписаниеОповещения("ВзятьИзСтрокиБалансаПослеВыбораСтроки", ЭтотОбъект);
	ПоказатьВыборИзСписка(Оповещение, Список);

КонецПроцедуры

&НаКлиенте
Процедура ВзятьИзСтрокиБалансаПослеВыбораСтроки(ВыбранныйЭлемент, ДополнительныеПараметры) Экспорт

	Если ВыбранныйЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ЗаполнитьСоставСтрокиБалансаНаСервере(ВыбранныйЭлемент.Значение);

КонецПроцедуры

&НаКлиенте
Процедура ПеренестиСоставляющиеБаланса(Команда)

	НачатьПрименениеСостава("Перенос");

КонецПроцедуры

&НаКлиенте
Процедура ДобавитьСоставляющиеБаланса(Команда)

	НачатьПрименениеСостава("Добавить");

КонецПроцедуры

&НаКлиенте
Процедура НачатьПрименениеСостава(Режим)

	Если Не ЕстьОтмеченныеСоставляющие() Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Отметьте счета, которые можно перенести.'"));
		Возврат;
	КонецЕсли;

	ПараметрыПрименения = Новый Структура("Режим, Заменять", Режим, Истина);
	Если НужноСпроситьОЗамене(Режим) Тогда
		Кнопки = Новый СписокЗначений;
		Кнопки.Добавить(КодВозвратаДиалога.Да, НСтр("ru = 'Заменить текущие'"));
		Кнопки.Добавить(КодВозвратаДиалога.Нет, НСтр("ru = 'Добавить к текущим'"));
		Кнопки.Добавить(КодВозвратаДиалога.Отмена);
		Оповещение = Новый ОписаниеОповещения("ПрименениеСоставаПослеВопроса", ЭтотОбъект, ПараметрыПрименения);
		ПоказатьВопрос(Оповещение, НСтр("ru = 'В правиле уже есть операнды или формула. Заменить их выбранными счетами или добавить новые?'"), Кнопки);
		Возврат;
	КонецЕсли;

	ПродолжитьПрименениеСостава(ПараметрыПрименения);

КонецПроцедуры

&НаКлиенте
Процедура ПрименениеСоставаПослеВопроса(Ответ, ПараметрыПрименения) Экспорт

	Если Ответ = КодВозвратаДиалога.Отмена Или Ответ = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ПараметрыПрименения.Заменять = (Ответ = КодВозвратаДиалога.Да);
	ПродолжитьПрименениеСостава(ПараметрыПрименения);

КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьПрименениеСостава(ПараметрыПрименения)

	Если ПараметрыПрименения.Режим = "Перенос" Тогда
		Оповещение = Новый ОписаниеОповещения("ПрименениеСоставаПослеВыбораПриемника", ЭтотОбъект, ПараметрыПрименения);
		ОткрытьФорму(
			"Справочник.дбу_ПравилаДоработки.Форма.ФормаВыбораСтрокиОтчетности",
			ПараметрыВыбораСтрокиБаланса(),
			ЭтотОбъект,
			,
			,
			,
			Оповещение,
			РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		Возврат;
	КонецЕсли;

	ПоказатьРезультатПрименения(ПрименитьСоставляющиеБалансаНаСервере(ПараметрыПрименения.Режим, ПараметрыПрименения.Заменять, Неопределено));

КонецПроцедуры

&НаКлиенте
Процедура ПрименениеСоставаПослеВыбораПриемника(СтрокаПриемник, ПараметрыПрименения) Экспорт

	Если Не ЗначениеЗаполнено(СтрокаПриемник) Тогда
		Возврат;
	КонецЕсли;

	ПоказатьРезультатПрименения(ПрименитьСоставляющиеБалансаНаСервере(
		ПараметрыПрименения.Режим, ПараметрыПрименения.Заменять, СтрокаПриемник));

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьРезультатПрименения(Сообщение)

	Если ЗначениеЗаполнено(Сообщение) Тогда
		ПоказатьПредупреждение(, Сообщение);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ОбновитьПодсказки()

	ПодсказкаВидаПравила = дбу_ФормыПравил.ТекстПодсказкиВидаПравила(Объект.ВидПравила);
	ПодсказкаФормулы = дбу_ФормыПравил.ТекстПодсказкиФормулы(Объект.ВидПравила);
	ИнструкцияФормы = НСтр("ru = 'Шаг 1. Укажите название правила и проверьте раздел «Баланс».'");
	ИнструкцияОперанды = НСтр("ru = 'Шаг 2. Добавьте счета и задайте, как получить сумму.'");
	ИнструкцияФормулы = НСтр("ru = 'Шаг 3. Запишите формулу и проверьте её перед расчётом.'");
	ИнструкцияЦели = НСтр("ru = 'Шаг 4. Выберите строки баланса и действие записи.'");

	Элементы.ВидПравила.Подсказка = ПодсказкаВидаПравила;
	Элементы.Формула.Подсказка = ПодсказкаФормулы;

КонецПроцедуры

&НаКлиенте
Процедура УстановитьДоступностьПолейОперанда(ИдентификаторСтроки)

	УстановитьДоступностьПолейОперандаНаСервере(ИдентификаторСтроки);

КонецПроцедуры

&НаСервере
Процедура УстановитьДоступностьПолейПравилаНаСервере()

	Настройки = дбу_ФормыПравил.НастройкиДоступностиПравила(Объект.ВидПравила);

	Элементы.Формула.ТолькоПросмотр = Не Настройки.ФормулаДоступна;
	Элементы.ФормаПроверитьФормулу.Доступность = Настройки.ФормулаДоступна;
	Элементы.ФормаВставитьМакс.Доступность = Настройки.ФормулаДоступна;
	Элементы.ФормаВставитьМин.Доступность = Настройки.ФормулаДоступна;
	Элементы.ФормаВставитьШаблонСвертка.Доступность = Настройки.ФормулаДоступна;
	Элементы.ЦелиСторонаСвертки.ТолькоПросмотр = Не Настройки.СторонаСверткиДоступна;

КонецПроцедуры

&НаСервере
Процедура УстановитьДоступностьПолейОперандаНаСервере(ИдентификаторСтроки)

	СпособРасчета = Неопределено;

	Если ИдентификаторСтроки <> Неопределено Тогда
		СтрокаОперанда = Объект.Операнды.НайтиПоИдентификатору(ИдентификаторСтроки);
		Если СтрокаОперанда <> Неопределено Тогда
			СпособРасчета = СтрокаОперанда.СпособРасчета;
		КонецЕсли;
	КонецЕсли;

	Настройки = дбу_ФормыПравил.НастройкиДоступностиОперанда(СпособРасчета);

	Элементы.ОперандыСчет.ТолькоПросмотр = Не Настройки.СчетДоступен;
	Элементы.ОперандыКорСчет.ТолькоПросмотр = Не Настройки.КорСчетДоступен;
	Элементы.ОперандыЗнакСальдо.ТолькоПросмотр = Не Настройки.ЗнакСальдоДоступен;
	Элементы.ОперандыВидыСубконто.ТолькоПросмотр = Не Настройки.ВидыСубконтоДоступен;
	Элементы.ОперандыЗапросДанных.Видимость = Настройки.ЗапросДанныхВидим;
	Элементы.ОперандыЗапросДанных.ТолькоПросмотр = Не Настройки.ЗапросДанныхРедактирование;
	Элементы.ОперандыНастроитьОтборСКД.Доступность = Настройки.КомандаНастроитьОтборСКД;

КонецПроцедуры

&НаСервере
Процедура ОперандыСпособРасчетаПриИзмененииНаСервере(ИдентификаторСтроки)

	Если ИдентификаторСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;

	СтрокаОперанда = Объект.Операнды.НайтиПоИдентификатору(ИдентификаторСтроки);
	Если СтрокаОперанда = Неопределено Тогда
		Возврат;
	КонецЕсли;

	дбу_ФормыПравил.СкорректироватьСтрокуОперандаПоСпособу(СтрокаОперанда);
	СтрокаОперанда.Представление = дбу_ФормыПравил.СформироватьОписаниеОперанда(СтрокаОперанда);
	УстановитьДоступностьПолейОперандаНаСервере(ИдентификаторСтроки);

КонецПроцедуры

&НаСервере
Процедура СкорректироватьОборотныеВидыСубконтоВсехОперандов()

	Для Каждого СтрокаОперанда Из Объект.Операнды Цикл
		дбу_ФормыПравил.СкорректироватьОборотныеВидыСубконто(СтрокаОперанда);
		СтрокаОперанда.Представление = дбу_ФормыПравил.СформироватьОписаниеОперанда(СтрокаОперанда);
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ОперандыСчетПриИзмененииНаСервере(ИдентификаторСтроки)

	Если ИдентификаторСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;

	СтрокаОперанда = Объект.Операнды.НайтиПоИдентификатору(ИдентификаторСтроки);
	Если СтрокаОперанда = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если дбу_ФормыПравил.НастройкиДоступностиОперанда(СтрокаОперанда.СпособРасчета).ВидыСубконтоДоступен Тогда
		СтрокаОперанда.ВидыСубконто = "";
	КонецЕсли;

	СтрокаОперанда.Представление = дбу_ФормыПравил.СформироватьОписаниеОперанда(СтрокаОперанда);
	УстановитьДоступностьПолейОперандаНаСервере(ИдентификаторСтроки);

КонецПроцедуры

&НаСервере
Процедура ОперандыКорСчетПриИзмененииНаСервере(ИдентификаторСтроки)

	Если ИдентификаторСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;

	СтрокаОперанда = Объект.Операнды.НайтиПоИдентификатору(ИдентификаторСтроки);
	Если СтрокаОперанда = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Настройки = дбу_ФормыПравил.НастройкиДоступностиОперанда(СтрокаОперанда.СпособРасчета);
	Если (СтрокаОперанда.СпособРасчета = Перечисления.дбу_СпособыРасчетаОперанда.ДО
		Или СтрокаОперанда.СпособРасчета = Перечисления.дбу_СпособыРасчетаОперанда.КО)
		И ЗначениеЗаполнено(СтрокаОперанда.КорСчет) Тогда
		СтрокаОперанда.ВидыСубконто = "";
	КонецЕсли;

	СтрокаОперанда.Представление = дбу_ФормыПравил.СформироватьОписаниеОперанда(СтрокаОперанда);
	УстановитьДоступностьПолейОперандаНаСервере(ИдентификаторСтроки);

КонецПроцедуры

&НаСервере
Процедура ОбновитьПредставлениеОперандаНаСервере(ИдентификаторСтроки)

	Если ИдентификаторСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;

	СтрокаОперанда = Объект.Операнды.НайтиПоИдентификатору(ИдентификаторСтроки);
	Если СтрокаОперанда = Неопределено Тогда
