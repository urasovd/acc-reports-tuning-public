Функция ЕстьОтмеченныеСоставляющие()

	Для Каждого СтрокаСостава Из СоставСтрокиБаланса Цикл
		Если СтрокаСостава.Пометка И СтрокаСостава.МожноВыбрать Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

&НаКлиенте
Функция НужноСпроситьОЗамене(Режим)

	Если ЗначениеЗаполнено(СокрЛП(Объект.Формула)) Тогда
		Возврат Истина;
	КонецЕсли;

	Для Каждого СтрокаОперанда Из Объект.Операнды Цикл
		Если ЗначениеЗаполнено(СтрокаОперанда.Идентификатор) Или ЗначениеЗаполнено(СтрокаОперанда.Счет) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Если Режим = "Перенос" Тогда
		Для Каждого СтрокаЦели Из Объект.Цели Цикл
			Если ЗначениеЗаполнено(СтрокаЦели.КодСтрокиФСБУ) Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Возврат Ложь;

КонецФункции

&НаСервере
Функция ПодготовитьСтрокиБалансаНаСервере()

	Результат = Новый Структура("Ошибка, Строки", "", Новый Массив);
	Попытка
		Алгоритмы = дбу_СоставСтрокБаланса.АлгоритмыБаланса(ОрганизацияКонтекста, ПериодКонтекста);
		АдресАлгоритмов = ПоместитьВоВременноеХранилище(Алгоритмы, УникальныйИдентификатор);
		Для Каждого СтрокаБаланса Из дбу_СоставСтрокБаланса.СтрокиИзАлгоритмов(Алгоритмы) Цикл
			Результат.Строки.Добавить(Новый Структура("Номер, Наименование", СтрокаБаланса.Номер, СтрокаБаланса.Наименование));
		КонецЦикла;
	Исключение
		Результат.Ошибка = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Возврат Результат;

КонецФункции

&НаСервере
Процедура ЗаполнитьСоставСтрокиБалансаНаСервере(НомерСтроки)

	СоставСтрокиБаланса.Очистить();
	НомерСтрокиИсточника = СокрЛП(НомерСтроки);
	НаименованиеСтрокиИсточника = "";
	Если Не ЭтоАдресВременногоХранилища(АдресАлгоритмов) Тогда
		Элементы.СоставСтрокиБалансаГруппа.Видимость = Ложь;
		Возврат;
	КонецЕсли;

	Алгоритмы = ПолучитьИзВременногоХранилища(АдресАлгоритмов);
	Для Каждого СтрокаБаланса Из дбу_СоставСтрокБаланса.СтрокиИзАлгоритмов(Алгоритмы) Цикл
		Если СтрокаБаланса.Номер = НомерСтрокиИсточника Тогда
			НаименованиеСтрокиИсточника = СтрокаБаланса.Наименование;
		КонецЕсли;
	КонецЦикла;

	Составляющие = дбу_СоставСтрокБаланса.СоставляющиеИзАлгоритмов(Алгоритмы, НомерСтрокиИсточника);
	Для Каждого Составляющая Из Составляющие Цикл
		ЗаполнитьЗначенияСвойств(СоставСтрокиБаланса.Добавить(), Составляющая);
	КонецЦикла;

	Элементы.СоставСтрокиБалансаГруппа.Видимость = Истина;
	Элементы.СоставСтрокиБалансаГруппа.Заголовок = СтрШаблон(
		НСтр("ru = 'Строка %1 %2'"), НомерСтрокиИсточника, НаименованиеСтрокиИсточника);

КонецПроцедуры

&НаСервере
Функция ПрименитьСоставляющиеБалансаНаСервере(Режим, Заменять, СтрокаПриемник)

	Выбранные = Новый Массив;
	Для Каждого СтрокаСостава Из СоставСтрокиБаланса Цикл
		Если СтрокаСостава.Пометка И СтрокаСостава.МожноВыбрать И ЗначениеЗаполнено(СтрокаСостава.Счет) Тогда
			Выбранные.Добавить(СтрокаСостава);
		КонецЕсли;
	КонецЦикла;
	Если Выбранные.Количество() = 0 Тогда
		Возврат НСтр("ru = 'Отметьте счета, которые можно перенести.'");
	КонецЕсли;

	Если Заменять Тогда
		Объект.Операнды.Очистить();
		Если Режим = "Перенос" Тогда
			Объект.Цели.Очистить();
			Объект.ВидПравила = Перечисления.дбу_ВидыПравил.ПереносМеждуСтроками;
			Объект.Раздел = Перечисления.дбу_РазделыБухОтчетности.Баланс;
		КонецЕсли;
	КонецЕсли;

	ЗанятыеБуквы = Новый Соответствие;
	Если Не Заменять Тогда
		Для Каждого СтрокаОперанда Из Объект.Операнды Цикл
			Буква = ВРег(СокрЛП(СтрокаОперанда.Идентификатор));
			Если ЗначениеЗаполнено(Буква) Тогда
				ЗанятыеБуквы.Вставить(Буква, Истина);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Если Заменять Тогда
		Объект.Формула = "";
	КонецЕсли;

	НомерБуквы = 1;
	Для Каждого СтрокаСостава Из Выбранные Цикл
		Буква = СвободнаяБукваОперанда(НомерБуквы, ЗанятыеБуквы);
		НомерБуквы = НомерБуквы + 1;
		ЗанятыеБуквы.Вставить(Буква, Истина);

		СтрокаОперанда = Объект.Операнды.Добавить();
		СтрокаОперанда.Идентификатор = Буква;
		СтрокаОперанда.СпособРасчета = Перечисления.дбу_СпособыРасчетаОперанда[СтрокаСостава.Способ];
		СтрокаОперанда.Счет = СтрокаСостава.Счет;
		СтрокаОперанда.Знак = СтрокаСостава.Знак;
		СтрокаОперанда.Представление = СтрокаСостава.Описание;
		Объект.Формула = ФормулаСБуквой(Объект.Формула, Буква);
	КонецЦикла;

	Сообщение = "";
	Если Режим = "Перенос" Тогда
		Сообщение = ДобавитьЦелиПереноса(СтрокаПриемник);
	КонецЕсли;

	Модифицированность = Истина;
	УстановитьДоступностьПолейПравилаНаСервере();
	ОбновитьСтатусПравилаНаСервере();
	Возврат Сообщение;

КонецФункции

&НаСервере
Функция ДобавитьЦелиПереноса(СтрокаПриемник)

	Если дбу_СтруктураОтчетности.ОписаниеСтроки(Перечисления.дбу_РазделыБухОтчетности.Баланс, НомерСтрокиИсточника) = Неопределено Тогда
		Возврат СтрШаблон(НСтр("ru = 'Операнды заполнены. Строки %1 нет в макете баланса, цель не записана.'"), НомерСтрокиИсточника);
	КонецЕсли;
	Если Не ЗначениеЗаполнено(СтрокаПриемник) Тогда
		Возврат НСтр("ru = 'Операнды заполнены. Строка приёмник не выбрана.'");
	КонецЕсли;
	Если СокрЛП(НомерСтрокиИсточника) = СокрЛП(СтрокаПриемник) Тогда
		Возврат НСтр("ru = 'Операнды заполнены. Для переноса выберите другую строку.'");
	КонецЕсли;

	Колонка = Перечисления.дбу_КолонкиПоказателя.Колонка04;
	Источник = Объект.Цели.Добавить();
	Источник.КодСтрокиФСБУ = НомерСтрокиИсточника;
	Источник.Колонка = Колонка;
	Источник.Действие = Перечисления.дбу_ДействияСПоказателем.УменьшитьТиповое;
	Приемник = Объект.Цели.Добавить();
	Приемник.КодСтрокиФСБУ = СокрЛП(СтрокаПриемник);
	Приемник.Колонка = Колонка;
	Приемник.Действие = Перечисления.дбу_ДействияСПоказателем.Добавить;
	Возврат "";

КонецФункции

&НаСервере
Функция СвободнаяБукваОперанда(НачальныйНомер, ЗанятыеБуквы)

	Алфавит = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
	Номер = НачальныйНомер;
	Пока Номер < 1000 Цикл
		Если Номер <= СтрДлина(Алфавит) Тогда
			Буква = Сред(Алфавит, Номер, 1);
		Иначе
			Буква = "A" + Формат(Номер, "ЧГ=0");
		КонецЕсли;
		Если ЗанятыеБуквы.Получить(Буква) = Неопределено Тогда
			Возврат Буква;
		КонецЕсли;
		Номер = Номер + 1;
	КонецЦикла;

	Возврат "A" + Формат(НачальныйНомер, "ЧГ=0");

КонецФункции

&НаСервере
Процедура ПрименитьВыборСтрокиОтчетностиНаСервере(ИдентификаторСтроки, ВыбранноеЗначение)

	Если ИдентификаторСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;

	СтрокаТаблицы = Объект.Цели.НайтиПоИдентификатору(ИдентификаторСтроки);
	Если СтрокаТаблицы = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если ТипЗнч(ВыбранноеЗначение) = Тип("Структура") Тогда
		СтрокаТаблицы.ВерсияАдреса = ВыбранноеЗначение.ВерсияАдреса;
		СтрокаТаблицы.ВидСтрокиОтчетности = ВыбранноеЗначение.ВидСтрокиОтчетности;
		СтрокаТаблицы.КодСтрокиФСБУ = СокрЛП(ВыбранноеЗначение.КодСтрокиФСБУ);
		СтрокаТаблицы.НаименованиеСтроки = СокрЛП(ВыбранноеЗначение.НаименованиеСтроки);
		СтрокаТаблицы.КодСтрокиВОтчете = СокрЛП(ВыбранноеЗначение.КодСтрокиВОтчете);
		СтрокаТаблицы.НаименованиеРодительскойСтроки = СокрЛП(
			ВыбранноеЗначение.НаименованиеРодительскойСтроки);
		СтрокаТаблицы.КодРодительскойСтроки = СокрЛП(ВыбранноеЗначение.КодРодительскойСтроки);
		СтрокаТаблицы.ТехническийВидМСЧ = СокрЛП(ВыбранноеЗначение.ТехническийВидМСЧ);
	Иначе
		// Старый формат результата выбора оставляем для совместимости внешних вызовов.
		СтрокаТаблицы.ВидСтрокиОтчетности = Перечисления.дбу_ВидыСтрокОтчетности.ПустаяСсылка();
		СтрокаТаблицы.КодСтрокиФСБУ = СокрЛП(ВыбранноеЗначение);
		СтрокаТаблицы.НаименованиеСтроки = "";
		СтрокаТаблицы.КодСтрокиВОтчете = "";
		СтрокаТаблицы.НаименованиеРодительскойСтроки = "";
		СтрокаТаблицы.КодРодительскойСтроки = "";
		СтрокаТаблицы.ТехническийВидМСЧ = "";
	КонецЕсли;
	Модифицированность = Истина;

КонецПроцедуры

&НаСервере
Процедура ОбновитьПредставлениеЦелиНаСервере(ИдентификаторСтроки)

	ПредставлениеВыбраннойЦели = "";
	ДиагностикаВыбраннойЦели = "";
	Если ИдентификаторСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;

	СтрокаЦели = Объект.Цели.НайтиПоИдентификатору(ИдентификаторСтроки);
	Если СтрокаЦели = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Адрес = дбу_СтруктураОтчетности.АдресСтрокиЦели(СтрокаЦели);
	ПредставлениеВыбраннойЦели = ПредставлениеАдресаЦели(Адрес);
	Проверка = дбу_СтруктураОтчетности.ПроверитьАдресСтрокиЦели(Объект.Раздел, СтрокаЦели);
	Если Не Проверка.Успех Тогда
		ДиагностикаВыбраннойЦели = Проверка.ТекстОшибки;
	Иначе
		ДиагностикаВыбраннойЦели = НСтр("ru = 'Адрес заполнен. Фактическое наличие строки проверяется при применении к отчёту.'");
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ПредставлениеАдресаЦели(Адрес)

	ВидСтроки = Адрес.ВидСтрокиОтчетности;
	Если ВидСтроки = Перечисления.дбу_ВидыСтрокОтчетности.Стандартная Тогда
		Описание = дбу_СтруктураОтчетности.ОписаниеСтроки(
			Объект.Раздел, Адрес.КодСтрокиФСБУ);
		Наименование = Адрес.КодСтрокиФСБУ;
		Если Описание <> Неопределено И ЗначениеЗаполнено(Описание.Наименование) Тогда
			Наименование = Описание.Наименование;
		КонецЕсли;
		Возврат СтрШаблон("%1 — %2 (стандартная)", Адрес.КодСтрокиФСБУ, Наименование);
	ИначеЕсли ВидСтроки = Перечисления.дбу_ВидыСтрокОтчетности.ПрямаяРасшифровка Тогда
		Код = ?(ЗначениеЗаполнено(Адрес.КодСтрокиВОтчете),
			"код " + Адрес.КодСтрокиВОтчете, "без кода");
		Возврат СтрШаблон("%1 — %2 (расшифровка, %3)", Адрес.КодСтрокиФСБУ,
			Адрес.НаименованиеСтроки, Код);
	ИначеЕсли ВидСтроки = Перечисления.дбу_ВидыСтрокОтчетности.Вписанная Тогда
		Возврат СтрШаблон("%1 — %2 (вписанная)", Адрес.КодСтрокиФСБУ,
			Адрес.НаименованиеСтроки);
	КонецЕсли;

	Код = ?(ЗначениеЗаполнено(Адрес.КодСтрокиВОтчете),
		"код " + Адрес.КодСтрокиВОтчете, "без кода");
	Возврат СтрШаблон("%1 — %2 / %3 (вложенная, %4)", Адрес.КодСтрокиФСБУ,
		Адрес.НаименованиеРодительскойСтроки, Адрес.НаименованиеСтроки, Код);

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ФормулаСБуквой(Формула, Буква)

	Буква = ВРег(СокрЛП(Буква));
	Если Не ЗначениеЗаполнено(Буква) Или ФормулаСодержитБукву(Формула, Буква) Тогда
		Возврат Формула;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(СокрЛП(Формула)) Тогда
		Возврат Буква;
	КонецЕсли;

	Возврат СокрЛП(Формула) + "+" + Буква;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ФормулаБезБуквы(Формула, Буква)

	Результат = Формула;
	Буква = ВРег(СокрЛП(Буква));
	ДлинаБуквы = СтрДлина(Буква);
	Если Не ЗначениеЗаполнено(Буква) Тогда
		Возврат Результат;
	КонецЕсли;

	Позиция = 1;
	Пока Позиция <= СтрДлина(Результат) Цикл
		Если ВРег(Сред(Результат, Позиция, ДлинаБуквы)) <> Буква
			Или Не ГраницаБуквыФормулы(Результат, Позиция - 1)
			Или Не ГраницаБуквыФормулы(Результат, Позиция + ДлинаБуквы) Тогда
			Позиция = Позиция + 1;
			Продолжить;
		КонецЕсли;

		Начало = Позиция;
		Конец = Позиция + ДлинаБуквы - 1;
		ЛеваяПозиция = Начало - 1;
		Пока ЛеваяПозиция >= 1 И Сред(Результат, ЛеваяПозиция, 1) = " " Цикл
			ЛеваяПозиция = ЛеваяПозиция - 1;
		КонецЦикла;
		Если ЛеваяПозиция >= 1 И ЭтоОператорФормулы(Сред(Результат, ЛеваяПозиция, 1)) Тогда
			Начало = ЛеваяПозиция;
		Иначе
			ПраваяПозиция = Конец + 1;
			Пока ПраваяПозиция <= СтрДлина(Результат) И Сред(Результат, ПраваяПозиция, 1) = " " Цикл
				ПраваяПозиция = ПраваяПозиция + 1;
			КонецЦикла;
			Если ПраваяПозиция <= СтрДлина(Результат) И ЭтоОператорФормулы(Сред(Результат, ПраваяПозиция, 1)) Тогда
				Конец = ПраваяПозиция;
			КонецЕсли;
		КонецЕсли;

		Результат = Лев(Результат, Начало - 1) + Сред(Результат, Конец + 1);
		Позиция = Начало;
	КонецЦикла;

	Возврат СокрЛП(Результат);

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ФормулаСодержитБукву(Формула, Буква)

	Буква = ВРег(СокрЛП(Буква));
	ДлинаБуквы = СтрДлина(Буква);
	ФормулаВРег = ВРег(Формула);
	Позиция = 1;
	Пока Позиция <= СтрДлина(ФормулаВРег) Цикл
		Если Сред(ФормулаВРег, Позиция, ДлинаБуквы) = Буква
			И ГраницаБуквыФормулы(ФормулаВРег, Позиция - 1)
			И ГраницаБуквыФормулы(ФормулаВРег, Позиция + ДлинаБуквы) Тогда
			Возврат Истина;
		КонецЕсли;
		Позиция = Позиция + 1;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ГраницаБуквыФормулы(Формула, Позиция)

	Если Позиция < 1 Или Позиция > СтрДлина(Формула) Тогда
		Возврат Истина;
	КонецЕсли;

	Символ = ВРег(Сред(Формула, Позиция, 1));
	Возврат СтрНайти("ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789", Символ) = 0;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ЭтоОператорФормулы(Символ)

	Возврат Символ = "+" Или Символ = "-" Или Символ = "−";

КонецФункции

&НаКлиенте
Процедура ВставитьФрагментВФормулу(Фрагмент)

	ТекущаяФормула = Объект.Формула;
	Объект.Формула = ?(ЗначениеЗаполнено(ТекущаяФормула), ТекущаяФормула + Фрагмент, Фрагмент);
	Модифицированность = Истина;

КонецПроцедуры

&НаСервере
Функция ПроверитьФормулуНаСервере()

	Идентификаторы = ИдентификаторыОперандовФормы();
	Возврат дбу_ДвижокДоработки.ПроверитьФормулу(Объект.Формула, Идентификаторы);

КонецФункции

&НаСервере
Функция ПодготовитьПробныйРасчетНаСервере()

	ДанныеПравила = дбу_ФормыПравил.ДанныеПравилаДляПробногоРасчета(Объект);
	ДанныеПравила.Вставить("ОтчетОбразецВыбран", ЗначениеЗаполнено(ОтчетОбразец));
	ДанныеПравила.Вставить("ДеревоДанныхРазделов", ДеревоДанныхОтчетаОбразца());
	Если ЗначениеЗаполнено(ОтчетОбразец) Тогда
		ДокументОбразец = ОтчетОбразец.ПолучитьОбъект();
		Если ДокументОбразец <> Неопределено Тогда
			ДанныеПравила.Вставить("Организация", ДокументОбразец.Организация);
			ДанныеПравила.Вставить("КонецПериода", ДокументОбразец.Дата);
		КонецЕсли;
	КонецЕсли;
	Возврат ПоместитьВоВременноеХранилище(ДанныеПравила, УникальныйИдентификатор);

КонецФункции

&НаСервере
Функция ИдентификаторыОперандовФормы()

	Идентификаторы = Новый Массив;
	Для Каждого СтрокаОперанда Из Объект.Операнды Цикл
		Идентификатор = СокрЛП(Строка(СтрокаОперанда.Идентификатор));
		Если ЗначениеЗаполнено(Идентификатор) Тогда
			Идентификаторы.Добавить(Идентификатор);
		КонецЕсли;
	КонецЦикла;
	Возврат Идентификаторы;

КонецФункции

&НаСервере
Функция ПараметрыФормыОтбораСКД(ИдентификаторСтроки)

	СтрокаОперанда = Объект.Операнды.НайтиПоИдентификатору(ИдентификаторСтроки);

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Счет", СтрокаОперанда.Счет);
	ПараметрыФормы.Вставить("КорСчет", СтрокаОперанда.КорСчет);
	ПараметрыФормы.Вставить("ВидыСубконто", СтрокаОперанда.ВидыСубконто);

	Если ЗначениеЗаполнено(СтрокаОперанда.ЗапросДанных) Тогда
		Пакет = дбу_СКДОперандов.ПакетЗапросаИзСправочника(СтрокаОперанда.ЗапросДанных);
		Если Пакет <> Неопределено Тогда
			Если Не ЗначениеЗаполнено(ПараметрыФормы.ВидыСубконто) Тогда
				ПараметрыФормы.ВидыСубконто = Пакет.ВидыСубконто;
			КонецЕсли;
			ПараметрыФормы.Вставить("ДанныеЗапроса", ПоместитьВоВременноеХранилище(Пакет, УникальныйИдентификатор));
		КонецЕсли;
	КонецЕсли;

	ПараметрыФормы.Вставить("ИдентификаторСтроки", ИдентификаторСтроки);
	Возврат ПараметрыФормы;

КонецФункции

&НаСервере
Процедура СохранитьПакетОтбораОперанда(ИдентификаторСтроки, АдресПакета)

	СтрокаОперанда = Объект.Операнды.НайтиПоИдентификатору(ИдентификаторСтроки);
	Если СтрокаОперанда = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ПакетЗапроса = ПолучитьИзВременногоХранилища(АдресПакета);
	СсылкаЗапроса = НайтиИлиСоздатьЗапросДанных(ПакетЗапроса);
	СтрокаОперанда.ЗапросДанных = СсылкаЗапроса;

	Если ПакетЗапроса.Свойство("ВидыСубконто") И ЗначениеЗаполнено(ПакетЗапроса.ВидыСубконто) Тогда
		СтрокаОперанда.ВидыСубконто = ПакетЗапроса.ВидыСубконто;
	КонецЕсли;

	СтрокаОперанда.Представление = дбу_ФормыПравил.СформироватьОписаниеОперанда(СтрокаОперанда);
	УстановитьДоступностьПолейОперандаНаСервере(ИдентификаторСтроки);

КонецПроцедуры

&НаСервере
Функция НайтиИлиСоздатьЗапросДанных(ПакетЗапроса)

	ХэшСумма = дбу_СКДОперандов.РассчитатьХэшНастроек(ПакетЗапроса.НастройкиКомпоновки);
	Если ЗначениеЗаполнено(ХэшСумма) Тогда
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ЗапросыДанных.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.дбу_ЗапросыДанных КАК ЗапросыДанных
		|ГДЕ
		|	ЗапросыДанных.ХэшСумма = &ХэшСумма
		|	И НЕ ЗапросыДанных.ПометкаУдаления";
		Запрос.УстановитьПараметр("ХэшСумма", ХэшСумма);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			ОбъектЗапроса = Выборка.Ссылка.ПолучитьОбъект();
			дбу_СКДОперандов.ОбновитьРеквизитыЗапросаИзПакета(ОбъектЗапроса, ПакетЗапроса);
			ОбъектЗапроса.Записать();
			Возврат ОбъектЗапроса.Ссылка;
		КонецЕсли;
	КонецЕсли;

	ОбъектЗапроса = Справочники.дбу_ЗапросыДанных.СоздатьЭлемент();
	ОбъектЗапроса.Наименование = Лев(ПакетЗапроса.Представление, 150);
	дбу_СКДОперандов.ОбновитьРеквизитыЗапросаИзПакета(ОбъектЗапроса, ПакетЗапроса);
	ОбъектЗапроса.Записать();

	Возврат ОбъектЗапроса.Ссылка;

КонецФункции

#КонецОбласти
