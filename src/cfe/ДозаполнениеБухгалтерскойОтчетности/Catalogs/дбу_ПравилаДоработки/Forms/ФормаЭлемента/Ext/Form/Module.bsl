&НаСервере
Функция ДеревоДанныхОтчетаОбразца()

	Если Не ЗначениеЗаполнено(ОтчетОбразец) Тогда
		Возврат Неопределено;
	КонецЕсли;

	ДокументОбразец = ОтчетОбразец.ПолучитьОбъект();
	Если ДокументОбразец = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	ОбъектОтчета = Отчеты.РегламентированныйОтчетБухОтчетность.Создать();
	СохраненныеДанные = ОбъектОтчета.СохраненныеДанные(ДокументОбразец);
	Дерево = Неопределено;
	Если СохраненныеДанные.Свойство("ДеревоДанныхРазделов", Дерево) Тогда
		Возврат Дерево;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

