&НаКлиенте
Процедура ЦелиКодСтрокиФСБУПриИзменении(Элемент)

	ТекущиеДанные = Элементы.Цели.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	КодСтроки = СокрЛП(ТекущиеДанные.КодСтрокиФСБУ);
	ТекущиеДанные.КодСтрокиФСБУ = КодСтроки;
	Если Не ЗначениеЗаполнено(КодСтроки) Тогда
		ОбновитьПредставлениеЦелиНаСервере(ТекущиеДанные.ПолучитьИдентификатор());
		Возврат;
	КонецЕсли;

	Если Не КодСтрокиЕстьВМакете(КодСтроки) Тогда
		ПоказатьПредупреждение(, СтрШаблон(
			НСтр("ru = 'Строки %1 нет в макете отчёта этого раздела.'"), КодСтроки));
	КонецЕсли;
	ОбновитьПредставлениеЦелиНаСервере(ТекущиеДанные.ПолучитьИдентификатор());

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыОперанды

&НаКлиенте
Процедура ОперандыВидыСубконтоНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;

	ТекущаяСтрока = Элементы.Операнды.ТекущиеДанные;
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ТекущаяСтрока.Счет) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Укажите счёт операнда.'"));
		Возврат;
	КонецЕсли;

	ПараметрыФормы = Новый Структура("Счет,ВидыСубконто,СпособРасчета",
		ТекущаяСтрока.Счет, ТекущаяСтрока.ВидыСубконто, ТекущаяСтрока.СпособРасчета);
	Оповещение = Новый ОписаниеОповещения("ВыборВидовСубконтоЗавершение", ЭтотОбъект);
	ОткрытьФорму(
		"Справочник.дбу_ПравилаДоработки.Форма.ФормаВыбораСубконто",
		ПараметрыФормы,
		ЭтотОбъект,
		,
		,
		,
		Оповещение,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаКлиенте
Процедура ОперандыПередУдалением(Элемент, Отказ)

	ТекущиеДанные = Элементы.Операнды.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Буква = ВРег(СокрЛП(Строка(ТекущиеДанные.Идентификатор)));
	Если Не ЗначениеЗаполнено(Буква) Тогда
		Возврат;
	КонецЕсли;

	ИдентификаторСтроки = ТекущиеДанные.ПолучитьИдентификатор();
	Для Каждого СтрокаОперанда Из Объект.Операнды Цикл
		Если СтрокаОперанда.ПолучитьИдентификатор() = ИдентификаторСтроки Тогда
			Продолжить;
		КонецЕсли;
		Если ВРег(СокрЛП(Строка(СтрокаОперанда.Идентификатор))) = Буква Тогда
			Возврат;
		КонецЕсли;
	КонецЦикла;

	Объект.Формула = ФормулаБезБуквы(Объект.Формула, Буква);
	Модифицированность = Истина;

КонецПроцедуры

&НаКлиенте
Процедура ОперандыПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)

	Если Не НоваяСтрока Тогда
		Возврат;
	КонецЕсли;

	ТекущиеДанные = Элементы.Операнды.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ЗанятыеБуквы = Новый Соответствие;
	ИдентификаторСтроки = ТекущиеДанные.ПолучитьИдентификатор();
	Для Каждого СтрокаОперанда Из Объект.Операнды Цикл
		Если СтрокаОперанда.ПолучитьИдентификатор() = ИдентификаторСтроки Тогда
			Продолжить;
		КонецЕсли;
		БукваСтроки = ВРег(СокрЛП(Строка(СтрокаОперанда.Идентификатор)));
		Если ЗначениеЗаполнено(БукваСтроки) Тогда
			ЗанятыеБуквы.Вставить(БукваСтроки, Истина);
		КонецЕсли;
	КонецЦикла;

	Буква = СвободнаяБукваОперанда(1, ЗанятыеБуквы);
	ТекущиеДанные.Идентификатор = Буква;
	Объект.Формула = ФормулаСБуквой(Объект.Формула, Буква);
	Модифицированность = Истина;
	ОбновитьСтатусПравилаНаСервере();

КонецПроцедуры

