#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Объект.Ссылка = Справочники.дбу_ПравилаДоработки.ПустаяСсылка() Тогда
		Если Не ЗначениеЗаполнено(Объект.ВидПравила) Тогда
			Объект.ВидПравила = Перечисления.дбу_ВидыПравил.КорректировкаПоказателя;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Объект.Раздел) Тогда
			Объект.Раздел = Перечисления.дбу_РазделыБухОтчетности.Баланс;
		КонецЕсли;
		Объект.ПрименятьС = НачалоМесяца(ТекущаяДата());
	КонецЕсли;
	Если ЗначениеЗаполнено(Объект.ПрименятьС) Тогда
		ПериодНовойВерсии = Год(Объект.ПрименятьС) + 1;
	Иначе
		ПериодНовойВерсии = Год(ТекущаяДата()) + 1;
	КонецЕсли;

	ПредставлениеОрганизацииКонтекста = "";
	Если Параметры.Свойство("Организация") И ЗначениеЗаполнено(Параметры.Организация) Тогда
		ОрганизацияКонтекста = Параметры.Организация;
		ПредставлениеОрганизацииКонтекста = НСтр("ru = 'Правило будет применяться только для: '")
			+ Строка(ОрганизацияКонтекста);
	КонецЕсли;
	Элементы.ПредставлениеОрганизацииКонтекста.Видимость = ЗначениеЗаполнено(ПредставлениеОрганизацииКонтекста);

	Если Параметры.Свойство("Период") И ЗначениеЗаполнено(Параметры.Период) Тогда
		ПериодКонтекста = Параметры.Период;
	КонецЕсли;

	ЗаполнитьСписокОтчетовНаСервере();
	ОбновитьПодсказки();
	СкорректироватьОборотныеВидыСубконтоВсехОперандов();
	УстановитьДоступностьПолейПравилаНаСервере();
	УстановитьДоступностьПолейОперандаНаСервере(Элементы.Операнды.ТекущаяСтрока);
	ОбновитьДеталиОперандаНаСервере(Элементы.Операнды.ТекущаяСтрока);
	ОбновитьПредставлениеЦелиНаСервере(Элементы.Цели.ТекущаяСтрока);
	ОбновитьСтатусПравилаНаСервере();

КонецПроцедуры

#КонецОбласти

&НаСервере
Процедура ЗаполнитьСписокОтчетовНаСервере()

	Элементы.ОтчетОбразец.СписокВыбора.Очистить();
	Для Каждого ЭлементСписка Из ОтчетыОбразцыДляВыбора() Цикл
		Элементы.ОтчетОбразец.СписокВыбора.Добавить(
			ЭлементСписка.Значение,
			ЭлементСписка.Представление);
	КонецЦикла;
	Элементы.ОтчетОбразец.РежимВыбораИзСписка = Истина;
	Элементы.ОтчетОбразец.КнопкаВыпадающегоСписка = Истина;

КонецПроцедуры

#Область ОбработчикиКомандПериода

&НаКлиенте
Процедура СоздатьНовуюВерсию(Команда)

	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Сначала запишите правило.'"));
		Возврат;
	КонецЕсли;
	Если Модифицированность Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Сначала запишите изменения правила, затем создавайте новую версию.'"));
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ПериодНовойВерсии) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Укажите год начала новой версии.'"));
		Возврат;
	КонецЕсли;
	Если ПериодНовойВерсии < 1900 Или ПериодНовойВерсии > 9999 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Год новой версии должен быть в диапазоне 1900–9999.'"));
		Возврат;
	КонецЕсли;

	Попытка
		НоваяВерсия = СоздатьНовуюВерсиюНаСервере();
		Сообщить(СтрШаблон(НСтр("ru = 'Создана новая версия правила: %1.'"), НоваяВерсия));
		дбу_РабочееМестоНастройкиКлиент.ОткрытьПравило(НоваяВерсия);
		Закрыть();
	Исключение
		ПоказатьПредупреждение(, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

&НаСервере
Функция СоздатьНовуюВерсиюНаСервере()

	Возврат дбу_ПрофилиДоработкиСервер.СоздатьНовуюВерсиюПравила(
		Объект.Ссылка, Дата(ПериодНовойВерсии, 1, 1));

КонецФункции

