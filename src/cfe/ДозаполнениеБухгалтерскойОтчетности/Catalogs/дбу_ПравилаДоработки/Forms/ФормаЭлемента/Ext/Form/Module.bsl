&НаКлиенте
Процедура ОтчетОбразецНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	СписокОтчетов = ОтчетыОбразцыДляВыбора();
	Если СписокОтчетов.Количество() = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'В базе нет сохранённых регламентированных отчётов для выбора.'"));
		Возврат;
	КонецЕсли;

	Оповещение = Новый ОписаниеОповещения("ОтчетОбразецПослеВыбора", ЭтотОбъект);
	ПоказатьВыборИзСписка(Оповещение, СписокОтчетов, Элемент);

КонецПроцедуры

&НаСервере
Функция ОтчетыОбразцыДляВыбора()

	Результат = Новый СписокЗначений;
	Организации = дбу_ДоступОрганизаций.ДоступныеОрганизации();
	Если ЗначениеЗаполнено(ОрганизацияКонтекста) Тогда
		Если Не дбу_ДоступОрганизаций.ОрганизацияДоступна(ОрганизацияКонтекста) Тогда
			Возврат Результат;
		КонецЕсли;
		Организации = Новый Массив;
		Организации.Добавить(ОрганизацияКонтекста);
	КонецЕсли;
	Если Организации.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 200
		|    Отчеты.Ссылка КАК Ссылка
		|ИЗ
		|    Документ.РегламентированныйОтчет КАК Отчеты
		|ГДЕ
		|    НЕ Отчеты.ПометкаУдаления
		|    И Отчеты.ИсточникОтчета = &ИсточникОтчета
		|    И Отчеты.Организация В (&Организации)
		|УПОРЯДОЧИТЬ ПО
		|    Отчеты.Дата УБЫВ");
	Запрос.УстановитьПараметр("ИсточникОтчета", "РегламентированныйОтчетБухОтчетность");
	Запрос.УстановитьПараметр("Организации", Организации);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Добавить(Выборка.Ссылка, Строка(Выборка.Ссылка));
	КонецЦикла;

	Возврат Результат;

КонецФункции

&НаКлиенте
Процедура ОтчетОбразецПослеВыбора(Результат, ДополнительныеПараметры) Экспорт

	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если ТипЗнч(Результат) = Тип("ЭлементСпискаЗначений") Тогда
		ОтчетОбразец = Результат.Значение;
	Иначе
		ОтчетОбразец = Результат;
	КонецЕсли;
	ОбновитьПредставлениеЦелиНаСервере(Элементы.Цели.ТекущаяСтрока);

КонецПроцедуры

