
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ЗаполнитьЗначенияСвойств(ЭтотОбъект, Параметры, "Счет,КорСчет,ВидыСубконто");

	ПакетЗапроса = Неопределено;
	АдресДанныхЗапроса = Неопределено;
	Если Параметры.Свойство("ДанныеЗапроса", АдресДанныхЗапроса)
		И ЭтоАдресВременногоХранилища(АдресДанныхЗапроса) Тогда
		ПакетЗапроса = ПолучитьИзВременногоХранилища(АдресДанныхЗапроса);
	КонецЕсли;

	ИмяМакета = дбу_СКДОперандов.ИмяМакетаСКДПоСчетам(ЗначениеЗаполнено(КорСчет));

	Если ПакетЗапроса = Неопределено Тогда

		СхемаКомпоновки = дбу_СКДОперандов.ПолучитьСхемуКомпоновки(ИмяМакета);
		НастройкиКомпоновки = СхемаКомпоновки.НастройкиПоУмолчанию;
		ПоляКомпоновки = СхемаКомпоновки.НаборыДанных[0].Поля;

		дбу_СКДОперандов.НастроитьСубконтоИОтборПоСчету(Счет, "Счет", "Субконто", ПоляКомпоновки, НастройкиКомпоновки);
		дбу_СКДОперандов.НастроитьСубконтоИОтборПоСчету(КорСчет, "КорСчет", "КорСубконто", ПоляКомпоновки, НастройкиКомпоновки);

		УстановитьПараметрВидыСубконто(НастройкиКомпоновки);
		УстановитьПоказательПоУмолчанию(НастройкиКомпоновки);

	Иначе

		СхемаКомпоновки = ПакетЗапроса.СхемаКомпоновки;
		НастройкиКомпоновки = ПакетЗапроса.НастройкиКомпоновки;

	КонецЕсли;

	СхемаКомпоновкиДанныхАдрес = ПоместитьВоВременноеХранилище(СхемаКомпоновки, УникальныйИдентификатор);
	ИсточникНастроек = Новый ИсточникДоступныхНастроекКомпоновкиДанных(СхемаКомпоновкиДанныхАдрес);

	КомпоновщикНастроек.Инициализировать(ИсточникНастроек);
	КомпоновщикНастроек.ЗагрузитьНастройки(НастройкиКомпоновки);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКоманд

&НаКлиенте
Процедура ЗавершитьРедактирование(Команда)

	Если КомпоновщикНастроек.Настройки.Выбор.Элементы.Количество() = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Не выбрано ни одного показателя'"));
		Возврат;
	ИначеЕсли КомпоновщикНастроек.Настройки.Выбор.Элементы.Количество() > 1 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Выбрано более одного показателя'"));
		Возврат;
	КонецЕсли;

	Если Не ЕстьОтборПоПолю("Счет") Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Отсутствует отбор по счету'"));
		Возврат;
	КонецЕсли;

	Если ЗначениеЗаполнено(КорСчет) И Не ЕстьОтборПоПолю("КорСчет") Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Отсутствует отбор по корр. счету'"));
		Возврат;
	КонецЕсли;

	РезультатАдрес = СкомпилироватьИВернутьАдрес();
	Если ЭтоАдресВременногоХранилища(РезультатАдрес) Тогда
		Закрыть(РезультатАдрес);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Функция ЕстьОтборПоПолю(ИмяПоля)

	Для Каждого ЭлементОтбора Из КомпоновщикНастроек.Настройки.Отбор.Элементы Цикл

		Если ТипЗнч(ЭлементОтбора) <> Тип("ЭлементОтбораКомпоновкиДанных") Тогда
			Продолжить;
		КонецЕсли;

		Если ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ИмяПоля)
			И ЭлементОтбора.Использование Тогда
			Возврат Истина;
		КонецЕсли;

	КонецЦикла;

	Возврат Ложь;

КонецФункции

&НаСервере
Процедура УстановитьПараметрВидыСубконто(НастройкиКомпоновки)

	ПараметрВидыСубконто = НастройкиКомпоновки.ПараметрыДанных.Элементы.Найти("ВидыСубконто");
	Если ПараметрВидыСубконто = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если ЗначениеЗаполнено(ВидыСубконто) Тогда

		МассивВидовСубконто = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ВидыСубконто, ",", Истина, Истина);
		СписокВидовСубконто = Новый СписокЗначений;

		Для Каждого ВидСубконто Из МассивВидовСубконто Цикл
			СписокВидовСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные[СокрЛП(ВидСубконто)]);
		КонецЦикла;

		ПараметрВидыСубконто.Значение = СписокВидовСубконто;
		ПараметрВидыСубконто.Использование = Истина;

	Иначе
		ПараметрВидыСубконто.Использование = Ложь;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура УстановитьПоказательПоУмолчанию(НастройкиКомпоновки)

	НастройкиКомпоновки.Выбор.Элементы.Очистить();

	Если ЗначениеЗаполнено(КорСчет) Тогда
		дбу_СКДОперандов.ДобавитьВыбранноеПоле(НастройкиКомпоновки, "ДО");
	ИначеЕсли Счет.Вид = ВидСчета.Активный Тогда
		дбу_СКДОперандов.ДобавитьВыбранноеПоле(НастройкиКомпоновки, "СКД");
	ИначеЕсли Счет.Вид = ВидСчета.Пассивный Тогда
		дбу_СКДОперандов.ДобавитьВыбранноеПоле(НастройкиКомпоновки, "СКК");
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция СкомпилироватьИВернутьАдрес()

	СхемаКомпоновки = ПолучитьИзВременногоХранилища(СхемаКомпоновкиДанныхАдрес);
	ТекущиеНастройки = КомпоновщикНастроек.ПолучитьНастройки();

	ПакетЗапроса = дбу_СКДОперандов.СкомпилироватьПакетЗапроса(
		СхемаКомпоновки, ТекущиеНастройки, Счет, КорСчет, ВидыСубконто);

	Возврат ПоместитьВоВременноеХранилище(ПакетЗапроса, Новый УникальныйИдентификатор);

КонецФункции

#КонецОбласти
