// Запросы данных для операндов правил КДР.

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ)

	Если НастройкиСКД.Получить() = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ПакетЗапроса = НастройкиСКД.Получить();
	Если ТипЗнч(ПакетЗапроса) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;

	дбу_СКДОперандов.ОбновитьРеквизитыЗапросаИзПакета(ЭтотОбъект, ПакетЗапроса);

КонецПроцедуры

#КонецОбласти

#КонецЕсли
