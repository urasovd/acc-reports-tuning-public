		<query>ВЫБРАТЬ
	ЕСТЬNULL(СУММА(ВложенныйЗапрос.СНД), 0) КАК СНД,
	ЕСТЬNULL(СУММА(ВложенныйЗапрос.СНК), 0) КАК СНК,
	ЕСТЬNULL(СУММА(ВложенныйЗапрос.СНДР), 0) КАК СНДР,
	ЕСТЬNULL(СУММА(ВложенныйЗапрос.СНКР), 0) КАК СНКР,
	ЕСТЬNULL(СУММА(ВложенныйЗапрос.СКД), 0) КАК СКД,
	ЕСТЬNULL(СУММА(ВложенныйЗапрос.СКК), 0) КАК СКК,
	ЕСТЬNULL(СУММА(ВложенныйЗапрос.СКДР), 0) КАК СКДР,
	ЕСТЬNULL(СУММА(ВложенныйЗапрос.СККР), 0) КАК СККР,
	ЕСТЬNULL(СУММА(ВложенныйЗапрос.ДО), 0) КАК ДО,
	ЕСТЬNULL(СУММА(ВложенныйЗапрос.КО), 0) КАК КО
{ВЫБРАТЬ
	СНД,
	СНК,
	СНДР,
	СНКР,
	СКД,
	СКК,
	СКДР,
	СККР,
	ДО,
	КО}
ИЗ
	(ВЫБРАТЬ
		ХозрасчетныйОстаткиИОбороты.Счет КАК Счет,
		"ТекстЗапросаСубконто" КАК ТекстЗапросаСубконто,
		ХозрасчетныйОстаткиИОбороты.СуммаНачальныйОстатокДт КАК СНД,
		ХозрасчетныйОстаткиИОбороты.СуммаНачальныйОстатокКт КАК СНК,
		ХозрасчетныйОстаткиИОбороты.СуммаНачальныйРазвернутыйОстатокДт КАК СНДР,
		ХозрасчетныйОстаткиИОбороты.СуммаНачальныйРазвернутыйОстатокКт КАК СНКР,
		ХозрасчетныйОстаткиИОбороты.СуммаКонечныйОстатокДт КАК СКД,
		ХозрасчетныйОстаткиИОбороты.СуммаКонечныйОстатокКт КАК СКК,
		ХозрасчетныйОстаткиИОбороты.СуммаКонечныйРазвернутыйОстатокДт КАК СКДР,
		ХозрасчетныйОстаткиИОбороты.СуммаКонечныйРазвернутыйОстатокКт КАК СККР,
		ХозрасчетныйОстаткиИОбороты.СуммаОборотДт КАК ДО,
		ХозрасчетныйОстаткиИОбороты.СуммаОборотКт КАК КО
	{ВЫБРАТЬ
		СНД,
		СНК,
		СНДР,
		СНКР,
		СКД,
		СКК,
		СКДР,
		СККР,
		ДО,
		КО}
	ИЗ
		РегистрБухгалтерии.Хозрасчетный.ОстаткиИОбороты(&amp;НачалоПериода, &amp;КонецПериода, , , {(Счет)}, {(&amp;ВидыСубконто)}, Организация = &amp;Организация {(Подразделение).*, (Субконто1).*, (Субконто2).*, (Субконто3).*}) КАК ХозрасчетныйОстаткиИОбороты
	{ГДЕ
		ХозрасчетныйОстаткиИОбороты.СуммаНачальныйОстатокДт КАК СНД,
		ХозрасчетныйОстаткиИОбороты.СуммаНачальныйОстатокКт КАК СНК,
		ХозрасчетныйОстаткиИОбороты.СуммаНачальныйРазвернутыйОстатокДт КАК СНДР,
		ХозрасчетныйОстаткиИОбороты.СуммаНачальныйРазвернутыйОстатокКт КАК СНКР,
		ХозрасчетныйОстаткиИОбороты.СуммаКонечныйОстатокДт КАК СКД,
		ХозрасчетныйОстаткиИОбороты.СуммаКонечныйОстатокКт КАК СКК,
		ХозрасчетныйОстаткиИОбороты.СуммаКонечныйРазвернутыйОстатокДт КАК СКДР,
		ХозрасчетныйОстаткиИОбороты.СуммаКонечныйРазвернутыйОстатокКт КАК СККР,
		ХозрасчетныйОстаткиИОбороты.СуммаОборотДт КАК ДО,
		ХозрасчетныйОстаткиИОбороты.СуммаОборотКт КАК КО}) КАК ВложенныйЗапрос</query>
