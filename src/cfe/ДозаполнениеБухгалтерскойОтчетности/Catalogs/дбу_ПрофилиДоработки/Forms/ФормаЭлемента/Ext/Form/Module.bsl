&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Параметры.Свойство("Копирование") И Параметры.Копирование Тогда
		// Назначения организаций не должны незаметно переходить в копию профиля.
		Объект.Применения.Очистить();
	КонецЕсли;

	// Баланс показывает три даты: отчётную и 31 декабря двух предыдущих лет.
	// Подключение с позапрошлого года даёт те же правила и при перезаполнении
	// отчётов за прошлые годы, поэтому сравнительные графы совпадают.
	ГодНачалаПрименения = Год(ТекущаяДата()) - 2;
	ПоследнийГодПрименения = Год(ТекущаяДата());
	УстановитьОтборПравил();
	ОбновитьОрганизацииНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ДобавитьПравило(Команда)

	Если Не ПроверитьСохраненныйПрофиль() Тогда
		Возврат;
	КонецЕсли;
	дбу_РабочееМестоНастройкиКлиент.СоздатьПравило(
		Объект.Ссылка, ЭтаФорма,
		Новый ОписаниеОповещения("ПравилоПрофиляЗакрыто", ЭтаФорма));

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьПравило(Команда)

	Правило = ТекущееПравилоПрофиля();
	Если Не ПроверитьСохраненныйПрофиль() Или Не ЗначениеЗаполнено(Правило) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Выберите правило профиля.'"));
		Возврат;
	КонецЕсли;

	дбу_РабочееМестоНастройкиКлиент.ОткрытьПравило(
		Правило, ЭтаФорма,
		Новый ОписаниеОповещения("ПравилоПрофиляЗакрыто", ЭтаФорма));

КонецПроцедуры

&НаКлиенте
Процедура СкопироватьПравило(Команда)

	Правило = ТекущееПравилоПрофиля();
	Если Не ПроверитьСохраненныйПрофиль() Или Не ЗначениеЗаполнено(Правило) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Выберите правило профиля.'"));
		Возврат;
	КонецЕсли;

	НовоеПравило = СкопироватьПравилоНаСервере(Правило);
	дбу_РабочееМестоНастройкиКлиент.ОткрытьПравило(
		НовоеПравило, ЭтаФорма,
		Новый ОписаниеОповещения("ПравилоПрофиляЗакрыто", ЭтаФорма));

КонецПроцедуры

&НаКлиенте
Процедура ПроверитьФормулы(Команда)

	Сообщить(ПроверитьФормулыНаСервере());

КонецПроцедуры

&НаКлиенте
Процедура ПробныйРасчет(Команда)

	Правило = ТекущееПравилоПрофиля();
	Организация = ТекущаяОрганизацияПрофиля();
	Если Не ЗначениеЗаполнено(Правило) Или Не ЗначениеЗаполнено(Организация) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Выберите правило и организацию профиля для пробного расчёта.'"));
		Возврат;
	КонецЕсли;

	АдресДанных = ПодготовитьПробныйРасчетНаСервере(Правило, Организация);
	дбу_РабочееМестоНастройкиКлиент.ОткрытьПробныйРасчет(АдресДанных, ЭтаФорма);

КонецПроцедуры

&НаКлиенте
Процедура ПодключитьОрганизацию(Команда)

	Если Не ЗначениеЗаполнено(ОрганизацияДляПодключения) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Выберите организацию.'"));
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ГодНачалаПрименения) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Укажите год начала применения.'"));
		Возврат;
	КонецЕсли;
	Если ГодНачалаПрименения < 1900 Или ГодНачалаПрименения > 9999 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Год начала должен быть в диапазоне 1900–9999.'"));
		Возврат;
	КонецЕсли;
	Если Не ПроверитьСохраненныйПрофиль() Тогда
		Возврат;
	КонецЕсли;

	Попытка
		ПодключитьОрганизациюНаСервере();
		ОрганизацияДляПодключения = Неопределено;
		ОбновитьОрганизацииНаСервере();
		ОбновитьСписокОрганизацийНаКлиенте();
		Сообщить(НСтр("ru = 'Организация подключена к профилю.'"));
	Исключение
		Сообщить(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ПрекратитьПрименение(Команда)

	ТекущиеДанные = Элементы.Организации.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Выберите применение профиля.'"));
		Возврат;
	КонецЕсли;
	Если ЗначениеЗаполнено(ТекущиеДанные.ПоследнийГодПрименения) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Выбранный интервал применения уже завершён.'"));
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ПоследнийГодПрименения) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Укажите последний год применения.'"));
		Возврат;
	КонецЕсли;
	Если ПоследнийГодПрименения < ТекущиеДанные.ГодНачалаПрименения Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Последний год применения не может быть раньше года начала.'"));
		Возврат;
	КонецЕсли;

	Попытка
		ПрекратитьПрименениеНаСервере(
			ТекущиеДанные.Организация, ТекущиеДанные.ГодНачалаПрименения,
			ПоследнийГодПрименения);
		ОбновитьОрганизацииНаСервере();
		ОбновитьСписокОрганизацийНаКлиенте();
		Сообщить(НСтр("ru = 'Применение профиля завершено после указанного года.'"));
	Исключение
		Сообщить(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьБухОтчетность(Команда)

	Организация = ТекущаяОрганизацияПрофиля();
	Если Не ЗначениеЗаполнено(Организация) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Выберите организацию профиля.'"));
		Возврат;
	КонецЕсли;

	дбу_РабочееМестоНастройкиКлиент.ОткрытьБухОтчетность(Организация);

КонецПроцедуры

&НаКлиенте
Процедура ИсторияПрименения(Команда)

	Организация = ТекущаяОрганизацияПрофиля();
	Если Не ЗначениеЗаполнено(Организация) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Выберите организацию профиля.'"));
		Возврат;
	КонецЕсли;
	ТекстИстории = ИсторияПримененияНаСервере(Организация);
	Если Не ЗначениеЗаполнено(ТекстИстории) Тогда
		ТекстИстории = НСтр("ru = 'История применения отсутствует.'");
	КонецЕсли;
	Сообщить(ТекстИстории);

КонецПроцедуры

&НаКлиенте
Процедура ПравилоПрофиляЗакрыто(Результат, ДополнительныеПараметры) Экспорт

	ОбновитьПравилаНаКлиенте();

КонецПроцедуры

&НаСервере
Процедура ПодключитьОрганизациюНаСервере()

	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ВызватьИсключение НСтр("ru = 'Сначала запишите профиль, затем подключайте организации.'");
	КонецЕсли;
	УстановитьОтборПравил();
	дбу_ПрофилиДоработкиСервер.ЗаписатьПрименениеПрофиля(
		ОрганизацияДляПодключения, Объект.Ссылка,
		Дата(ГодНачалаПрименения, 1, 1));
	ЗначениеВРеквизитФормы(Объект.Ссылка.ПолучитьОбъект(), "Объект");

КонецПроцедуры

&НаСервере
Процедура ПрекратитьПрименениеНаСервере(Организация, ГодНачала, ПоследнийГод)

	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ВызватьИсключение НСтр("ru = 'Сначала запишите профиль, затем изменяйте применения.'");
	КонецЕсли;
	дбу_ПрофилиДоработкиСервер.ПрекратитьПрименениеПрофиля(
		Объект.Ссылка, Организация, Дата(ГодНачала, 1, 1),
		Дата(ПоследнийГод, 1, 1));
	ЗначениеВРеквизитФормы(Объект.Ссылка.ПолучитьОбъект(), "Объект");

КонецПроцедуры

&НаСервере
Функция ИсторияПримененияНаСервере(Организация)

	Возврат дбу_ПрофилиДоработкиСервер.ИсторияПрименения(Объект.Ссылка, Организация);

КонецФункции

&НаСервере
Процедура ОбновитьОрганизацииНаСервере()

	НоваяТаблицаОрганизаций = Новый ТаблицаЗначений;
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		НоваяТаблицаОрганизаций = дбу_ПрофилиДоработкиСервер.ПримененияПрофиля(Объект.Ссылка);
	КонецЕсли;
	ЗначениеВРеквизитФормы(НоваяТаблицаОрганизаций, "Организации");

КонецПроцедуры

&НаКлиенте
Функция ПроверитьСохраненныйПрофиль()

	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Возврат Истина;
	КонецЕсли;

	ПоказатьПредупреждение(, НСтр("ru = 'Сначала запишите профиль.'"));
	Возврат Ложь;

КонецФункции

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	ОбновитьСписокОрганизацийНаКлиенте();

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСписокОрганизацийНаКлиенте()

	СписокОрганизаций = СписокОрганизацийДляПодключенияНаСервере();
	СписокВыбора = Элементы.ОрганизацияДляПодключения.СписокВыбора;
	СписокВыбора.Очистить();
	Для Каждого ЭлементСписка Из СписокОрганизаций Цикл
		СписокВыбора.Добавить(ЭлементСписка.Значение, ЭлементСписка.Представление);
	КонецЦикла;

КонецПроцедуры

&НаСервере
Функция СписокОрганизацийДляПодключенияНаСервере()

	Возврат дбу_ПрофилиДоработкиСервер.СписокОрганизацийДляПодключения(Объект.Ссылка);

КонецФункции

&НаСервере
Процедура УстановитьОтборПравил()

	Отбор = ПравилаПрофиля.КомпоновщикНастроек.ФиксированныеНастройки.Отбор;
	Отбор.Элементы.Очистить();

	ОтборПоВладельцу = Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборПоВладельцу.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Владелец");
	ОтборПоВладельцу.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборПоВладельцу.ПравоеЗначение = Объект.Ссылка;
	ОтборПоВладельцу.Использование = Истина;
	ОтборПоВладельцу.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;

	ОтборПоПометкеУдаления = Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборПоПометкеУдаления.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ПометкаУдаления");
	ОтборПоПометкеУдаления.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборПоПометкеУдаления.ПравоеЗначение = Ложь;
	ОтборПоПометкеУдаления.Использование = Истина;
	ОтборПоПометкеУдаления.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;

	ОтборПоАктивности = Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборПоАктивности.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Активно");
	ОтборПоАктивности.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборПоАктивности.ПравоеЗначение = Истина;
	ОтборПоАктивности.Использование = Истина;
	ОтборПоАктивности.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;

КонецПроцедуры

&НаСервере
Функция СкопироватьПравилоНаСервере(Правило)

	НовоеПравило = Правило.ПолучитьОбъект().Скопировать();
	НовоеПравило.Наименование = НовоеПравило.Наименование + " (копия)";
	НовоеПравило.Записать();
	Возврат НовоеПравило.Ссылка;

КонецФункции

&НаСервере
Функция ПроверитьФормулыНаСервере()

	Ошибки = Новый Массив;
	Запрос = Новый Запрос(
		"ВЫБРАТЬ Правила.Ссылка, Правила.Наименование
		|ИЗ Справочник.дбу_ПравилаДоработки КАК Правила
		|ГДЕ Правила.Владелец = &Профиль
		| И Правила.Активно
		| И НЕ Правила.ПометкаУдаления");
	Запрос.УстановитьПараметр("Профиль", Объект.Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ПравилоОбъект = Выборка.Ссылка.ПолучитьОбъект();
		Идентификаторы = Новый Массив;
		Для Каждого СтрокаОперанда Из ПравилоОбъект.Операнды Цикл
			Если ЗначениеЗаполнено(СтрокаОперанда.Идентификатор) Тогда
				Идентификаторы.Добавить(СтрокаОперанда.Идентификатор);
			КонецЕсли;
		КонецЦикла;
		РезультатПроверки = дбу_ДвижокДоработки.ПроверитьФормулу(ПравилоОбъект.Формула, Идентификаторы);
		Если Не РезультатПроверки.Успех Тогда
			Ошибки.Добавить(Строка(Выборка.Наименование) + ": " + РезультатПроверки.ТекстОшибки);
		КонецЕсли;
	КонецЦикла;

	Если Ошибки.Количество() = 0 Тогда
		Возврат НСтр("ru = 'Формулы всех правил профиля корректны.'");
	КонецЕсли;
	Возврат СтрСоединить(Ошибки, Символы.ПС);

КонецФункции

&НаСервере
Функция ПодготовитьПробныйРасчетНаСервере(Правило, Организация)

	Возврат дбу_ПрофилиДоработкиСервер.АдресДанныхПравилаДляПробногоРасчета(
		Правило, УникальныйИдентификатор, Организация,
		Дата(ГодНачалаПрименения, 1, 1));

КонецФункции

&НаКлиенте
Процедура ОбновитьПравилаНаКлиенте()

	Элементы.ПравилаПрофиля.Обновить();

КонецПроцедуры

&НаКлиенте
Функция ТекущееПравилоПрофиля()

	ТекущиеДанные = Элементы.ПравилаПрофиля.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		Возврат НайтиПравилоПрофиляНаСервере(ТекущиеДанные.Description);
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

&НаСервере
Функция НайтиПравилоПрофиляНаСервере(НаименованиеПравила)

	Если Не ЗначениеЗаполнено(Объект.Ссылка)
		Или Не ЗначениеЗаполнено(НаименованиеПравила) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 2
		|   Правила.Ссылка
		|ИЗ Справочник.дбу_ПравилаДоработки КАК Правила
		|ГДЕ Правила.Владелец = &Профиль
		|   И Правила.Наименование = &Наименование
		|   И НЕ Правила.ПометкаУдаления");
	Запрос.УстановитьПараметр("Профиль", Объект.Ссылка);
	Запрос.УстановитьПараметр("Наименование", НаименованиеПравила);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;
	Правило = Выборка.Ссылка;
	Если Выборка.Следующий() Тогда
		ВызватьИсключение НСтр("ru = 'В профиле есть несколько правил с одинаковым наименованием.'");
	КонецЕсли;
	Возврат Правило;

КонецФункции

&НаКлиенте
Функция ТекущаяОрганизацияПрофиля()

	ТекущиеДанные = Элементы.Организации.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		Возврат ТекущиеДанные.Организация;
	КонецЕсли;
	Возврат Неопределено;

КонецФункции
