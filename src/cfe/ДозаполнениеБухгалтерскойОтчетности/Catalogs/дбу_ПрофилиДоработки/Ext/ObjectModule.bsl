// Проверка интервальных применений профиля.

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Процедура ПередЗаписью(Отказ)

	Для Каждого СтрокаПрименения Из Применения Цикл
		Если Не ЗначениеЗаполнено(СтрокаПрименения.Организация) Тогда
			Отказ = Истина;
			ОбщегоНазначения.СообщитьПользователю(
				НСтр("ru = 'В применении профиля не указана организация.'"), ЭтотОбъект, , , Отказ);
			Возврат;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(СтрокаПрименения.ПрименятьС) Тогда
			Отказ = Истина;
			ОбщегоНазначения.СообщитьПользователю(
				НСтр("ru = 'Для применения профиля укажите дату начала.'"), ЭтотОбъект, , , Отказ);
			Возврат;
		КонецЕсли;
		Если ЗначениеЗаполнено(СтрокаПрименения.НеПрименятьС)
			И СтрокаПрименения.НеПрименятьС <= СтрокаПрименения.ПрименятьС Тогда
			Отказ = Истина;
			ОбщегоНазначения.СообщитьПользователю(
				НСтр("ru = 'Дата отключения должна быть позже даты подключения.'"), ЭтотОбъект, , , Отказ);
			Возврат;
		КонецЕсли;
	КонецЦикла;

	Если Применения.Количество() > 1 Тогда
		Для НомерСтроки = 0 По Применения.Количество() - 1 Цикл
			Строка1 = Применения[НомерСтроки];
			Для НомерСледующейСтроки = НомерСтроки + 1 По Применения.Количество() - 1 Цикл
				Строка2 = Применения[НомерСледующейСтроки];
				Если Строка1.Организация <> Строка2.Организация Тогда
					Продолжить;
				КонецЕсли;
				Если ИнтервалыПересекаются(Строка1, Строка2) Тогда
					Отказ = Истина;
					ОбщегоНазначения.СообщитьПользователю(
						НСтр("ru = 'Интервалы применения одной организации пересекаются.'"), ЭтотОбъект, , , Отказ);
					Возврат;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

Функция ИнтервалыПересекаются(Строка1, Строка2)
	Возврат (Не ЗначениеЗаполнено(Строка1.НеПрименятьС)
		Или Строка2.ПрименятьС < Строка1.НеПрименятьС)
		И (Не ЗначениеЗаполнено(Строка2.НеПрименятьС)
		Или Строка1.ПрименятьС < Строка2.НеПрименятьС);
КонецФункции

#КонецЕсли
