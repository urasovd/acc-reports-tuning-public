// Возвращает способы расчёта со свёрнутым сальдо.
//
Функция СвернутоеСальдо() Экспорт

	СпособыРасчета = Новый Массив;
	СпособыРасчета.Добавить(Перечисления.дбу_СпособыРасчетаОперанда.СНД);
	СпособыРасчета.Добавить(Перечисления.дбу_СпособыРасчетаОперанда.СНК);
	СпособыРасчета.Добавить(Перечисления.дбу_СпособыРасчетаОперанда.СКД);
	СпособыРасчета.Добавить(Перечисления.дбу_СпособыРасчетаОперанда.СКК);

	Возврат СпособыРасчета;

КонецФункции

// Возвращает способы расчёта с развёрнутым сальдо.
//
Функция РазвернутоеСальдо() Экспорт

	СпособыРасчета = Новый Массив;
	СпособыРасчета.Добавить(Перечисления.дбу_СпособыРасчетаОперанда.СНДР);
	СпособыРасчета.Добавить(Перечисления.дбу_СпособыРасчетаОперанда.СНКР);
	СпособыРасчета.Добавить(Перечисления.дбу_СпособыРасчетаОперанда.СКДР);
	СпособыРасчета.Добавить(Перечисления.дбу_СпособыРасчетаОперанда.СККР);

	Возврат СпособыРасчета;

КонецФункции

