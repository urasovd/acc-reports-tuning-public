Процедура ПроверитьНаличиеПрофиля(Пользователь, Профиль)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|   ГруппыДоступа.Ссылка
		|ИЗ
		|   Справочник.ГруппыДоступа КАК ГруппыДоступа
		|ГДЕ
		|   ГруппыДоступа.Пользователь = &Пользователь
		|   И ГруппыДоступа.Профиль = &Профиль";
	Запрос.УстановитьПараметр("Пользователь", Пользователь);
	Запрос.УстановитьПараметр("Профиль", Профиль);
	ЮТест.ОжидаетЧто(Запрос.Выполнить().Пустой()).Равно(Ложь);

