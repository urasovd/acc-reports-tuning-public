	Раздел = НайтиРазделФикстуры(Дерево);
	НайденныеМСЧ = Раздел.Строки.НайтиСтроки(Новый Структура(
		"Тип,Идентификатор", "МногострочнаяЧасть", "П10001А1110"));
	ЮТест.ОжидаетЧто(НайденныеМСЧ.Количество()).Равно(1);
