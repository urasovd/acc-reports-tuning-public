Процедура СтрокиОтчетностиСтроятсяИзМакета() Экспорт

	Раздел = Перечисления.дбу_РазделыБухОтчетности.Баланс;
	Описание1230 = дбу_СтруктураОтчетности.ОписаниеСтроки(Раздел, "1230");
	Описание1250 = дбу_СтруктураОтчетности.ОписаниеСтроки(Раздел, "1250");

	ЮТест.ОжидаетЧто(Описание1230 <> Неопределено).Равно(Истина);
	ЮТест.ОжидаетЧто(Описание1250 <> Неопределено).Равно(Истина);

	Дерево = дбу_СтруктураОтчетности.ДеревоСтрокДляВыбора(Раздел);
	ЮТест.ОжидаетЧто(НайтиСтрокуВДереве(Дерево.Строки, "1230") <> Неопределено).Равно(Истина);
	ЮТест.ОжидаетЧто(НайтиСтрокуВДереве(Дерево.Строки, "1250") <> Неопределено).Равно(Истина);

КонецПроцедуры

Процедура ДеревоФикстурыСодержитЧетыреВидаСтрок() Экспорт

	Дерево = ДеревоДанныхРазделов();
	Адреса = дбу_СтруктураОтчетности.ПеречислитьДоступныеСтроки(
		Дерево, Перечисления.дбу_РазделыБухОтчетности.Баланс);
	Виды = Новый Соответствие;
	Для Каждого Адрес Из Адреса Цикл
		Виды.Вставить(Строка(Адрес.ВидСтрокиОтчетности), Истина);
		ЮТест.ОжидаетЧто(СтрНайти(Адрес.НаименованиеСтроки, "в том числе") = 0).Равно(Истина);
		Если Адрес.ВидСтрокиОтчетности <> Перечисления.дбу_ВидыСтрокОтчетности.Стандартная Тогда
			ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Адрес.НаименованиеСтроки)).Равно(Истина);
		КонецЕсли;
	КонецЦикла;

	ЮТест.ОжидаетЧто(Виды.Количество()).Равно(4);
	ЮТест.ОжидаетЧто(Виды.Получить(Строка(
		Перечисления.дбу_ВидыСтрокОтчетности.Стандартная))).Равно(Истина);
	ЮТест.ОжидаетЧто(Виды.Получить(Строка(
		Перечисления.дбу_ВидыСтрокОтчетности.ПрямаяРасшифровка))).Равно(Истина);
	ЮТест.ОжидаетЧто(Виды.Получить(Строка(
		Перечисления.дбу_ВидыСтрокОтчетности.Вписанная))).Равно(Истина);
	ЮТест.ОжидаетЧто(Виды.Получить(Строка(
		Перечисления.дбу_ВидыСтрокОтчетности.ВложеннаяРасшифровка))).Равно(Истина);

КонецПроцедуры

Процедура ДеревоНеПоказываетИтоговыеСтандартныеСтроки() Экспорт

	Дерево = ДеревоДанныхРазделов();
	Адреса = дбу_СтруктураОтчетности.ПеречислитьДоступныеСтроки(
		Дерево, Перечисления.дбу_РазделыБухОтчетности.Баланс);

	Для Каждого Адрес Из Адреса Цикл
		Если Адрес.ВидСтрокиОтчетности = Перечисления.дбу_ВидыСтрокОтчетности.Стандартная Тогда
			ЮТест.ОжидаетЧто(Адрес.КодСтрокиФСБУ = "1100").Равно(Ложь);
		КонецЕсли;
	КонецЦикла;

	ДеревоВыбора = дбу_СтруктураОтчетности.ДеревоСтрокДляВыбора(
		Перечисления.дбу_РазделыБухОтчетности.Баланс, "", Дерево);
	ЮТест.ОжидаетЧто(НайтиАдресВДеревеВыбора(ДеревоВыбора.Строки,
		Перечисления.дбу_ВидыСтрокОтчетности.Стандартная, "1100", "", "") = Неопределено).Равно(Истина);

