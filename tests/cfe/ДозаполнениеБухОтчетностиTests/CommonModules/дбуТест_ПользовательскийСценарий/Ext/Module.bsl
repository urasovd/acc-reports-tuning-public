Процедура АдресЦелиПроверяетсяДоЗаписи() Экспорт

	Стандартная = ЦельСтрокиТеста(
		Перечисления.дбу_ВидыСтрокОтчетности.Стандартная,
		"1520");
	Проверка = дбу_СтруктураОтчетности.ПроверитьАдресСтрокиЦели(
		Перечисления.дбу_РазделыБухОтчетности.Баланс, Стандартная);
	ЮТест.ОжидаетЧто(Проверка.Успех).Равно(Истина);

	Прямая = ЦельСтрокиТеста(
		Перечисления.дбу_ВидыСтрокОтчетности.ПрямаяРасшифровка,
		"1520", "Обязательство по аренде", "76.07");
	Прямая.НаименованиеРодительскойСтроки = "Лишний родитель";
	Проверка = дбу_СтруктураОтчетности.ПроверитьАдресСтрокиЦели(
		Перечисления.дбу_РазделыБухОтчетности.Баланс, Прямая);
	ЮТест.ОжидаетЧто(Проверка.Успех).Равно(Ложь);

	Вписанная = ЦельСтрокиТеста(
		Перечисления.дбу_ВидыСтрокОтчетности.Вписанная,
		"1110", "Вписанная строка аренды");
	Вписанная.КодСтрокиВОтчете = "01";
	Проверка = дбу_СтруктураОтчетности.ПроверитьАдресСтрокиЦели(
		Перечисления.дбу_РазделыБухОтчетности.Баланс, Вписанная);
	ЮТест.ОжидаетЧто(Проверка.Успех).Равно(Ложь);

	Вложенная = ЦельСтрокиТеста(
		Перечисления.дбу_ВидыСтрокОтчетности.ВложеннаяРасшифровка,
		"1110", "Долгосрочная часть", "76.07", "Вписанная строка аренды");
	Проверка = дбу_СтруктураОтчетности.ПроверитьАдресСтрокиЦели(
		Перечисления.дбу_РазделыБухОтчетности.Баланс, Вложенная);
	ЮТест.ОжидаетЧто(Проверка.Успех).Равно(Истина);

	Вложенная.НаименованиеРодительскойСтроки = "";
	Проверка = дбу_СтруктураОтчетности.ПроверитьАдресСтрокиЦели(
