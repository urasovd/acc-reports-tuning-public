		Если Строка.Тип = ТипУзла И Строка.Идентификатор = Идентификатор Тогда
			Результат.Добавить(Строка);
		КонецЕсли;
		СобратьУзлыФикстуры(Строка.Строки, ТипУзла, Идентификатор, Результат);
	КонецЦикла;

