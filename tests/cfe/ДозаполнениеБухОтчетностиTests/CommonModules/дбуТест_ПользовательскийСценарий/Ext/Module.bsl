Функция СоздатьИлиОбновитьПрофильДБУ(Наименование, ИменаРолей)

	Профиль = Справочники.ПрофилиГруппДоступа.НайтиПоНаименованию(Наименование);
	Если Профиль.Пустая() Тогда
		ПрофильОбъект = Справочники.ПрофилиГруппДоступа.СоздатьЭлемент();
	Иначе
		ПрофильОбъект = Профиль.ПолучитьОбъект();
	КонецЕсли;
	ПрофильОбъект.Наименование = Наименование;
	ПрофильОбъект.Роли.Очистить();
	Для Каждого ИмяРоли Из ИменаРолей Цикл
		МетаданныеРоли = Метаданные.Роли.Найти(ИмяРоли);
		Если МетаданныеРоли = Неопределено Тогда
			ВызватьИсключение "Роль не найдена в метаданных: " + ИмяРоли;
		КонецЕсли;
		ПрофильОбъект.Роли.Добавить().Роль =
			ОбщегоНазначения.ИдентификаторОбъектаМетаданных(МетаданныеРоли);
	КонецЦикла;
	ПрофильОбъект.Назначение.Очистить();
	ПрофильОбъект.Назначение.Добавить().ТипПользователей =
		Справочники.Пользователи.ПустаяСсылка();
	ПрофильОбъект.Записать();

	Возврат ПрофильОбъект.Ссылка;

