Функция ПодготовитьФикстуру()

	Организация = ПерваяОрганизация();
	ДатаОтчета = КонецМесяца(ТекущаяДатаСеанса());
	Результат = Новый Структура;
	Результат.Вставить("Организация", Организация);
	Результат.Вставить("ДатаОтчета", ДатаОтчета);

	Если Не ЗначениеЗаполнено(Организация) Тогда
		Результат.Вставить("Результат", Новый Структура("Успех,Профиль", Ложь,
			Справочники.дбу_ПрофилиДоработки.ПустаяСсылка()));
		Возврат Результат;
	КонецЕсли;

	СброситьТестовыйПрофиль("Демо: все виды правил КДР");
	СброситьТестовыйПрофиль("Полигон КДР");

	Результат.Вставить("Результат",
		дбу_ПримерыПравил.СоздатьПолигонТестирования(Организация, ДатаОтчета, Истина));
	Если Результат.Результат.Успех И ЗначениеЗаполнено(Результат.Результат.Правило) Тогда
		ПравилоОбъект = Результат.Результат.Правило.ПолучитьОбъект();
		ПравилоОбъект.Активно = Истина;
		ПравилоОбъект.Записать();
	КонецЕсли;
	Возврат Результат;

КонецФункции

Процедура СброситьТестовыйПрофиль(Наименование)

	СсылкаПрофиля = Справочники.дбу_ПрофилиДоработки.НайтиПоНаименованию(Наименование);
	Если СсылкаПрофиля.Пустая() Тогда
		Возврат;
	КонецЕсли;

	ПрофильОбъект = СсылкаПрофиля.ПолучитьОбъект();
	ПрофильОбъект.Применения.Очистить();
	ПрофильОбъект.Записать();

	Запрос = Новый Запрос(
		"ВЫБРАТЬ Правила.Ссылка
		|ИЗ Справочник.дбу_ПравилаДоработки КАК Правила
		|ГДЕ Правила.Владелец = &Профиль");
	Запрос.УстановитьПараметр("Профиль", СсылкаПрофиля);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ПравилоОбъект = Выборка.Ссылка.ПолучитьОбъект();
		ПравилоОбъект.Активно = Ложь;
		ПравилоОбъект.ПрименятьС = Дата(1, 1, 1);
		ПравилоОбъект.НеПрименятьС = Дата(1, 1, 1);
		ПравилоОбъект.Записать();
	КонецЦикла;

КонецПроцедуры

Функция НайтиСтрокуВДереве(СтрокиДерева, КодСтроки)

	Для Каждого СтрокаДерева Из СтрокиДерева Цикл
		Если СтрокаДерева.КодСтроки = КодСтроки Тогда
			Возврат СтрокаДерева;
		КонецЕсли;

		НайденнаяСтрока = НайтиСтрокуВДереве(СтрокаДерева.Строки, КодСтроки);
		Если НайденнаяСтрока <> Неопределено Тогда
			Возврат НайденнаяСтрока;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

Функция СоздатьТестовыйПрофиль(Наименование)

	СсылкаПрофиля = Справочники.дбу_ПрофилиДоработки.НайтиПоНаименованию(Наименование);
	Если СсылкаПрофиля.Пустая() Тогда
		ПрофильОбъект = Справочники.дбу_ПрофилиДоработки.СоздатьЭлемент();
	Иначе
		ПрофильОбъект = СсылкаПрофиля.ПолучитьОбъект();
	КонецЕсли;
	ПрофильОбъект.Наименование = Наименование;
	ПрофильОбъект.ПрефиксРасшифровки = "DBU TEST: ";
	// Каждый тест получает чистую табличную часть назначений.
	// Иначе оставленная предыдущим прогоном история меняет смысл сценария.
	ПрофильОбъект.Применения.Очистить();
	ПрофильОбъект.Записать();
	Возврат ПрофильОбъект.Ссылка;

КонецФункции

Функция НайтиПрофильВСрезе(Профили, Профиль)

	Для Каждого СтрокаПрофиля Из Профили Цикл
		Если СтрокаПрофиля.Профиль = Профиль Тогда
			Возврат СтрокаПрофиля;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

Функция КоличествоУникальныхПрофилей(Профили)

	Уникальные = Новый Соответствие;
	Для Каждого СтрокаПрофиля Из Профили Цикл
		Уникальные.Вставить(Строка(СтрокаПрофиля.Профиль), Истина);
	КонецЦикла;
	Возврат Уникальные.Количество();

КонецФункции

Процедура ЗакрытьИнтервалПрофиля(Профиль, Организация, ДатаОкончания)

	ОбъектПрофиля = Профиль.ПолучитьОбъект();
	Для Каждого СтрокаПрименения Из ОбъектПрофиля.Применения Цикл
		Если СтрокаПрименения.Организация = Организация
			И Не ЗначениеЗаполнено(СтрокаПрименения.НеПрименятьС) Тогда
			СтрокаПрименения.НеПрименятьС = НачалоГода(ДатаОкончания);
			ОбъектПрофиля.Записать();
			Возврат;
		КонецЕсли;
	КонецЦикла;
	ВызватьИсключение "Не найден открытый интервал тестового профиля.";

КонецПроцедуры

Процедура УстановитьНачалоПримененияПрофиля(Профиль, Организация, ДатаНачала)

	ОбъектПрофиля = Профиль.ПолучитьОбъект();
	Для Каждого СтрокаПрименения Из ОбъектПрофиля.Применения Цикл
		Если СтрокаПрименения.Организация = Организация Тогда
			СтрокаПрименения.ПрименятьС = НачалоГода(ДатаНачала);
			ОбъектПрофиля.Записать();
			Возврат;
		КонецЕсли;
	КонецЦикла;
	ВызватьИсключение "Не найден интервал тестового профиля.";

КонецПроцедуры

Функция ЕстьПравило(Правила, Правило)

	Для Каждого ОписаниеПравила Из Правила Цикл
		Если ОписаниеПравила.Ссылка = Правило Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

Функция ПерваяОрганизация()

	Выборка = Справочники.Организации.Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Не Выборка.ПометкаУдаления Тогда
			Возврат Выборка.Ссылка;
		КонецЕсли;
	КонецЦикла;

	Возврат Справочники.Организации.ПустаяСсылка();

КонецФункции

Функция АрендноеПравилоТеста(ВидСтрокиОтчетности, Действие = Неопределено)

	Правило = Справочники.дбу_ПравилаДоработки.СоздатьЭлемент();
	Правило.Наименование = "Тест адресной замены аренды";
	Правило.ВидПравила = Перечисления.дбу_ВидыПравил.КорректировкаПоказателя;
	Правило.Раздел = Перечисления.дбу_РазделыБухОтчетности.Баланс;
	Правило.Формула = "A";

	Операнд = Правило.Операнды.Добавить();
	Операнд.Идентификатор = "A";
	Операнд.СпособРасчета = Перечисления.дбу_СпособыРасчетаОперанда.АрендаКраткосрочная;

	Цель = Правило.Цели.Добавить();
	Цель.ВидСтрокиОтчетности = ВидСтрокиОтчетности;
	Цель.КодСтрокиФСБУ = "1520";
	Цель.Колонка = Перечисления.дбу_КолонкиПоказателя.Колонка04;
	Цель.Действие = ?(Действие = Неопределено,
		Перечисления.дбу_ДействияСПоказателем.Заменить, Действие);
	Если ВидСтрокиОтчетности = Перечисления.дбу_ВидыСтрокОтчетности.ПрямаяРасшифровка Тогда
		Цель.НаименованиеСтроки = "Обязательство по аренде";
		Цель.КодСтрокиВОтчете = "76.07";
	КонецЕсли;

	Возврат Правило;

КонецФункции

Функция ОписаниеПравилаТеста(Правило)

	Описание = Новый Структура;
	Описание.Вставить("Ссылка", Правило.Ссылка);
	Описание.Вставить("Наименование", Правило.Наименование);
	Описание.Вставить("ВидПравила", Правило.ВидПравила);
	Описание.Вставить("Раздел", Правило.Раздел);
	Описание.Вставить("ПрефиксРасшифровки", "");
	Описание.Вставить("ПрефиксПрофиля", "");
	Описание.Вставить("Профиль", Справочники.дбу_ПрофилиДоработки.ПустаяСсылка());
	Описание.Вставить("Формула", Правило.Формула);
	Возврат Описание;

КонецФункции

Функция ПараметрыРасчетаТеста()

	Параметры = Новый Структура;
	Параметры.Вставить("Организация", ПерваяОрганизация());
	Параметры.Вставить("НачалоПериода", Дата(2026, 1, 1));
	Параметры.Вставить("КонецПериода", Дата(2026, 12, 31));
	Возврат Параметры;

КонецФункции

// Шесть квартальных платежей по 100: четыре в пределах 12 месяцев, два позже.
// Превышение графика над 76.07.1 (150) не совпадает с ближайшими платежами.
Функция РасчетАрендыСОтсрочкойТеста()

	График = ГрафикАрендыТеста();
	Для Каждого ДатаПлатежа Из СтрРазделить("20261005,20270105,20270405,20270705,20271005,20280105", ",") Цикл
		ДобавитьПлатежАрендыТеста(График, Дата(ДатаПлатежа), 100, 0, 0);
	КонецЦикла;
	Возврат дбу_РасчетАрендныхОбязательств.РассчитатьПоДанным(
		График, Дата(2026, 9, 30), 450, 150, 0);

КонецФункции

Функция ГрафикАрендыТеста()

	График = Новый ТаблицаЗначений;
	График.Колонки.Добавить("ДатаПлатежа");
	График.Колонки.Добавить("СуммаПлатежа");
	График.Колонки.Добавить("СуммаНДСПлатежа");
	График.Колонки.Добавить("СтавкаДисконтирования");
	Возврат График;

КонецФункции

Процедура ДобавитьПлатежАрендыТеста(График, ДатаПлатежа, СуммаПлатежа,
	СуммаНДС, СтавкаДисконтирования)

	Строка = График.Добавить();
	Строка.ДатаПлатежа = ДатаПлатежа;
	Строка.СуммаПлатежа = СуммаПлатежа;
	Строка.СуммаНДСПлатежа = СуммаНДС;
	Строка.СтавкаДисконтирования = СтавкаДисконтирования;

КонецПроцедуры

#КонецОбласти

