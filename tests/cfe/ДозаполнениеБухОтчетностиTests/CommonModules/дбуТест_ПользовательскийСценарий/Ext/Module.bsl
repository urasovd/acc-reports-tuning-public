		Возврат;
	КонецЕсли;
	МСЧ = НайденныеМСЧ[0];
	Сосед = Неопределено;
	Для Каждого Строка Из МСЧ.Строки Цикл
		Если Строка.Тип = "Строка"
			И ИмяСтрокиМСЧ(Строка, "П10001А1110") = "Другая вписанная строка" Тогда
			Сосед = Строка;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если Сосед <> Неопределено Тогда
		ВставленнаяСтрока = МСЧ.Строки.Вставить(0);
		ДобавитьПоказателиМСЧФикстуры(ВставленнаяСтрока.Строки, "П10001А1110",
			"Вставленная соседняя строка", "", 430);
		МСЧ.Строки.Удалить(Сосед);
	КонецЕсли;

	Адрес = АдресСтрокиТеста(
		Перечисления.дбу_ВидыСтрокОтчетности.ВложеннаяРасшифровка,
		"1110", "Долгосрочная часть", "76.07", "Вписанная строка аренды");
	Результат = РазрешитьАдресТеста(Дерево, Адрес);
	ЮТест.ОжидаетЧто(Результат.Статус).Равно("Найдена");
