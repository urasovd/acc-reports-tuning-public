Процедура ДобавитьПоказателиМСЧФикстуры(Строки, ИдентификаторМСЧ,
	Наименование, Код, Значение)

	ДобавитьУзелФикстуры(Строки, "Показатель", ИдентификаторМСЧ + "02", Наименование);
	Если Лев(ИдентификаторМСЧ, 7) <> "П10001А" Тогда
		ДобавитьУзелФикстуры(Строки, "Показатель", ИдентификаторМСЧ + "03", Код);
	КонецЕсли;
	НомераКолонок = Новый Массив;
	НомераКолонок.Добавить("04");
	НомераКолонок.Добавить("05");
	НомераКолонок.Добавить("06");
	Для Каждого НомерКолонки Из НомераКолонок Цикл
		ДобавитьУзелФикстуры(Строки, "Показатель",
			ИдентификаторМСЧ + НомерКолонки, Значение);
	КонецЦикла;

