Процедура ПроверитьПрофилиРолевогоПользователя(ПользовательИБ, ИмяТиповогоПрофиля, ИмяТестовогоПрофиля)

	ЮТест.ОжидаетЧто(ПользовательИБ.АутентификацияСтандартная).Равно(Истина);
	ЭлементПользователя = Справочники.Пользователи.НайтиПоРеквизиту(
		"ИдентификаторПользователяИБ", ПользовательИБ.УникальныйИдентификатор);
	ЮТест.ОжидаетЧто(ЭлементПользователя.Пустая()).Равно(Ложь);
	ПрофильТиповой = УправлениеДоступом.ПоставляемыйПрофильПоИдентификатору(
		ИмяТиповогоПрофиля);
	ПрофильТестовый = Справочники.ПрофилиГруппДоступа.НайтиПоНаименованию(
		ИмяТестовогоПрофиля);
	ЮТест.ОжидаетЧто(ПрофильТиповой.Пустая()).Равно(Ложь);
	ЮТест.ОжидаетЧто(ПрофильТестовый.Пустая()).Равно(Ложь);
	ПроверитьНаличиеПрофиля(ЭлементПользователя, ПрофильТиповой);
	ПроверитьНаличиеПрофиля(ЭлементПользователя, ПрофильТестовый);

