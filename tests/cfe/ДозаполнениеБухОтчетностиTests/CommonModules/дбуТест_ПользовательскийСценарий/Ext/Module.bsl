Функция НайтиЕдинственнуюСтрокуМСЧ(МСЧ, Наименование)

	НайденнаяСтрока = Неопределено;
	Количество = 0;
	Для Каждого Строка Из МСЧ.Строки Цикл
		Если Строка.Тип <> "Строка" Тогда
			Продолжить;
		КонецЕсли;
		Если ИмяСтрокиМСЧ(Строка, "П10001А1110") = Наименование Тогда
			Количество = Количество + 1;
			НайденнаяСтрока = Строка;
		КонецЕсли;
	КонецЦикла;

	Если Количество <> 1 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат НайденнаяСтрока;

