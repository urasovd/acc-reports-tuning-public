Функция СоздатьИлиОбновитьРолевогоПользователя(Имя, ПолноеИмя, ИмяТиповогоПрофиля, ИменаРолей)

	ПользовательИБ = ПользователиИнформационнойБазы.НайтиПоИмени(Имя);
	Если ПользовательИБ = Неопределено Тогда
		ВызватьИсключение "Не найден пользователь приемочного контура: " + Имя
			+ ". Создайте его по инструкции docs/role-users.md и повторите тесты.";
	КонецЕсли;

	ПользовательИБ.АутентификацияСтандартная = Истина;
	ПользовательИБ.Имя = Имя;
	ПользовательИБ.ПолноеИмя = ПолноеИмя;
	ПользовательИБ.ПоказыватьВСпискеВыбора = Истина;
	ПользовательИБ.Язык = Метаданные.Языки.Русский;
	ПользовательИБ.Записать();
	ЭлементПользователя = СоздатьИлиОбновитьЭлементПользователя(ПользовательИБ);

	// Используем тот же API БСП, что и ручная выдача профиля в разделе
	// «НСИ и администрирование — Настройки пользователей и прав».
	УправлениеДоступом.ВключитьПрофильПользователю(
		ЭлементПользователя, ИмяТиповогоПрофиля);

	ИмяТестовогоПрофиля = ?(ИмяТиповогоПрофиля = "Бухгалтер",
		"ДБУ тест: профиль бухгалтера (только чтение)",
		"ДБУ тест: профиль главного бухгалтера (чтение и изменение)");
	ПрофильДБУ = СоздатьИлиОбновитьПрофильДБУ(ИмяТестовогоПрофиля, ИменаРолей);
	УправлениеДоступом.ВключитьПрофильПользователю(ЭлементПользователя, ПрофильДБУ);

	ПользователиДляОбновления = Новый Массив;
	ПользователиДляОбновления.Добавить(ЭлементПользователя);
	УправлениеДоступом.ОбновитьРолиПользователей(ПользователиДляОбновления);

	Возврат ПользовательИБ;

КонецФункции

Функция СоздатьИлиОбновитьЭлементПользователя(ПользовательИБ)

	ЭлементПользователя = Справочники.Пользователи.НайтиПоРеквизиту(
		"ИдентификаторПользователяИБ", ПользовательИБ.УникальныйИдентификатор);
	Если ЭлементПользователя.Пустая() Тогда
		ЭлементПользователя = Справочники.Пользователи.НайтиПоНаименованию(ПользовательИБ.ПолноеИмя);
	КонецЕсли;
	Если ЭлементПользователя.Пустая() Тогда
		ЭлементПользователя = Справочники.Пользователи.СоздатьЭлемент();
	Иначе
		ЭлементПользователя = ЭлементПользователя.ПолучитьОбъект();
	КонецЕсли;
	ЭлементПользователя.Наименование = ПользовательИБ.ПолноеИмя;
	ОписаниеПользователяИБ = Новый Структура;
	ОписаниеПользователяИБ.Вставить("Действие", "Записать");
	ОписаниеПользователяИБ.Вставить("УникальныйИдентификатор", ПользовательИБ.УникальныйИдентификатор);
	ЭлементПользователя.ДополнительныеСвойства.Вставить(
		"ОписаниеПользователяИБ", ОписаниеПользователяИБ);
	ЭлементПользователя.Записать();
	Возврат ЭлементПользователя.Ссылка;

